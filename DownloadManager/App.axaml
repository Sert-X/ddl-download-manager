<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="DownloadManager.App"
             RequestedThemeVariant="Dark">

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>

                <!-- ============================================ -->
                <!--  TEMA SCURO                                   -->
                <!-- ============================================ -->
                <ResourceDictionary x:Key="Dark">

                    <!-- Accent blu elettrico -->
                    <Color x:Key="SystemAccentColor">#3B82F6</Color>
                    <Color x:Key="SystemAccentColorLight1">#60A5FA</Color>
                    <Color x:Key="SystemAccentColorLight2">#93C5FD</Color>
                    <Color x:Key="SystemAccentColorLight3">#BFDBFE</Color>
                    <Color x:Key="SystemAccentColorDark1">#2563EB</Color>
                    <Color x:Key="SystemAccentColorDark2">#1D4ED8</Color>
                    <Color x:Key="SystemAccentColorDark3">#1E40AF</Color>

                    <!-- Sfondi molto scuri -->
                    <SolidColorBrush x:Key="AppBackgroundBrush">#06070D</SolidColorBrush>
                    <SolidColorBrush x:Key="AppSurfaceBrush">#0D0F18</SolidColorBrush>
                    <SolidColorBrush x:Key="AppSurface2Brush">#141722</SolidColorBrush>
                    <SolidColorBrush x:Key="AppInputBrush">#0A0C14</SolidColorBrush>
                    <SolidColorBrush x:Key="AppBorderBrush">#1F2233</SolidColorBrush>
                    <SolidColorBrush x:Key="AppTextBrush">#E8EAF2</SolidColorBrush>
                    <SolidColorBrush x:Key="AppTextMutedBrush">#7A7F98</SolidColorBrush>

                    <!-- Accent blu -->
                    <SolidColorBrush x:Key="AppAccentBrush">#60A5FA</SolidColorBrush>
                    <SolidColorBrush x:Key="AppAccentHoverBrush">#93C5FD</SolidColorBrush>
                    <SolidColorBrush x:Key="AppAccentSoftBrush">#333B82F6</SolidColorBrush>

                    <!-- Colori semantici -->
                    <SolidColorBrush x:Key="AppSuccessBrush">#34D399</SolidColorBrush>
                    <SolidColorBrush x:Key="AppWarningBrush">#FBBF24</SolidColorBrush>
                    <SolidColorBrush x:Key="AppDangerBrush">#F87171</SolidColorBrush>
                    <SolidColorBrush x:Key="AppInfoBrush">#38BDF8</SolidColorBrush>
                    <SolidColorBrush x:Key="AppHoverBrush">#1A1E30</SolidColorBrush>
                    <SolidColorBrush x:Key="AppSelectedBrush">#232848</SolidColorBrush>

                    <!-- Soft variants -->
                    <SolidColorBrush x:Key="AppSuccessSoftBrush" Color="#2634D399"/>
                    <SolidColorBrush x:Key="AppWarningSoftBrush" Color="#26FBBF24"/>
                    <SolidColorBrush x:Key="AppDangerSoftBrush" Color="#26F87171"/>
                    <SolidColorBrush x:Key="AppInfoSoftBrush" Color="#2638BDF8"/>
                    <SolidColorBrush x:Key="AppSuccessSoftHoverBrush" Color="#4034D399"/>
                    <SolidColorBrush x:Key="AppWarningSoftHoverBrush" Color="#40FBBF24"/>
                    <SolidColorBrush x:Key="AppDangerSoftHoverBrush" Color="#40F87171"/>
                    <SolidColorBrush x:Key="AppInfoSoftHoverBrush" Color="#4038BDF8"/>

                    <!-- Gradienti blu/ciano (meno "violet" del precedente) -->
                    <LinearGradientBrush x:Key="AppAccentGradientBrush" StartPoint="0%,0%" EndPoint="100%,100%">
                        <GradientStop Color="#2563EB" Offset="0"/>
                        <GradientStop Color="#06B6D4" Offset="1"/>
                    </LinearGradientBrush>
                    <LinearGradientBrush x:Key="AppAccentGradientHoverBrush" StartPoint="0%,0%" EndPoint="100%,100%">
                        <GradientStop Color="#3B82F6" Offset="0"/>
                        <GradientStop Color="#22D3EE" Offset="1"/>
                    </LinearGradientBrush>
                    <LinearGradientBrush x:Key="AppHeaderBrush" StartPoint="0%,0%" EndPoint="100%,0%">
                        <GradientStop Color="#0A0D18" Offset="0"/>
                        <GradientStop Color="#0D1020" Offset="0.55"/>
                        <GradientStop Color="#0A0F1C" Offset="1"/>
                    </LinearGradientBrush>

                    <BoxShadows x:Key="AppCardShadow">0 8 24 0 #60000000</BoxShadows>
                    <LinearGradientBrush x:Key="AppCardBrush" StartPoint="0%,0%" EndPoint="0%,100%">
                        <GradientStop Color="#101320" Offset="0"/>
                        <GradientStop Color="#0B0D16" Offset="1"/>
                    </LinearGradientBrush>

                    <SolidColorBrush x:Key="AppProxyBadgeActiveBgBrush" Color="#132A1E"/>
                    <SolidColorBrush x:Key="AppProxyBadgeActiveBorderBrush" Color="#22C55E"/>
                    <SolidColorBrush x:Key="AppProxyBadgeActiveTextBrush" Color="#4ADE80"/>

                    <SolidColorBrush x:Key="AppZeroByteHighlightBrush" Color="#3A0F0F"/>
                    <SolidColorBrush x:Key="AppZeroByteHighlightBorderBrush" Color="#7F1D1D"/>

                    <SolidColorBrush x:Key="AppWarningButtonBgBrush" Color="#26FBBF24"/>
                    <SolidColorBrush x:Key="AppWarningButtonFgBrush" Color="#FBBF24"/>
                    <SolidColorBrush x:Key="AppWarningButtonBorderBrush" Color="#FBBF24"/>

                    <SolidColorBrush x:Key="AppTextSelectionBrush" Color="#2563EB"/>
                    <SolidColorBrush x:Key="AppTextSelectionForegroundBrush" Color="#FFFFFF"/>
                    <SolidColorBrush x:Key="AppCaretBrush" Color="#60A5FA"/>

                    <SolidColorBrush x:Key="TextControlSelectionBrush" Color="#2563EB"/>
                    <SolidColorBrush x:Key="TextControlSelectionForegroundBrush" Color="#FFFFFF"/>
                    <SolidColorBrush x:Key="TextControlSelectionForegroundBrushUnfocused" Color="#FFFFFF"/>

                    <SolidColorBrush x:Key="TextControlBackground" Color="#0A0C14"/>
                    <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="#0E1020"/>
                    <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="#0A0C14"/>
                    <SolidColorBrush x:Key="TextControlBorderBrush" Color="#1F2233"/>
                    <SolidColorBrush x:Key="ComboBoxBackground" Color="#0A0C14"/>
                    <SolidColorBrush x:Key="ComboBoxBackgroundPointerOver" Color="#0E1020"/>
                    <SolidColorBrush x:Key="ComboBoxBorderBrush" Color="#1F2233"/>
                </ResourceDictionary>

                <!-- ============================================ -->
                <!--  TEMA CHIARO                                  -->
                <!-- ============================================ -->
                <ResourceDictionary x:Key="Light">

                    <Color x:Key="SystemAccentColor">#2563EB</Color>
                    <Color x:Key="SystemAccentColorLight1">#3B82F6</Color>
                    <Color x:Key="SystemAccentColorLight2">#60A5FA</Color>
                    <Color x:Key="SystemAccentColorLight3">#93C5FD</Color>
                    <Color x:Key="SystemAccentColorDark1">#1D4ED8</Color>
                    <Color x:Key="SystemAccentColorDark2">#1E40AF</Color>
                    <Color x:Key="SystemAccentColorDark3">#1E3A8A</Color>

                    <SolidColorBrush x:Key="AppBackgroundBrush">#F2F4F9</SolidColorBrush>
                    <SolidColorBrush x:Key="AppSurfaceBrush">#FFFFFF</SolidColorBrush>
                    <SolidColorBrush x:Key="AppSurface2Brush">#ECEEF6</SolidColorBrush>
                    <SolidColorBrush x:Key="AppInputBrush">#FAFBFF</SolidColorBrush>
                    <SolidColorBrush x:Key="AppBorderBrush">#D7DAE5</SolidColorBrush>
                    <SolidColorBrush x:Key="AppTextBrush">#15182A</SolidColorBrush>
                    <SolidColorBrush x:Key="AppTextMutedBrush">#626882</SolidColorBrush>
                    <SolidColorBrush x:Key="AppAccentBrush">#2563EB</SolidColorBrush>
                    <SolidColorBrush x:Key="AppAccentHoverBrush">#1D4ED8</SolidColorBrush>
                    <SolidColorBrush x:Key="AppAccentSoftBrush">#1F2563EB</SolidColorBrush>
                    <SolidColorBrush x:Key="AppSuccessBrush">#059669</SolidColorBrush>
                    <SolidColorBrush x:Key="AppWarningBrush">#B45309</SolidColorBrush>
                    <SolidColorBrush x:Key="AppDangerBrush">#DC2626</SolidColorBrush>
                    <SolidColorBrush x:Key="AppInfoBrush">#0284C7</SolidColorBrush>
                    <SolidColorBrush x:Key="AppHoverBrush">#E3E7F3</SolidColorBrush>
                    <SolidColorBrush x:Key="AppSelectedBrush">#D3DBF2</SolidColorBrush>

                    <SolidColorBrush x:Key="AppSuccessSoftBrush" Color="#1A059669"/>
                    <SolidColorBrush x:Key="AppWarningSoftBrush" Color="#1FF59E0B"/>
                    <SolidColorBrush x:Key="AppDangerSoftBrush" Color="#1ADC2626"/>
                    <SolidColorBrush x:Key="AppInfoSoftBrush" Color="#1A0284C7"/>
                    <SolidColorBrush x:Key="AppSuccessSoftHoverBrush" Color="#2E059669"/>
                    <SolidColorBrush x:Key="AppWarningSoftHoverBrush" Color="#33F59E0B"/>
                    <SolidColorBrush x:Key="AppDangerSoftHoverBrush" Color="#2EDC2626"/>
                    <SolidColorBrush x:Key="AppInfoSoftHoverBrush" Color="#2E0284C7"/>

                    <LinearGradientBrush x:Key="AppAccentGradientBrush" StartPoint="0%,0%" EndPoint="100%,100%">
                        <GradientStop Color="#2563EB" Offset="0"/>
                        <GradientStop Color="#06B6D4" Offset="1"/>
                    </LinearGradientBrush>
                    <LinearGradientBrush x:Key="AppAccentGradientHoverBrush" StartPoint="0%,0%" EndPoint="100%,100%">
                        <GradientStop Color="#3B82F6" Offset="0"/>
                        <GradientStop Color="#22D3EE" Offset="1"/>
                    </LinearGradientBrush>
                    <LinearGradientBrush x:Key="AppHeaderBrush" StartPoint="0%,0%" EndPoint="100%,0%">
                        <GradientStop Color="#FFFFFF" Offset="0"/>
                        <GradientStop Color="#F1F6FF" Offset="0.6"/>
                        <GradientStop Color="#EAF9FF" Offset="1"/>
                    </LinearGradientBrush>

                    <BoxShadows x:Key="AppCardShadow">0 4 18 0 #14204080</BoxShadows>
                    <LinearGradientBrush x:Key="AppCardBrush" StartPoint="0%,0%" EndPoint="0%,100%">
                        <GradientStop Color="#FFFFFF" Offset="0"/>
                        <GradientStop Color="#F8FAFF" Offset="1"/>
                    </LinearGradientBrush>

                    <SolidColorBrush x:Key="AppProxyBadgeActiveBgBrush" Color="#DCFCE7"/>
                    <SolidColorBrush x:Key="AppProxyBadgeActiveBorderBrush" Color="#16A34A"/>
                    <SolidColorBrush x:Key="AppProxyBadgeActiveTextBrush" Color="#15803D"/>

                    <SolidColorBrush x:Key="AppZeroByteHighlightBrush" Color="#FEE2E2"/>
                    <SolidColorBrush x:Key="AppZeroByteHighlightBorderBrush" Color="#FCA5A5"/>

                    <SolidColorBrush x:Key="AppWarningButtonBgBrush" Color="#1FF59E0B"/>
                    <SolidColorBrush x:Key="AppWarningButtonFgBrush" Color="#B45309"/>
                    <SolidColorBrush x:Key="AppWarningButtonBorderBrush" Color="#B45309"/>

                    <SolidColorBrush x:Key="AppTextSelectionBrush" Color="#2563EB"/>
                    <SolidColorBrush x:Key="AppTextSelectionForegroundBrush" Color="#FFFFFF"/>
                    <SolidColorBrush x:Key="AppCaretBrush" Color="#2563EB"/>

                    <SolidColorBrush x:Key="TextControlSelectionBrush" Color="#2563EB"/>
                    <SolidColorBrush x:Key="TextControlSelectionForegroundBrush" Color="#FFFFFF"/>
                    <SolidColorBrush x:Key="TextControlSelectionForegroundBrushUnfocused" Color="#FFFFFF"/>

                    <SolidColorBrush x:Key="TextControlBackground" Color="#FAFBFF"/>
                    <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="#FFFFFF"/>
                    <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="#FFFFFF"/>
                    <SolidColorBrush x:Key="TextControlBorderBrush" Color="#D7DAE5"/>
                    <SolidColorBrush x:Key="ComboBoxBackground" Color="#FAFBFF"/>
                    <SolidColorBrush x:Key="ComboBoxBackgroundPointerOver" Color="#FFFFFF"/>
                    <SolidColorBrush x:Key="ComboBoxBorderBrush" Color="#D7DAE5"/>
                </ResourceDictionary>

            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Fluent.xaml"/>

        <!-- ============================================================ -->
        <!--  WINDOW                                                        -->
        <!-- ============================================================ -->
        <Style Selector=":is(Window)">
            <Setter Property="Background" Value="{DynamicResource AppBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}"/>
            <Setter Property="FontFamily" Value="Inter, Segoe UI, sans-serif"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <!-- ============================================================ -->
        <!--  TABCONTROL                                                    -->
        <!-- ============================================================ -->
        <Style Selector="TabControl">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="0"/>
        </Style>

        <Style Selector="TabControl > TabItem">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource AppTextMutedBrush}"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="CornerRadius" Value="999"/>
        </Style>
        <Style Selector="TabControl > TabItem /template/ Border#PART_SelectedPipe">
            <Setter Property="IsVisible" Value="False"/>
        </Style>
        <Style Selector="TabControl > TabItem:pointerover">
            <Setter Property="Background" Value="{DynamicResource AppHoverBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}"/>
        </Style>
        <Style Selector="TabControl > TabItem:selected">
            <Setter Property="Background" Value="{DynamicResource AppAccentSoftBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource AppAccentBrush}"/>
        </Style>

        <Style Selector="TabControl.nav">
            <Setter Property="Padding" Value="8,4,16,0"/>
        </Style>
        <Style Selector="TabControl.nav > TabItem">
            <Setter Property="Width" Value="236"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="18,13"/>
            <Setter Property="Margin" Value="12,3,4,3"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
        </Style>
        <Style Selector="TabControl.nav > TabItem:pointerover">
            <Setter Property="Background" Value="{DynamicResource AppHoverBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}"/>
        </Style>
        <Style Selector="TabControl.nav > TabItem:selected">
            <Setter Property="Background" Value="{DynamicResource AppAccentGradientBrush}"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>

        <!-- ============================================================ -->
        <!--  BUTTONS                                                       -->
        <!-- ============================================================ -->
        <Style Selector="Button">
            <Setter Property="Background" Value="{DynamicResource AppSurface2Brush}"/>
            <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="999"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style Selector="Button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AppHoverBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AppAccentBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}"/>
        </Style>

        <Style Selector="Button:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AppSelectedBrush}"/>
        </Style>

        <Style Selector="Button.accent">
            <Setter Property="Background" Value="{DynamicResource AppAccentGradientBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style Selector="Button.accent:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AppAccentGradientHoverBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

        <Style Selector="Button.success">
            <Setter Property="Background" Value="{DynamicResource AppSuccessSoftBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AppSuccessBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource AppSuccessBrush}"/>
        </Style>
        <Style Selector="Button.success:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AppSuccessSoftHoverBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AppSuccessBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource AppSuccessBrush}"/>
        </Style>

        <Style Selector="Button.warning">
            <Setter Property="Background" Value="{DynamicResource AppWarningSoftBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AppWarningBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource AppWarningBrush}"/>
        </Style>
        <Style Selector="Button.warning:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AppWarningSoftHoverBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AppWarningBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource AppWarningBrush}"/>
        </Style>

        <Style Selector="Button.danger">
            <Setter Property="Background" Value="{DynamicResource AppDangerSoftBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AppDangerBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource AppDangerBrush}"/>
        </Style>
        <Style Selector="Button.danger:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AppDangerSoftHoverBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AppDangerBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource AppDangerBrush}"/>
        </Style>

        <Style Selector="Button.info">
            <Setter Property="Background" Value="{DynamicResource AppInfoSoftBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AppInfoBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource AppInfoBrush}"/>
        </Style>
        <Style Selector="Button.info:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AppInfoSoftHoverBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AppInfoBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource AppInfoBrush}"/>
        </Style>

        <Style Selector="Button.ghost">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
        </Style>
        <Style Selector="Button.ghost:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AppHoverBrush}"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
        </Style>

        <Style Selector="Button.iconCircle">
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="CornerRadius" Value="18"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>

        <!-- ============================================================ -->
        <!--  TEXTBOX                                                       -->
        <!-- ============================================================ -->
        <Style Selector="TextBox">
            <Setter Property="Background" Value="{DynamicResource AppInputBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="MinHeight" Value="34"/>
            <Setter Property="SelectionBrush" Value="{DynamicResource AppTextSelectionBrush}"/>
            <Setter Property="SelectionForegroundBrush" Value="{DynamicResource AppTextSelectionForegroundBrush}"/>
        </Style>

        <Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
            <Setter Property="BorderBrush" Value="{DynamicResource AppAccentBrush}"/>
        </Style>

        <Style Selector="TextBox /template/ TextPresenter">
            <Setter Property="SelectionBrush" Value="{DynamicResource AppTextSelectionBrush}"/>
            <Setter Property="SelectionForegroundBrush" Value="{DynamicResource AppTextSelectionForegroundBrush}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource AppCaretBrush}"/>
        </Style>

        <!-- ============================================================ -->
        <!--  COMBOBOX                                                      -->
        <!-- ============================================================ -->
        <Style Selector="ComboBox">
            <Setter Property="Background" Value="{DynamicResource AppInputBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="MinHeight" Value="34"/>
        </Style>

        <Style Selector="ComboBox:pointerover /template/ Border#Background">
            <Setter Property="Background" Value="{DynamicResource AppHoverBrush}"/>
        </Style>

        <Style Selector="ComboBox TextBox">
            <Setter Property="SelectionBrush" Value="{DynamicResource AppTextSelectionBrush}"/>
            <Setter Property="SelectionForegroundBrush" Value="{DynamicResource AppTextSelectionForegroundBrush}"/>
        </Style>
        <Style Selector="ComboBox TextBox /template/ TextPresenter">
            <Setter Property="SelectionBrush" Value="{DynamicResource AppTextSelectionBrush}"/>
            <Setter Property="SelectionForegroundBrush" Value="{DynamicResource AppTextSelectionForegroundBrush}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource AppCaretBrush}"/>
        </Style>

        <!-- ============================================================ -->
        <!--  CHECKBOX / RADIOBUTTON                                        -->
        <!-- ============================================================ -->
        <Style Selector="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}"/>
        </Style>
        <Style Selector="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}"/>
        </Style>

        <!-- ============================================================ -->
        <!--  CARD / BORDER                                                 -->
        <!-- ============================================================ -->
        <Style Selector="Border.card">
            <Setter Property="Background" Value="{DynamicResource AppSurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="14"/>
        </Style>

        <Style Selector="Border.cardElevated">
            <Setter Property="Background" Value="{DynamicResource AppCardBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="20"/>
            <Setter Property="Padding" Value="18"/>
            <Setter Property="BoxShadow" Value="{DynamicResource AppCardShadow}"/>
        </Style>

        <Style Selector="Border.poster">
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="ClipToBounds" Value="True"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}"/>
            <Setter Property="BoxShadow" Value="0 3 10 0 #40000000"/>
        </Style>

        <!-- ============================================================ -->
        <!--  GRIGLIA DI LOCANDINE                                          -->
        <!-- ============================================================ -->
        <Style Selector="ListBox.posterGrid">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="2"/>
        </Style>
        <Style Selector="ListBox.posterGrid > ListBoxItem">
            <Setter Property="Padding" Value="8"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="CornerRadius" Value="16"/>
        </Style>
        <Style Selector="ListBox.posterGrid > ListBoxItem:selected /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AppAccentSoftBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AppAccentBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style Selector="ListBox.posterGrid ListBoxItem Border.poster">
            <Setter Property="Transitions">
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.15"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="ListBox.posterGrid ListBoxItem:pointerover Border.poster">
            <Setter Property="RenderTransform" Value="scale(1.05)"/>
        </Style>

        <!-- ============================================================ -->
        <!--  DATAGRID                                                      -->
        <!-- ============================================================ -->
        <Style Selector="DataGrid">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource AppBorderBrush}"/>
            <Setter Property="RowBackground" Value="Transparent"/>
        </Style>

        <Style Selector="DataGridColumnHeader">
            <Setter Property="Background" Value="{DynamicResource AppSurface2Brush}"/>
            <Setter Property="Foreground" Value="{DynamicResource AppTextMutedBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="10,8"/>
        </Style>

        <Style Selector="DataGridRow">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="DataGridRow:pointerover /template/ Rectangle#BackgroundRectangle">
            <Setter Property="Fill" Value="{DynamicResource AppHoverBrush}"/>
        </Style>
        <Style Selector="DataGridRow:selected /template/ Rectangle#BackgroundRectangle">
            <Setter Property="Fill" Value="{DynamicResource AppAccentSoftBrush}"/>
            <Setter Property="Opacity" Value="1"/>
        </Style>

        <Style Selector="DataGridRow.zeroByte">
            <Setter Property="Background" Value="{DynamicResource AppZeroByteHighlightBrush}"/>
        </Style>
        <Style Selector="DataGridRow.zeroByte:pointerover /template/ Rectangle#BackgroundRectangle">
            <Setter Property="Fill" Value="{DynamicResource AppZeroByteHighlightBrush}"/>
        </Style>

        <!-- ============================================================ -->
        <!--  EXPANDER                                                      -->
        <!-- ============================================================ -->
        <Style Selector="Expander">
            <Setter Property="Background" Value="{DynamicResource AppSurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

        <Style Selector="Expander /template/ ToggleButton#PART_toggle">
            <Setter Property="Background" Value="{DynamicResource AppSurfaceBrush}"/>
        </Style>

        <!-- ============================================================ -->
        <!--  PROGRESSBAR                                                   -->
        <!-- ============================================================ -->
        <Style Selector="ProgressBar">
            <Setter Property="Background" Value="{DynamicResource AppBorderBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource AppAccentGradientBrush}"/>
            <Setter Property="CornerRadius" Value="7"/>
        </Style>

        <!-- ============================================================ -->
        <!--  SLIDER                                                        -->
        <!-- ============================================================ -->
        <Style Selector="Slider">
            <Setter Property="Foreground" Value="{DynamicResource AppAccentBrush}"/>
        </Style>

        <!-- ============================================================ -->
        <!--  SEPARATOR                                                     -->
        <!-- ============================================================ -->
        <Style Selector="Separator">
            <Setter Property="Background" Value="{DynamicResource AppBorderBrush}"/>
        </Style>

        <!-- ============================================================ -->
        <!--  LISTBOX                                                       -->
        <!-- ============================================================ -->
        <Style Selector="ListBox">
            <Setter Property="Background" Value="{DynamicResource AppSurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}"/>
        </Style>

        <Style Selector="ListBoxItem">
            <Setter Property="CornerRadius" Value="8"/>
        </Style>
        <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AppHoverBrush}"/>
        </Style>
        <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AppSelectedBrush}"/>
        </Style>

        <!-- ============================================================ -->
        <!--  SCROLLBAR                                                     -->
        <!-- ============================================================ -->
        <Style Selector="ScrollBar">
            <Setter Property="Background" Value="Transparent"/>
        </Style>

        <!-- ============================================================ -->
        <!--  PROXY BADGE                                                   -->
        <!-- ============================================================ -->
        <Style Selector="Border.proxyBadge">
            <Setter Property="Background" Value="{DynamicResource AppSurface2Brush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="999"/>
            <Setter Property="Padding" Value="12,5"/>
        </Style>

        <Style Selector="Border.proxyBadge > TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource AppTextMutedBrush}"/>
        </Style>

        <Style Selector="Border.proxyBadge.proxyActive">
            <Setter Property="Background" Value="{DynamicResource AppProxyBadgeActiveBgBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AppProxyBadgeActiveBorderBrush}"/>
        </Style>

        <Style Selector="Border.proxyBadge.proxyActive > TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource AppProxyBadgeActiveTextBrush}"/>
        </Style>
    </Application.Styles>
</Application>