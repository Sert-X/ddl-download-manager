                    <SolidColorBrush x:Key="MenuFlyoutPresenterBorderBrush" Color="#D7DAE5"/>
                    <SolidColorBrush x:Key="MenuFlyoutItemBackgroundPointerOver" Color="#EEF1F9"/>
