<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:h="using:DownloadManager.Helpers"
             x:Class="DownloadManager.App"
             RequestedThemeVariant="Dark">

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>

                <!-- TEMA SCURO -->
                <ResourceDictionary x:Key="Dark">
                    <Color x:Key="SystemAccentColor">#3B82F6</Color>
                    <Color x:Key="SystemAccentColorLight1">#60A5FA</Color>
                    <Color x:Key="SystemAccentColorLight2">#93C5FD</Color>
                    <Color x:Key="SystemAccentColorLight3">#BFDBFE</Color>
                    <Color x:Key="SystemAccentColorDark1">#2563EB</Color>
                    <Color x:Key="SystemAccentColorDark2">#1D4ED8</Color>
                    <Color x:Key="SystemAccentColorDark3">#1E40AF</Color>

                    <SolidColorBrush x:Key="AppBackgroundBrush">#06070D</SolidColorBrush>
                    <SolidColorBrush x:Key="AppSurfaceBrush">#0D0F18</SolidColorBrush>
                    <SolidColorBrush x:Key="AppSurface2Brush">#141722</SolidColorBrush>
                    <SolidColorBrush x:Key="AppInputBrush">#0A0C14</SolidColorBrush>
                    <SolidColorBrush x:Key="AppBorderBrush">#1F2233</SolidColorBrush>
                    <SolidColorBrush x:Key="AppTextBrush">#E8EAF2</SolidColorBrush>
                    <SolidColorBrush x:Key="AppTextMutedBrush">#7A7F98</SolidColorBrush>
                    <SolidColorBrush x:Key="AppExpanderBrush">#1C2033</SolidColorBrush>
                    <!-- Superfici dedicate alla coda download: blu ardesia, non nero -->
                    <SolidColorBrush x:Key="DownloadGroupCardBrush">#14161F</SolidColorBrush>
                    <SolidColorBrush x:Key="DownloadGroupHeaderBrush">#1B1E2B</SolidColorBrush>
                    <SolidColorBrush x:Key="DownloadGroupHeaderHoverBrush">#242839</SolidColorBrush>
                    <SolidColorBrush x:Key="DownloadGroupRowBrush">#11131B</SolidColorBrush>
                    <SolidColorBrush x:Key="DownloadGroupRowAltBrush">#161925</SolidColorBrush>
                    <!-- Tab -->
                    <SolidColorBrush x:Key="AppTabTrackBrush">#0D0F18</SolidColorBrush>
                    <SolidColorBrush x:Key="AppTabSelectedBrush">#222637</SolidColorBrush>
                    <SolidColorBrush x:Key="AppTabSelectedBorderBrush">#2F354B</SolidColorBrush>
                    <!-- Scrollbar -->
                    <!-- Menu a tendina / menu contestuali -->
                    <SolidColorBrush x:Key="ComboBoxItemForegroundPointerOver">#E8EAF2</SolidColorBrush>
                    <SolidColorBrush x:Key="ComboBoxItemForegroundPressed">#E8EAF2</SolidColorBrush>
                    <SolidColorBrush x:Key="ContextMenuBackground">#141722</SolidColorBrush>
                    <SolidColorBrush x:Key="ContextMenuBorderBrush">#2A2F45</SolidColorBrush>

                    <!-- Scrollbar -->
                    <SolidColorBrush x:Key="AppScrollThumbBrush">#2E344A</SolidColorBrush>
                    <SolidColorBrush x:Key="AppScrollThumbHoverBrush">#4A5270</SolidColorBrush>
                    <SolidColorBrush x:Key="AppScrollThumbPressedBrush">#60A5FA</SolidColorBrush>

                    <!-- Menu a tendina / menu contestuali -->
                    <SolidColorBrush x:Key="ComboBoxDropDownBackground" Color="#12151F"/>
                    <SolidColorBrush x:Key="ComboBoxDropDownBorderBrush" Color="#2A2F45"/>
                    <SolidColorBrush x:Key="ComboBoxItemBackgroundPointerOver" Color="#1D2132"/>
                    <SolidColorBrush x:Key="ComboBoxItemBackgroundPressed" Color="#252A3E"/>
                    <SolidColorBrush x:Key="ComboBoxItemBackgroundSelected" Color="#252A3E"/>
                    <SolidColorBrush x:Key="ComboBoxItemBackgroundSelectedUnfocused" Color="#252A3E"/>
                    <SolidColorBrush x:Key="ComboBoxItemBackgroundSelectedPointerOver" Color="#2B3148"/>
                    <SolidColorBrush x:Key="ComboBoxItemBackgroundSelectedPressed" Color="#252A3E"/>
                    <SolidColorBrush x:Key="ComboBoxItemForegroundSelected" Color="#60A5FA"/>
                    <SolidColorBrush x:Key="ComboBoxItemForegroundSelectedUnfocused" Color="#60A5FA"/>
                    <SolidColorBrush x:Key="ComboBoxItemForegroundSelectedPointerOver" Color="#60A5FA"/>
                    <SolidColorBrush x:Key="ComboBoxItemForegroundSelectedPressed" Color="#60A5FA"/>
                    <SolidColorBrush x:Key="MenuFlyoutPresenterBackground" Color="#12151F"/>
                    <SolidColorBrush x:Key="MenuFlyoutPresenterBorderBrush" Color="#2A2F45"/>
                    <SolidColorBrush x:Key="MenuFlyoutItemBackgroundPointerOver" Color="#1D2132"/>
                    <SolidColorBrush x:Key="MenuFlyoutItemBackgroundPressed" Color="#252A3E"/>

                    <SolidColorBrush x:Key="AppAccentBrush">#60A5FA</SolidColorBrush>
                    <SolidColorBrush x:Key="AppAccentHoverBrush">#93C5FD</SolidColorBrush>
                    <SolidColorBrush x:Key="AppAccentSoftBrush">#333B82F6</SolidColorBrush>
                    <SolidColorBrush x:Key="AppAccentSoftHoverBrush">#4D3B82F6</SolidColorBrush>

                    <SolidColorBrush x:Key="AppSuccessBrush">#34D399</SolidColorBrush>
                    <SolidColorBrush x:Key="AppWarningBrush">#FBBF24</SolidColorBrush>
                    <SolidColorBrush x:Key="AppDangerBrush">#F87171</SolidColorBrush>
                    <SolidColorBrush x:Key="AppInfoBrush">#38BDF8</SolidColorBrush>
                    <SolidColorBrush x:Key="AppHoverBrush">#1A1E30</SolidColorBrush>
                    <SolidColorBrush x:Key="AppSelectedBrush">#232848</SolidColorBrush>

                    <SolidColorBrush x:Key="AppSuccessSoftBrush" Color="#2634D399"/>
                    <SolidColorBrush x:Key="AppWarningSoftBrush" Color="#26FBBF24"/>
                    <SolidColorBrush x:Key="AppDangerSoftBrush" Color="#26F87171"/>
                    <SolidColorBrush x:Key="AppInfoSoftBrush" Color="#2638BDF8"/>
                    <SolidColorBrush x:Key="AppSuccessSoftHoverBrush" Color="#4034D399"/>
                    <SolidColorBrush x:Key="AppWarningSoftHoverBrush" Color="#40FBBF24"/>
                    <SolidColorBrush x:Key="AppDangerSoftHoverBrush" Color="#40F87171"/>
                    <SolidColorBrush x:Key="AppInfoSoftHoverBrush" Color="#4038BDF8"/>

                    <LinearGradientBrush x:Key="AppAccentGradientBrush" StartPoint="0%,0%" EndPoint="100%,100%">
                        <GradientStop Color="#2563EB" Offset="0"/>
                        <GradientStop Color="#06B6D4" Offset="1"/>
                    </LinearGradientBrush>
                    <LinearGradientBrush x:Key="AppAccentGradientHoverBrush" StartPoint="0%,0%" EndPoint="100%,100%">
                        <GradientStop Color="#3B82F6" Offset="0"/>
                        <GradientStop Color="#22D3EE" Offset="1"/>
                    </LinearGradientBrush>
                    <LinearGradientBrush x:Key="AppHeaderBrush" StartPoint="0%,0%" EndPoint="100%,0%">
                        <GradientStop Color="#0A0D18" Offset="0"/>
                        <GradientStop Color="#0D1020" Offset="0.55"/>
                        <GradientStop Color="#0A0F1C" Offset="1"/>
                    </LinearGradientBrush>

                    <BoxShadows x:Key="AppCardShadow">0 8 24 0 #60000000</BoxShadows>
                    <LinearGradientBrush x:Key="AppCardBrush" StartPoint="0%,0%" EndPoint="0%,100%">
                        <GradientStop Color="#101320" Offset="0"/>
                        <GradientStop Color="#0B0D16" Offset="1"/>
                    </LinearGradientBrush>

                    <SolidColorBrush x:Key="AppProxyBadgeActiveBgBrush" Color="#132A1E"/>
                    <SolidColorBrush x:Key="AppProxyBadgeActiveBorderBrush" Color="#22C55E"/>
                    <SolidColorBrush x:Key="AppProxyBadgeActiveTextBrush" Color="#4ADE80"/>

                    <SolidColorBrush x:Key="AppZeroByteHighlightBrush" Color="#3A0F0F"/>
                    <SolidColorBrush x:Key="AppZeroByteHighlightBorderBrush" Color="#7F1D1D"/>

                    <SolidColorBrush x:Key="AppTextSelectionBrush" Color="#2563EB"/>
                    <SolidColorBrush x:Key="AppTextSelectionForegroundBrush" Color="#FFFFFF"/>
                    <SolidColorBrush x:Key="AppCaretBrush" Color="#60A5FA"/>

                    <SolidColorBrush x:Key="TextControlSelectionBrush" Color="#2563EB"/>
                    <SolidColorBrush x:Key="TextControlSelectionForegroundBrush" Color="#FFFFFF"/>
                    <SolidColorBrush x:Key="TextControlSelectionForegroundBrushUnfocused" Color="#FFFFFF"/>

                    <SolidColorBrush x:Key="TextControlBackground" Color="#0A0C14"/>
                    <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="#0E1020"/>
                    <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="#0A0C14"/>
                    <SolidColorBrush x:Key="TextControlBorderBrush" Color="#1F2233"/>
                    <SolidColorBrush x:Key="ComboBoxBackground" Color="#0A0C14"/>
                    <SolidColorBrush x:Key="ComboBoxBackgroundPointerOver" Color="#0E1020"/>
                    <SolidColorBrush x:Key="ComboBoxBorderBrush" Color="#1F2233"/>
                </ResourceDictionary>

                <!-- TEMA CHIARO -->
                <ResourceDictionary x:Key="Light">
                    <Color x:Key="SystemAccentColor">#2563EB</Color>
                    <Color x:Key="SystemAccentColorLight1">#3B82F6</Color>
                    <Color x:Key="SystemAccentColorLight2">#60A5FA</Color>
                    <Color x:Key="SystemAccentColorLight3">#93C5FD</Color>
                    <Color x:Key="SystemAccentColorDark1">#1D4ED8</Color>
                    <Color x:Key="SystemAccentColorDark2">#1E40AF</Color>
                    <Color x:Key="SystemAccentColorDark3">#1E3A8A</Color>
                    <SolidColorBrush x:Key="AppExpanderBrush">#F5F7FD</SolidColorBrush>
                    <!-- Superfici dedicate alla coda download -->
                    <SolidColorBrush x:Key="DownloadGroupCardBrush">#FFFFFF</SolidColorBrush>
                    <SolidColorBrush x:Key="DownloadGroupHeaderBrush">#F1F3F9</SolidColorBrush>
                    <SolidColorBrush x:Key="DownloadGroupHeaderHoverBrush">#E6EAF4</SolidColorBrush>
                    <SolidColorBrush x:Key="DownloadGroupRowBrush">#FFFFFF</SolidColorBrush>
                    <SolidColorBrush x:Key="DownloadGroupRowAltBrush">#F7F8FB</SolidColorBrush>
                    <!-- Tab -->
                    <SolidColorBrush x:Key="AppTabTrackBrush">#E8EBF3</SolidColorBrush>
                    <SolidColorBrush x:Key="AppTabSelectedBrush">#FFFFFF</SolidColorBrush>
                    <SolidColorBrush x:Key="AppTabSelectedBorderBrush">#D7DAE5</SolidColorBrush>
                    <!-- Scrollbar -->
                    <!-- Menu a tendina / menu contestuali -->
                    <SolidColorBrush x:Key="ComboBoxItemForegroundPointerOver">#15182A</SolidColorBrush>
                    <SolidColorBrush x:Key="ComboBoxItemForegroundPressed">#15182A</SolidColorBrush>
                    <SolidColorBrush x:Key="ContextMenuBackground">#FFFFFF</SolidColorBrush>
                    <SolidColorBrush x:Key="ContextMenuBorderBrush">#D7DAE5</SolidColorBrush>

                    <!-- Scrollbar -->
                    <SolidColorBrush x:Key="AppScrollThumbBrush">#C9CEDC</SolidColorBrush>
                    <SolidColorBrush x:Key="AppScrollThumbHoverBrush">#9CA4BC</SolidColorBrush>
                    <SolidColorBrush x:Key="AppScrollThumbPressedBrush">#2563EB</SolidColorBrush>

                    <!-- Menu a tendina / menu contestuali -->
                    <SolidColorBrush x:Key="ComboBoxDropDownBackground" Color="#FFFFFF"/>
                    <SolidColorBrush x:Key="ComboBoxDropDownBorderBrush" Color="#D7DAE5"/>
