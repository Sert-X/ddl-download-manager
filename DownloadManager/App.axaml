<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="DownloadManager.App"
             RequestedThemeVariant="Dark">

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>

                <!-- ============================================ -->
                <!--  TEMA SCURO (Netflix-like)                   -->
                <!-- ============================================ -->
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="AppBackgroundBrush">#0B0B0F</SolidColorBrush>
                    <SolidColorBrush x:Key="AppSurfaceBrush">#16161C</SolidColorBrush>
                    <SolidColorBrush x:Key="AppSurface2Brush">#1E1E26</SolidColorBrush>
                    <SolidColorBrush x:Key="AppBorderBrush">#2A2A35</SolidColorBrush>
                    <SolidColorBrush x:Key="AppTextBrush">#F5F5F7</SolidColorBrush>
                    <SolidColorBrush x:Key="AppTextMutedBrush">#8E8EA0</SolidColorBrush>
                    <SolidColorBrush x:Key="AppAccentBrush">#E50914</SolidColorBrush>
                    <SolidColorBrush x:Key="AppAccentHoverBrush">#F6121D</SolidColorBrush>
                    <SolidColorBrush x:Key="AppSuccessBrush">#22C55E</SolidColorBrush>
                    <SolidColorBrush x:Key="AppWarningBrush">#F59E0B</SolidColorBrush>
                    <SolidColorBrush x:Key="AppDangerBrush">#EF4444</SolidColorBrush>
                    <SolidColorBrush x:Key="AppInfoBrush">#3B82F6</SolidColorBrush>
                    <SolidColorBrush x:Key="AppHoverBrush">#22222C</SolidColorBrush>
                    <SolidColorBrush x:Key="AppSelectedBrush">#2A2A3A</SolidColorBrush>
                    <SolidColorBrush x:Key="AppProxyBadgeActiveBgBrush" Color="#1E3A24"/>
                    <SolidColorBrush x:Key="AppProxyBadgeActiveBorderBrush" Color="#22C55E"/>
                    <SolidColorBrush x:Key="AppProxyBadgeActiveTextBrush" Color="#4ADE80"/>

                    <!-- Evidenziazione file/cartelle con 0-byte (tema scuro) -->
                    <SolidColorBrush x:Key="AppZeroByteHighlightBrush" Color="#4A1414"/>
                    <SolidColorBrush x:Key="AppZeroByteHighlightBorderBrush" Color="#7F1D1D"/>

                    <!-- Pulsanti .warning (tema scuro: pieno) -->
                    <SolidColorBrush x:Key="AppWarningButtonBgBrush" Color="#F59E0B"/>
                    <SolidColorBrush x:Key="AppWarningButtonFgBrush" Color="#FFFFFF"/>
                    <SolidColorBrush x:Key="AppWarningButtonBorderBrush" Color="#F59E0B"/>

                    <!-- Selezione testo (tema scuro) -->
                    <SolidColorBrush x:Key="AppTextSelectionBrush" Color="#3B82F6"/>
                    <SolidColorBrush x:Key="AppTextSelectionForegroundBrush" Color="#FFFFFF"/>
                    <SolidColorBrush x:Key="AppCaretBrush" Color="#E50914"/>

                    <!-- Override risorse Fluent per la selezione testo.
                         Queste sono le chiavi che il TextBox e il ComboBox
                         editable usano davvero: sovrascriverle garantisce
                         che il colore venga applicato ovunque. -->
                    <SolidColorBrush x:Key="TextControlSelectionBrush" Color="#3B82F6"/>
                    <SolidColorBrush x:Key="TextControlSelectionForegroundBrush" Color="#FFFFFF"/>
                    <SolidColorBrush x:Key="TextControlSelectionForegroundBrushUnfocused" Color="#FFFFFF"/>
                </ResourceDictionary>

                <!-- ============================================ -->
                <!--  TEMA CHIARO (Netflix-like)                  -->
                <!-- ============================================ -->
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="AppBackgroundBrush">#F5F5F8</SolidColorBrush>
                    <SolidColorBrush x:Key="AppSurfaceBrush">#FFFFFF</SolidColorBrush>
                    <SolidColorBrush x:Key="AppSurface2Brush">#EFEFF4</SolidColorBrush>
                    <SolidColorBrush x:Key="AppBorderBrush">#D4D4DD</SolidColorBrush>
                    <SolidColorBrush x:Key="AppTextBrush">#0F0F17</SolidColorBrush>
                    <SolidColorBrush x:Key="AppTextMutedBrush">#5A5A6E</SolidColorBrush>
                    <SolidColorBrush x:Key="AppAccentBrush">#E50914</SolidColorBrush>
                    <SolidColorBrush x:Key="AppAccentHoverBrush">#C50812</SolidColorBrush>
                    <SolidColorBrush x:Key="AppSuccessBrush">#15803D</SolidColorBrush>
                    <SolidColorBrush x:Key="AppWarningBrush">#B45309</SolidColorBrush>
                    <SolidColorBrush x:Key="AppDangerBrush">#B91C1C</SolidColorBrush>
                    <SolidColorBrush x:Key="AppInfoBrush">#1D4ED8</SolidColorBrush>
                    <SolidColorBrush x:Key="AppHoverBrush">#E4E4EC</SolidColorBrush>
                    <SolidColorBrush x:Key="AppSelectedBrush">#D4D4E0</SolidColorBrush>
                    <SolidColorBrush x:Key="AppProxyBadgeActiveBgBrush" Color="#DCFCE7"/>
                    <SolidColorBrush x:Key="AppProxyBadgeActiveBorderBrush" Color="#16A34A"/>
                    <SolidColorBrush x:Key="AppProxyBadgeActiveTextBrush" Color="#15803D"/>

                    <!-- Evidenziazione file/cartelle con 0-byte (tema chiaro) -->
                    <SolidColorBrush x:Key="AppZeroByteHighlightBrush" Color="#FEE2E2"/>
                    <SolidColorBrush x:Key="AppZeroByteHighlightBorderBrush" Color="#FCA5A5"/>

                    <!-- Pulsanti .warning (tema chiaro: soft, leggibile) -->
                    <SolidColorBrush x:Key="AppWarningButtonBgBrush" Color="#FEF3C7"/>
                    <SolidColorBrush x:Key="AppWarningButtonFgBrush" Color="#92400E"/>
                    <SolidColorBrush x:Key="AppWarningButtonBorderBrush" Color="#F59E0B"/>

                    <!-- Selezione testo (tema chiaro) -->
                    <SolidColorBrush x:Key="AppTextSelectionBrush" Color="#3B82F6"/>
                    <SolidColorBrush x:Key="AppTextSelectionForegroundBrush" Color="#FFFFFF"/>
                    <SolidColorBrush x:Key="AppCaretBrush" Color="#E50914"/>

                    <!-- Override risorse Fluent per la selezione testo. -->
                    <SolidColorBrush x:Key="TextControlSelectionBrush" Color="#3B82F6"/>
                    <SolidColorBrush x:Key="TextControlSelectionForegroundBrush" Color="#FFFFFF"/>
                    <SolidColorBrush x:Key="TextControlSelectionForegroundBrushUnfocused" Color="#FFFFFF"/>
                </ResourceDictionary>

            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Fluent.xaml"/>

        <!-- ============================================================ -->
        <!--  WINDOW BACKGROUND                                             -->
        <!-- ============================================================ -->
        <Style Selector="Window">
            <Setter Property="Background" Value="{DynamicResource AppBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}"/>
            <Setter Property="FontFamily" Value="Inter, Segoe UI, sans-serif"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <Style Selector="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}"/>
        </Style>

        <!-- ============================================================ -->
        <!--  TABCONTROL                                                    -->
        <!-- ============================================================ -->
        <Style Selector="TabControl">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="0"/>
        </Style>

        <Style Selector="TabControl > TabItem">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource AppTextMutedBrush}"/>
            <Setter Property="Padding" Value="18,10"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
            <Setter Property="Background" Value="Transparent"/>
        </Style>

        <Style Selector="TabControl > TabItem:pointerover /template/ Border#PART_SelectedPipe">
            <Setter Property="Background" Value="{DynamicResource AppTextMutedBrush}"/>
        </Style>

        <Style Selector="TabControl > TabItem:selected">
            <Setter Property="Foreground" Value="{DynamicResource AppAccentBrush}"/>
        </Style>

        <Style Selector="TabControl > TabItem:selected /template/ Border#PART_SelectedPipe">
            <Setter Property="Background" Value="{DynamicResource AppAccentBrush}"/>
        </Style>

        <!-- ============================================================ -->
        <!--  BUTTONS                                                       -->
        <!-- ============================================================ -->
        <Style Selector="Button">
            <Setter Property="Background" Value="{DynamicResource AppSurface2Brush}"/>
            <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style Selector="Button:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AppHoverBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AppAccentBrush}"/>
        </Style>

        <Style Selector="Button:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AppSelectedBrush}"/>
        </Style>

        <Style Selector="Button.accent">
            <Setter Property="Background" Value="{DynamicResource AppAccentBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AppAccentBrush}"/>
        </Style>
        <Style Selector="Button.accent:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AppAccentHoverBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AppAccentHoverBrush}"/>
        </Style>

        <Style Selector="Button.success">
            <Setter Property="Background" Value="{DynamicResource AppSuccessBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AppSuccessBrush}"/>
        </Style>

        <!-- Pulsante warning: nel tema scuro è pieno ambra,
             nel tema chiaro è "soft" (bg ambra chiarissimo, testo ambra scuro). -->
        <Style Selector="Button.warning">
            <Setter Property="Background" Value="{DynamicResource AppWarningButtonBgBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource AppWarningButtonFgBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AppWarningButtonBorderBrush}"/>
        </Style>
        <Style Selector="Button.warning:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AppWarningBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AppWarningBrush}"/>
        </Style>

        <Style Selector="Button.danger">
            <Setter Property="Background" Value="{DynamicResource AppDangerBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AppDangerBrush}"/>
        </Style>

        <Style Selector="Button.info">
            <Setter Property="Background" Value="{DynamicResource AppInfoBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AppInfoBrush}"/>
        </Style>

        <Style Selector="Button.ghost">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
        </Style>
        <Style Selector="Button.ghost:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AppHoverBrush}"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
        </Style>

        <Style Selector="Button.iconCircle">
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="CornerRadius" Value="18"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>

        <!-- ============================================================ -->
        <!--  TEXTBOX                                                       -->
        <!-- ============================================================ -->
        <Style Selector="TextBox">
            <Setter Property="Background" Value="{DynamicResource AppSurface2Brush}"/>
            <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="MinHeight" Value="32"/>
            <!-- Selezione testo: applicata direttamente sul TextBox.
                 Insieme agli override di TextControlSelectionBrush nei
                 ThemeDictionaries, garantisce leggibilità in entrambi i temi. -->
            <Setter Property="SelectionBrush" Value="{DynamicResource AppTextSelectionBrush}"/>
            <Setter Property="SelectionForegroundBrush" Value="{DynamicResource AppTextSelectionForegroundBrush}"/>
        </Style>

        <Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
            <Setter Property="BorderBrush" Value="{DynamicResource AppAccentBrush}"/>
        </Style>

        <!-- Fallback: applica anche direttamente al TextPresenter interno -->
        <Style Selector="TextBox /template/ TextPresenter">
            <Setter Property="SelectionBrush" Value="{DynamicResource AppTextSelectionBrush}"/>
            <Setter Property="SelectionForegroundBrush" Value="{DynamicResource AppTextSelectionForegroundBrush}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource AppCaretBrush}"/>
        </Style>

        <!-- ============================================================ -->
        <!--  COMBOBOX                                                      -->
        <!-- ============================================================ -->
        <Style Selector="ComboBox">
            <Setter Property="Background" Value="{DynamicResource AppSurface2Brush}"/>
            <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="MinHeight" Value="32"/>
        </Style>

        <Style Selector="ComboBox:pointerover /template/ Border#Background">
            <Setter Property="Background" Value="{DynamicResource AppHoverBrush}"/>
        </Style>

        <!-- ComboBox editable: il TextBox interno usa le stesse risorse -->
        <Style Selector="ComboBox TextBox">
            <Setter Property="SelectionBrush" Value="{DynamicResource AppTextSelectionBrush}"/>
            <Setter Property="SelectionForegroundBrush" Value="{DynamicResource AppTextSelectionForegroundBrush}"/>
        </Style>
        <Style Selector="ComboBox TextBox /template/ TextPresenter">
            <Setter Property="SelectionBrush" Value="{DynamicResource AppTextSelectionBrush}"/>
            <Setter Property="SelectionForegroundBrush" Value="{DynamicResource AppTextSelectionForegroundBrush}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource AppCaretBrush}"/>
        </Style>

        <!-- ============================================================ -->
        <!--  CHECKBOX / RADIOBUTTON                                        -->
        <!-- ============================================================ -->
        <Style Selector="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}"/>
        </Style>
        <Style Selector="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}"/>
        </Style>

        <!-- ============================================================ -->
        <!--  CARD / BORDER                                                 -->
        <!-- ============================================================ -->
        <Style Selector="Border.card">
            <Setter Property="Background" Value="{DynamicResource AppSurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="14"/>
        </Style>

        <Style Selector="Border.cardElevated">
            <Setter Property="Background" Value="{DynamicResource AppSurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="14"/>
            <Setter Property="BoxShadow" Value="0 4 20 0 #20000000"/>
        </Style>

        <!-- ============================================================ -->
        <!--  DATAGRID                                                      -->
        <!-- ============================================================ -->
        <Style Selector="DataGrid">
            <Setter Property="Background" Value="{DynamicResource AppSurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource AppBorderBrush}"/>
            <Setter Property="RowBackground" Value="Transparent"/>
        </Style>

        <Style Selector="DataGridColumnHeader">
            <Setter Property="Background" Value="{DynamicResource AppSurface2Brush}"/>
            <Setter Property="Foreground" Value="{DynamicResource AppTextMutedBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="10,8"/>
        </Style>

        <Style Selector="DataGridRow">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="DataGridRow:pointerover /template/ Rectangle#BackgroundRectangle">
            <Setter Property="Fill" Value="{DynamicResource AppHoverBrush}"/>
        </Style>
        <Style Selector="DataGridRow:selected /template/ Rectangle#BackgroundRectangle">
            <Setter Property="Fill" Value="{DynamicResource AppSelectedBrush}"/>
        </Style>

        <!-- Evidenziazione riga con 0-byte. La classe .zeroByte viene aggiunta
             dinamicamente dal DataGrid.Styles in MainWindow.axaml. -->
        <Style Selector="DataGridRow.zeroByte">
            <Setter Property="Background" Value="{DynamicResource AppZeroByteHighlightBrush}"/>
        </Style>
        <Style Selector="DataGridRow.zeroByte:pointerover /template/ Rectangle#BackgroundRectangle">
            <Setter Property="Fill" Value="{DynamicResource AppZeroByteHighlightBrush}"/>
        </Style>

        <!-- ============================================================ -->
        <!--  EXPANDER                                                      -->
        <!-- ============================================================ -->
        <Style Selector="Expander">
            <Setter Property="Background" Value="{DynamicResource AppSurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

        <Style Selector="Expander /template/ ToggleButton#PART_toggle">
            <Setter Property="Background" Value="{DynamicResource AppSurfaceBrush}"/>
        </Style>

        <!-- ============================================================ -->
        <!--  PROGRESSBAR                                                   -->
        <!-- ============================================================ -->
        <Style Selector="ProgressBar">
            <Setter Property="Background" Value="{DynamicResource AppSurface2Brush}"/>
            <Setter Property="Foreground" Value="{DynamicResource AppAccentBrush}"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="MinHeight" Value="14"/>
        </Style>

        <!-- ============================================================ -->
        <!--  SLIDER                                                        -->
        <!-- ============================================================ -->
        <Style Selector="Slider">
            <Setter Property="Foreground" Value="{DynamicResource AppAccentBrush}"/>
        </Style>

        <!-- ============================================================ -->
        <!--  SEPARATOR                                                     -->
        <!-- ============================================================ -->
        <Style Selector="Separator">
            <Setter Property="Background" Value="{DynamicResource AppBorderBrush}"/>
        </Style>

        <!-- ============================================================ -->
        <!--  LISTBOX                                                       -->
        <!-- ============================================================ -->
        <Style Selector="ListBox">
            <Setter Property="Background" Value="{DynamicResource AppSurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}"/>
        </Style>

        <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AppHoverBrush}"/>
        </Style>
        <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AppSelectedBrush}"/>
        </Style>

        <!-- ============================================================ -->
        <!--  SCROLLBAR                                                     -->
        <!-- ============================================================ -->
        <Style Selector="ScrollBar">
            <Setter Property="Background" Value="Transparent"/>
        </Style>

        <!-- ============================================================ -->
        <!--  PROXY BADGE                                                 -->
        <!-- ============================================================ -->
        <Style Selector="Border.proxyBadge">
            <Setter Property="Background" Value="{DynamicResource AppSurface2Brush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="10,4"/>
        </Style>

        <Style Selector="Border.proxyBadge > TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource AppTextMutedBrush}"/>
        </Style>

        <Style Selector="Border.proxyBadge.proxyActive">
            <Setter Property="Background" Value="{DynamicResource AppProxyBadgeActiveBgBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AppProxyBadgeActiveBorderBrush}"/>
        </Style>

        <Style Selector="Border.proxyBadge.proxyActive > TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource AppProxyBadgeActiveTextBrush}"/>
        </Style>
    </Application.Styles>
</Application>