            <StreamGeometry x:Key="IconLogOut">M 9,21 L 5,21 A 2,2 0 0 1 3,19 L 3,5 A 2,2 0 0 1 5,3 L 9,3 M 16,17 L 21,12 L 16,7 M 21,12 L 9,12</StreamGeometry>
            <StreamGeometry x:Key="IconEye">M 1,12 C 1,12 5,4 12,4 C 19,4 23,12 23,12 C 23,12 19,20 12,20 C 5,20 1,12 1,12 Z M 15,12 A 3,3 0 1 1 9,12 A 3,3 0 1 1 15,12 Z</StreamGeometry>
            <StreamGeometry x:Key="IconUndo">M 3,7 L 3,13 L 9,13 M 3.51,13 A 9,9 0 1 0 5.64,6.64 L 3,9</StreamGeometry>
            <StreamGeometry x:Key="IconGlobe">M 22,12 A 10,10 0 1 1 2,12 A 10,10 0 1 1 22,12 Z M 2,12 L 22,12 M 12,2 C 14.5,4.7 15.9,8.3 16,12 C 15.9,15.7 14.5,19.3 12,22 C 9.5,19.3 8.1,15.7 8,12 C 8.1,8.3 9.5,4.7 12,2 Z</StreamGeometry>
            <StreamGeometry x:Key="IconPlug">M 9,2 L 9,7 M 15,2 L 15,7 M 6,7 L 18,7 L 18,12 A 6,6 0 0 1 6,12 Z M 12,18 L 12,22</StreamGeometry>
            <StreamGeometry x:Key="IconQueue">M 3,6 L 14,6 M 3,12 L 14,12 M 3,18 L 10,18 M 18,14 L 18,22 M 14,18 L 22,18</StreamGeometry>
            <StreamGeometry x:Key="IconEdit">M 12,20 L 21,20 M 16.5,3.5 A 2.12,2.12 0 0 1 20.5,7.5 L 7,21 L 3,22 L 4,18 Z</StreamGeometry>
            <StreamGeometry x:Key="IconMinus">M 5,12 L 19,12</StreamGeometry>
            <StreamGeometry x:Key="IconMinusCircle">M 22,12 A 10,10 0 1 1 2,12 A 10,10 0 1 1 22,12 Z M 8,12 L 16,12</StreamGeometry>
            <StreamGeometry x:Key="IconList">M 8,6 L 21,6 M 8,12 L 21,12 M 8,18 L 21,18 M 3,6 L 3.01,6 M 3,12 L 3.01,12 M 3,18 L 3.01,18</StreamGeometry>
            <StreamGeometry x:Key="IconCopy">M 11,9 L 20,9 A 2,2 0 0 1 22,11 L 22,20 A 2,2 0 0 1 20,22 L 11,22 A 2,2 0 0 1 9,20 L 9,11 A 2,2 0 0 1 11,9 Z M 5,15 L 4,15 A 2,2 0 0 1 2,13 L 2,4 A 2,2 0 0 1 4,2 L 13,2 A 2,2 0 0 1 15,4 L 15,5</StreamGeometry>
            <StreamGeometry x:Key="IconSettings">M 4,6 L 20,6 M 4,12 L 20,12 M 4,18 L 20,18 M 9,3.5 L 9,8.5 M 15,9.5 L 15,14.5 M 8,15.5 L 8,20.5</StreamGeometry>

            <!-- ============================================================ -->
            <!--  SCROLLBAR sottile: nessun "ingrandimento" al passaggio mouse  -->
            <!-- ============================================================ -->
            <ControlTheme x:Key="AppRepeatTrackTheme" TargetType="RepeatButton">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Focusable" Value="False"/>
                <Setter Property="Template">
                    <ControlTemplate>
                        <Border Background="Transparent"/>
                    </ControlTemplate>
                </Setter>
            </ControlTheme>

            <ControlTheme x:Key="AppThumbTheme" TargetType="Thumb">
                <Setter Property="Template">
                    <ControlTemplate>
                        <Border Classes="scrollThumb"/>
                    </ControlTemplate>
                </Setter>
            </ControlTheme>

            <ControlTheme x:Key="AppScrollBarTheme" TargetType="ScrollBar">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="AllowAutoHide" Value="False"/>
                <Style Selector="^:vertical">
                    <Setter Property="Width" Value="10"/>
                    <Setter Property="MinWidth" Value="10"/>
                    <Setter Property="Template">
                        <ControlTemplate>
                            <Border Background="Transparent" Padding="2">
                                <Track Name="PART_Track"
                                       Orientation="Vertical"
                                       IsDirectionReversed="True"
                                       Minimum="{TemplateBinding Minimum}"
                                       Maximum="{TemplateBinding Maximum}"
                                       ViewportSize="{TemplateBinding ViewportSize}"
                                       Value="{TemplateBinding Value, Mode=TwoWay}">
                                    <Track.DecreaseButton>
                                        <RepeatButton Name="PART_PageUpButton" Theme="{StaticResource AppRepeatTrackTheme}"/>
                                    </Track.DecreaseButton>
                                    <Track.IncreaseButton>
                                        <RepeatButton Name="PART_PageDownButton" Theme="{StaticResource AppRepeatTrackTheme}"/>
                                    </Track.IncreaseButton>
                                    <Thumb MinHeight="28" Theme="{StaticResource AppThumbTheme}"/>
                                </Track>
                            </Border>
                        </ControlTemplate>
                    </Setter>
                </Style>
                <Style Selector="^:horizontal">
                    <Setter Property="Height" Value="10"/>
                    <Setter Property="MinHeight" Value="10"/>
                    <Setter Property="Template">
                        <ControlTemplate>
                            <Border Background="Transparent" Padding="2">
                                <Track Name="PART_Track"
                                       Orientation="Horizontal"
                                       Minimum="{TemplateBinding Minimum}"
                                       Maximum="{TemplateBinding Maximum}"
                                       ViewportSize="{TemplateBinding ViewportSize}"
                                       Value="{TemplateBinding Value, Mode=TwoWay}">
                                    <Track.DecreaseButton>
                                        <RepeatButton Name="PART_PageUpButton" Theme="{StaticResource AppRepeatTrackTheme}"/>
                                    </Track.DecreaseButton>
                                    <Track.IncreaseButton>
                                        <RepeatButton Name="PART_PageDownButton" Theme="{StaticResource AppRepeatTrackTheme}"/>
                                    </Track.IncreaseButton>
                                    <Thumb MinWidth="28" Theme="{StaticResource AppThumbTheme}"/>
                                </Track>
                            </Border>
                        </ControlTemplate>
                    </Setter>
                </Style>
            </ControlTheme>

            <!-- ============================================================ -->
            <!--  STATUS BANNER                                                -->
            <!--  Uso: <ContentControl Theme="{StaticResource StatusBannerTheme}" Content="{Binding StatusMessage}"/> -->
            <!-- ============================================================ -->
            <ControlTheme x:Key="StatusBannerTheme" TargetType="ContentControl">
                <Setter Property="Margin" Value="0,0,0,12"/>
                <Setter Property="Template">
                    <ControlTemplate>
                        <Border Background="{DynamicResource AppSurface2Brush}"
                                BorderBrush="{DynamicResource AppBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="10,8">
                            <Grid ColumnDefinitions="Auto,*">
                                <!-- Icona secondo il tipo di messaggio (vedi StatusBannerTone): info, riuscito, avviso, errore -->
                                <Panel Margin="0,0,10,0" VerticalAlignment="Center">
                                    <Border Width="24" Height="24" CornerRadius="12" Background="{DynamicResource AppAccentSoftBrush}"
                                            IsVisible="{TemplateBinding Content, Converter={x:Static h:StatusBannerTone.IsInfo}}">
                                        <Path Classes="icon" Data="{StaticResource IconInfo}" Width="12" Height="12" Stretch="Uniform"
                                              Stroke="{DynamicResource AppAccentBrush}" StrokeThickness="2.2"
                                              StrokeLineCap="Round" StrokeJoin="Round"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <Border Width="24" Height="24" CornerRadius="12" Background="{DynamicResource AppSuccessSoftBrush}"
                                            IsVisible="{TemplateBinding Content, Converter={x:Static h:StatusBannerTone.IsSuccess}}">
                                        <Path Classes="icon" Data="{StaticResource IconCheck}" Width="11" Height="11" Stretch="Uniform"
                                              Stroke="{DynamicResource AppSuccessBrush}" StrokeThickness="2.2"
                                              StrokeLineCap="Round" StrokeJoin="Round"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <Border Width="24" Height="24" CornerRadius="12" Background="{DynamicResource AppWarningSoftBrush}"
                                            IsVisible="{TemplateBinding Content, Converter={x:Static h:StatusBannerTone.IsWarning}}">
                                        <Path Classes="icon" Data="{StaticResource IconAlert}" Width="12" Height="12" Stretch="Uniform"
                                              Stroke="{DynamicResource AppWarningBrush}" StrokeThickness="2.2"
                                              StrokeLineCap="Round" StrokeJoin="Round"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <Border Width="24" Height="24" CornerRadius="12" Background="{DynamicResource AppDangerSoftBrush}"
                                            IsVisible="{TemplateBinding Content, Converter={x:Static h:StatusBannerTone.IsError}}">
                                        <Path Classes="icon" Data="{StaticResource IconClose}" Width="10" Height="10" Stretch="Uniform"
                                              Stroke="{DynamicResource AppDangerBrush}" StrokeThickness="2.2"
                                              StrokeLineCap="Round" StrokeJoin="Round"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </Panel>
                                <TextBlock Grid.Column="1"
                                           Text="{TemplateBinding Content, Converter={x:Static h:StatusBannerTone.Text}}"
                                           Foreground="{DynamicResource AppTextBrush}"
                                           FontSize="12"
                                           VerticalAlignment="Center"
                                           TextWrapping="Wrap"/>
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter>
            </ControlTheme>

            <!-- ============================================================ -->
            <!--  EXPANDER GRUPPO DOWNLOAD - ControlTheme con template custom  -->
            <!--  Uso: <Expander Theme="{StaticResource DownloadGroupExpanderTheme}" .../> -->
            <!-- ============================================================ -->
            <ControlTheme x:Key="DownloadGroupExpanderTheme" TargetType="Expander">
                <Setter Property="Background" Value="{DynamicResource DownloadGroupCardBrush}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="12"/>
                <Setter Property="Margin" Value="0,0,0,10"/>
                <Setter Property="HorizontalAlignment" Value="Stretch"/>
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Setter Property="Template">
                    <ControlTemplate>
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{TemplateBinding CornerRadius}"
                                ClipToBounds="True">
                            <DockPanel>
                                <ToggleButton x:Name="PART_toggle"
                                              DockPanel.Dock="Top"
                                              IsChecked="{TemplateBinding IsExpanded, Mode=TwoWay}"
                                              Content="{TemplateBinding Header}"
                                              ContentTemplate="{TemplateBinding HeaderTemplate}"
                                              HorizontalAlignment="Stretch"
                                              HorizontalContentAlignment="Stretch"
                                              VerticalContentAlignment="Center"
                                              Cursor="Hand">
                                    <ToggleButton.Styles>
                                        <Style Selector="ToggleButton:pointerover /template/ Border#HeaderBorder">
                                            <Setter Property="Background" Value="{DynamicResource DownloadGroupHeaderHoverBrush}"/>
                                        </Style>
                                        <Style Selector="ToggleButton:checked /template/ Border#AccentBar">
                                            <Setter Property="Background" Value="{DynamicResource AppAccentBrush}"/>
                                        </Style>
                                        <Style Selector="ToggleButton:checked /template/ Path#Chevron">
                                            <Setter Property="RenderTransform" Value="rotate(180deg)"/>
                                            <Setter Property="Stroke" Value="{DynamicResource AppAccentBrush}"/>
                                        </Style>
                                    </ToggleButton.Styles>
                                    <ToggleButton.Template>
                                        <ControlTemplate>
                                            <Border x:Name="HeaderBorder"
                                                    Background="{DynamicResource DownloadGroupHeaderBrush}">
                                                <Grid ColumnDefinitions="3, *, Auto">
                                                    <Border x:Name="AccentBar" Grid.Column="0" Background="Transparent"/>
                                                    <ContentPresenter Grid.Column="1"
                                                                      Padding="12,12,8,12"
                                                                      Content="{TemplateBinding Content}"
                                                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                                                      HorizontalContentAlignment="Stretch"
                                                                      VerticalContentAlignment="Center"
                                                                      Foreground="{DynamicResource AppTextBrush}"/>
                                                    <Path x:Name="Chevron" Grid.Column="2"
                                                          Data="M 1,1 L 6,6 L 11,1"
                                                          Stroke="{DynamicResource AppTextMutedBrush}"
                                                          StrokeThickness="2"
                                                          StrokeLineCap="Round"
                                                          StrokeJoin="Round"
                                                          Margin="6,0,16,0"
                                                          VerticalAlignment="Center"
                                                          RenderTransformOrigin="50%,50%"/>
                                                </Grid>
                                            </Border>
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                </ToggleButton>

                                <Border IsVisible="{TemplateBinding IsExpanded}"
                                        BorderBrush="{DynamicResource AppBorderBrush}"
                                        BorderThickness="0,1,0,0">
                                    <ContentPresenter Content="{TemplateBinding Content}"
                                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                                      HorizontalContentAlignment="Stretch"/>
                                </Border>
                            </DockPanel>
                        </Border>
                    </ControlTemplate>
                </Setter>
            </ControlTheme>

        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Fluent.xaml"/>

        <!-- WINDOW -->
        <Style Selector=":is(Window)">
            <Setter Property="Background" Value="{DynamicResource AppBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}"/>
            <Setter Property="FontFamily" Value="Inter, Segoe UI, sans-serif"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <!-- ============================================================ -->
        <!--  TABCONTROL                                                   -->
        <!-- ============================================================ -->
        <Style Selector="TabControl">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="0"/>
        </Style>

        <Style Selector="TabControl /template/ ItemsPresenter">
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>

        <!-- Stile base (anche per i tab annidati) -->
        <Style Selector="TabControl > TabItem">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource AppTextMutedBrush}"/>
            <Setter Property="Padding" Value="16,9"/>
            <Setter Property="Margin" Value="0,0,2,0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="MinHeight" Value="38"/>
        </Style>
        <Style Selector="TabControl > TabItem /template/ Border#PART_SelectedPipe">
            <Setter Property="IsVisible" Value="False"/>
        </Style>
        <Style Selector="TabControl > TabItem:pointerover">
            <Setter Property="Background" Value="{DynamicResource AppHoverBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}"/>
        </Style>
        <Style Selector="TabControl > TabItem:selected">
            <Setter Property="Background" Value="{DynamicResource AppTabSelectedBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource AppAccentBrush}"/>
        </Style>

        <!-- Barra principale (Classes="nav"): capsula con tab "segmented" -->
        <Style Selector="TabControl.nav">
            <Setter Property="Template">
                <ControlTemplate>
                    <DockPanel>
                        <Border DockPanel.Dock="Top"
                                HorizontalAlignment="Center"
                                Background="{DynamicResource AppTabTrackBrush}"
                                BorderBrush="{DynamicResource AppBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="16"
                                Padding="4"
                                Margin="0">
                            <ItemsPresenter Name="PART_ItemsPresenter"
                                            ItemsPanel="{TemplateBinding ItemsPanel}"/>
                        </Border>
                        <ContentPresenter Name="PART_SelectedContentHost"
                                          Content="{TemplateBinding SelectedContent}"
                                          ContentTemplate="{TemplateBinding SelectedContentTemplate}"
                                          HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"/>
                    </DockPanel>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="TabControl.nav > TabItem">
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Margin" Value="1,0"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
        </Style>
        <Style Selector="TabControl.nav > TabItem:selected">
            <Setter Property="Background" Value="{DynamicResource AppTabSelectedBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AppTabSelectedBorderBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}"/>
        </Style>
        <Style Selector="TabControl.nav > TabItem:selected:pointerover">
            <Setter Property="Background" Value="{DynamicResource AppTabSelectedBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}"/>
        </Style>
        <!-- Piccola barra accento sotto il tab selezionato -->
        <Style Selector="TabControl.nav > TabItem:selected /template/ Border#PART_SelectedPipe">
            <Setter Property="IsVisible" Value="True"/>
            <Setter Property="Background" Value="{DynamicResource AppAccentBrush}"/>
            <Setter Property="Height" Value="2"/>
            <Setter Property="Width" Value="18"/>
            <Setter Property="CornerRadius" Value="1"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Bottom"/>
            <Setter Property="Margin" Value="0,0,0,2"/>
        </Style>

        <!-- ============================================================ -->
        <!--  GUIDE TOGGLE BUTTON (Nessun colore quando aperto)          -->
        <!-- ============================================================ -->
        <Style Selector="ToggleButton.guideToggle">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="16,12"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="RenderTransform" Value="none"/>
            <Setter Property="Transitions" Value="{x:Null}"/>
        </Style>
        <!-- Nessun effetto "scale" quando si preme -->
        <Style Selector="ToggleButton.guideToggle:pressed">
            <Setter Property="RenderTransform" Value="none"/>
        </Style>
        <Style Selector="ToggleButton.guideToggle:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style Selector="ToggleButton.guideToggle:checked:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

        <!-- Chevron per i toggle (guide, configurazioni, log): giu = chiuso, su = aperto -->
        <Style Selector="Path.chevron">
            <Setter Property="Data" Value="M 1,1 L 6,6 L 11,1"/>
            <Setter Property="Stroke" Value="{DynamicResource AppTextMutedBrush}"/>
            <Setter Property="StrokeThickness" Value="2"/>
            <Setter Property="StrokeLineCap" Value="Round"/>
            <Setter Property="StrokeJoin" Value="Round"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="8,0,2,0"/>
            <Setter Property="RenderTransformOrigin" Value="50%,50%"/>
        </Style>
        <Style Selector="ToggleButton:checked Path.chevron">
            <Setter Property="RenderTransform" Value="rotate(180deg)"/>
        </Style>
        <!-- Override totale del ContentPresenter per evitare l'azzurro di default -->
        <Style Selector="ToggleButton.guideToggle /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style Selector="ToggleButton.guideToggle:checked /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style Selector="ToggleButton.guideToggle:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

        <!-- BUTTONS -->
        <Style Selector="Button">
            <Setter Property="Background" Value="{DynamicResource AppSurface2Brush}"/>
            <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="999"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style Selector="Button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AppHoverBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AppAccentBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}"/>
        </Style>

        <Style Selector="Button:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AppSelectedBrush}"/>
        </Style>

        <Style Selector="Button.accent">
            <Setter Property="Background" Value="{DynamicResource AppAccentSoftBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AppAccentBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource AppAccentBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <!-- Fluent colora "accent" direttamente sul presenter del template: va sovrascritto lì -->
        <Style Selector="Button.accent /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AppAccentSoftBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AppAccentBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource AppAccentBrush}"/>
        </Style>
        <Style Selector="Button.accent:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AppAccentSoftHoverBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AppAccentBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource AppAccentBrush}"/>
        </Style>
        <Style Selector="Button.accent:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AppAccentSoftBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AppAccentBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource AppAccentBrush}"/>
        </Style>
        <Style Selector="Button.accent:disabled /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AppSurface2Brush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource AppTextMutedBrush}"/>
        </Style>

        <Style Selector="Button.success">
            <Setter Property="Background" Value="{DynamicResource AppSuccessSoftBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AppSuccessBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource AppSuccessBrush}"/>
        </Style>
        <Style Selector="Button.success:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AppSuccessSoftHoverBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AppSuccessBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource AppSuccessBrush}"/>
        </Style>

        <Style Selector="Button.warning">
            <Setter Property="Background" Value="{DynamicResource AppWarningSoftBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AppWarningBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource AppWarningBrush}"/>
        </Style>
        <Style Selector="Button.warning:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AppWarningSoftHoverBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AppWarningBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource AppWarningBrush}"/>
        </Style>

        <Style Selector="Button.danger">
            <Setter Property="Background" Value="{DynamicResource AppDangerSoftBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AppDangerBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource AppDangerBrush}"/>
        </Style>
        <Style Selector="Button.danger:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AppDangerSoftHoverBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AppDangerBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource AppDangerBrush}"/>
        </Style>

        <Style Selector="Button.info">
            <Setter Property="Background" Value="{DynamicResource AppInfoSoftBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AppInfoBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource AppInfoBrush}"/>
        </Style>
        <Style Selector="Button.info:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AppInfoSoftHoverBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AppInfoBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource AppInfoBrush}"/>
        </Style>

        <Style Selector="Button.ghost">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
        </Style>
        <Style Selector="Button.ghost:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AppHoverBrush}"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
        </Style>

        <Style Selector="Button.iconCircle">
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="CornerRadius" Value="18"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>

        <!-- TEXTBOX / COMBOBOX -->
        <Style Selector="TextBox">
            <Setter Property="Background" Value="{DynamicResource AppInputBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="MinHeight" Value="34"/>
            <Setter Property="SelectionBrush" Value="{DynamicResource AppTextSelectionBrush}"/>
            <Setter Property="SelectionForegroundBrush" Value="{DynamicResource AppTextSelectionForegroundBrush}"/>
        </Style>
        <Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
            <Setter Property="BorderBrush" Value="{DynamicResource AppAccentBrush}"/>
        </Style>
        <Style Selector="TextBox /template/ TextPresenter">
            <Setter Property="SelectionBrush" Value="{DynamicResource AppTextSelectionBrush}"/>
            <Setter Property="SelectionForegroundBrush" Value="{DynamicResource AppTextSelectionForegroundBrush}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource AppCaretBrush}"/>
        </Style>
        <Style Selector="ComboBox">
            <Setter Property="Background" Value="{DynamicResource AppInputBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="MinHeight" Value="34"/>
        </Style>
        <Style Selector="ComboBox:pointerover /template/ Border#Background">
            <Setter Property="Background" Value="{DynamicResource AppHoverBrush}"/>
        </Style>
        <Style Selector="ComboBox TextBox">
            <Setter Property="SelectionBrush" Value="{DynamicResource AppTextSelectionBrush}"/>
            <Setter Property="SelectionForegroundBrush" Value="{DynamicResource AppTextSelectionForegroundBrush}"/>
        </Style>
        <Style Selector="ComboBox TextBox /template/ TextPresenter">
            <Setter Property="SelectionBrush" Value="{DynamicResource AppTextSelectionBrush}"/>
            <Setter Property="SelectionForegroundBrush" Value="{DynamicResource AppTextSelectionForegroundBrush}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource AppCaretBrush}"/>
        </Style>

        <!-- CARD / BORDER -->
        <!-- Righe degli episodi in download (Anime, Film/Serie): evidenziate al passaggio del mouse -->
        <Style Selector="Border.episodeRow">
            <Setter Property="Background" Value="{DynamicResource DownloadGroupRowBrush}"/>
        </Style>
        <Style Selector="Border.episodeRow:pointerover">
            <Setter Property="Background" Value="{DynamicResource AppHoverBrush}"/>
        </Style>

        <Style Selector="Border.card">
            <Setter Property="Background" Value="{DynamicResource AppSurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="14"/>
        </Style>

        <Style Selector="Border.cardElevated">
            <Setter Property="Background" Value="{DynamicResource AppCardBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="20"/>
            <Setter Property="Padding" Value="18"/>
            <Setter Property="BoxShadow" Value="{DynamicResource AppCardShadow}"/>
        </Style>

        <Style Selector="Border.poster">
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="ClipToBounds" Value="True"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}"/>
            <Setter Property="BoxShadow" Value="0 3 10 0 #40000000"/>
        </Style>

        <!-- DATAGRID -->
        <Style Selector="DataGrid">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource AppBorderBrush}"/>
            <Setter Property="RowBackground" Value="Transparent"/>
        </Style>

        <Style Selector="DataGridColumnHeader">
            <Setter Property="Background" Value="{DynamicResource AppSurface2Brush}"/>
            <Setter Property="Foreground" Value="{DynamicResource AppTextMutedBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="10,8"/>
        </Style>

        <Style Selector="DataGridRow">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <!-- Testo lungo nelle celle: "…" e testo completo nel tooltip (TrimmedTextToolTip) -->
        <Style Selector="DataGridCell TextBlock">
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>
        <Style Selector="DataGridRow:pointerover /template/ Rectangle#BackgroundRectangle">
            <Setter Property="Fill" Value="{DynamicResource AppHoverBrush}"/>
        </Style>
        <Style Selector="DataGridRow:selected /template/ Rectangle#BackgroundRectangle">
            <Setter Property="Fill" Value="{DynamicResource AppAccentSoftBrush}"/>
            <Setter Property="Opacity" Value="1"/>
        </Style>

        <!-- Zero-Byte Checker: file a 0 byte e cartelle che li contengono (classe .zeroByte
             impostata dalla riga in base a HasZeroByteIssue). Il rosso resta visibile anche
             al passaggio del mouse e da selezionata. -->
        <Style Selector="DataGridRow.zeroByte">
            <Setter Property="Background" Value="{DynamicResource AppZeroByteHighlightBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource AppDangerBrush}"/>
        </Style>
        <Style Selector="DataGridRow.zeroByte:pointerover /template/ Rectangle#BackgroundRectangle">
            <Setter Property="Fill" Value="{DynamicResource AppZeroByteHighlightBrush}"/>
            <Setter Property="Opacity" Value="1"/>
        </Style>
        <Style Selector="DataGridRow.zeroByte:selected /template/ Rectangle#BackgroundRectangle">
            <Setter Property="Fill" Value="{DynamicResource AppZeroByteHighlightBorderBrush}"/>
            <Setter Property="Opacity" Value="1"/>
        </Style>

        <!-- PROGRESSBAR / SLIDER / ALTRO -->
        <Style Selector="ProgressBar">
            <Setter Property="Background" Value="{DynamicResource AppBorderBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource AppAccentGradientBrush}"/>
            <Setter Property="CornerRadius" Value="7"/>
        </Style>

        <Style Selector="Slider">
            <Setter Property="Foreground" Value="{DynamicResource AppAccentBrush}"/>
        </Style>

        <Style Selector="Separator">
            <Setter Property="Background" Value="{DynamicResource AppBorderBrush}"/>
        </Style>

        <Style Selector="ListBox">
            <Setter Property="Background" Value="{DynamicResource AppSurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}"/>
        </Style>

        <Style Selector="ListBoxItem">
            <Setter Property="CornerRadius" Value="8"/>
        </Style>
        <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AppHoverBrush}"/>
        </Style>
        <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AppSelectedBrush}"/>
        </Style>

        <!-- SCROLLBAR -->
        <Style Selector="ScrollBar">
            <Setter Property="Theme" Value="{StaticResource AppScrollBarTheme}"/>
        </Style>
        <Style Selector="ScrollViewer">
            <Setter Property="AllowAutoHide" Value="False"/>
        </Style>
        <Style Selector="Border.scrollThumb">
            <Setter Property="Background" Value="{DynamicResource AppScrollThumbBrush}"/>
            <Setter Property="CornerRadius" Value="4"/>
        </Style>
        <Style Selector="Thumb:pointerover /template/ Border.scrollThumb">
            <Setter Property="Background" Value="{DynamicResource AppScrollThumbHoverBrush}"/>
        </Style>
        <Style Selector="Thumb:pressed /template/ Border.scrollThumb">
            <Setter Property="Background" Value="{DynamicResource AppScrollThumbPressedBrush}"/>
        </Style>

        <!-- MENU A TENDINA (ComboBox) -->
        <Style Selector="ComboBoxItem">
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Margin" Value="2,1"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}"/>
        </Style>
        <Style Selector="ComboBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AppHoverBrush}"/>
        </Style>
        <Style Selector="ComboBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AppTabSelectedBrush}"/>
        </Style>
        <Style Selector="ComboBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AppTabSelectedBorderBrush}"/>
        </Style>
        <Style Selector="MenuItem">
            <Setter Property="CornerRadius" Value="6"/>
        </Style>

        <!-- ICONE VETTORIALI -->
        <Style Selector="Path.icon">
            <Setter Property="Width" Value="14"/>
            <Setter Property="Height" Value="14"/>
            <Setter Property="Stretch" Value="Uniform"/>
            <Setter Property="Stroke" Value="{DynamicResource AppTextBrush}"/>
            <Setter Property="StrokeThickness" Value="1.9"/>
            <Setter Property="StrokeLineCap" Value="Round"/>
            <Setter Property="StrokeJoin" Value="Round"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button.success Path.icon"><Setter Property="Stroke" Value="{DynamicResource AppSuccessBrush}"/></Style>
        <Style Selector="Button.warning Path.icon"><Setter Property="Stroke" Value="{DynamicResource AppWarningBrush}"/></Style>
        <Style Selector="Button.danger Path.icon"><Setter Property="Stroke" Value="{DynamicResource AppDangerBrush}"/></Style>
        <Style Selector="Button.info Path.icon"><Setter Property="Stroke" Value="{DynamicResource AppInfoBrush}"/></Style>
        <Style Selector="Button.accent Path.icon"><Setter Property="Stroke" Value="{DynamicResource AppAccentBrush}"/></Style>
        <Style Selector="StackPanel.bi">
            <Setter Property="Orientation" Value="Horizontal"/>
            <Setter Property="Spacing" Value="7"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="Path.icon.accent"><Setter Property="Stroke" Value="{DynamicResource AppAccentBrush}"/></Style>
        <Style Selector="Path.icon.warn"><Setter Property="Stroke" Value="{DynamicResource AppWarningBrush}"/></Style>
        <Style Selector="TabItem:selected Path.icon.accent"><Setter Property="Stroke" Value="{DynamicResource AppAccentBrush}"/></Style>
        <Style Selector="TabItem Path.icon"><Setter Property="Stroke" Value="{DynamicResource AppTextMutedBrush}"/></Style>
        <Style Selector="TabItem:selected Path.icon"><Setter Property="Stroke" Value="{DynamicResource AppAccentBrush}"/></Style>

        <!-- ============================================================ -->
        <!--  MENU A TENDINA / MENU CONTESTUALI                            -->
        <!-- ============================================================ -->
        <Style Selector="ComboBox /template/ Border#PopupBorder">
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="4"/>
        </Style>
        <Style Selector="ContextMenu">
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="4"/>
        </Style>

        <!-- SCELTA TRACCE (audio / sottotitoli): stesso aspetto delle ComboBox -->
        <Style Selector="DropDownButton.trackPicker">
            <Setter Property="Background" Value="{DynamicResource AppInputBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="MinHeight" Value="34"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
        </Style>
        <Style Selector="DropDownButton.trackPicker:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AppHoverBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AppAccentBrush}"/>
        </Style>
        <Style Selector="DropDownButton.trackPicker:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AppSelectedBrush}"/>
        </Style>
        <Style Selector="FlyoutPresenter.trackFlyout">
            <Setter Property="Background" Value="{DynamicResource ComboBoxDropDownBackground}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ComboBoxDropDownBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="MaxWidth" Value="420"/>
        </Style>
        <!-- Filtri a chip (Videobox): spenti = attenuati -->
        <Style Selector="ToggleButton.statusChip">
            <Setter Property="Padding" Value="9,3"/>
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Opacity" Value="0.4"/>
        </Style>
        <Style Selector="ToggleButton.statusChip:checked">
            <Setter Property="Opacity" Value="1"/>
        </Style>
        <Style Selector="ToggleButton.statusChip /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AppSurface2Brush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}"/>
        </Style>
        <Style Selector="ToggleButton.statusChip:checked /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AppSurface2Brush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AppAccentBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}"/>
        </Style>
        <Style Selector="ToggleButton.statusChip:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AppSurface2Brush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AppAccentBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}"/>
        </Style>
        <Style Selector="ToggleButton.statusChip:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AppSurface2Brush}"/>
            <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}"/>
        </Style>
        <Style Selector="FlyoutPresenter.legendFlyout">
            <Setter Property="Background" Value="{DynamicResource ComboBoxDropDownBackground}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ComboBoxDropDownBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="MaxWidth" Value="620"/>
        </Style>
        <Style Selector="Border.trackRow">
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="8,1"/>
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="Border.trackRow:pointerover">
            <Setter Property="Background" Value="{DynamicResource ComboBoxItemBackgroundPointerOver}"/>
        </Style>
        <!-- Locandine dei risultati: al passaggio del mouse compare "Analizza" (come il doppio clic) -->
        <Style Selector="Border.posterShade">
            <Setter Property="Background" Value="#66000000"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Opacity" Value="0"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
            <Setter Property="Transitions">
                <Transitions><DoubleTransition Property="Opacity" Duration="0:0:0.15"/></Transitions>
            </Setter>
        </Style>
        <Style Selector="ListBoxItem:pointerover Border.posterShade"><Setter Property="Opacity" Value="1"/></Style>
        <!-- Pulsante "Analizza": modello proprio (niente effetti del tema), pillola scura con icona nel cerchio colorato -->
        <Style Selector="Button.posterAnalyze">
            <Setter Property="Opacity" Value="0"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="RenderTransform" Value="scale(0.92)"/>
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.16"/>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.16"/>
                </Transitions>
            </Setter>
            <Setter Property="Template">
                <ControlTemplate>
                    <Border x:Name="Pill" Background="#E60F172A" BorderBrush="#33FFFFFF" BorderThickness="1"
                            CornerRadius="999" Padding="5,5,14,5">
                        <Border.Transitions>
                            <Transitions><BrushTransition Property="Background" Duration="0:0:0.12"/></Transitions>
                        </Border.Transitions>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Border x:Name="Dot" Width="26" Height="26" CornerRadius="13" Background="{DynamicResource AppAccentBrush}">
                                <Path Data="{StaticResource IconSearch}" Stroke="White" StrokeThickness="2.4" Width="12" Height="12"
                                      Stretch="Uniform" StrokeLineCap="Round" StrokeJoin="Round"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ContentPresenter Content="{TemplateBinding Content}" VerticalAlignment="Center"
                                              Foreground="{TemplateBinding Foreground}"/>
                        </StackPanel>
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="ListBoxItem:pointerover Button.posterAnalyze">
            <Setter Property="Opacity" Value="1"/>
            <Setter Property="RenderTransform" Value="scale(1)"/>
        </Style>
        <Style Selector="Button.posterAnalyze:pointerover /template/ Border#Pill">
            <Setter Property="Background" Value="{DynamicResource AppAccentBrush}"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
        </Style>
        <Style Selector="Button.posterAnalyze:pointerover /template/ Border#Dot">
            <Setter Property="Background" Value="#2EFFFFFF"/>
        </Style>
        <Style Selector="Button.posterAnalyze:pressed">
            <Setter Property="RenderTransform" Value="scale(0.95)"/>
        </Style>
        <!-- Badge della versione nell'intestazione: apre la finestra "Novità" -->
        <Style Selector="Button.versionBadge">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <Border x:Name="Pill" Background="{DynamicResource AppAccentSoftBrush}"
                            BorderBrush="{DynamicResource AppAccentBrush}" BorderThickness="1"
                            CornerRadius="999" Padding="8,2">
                        <ContentPresenter Content="{TemplateBinding Content}"/>
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="Button.versionBadge:pointerover /template/ Border#Pill">
            <Setter Property="Background" Value="{DynamicResource AppHoverBrush}"/>
        </Style>

        <!-- Pillole del riquadro dettaglio film -->
        <Style Selector="Border.moviePill">
            <Setter Property="Background" Value="{DynamicResource AppSurface2Brush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="999"/>
            <Setter Property="Padding" Value="10,3"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="Border.moviePill TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource AppTextMutedBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="Border.moviePill Path.icon">
            <Setter Property="Width" Value="11"/>
            <Setter Property="Height" Value="11"/>
            <Setter Property="Stroke" Value="{DynamicResource AppTextMutedBrush}"/>
        </Style>
        <Style Selector="Border.moviePill StackPanel.bi"><Setter Property="Spacing" Value="5"/></Style>
        <Style Selector="Border.moviePill.warn">
            <Setter Property="Background" Value="{DynamicResource AppWarningSoftBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AppWarningBrush}"/>
        </Style>
        <Style Selector="Border.moviePill.warn TextBlock"><Setter Property="Foreground" Value="{DynamicResource AppWarningBrush}"/></Style>
        <Style Selector="Border.moviePill.warn Path.icon"><Setter Property="Stroke" Value="{DynamicResource AppWarningBrush}"/></Style>
        <!-- Etichetta "SUB ITA" sulla locandina e nella tabella episodi -->
        <Style Selector="Border.subBadge">
            <Setter Property="Background" Value="{DynamicResource AppWarningBrush}"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="Border.subBadge TextBlock">
            <Setter Property="Foreground" Value="#1F1300"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
        <Style Selector="Border.moviePill.accent">
            <Setter Property="Background" Value="{DynamicResource AppAccentSoftBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AppAccentBrush}"/>
        </Style>
        <Style Selector="Border.moviePill.accent TextBlock"><Setter Property="Foreground" Value="{DynamicResource AppAccentBrush}"/></Style>
        <Style Selector="Border.moviePill.accent Path.icon"><Setter Property="Stroke" Value="{DynamicResource AppAccentBrush}"/></Style>
        <Style Selector="Border.trackBadge">
            <Setter Property="Background" Value="{DynamicResource AppAccentSoftBrush}"/>
            <Setter Property="CornerRadius" Value="999"/>
            <Setter Property="Padding" Value="7,1"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="Border.trackBadge > TextBlock">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource AppAccentBrush}"/>
        </Style>
        <Style Selector="Border.trackBadge.warn">
            <Setter Property="Background" Value="{DynamicResource AppWarningSoftBrush}"/>
        </Style>
        <Style Selector="Border.trackBadge.warn > TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource AppWarningBrush}"/>
        </Style>
        <!-- LOG GLOBALE -->
        <Style Selector="Border.logRow:pointerover">
            <Setter Property="Background" Value="{DynamicResource AppHoverBrush}"/>
        </Style>

        <Style Selector="Border.proxyBadge">
            <Setter Property="Background" Value="{DynamicResource AppSurface2Brush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="999"/>
            <Setter Property="Padding" Value="12,5"/>
        </Style>

        <Style Selector="Border.proxyBadge > TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource AppTextMutedBrush}"/>
        </Style>

        <Style Selector="Border.proxyBadge.proxyActive">
            <Setter Property="Background" Value="{DynamicResource AppProxyBadgeActiveBgBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AppProxyBadgeActiveBorderBrush}"/>
        </Style>

        <Style Selector="Border.proxyBadge.proxyActive > TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource AppProxyBadgeActiveTextBrush}"/>
        </Style>
        <!-- (in fondo: vince sugli stili generici delle icone e dei pulsanti) -->
        <!-- Schede dei server nella tab SFTP: nome e disconnessione nella stessa "pillola",
             così è chiaro quale server si disconnette -->
        <Style Selector="Border.serverTab">
            <Setter Property="Background" Value="{DynamicResource AppSurface2Brush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="999"/>
            <Setter Property="Padding" Value="2"/>
        </Style>
        <Style Selector="Border.serverTab.active">
            <Setter Property="Background" Value="{DynamicResource AppAccentSoftBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AppAccentBrush}"/>
        </Style>
        <Style Selector="Border.serverTab Button.tabName">
            <Setter Property="Padding" Value="10,3,6,3"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="CornerRadius" Value="999"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style Selector="Border.serverTab.active Button.tabName">
            <Setter Property="Foreground" Value="{DynamicResource AppAccentBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style Selector="Border.serverTab.active Button.tabName Path.icon">
            <Setter Property="Stroke" Value="{DynamicResource AppAccentBrush}"/>
        </Style>
        <Style Selector="Border.serverTab Button.tabClose">
            <Setter Property="Width" Value="24"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="Border.serverTab Button.tabClose Path.icon">
            <Setter Property="Width" Value="11"/>
            <Setter Property="Height" Value="11"/>
            <Setter Property="Stroke" Value="{DynamicResource AppDangerBrush}"/>
        </Style>
        <Style Selector="Border.serverTab Button.tabClose:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AppDangerSoftBrush}"/>
        </Style>
        <Style Selector="Border.serverTab Rectangle.tabSep">
            <Setter Property="Width" Value="1"/>
            <Setter Property="Height" Value="14"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="Fill" Value="{DynamicResource AppBorderBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- Tabelle: niente riquadro bianco sulla cella cliccata. Le tabelle dell'app lavorano per
             righe (la riga selezionata è già evidenziata): il riquadro della "cella corrente"
             disturbava e sembrava un campo da modificare. -->
        <!-- Trasparenti, non nascosti: il tema li riaccende (IsVisible) quando la cella diventa
             "corrente" o ha il focus, l'opacità invece non la tocca -->
        <Style Selector="DataGridCell /template/ Rectangle#CurrencyVisual">
            <Setter Property="Opacity" Value="0"/>
        </Style>
        <Style Selector="DataGridCell /template/ Grid#FocusVisual">
            <Setter Property="Opacity" Value="0"/>
        </Style>
    </Application.Styles>
</Application>