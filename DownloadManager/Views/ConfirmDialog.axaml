<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="DownloadManager.Views.ConfirmDialog"
        Title="Conferma"
        Width="480"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        ShowInTaskbar="False"
        Background="{DynamicResource AppBackgroundBrush}">

    <StackPanel Margin="22" Spacing="20">

        <Grid ColumnDefinitions="Auto, *">
            <Border Width="42" Height="42" CornerRadius="21"
                    Background="{DynamicResource AppDangerSoftBrush}"
                    VerticalAlignment="Top">
                <Path Classes="icon" Data="{StaticResource IconAlertCircle}" Width="20" Height="20"
                      Stroke="{DynamicResource AppDangerBrush}"/>
            </Border>
            <StackPanel Grid.Column="1" Margin="14,0,0,0" Spacing="6" VerticalAlignment="Center">
                <TextBlock x:Name="TitleText" Text="Conferma" FontSize="15" FontWeight="Bold"/>
                <TextBlock x:Name="PromptText" FontSize="13" TextWrapping="Wrap"
                           Foreground="{DynamicResource AppTextMutedBrush}"/>
            </StackPanel>
        </Grid>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
            <Button x:Name="CancelButton" Classes="ghost" MinWidth="100" IsCancel="True" Click="OnCancelClick">
                <TextBlock Text="Annulla"/>
            </Button>
            <Button x:Name="OkButton" Classes="danger" MinWidth="110" IsDefault="True" Click="OnOkClick">
                <StackPanel Classes="bi"><Path Classes="icon" Data="{StaticResource IconCheck}"/><TextBlock Text="Conferma"/></StackPanel>
            </Button>
        </StackPanel>
    </StackPanel>
</Window>
