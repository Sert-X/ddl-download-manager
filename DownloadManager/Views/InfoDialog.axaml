<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="DownloadManager.Views.InfoDialog"
        Title="Informazione"
        Width="420" Height="180"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        ShowInTaskbar="False"
        Background="{DynamicResource AppSurfaceBrush}">

    <Grid RowDefinitions="*, Auto" Margin="20">

        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
            <TextBlock x:Name="IconText"
                       Text="ℹ"
                       FontSize="32"
                       Foreground="{DynamicResource AppAccentBrush}"
                       VerticalAlignment="Top"/>
            <TextBlock x:Name="MessageText"
                       Text=""
                       FontSize="14"
                       TextWrapping="Wrap"
                       VerticalAlignment="Center"
                       MaxWidth="340"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal"
                    HorizontalAlignment="Right" Spacing="8" Margin="0,16,0,0">
            <Button Content="OK"
                    Classes="accent"
                    MinWidth="100"
                    Click="OnOkClick"/>
        </StackPanel>
    </Grid>
</Window>