<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="DownloadManager.Views.InfoDialog"
        Title="Informazione"
        Width="460"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        ShowInTaskbar="False"
        Background="{DynamicResource AppBackgroundBrush}">

    <StackPanel Margin="22" Spacing="20">

        <Grid ColumnDefinitions="Auto, *">
            <Border Width="42" Height="42" CornerRadius="21"
                    Background="{DynamicResource AppAccentSoftBrush}"
                    VerticalAlignment="Top">
                <Path Classes="icon accent" Data="{StaticResource IconInfo}" Width="20" Height="20"/>
            </Border>
            <StackPanel Grid.Column="1" Margin="14,0,0,0" Spacing="6" VerticalAlignment="Center">
                <TextBlock x:Name="TitleText" Text="Informazione" FontSize="15" FontWeight="Bold"/>
                <SelectableTextBlock x:Name="MessageText" FontSize="13" TextWrapping="Wrap"
                                     Foreground="{DynamicResource AppTextMutedBrush}"/>
            </StackPanel>
        </Grid>

        <Button Classes="accent" MinWidth="110" HorizontalAlignment="Right"
                IsDefault="True" IsCancel="True" Click="OnOkClick">
            <StackPanel Classes="bi"><Path Classes="icon" Data="{StaticResource IconCheck}"/><TextBlock Text="OK"/></StackPanel>
        </Button>
    </StackPanel>
</Window>
