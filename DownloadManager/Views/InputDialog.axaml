<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="DownloadManager.Views.InputDialog"
        Width="420" Height="180"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        Title="Input">
    <DockPanel Margin="20">
        <TextBlock x:Name="PromptText"
                   DockPanel.Dock="Top"
                   TextWrapping="Wrap"
                   Margin="0,0,0,12"/>

        <StackPanel DockPanel.Dock="Bottom"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Spacing="10"
                    Margin="0,15,0,0">
            <Button x:Name="CancelButton" Content="Annulla" Width="90" Click="OnCancelClick"/>
            <Button x:Name="OkButton" Content="OK" Width="90" IsDefault="True" Click="OnOkClick"/>
        </StackPanel>

        <TextBox x:Name="InputBox"
                 VerticalAlignment="Top"
                 KeyDown="OnInputKeyDown"/>
    </DockPanel>
</Window>