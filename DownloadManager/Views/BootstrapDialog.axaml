<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="DownloadManager.Views.BootstrapDialog"
        Title="DDL Download Manager — Preparazione"
        Width="560" Height="380"
        WindowStartupLocation="CenterScreen"
        CanResize="False"
        ShowInTaskbar="True"
        Background="{DynamicResource AppBackgroundBrush}">

    <Grid RowDefinitions="Auto, Auto, *, Auto" Margin="22">

        <!-- Intestazione -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto, *" Margin="0,0,0,18">
            <Border Width="46" Height="46" CornerRadius="23" Background="{DynamicResource AppAccentSoftBrush}">
                <Path Classes="icon accent" Data="{StaticResource IconSettings}" Width="22" Height="22"/>
            </Border>
            <StackPanel Grid.Column="1" Margin="14,0,0,0" Spacing="2" VerticalAlignment="Center">
                <TextBlock Text="Preparazione dell'applicazione" FontSize="17" FontWeight="Bold"/>
                <TextBlock Text="Primo avvio: scarico i componenti necessari, attendi qualche istante."
                           FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource AppTextMutedBrush}"/>
            </StackPanel>
        </Grid>

        <!-- Stato e progresso -->
        <Border Grid.Row="1" Classes="card" Margin="0,0,0,12">
            <StackPanel Spacing="8">
                <TextBlock x:Name="StatusText" Text="Inizializzazione..." FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap"/>
                <ProgressBar x:Name="ProgressBar" IsIndeterminate="True" Height="8"/>
                <TextBlock x:Name="ProgressDetailText" Text="" FontSize="11" Foreground="{DynamicResource AppTextMutedBrush}"/>
            </StackPanel>
        </Border>

        <!-- Log -->
        <Border Grid.Row="2"
                Background="{DynamicResource AppInputBrush}"
                BorderBrush="{DynamicResource AppBorderBrush}"
                BorderThickness="1" CornerRadius="10" Margin="0,0,0,12">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12,8">
                <SelectableTextBlock x:Name="LogText" Text=""
                                     FontFamily="Consolas, Cascadia Mono, monospace" FontSize="11"
                                     TextWrapping="Wrap" Foreground="{DynamicResource AppTextMutedBrush}"/>
            </ScrollViewer>
        </Border>

        <!-- Nota -->
        <StackPanel Grid.Row="3" Classes="bi">
            <Path Classes="icon" Data="{StaticResource IconInfo}"/>
            <TextBlock Text="Il primo avvio può richiedere 1-2 minuti (browser Chromium ~150 MB)."
                       FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource AppTextMutedBrush}"/>
        </StackPanel>
    </Grid>
</Window>
