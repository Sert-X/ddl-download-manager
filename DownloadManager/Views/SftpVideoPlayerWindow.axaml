<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vlc="clr-namespace:LibVLCSharp.Avalonia;assembly=LibVLCSharp.Avalonia"
        x:Class="DownloadManager.Views.SftpVideoPlayerWindow"
        Title="Anteprima video"
        Width="960" Height="640"
        MinWidth="600" MinHeight="400"
        WindowStartupLocation="CenterScreen"
        Background="Black">

    <Grid RowDefinitions="*, Auto">

        <!-- VideoView dichiarato in XAML: così il suo handle nativo esiste
             prima del Play e VLC non apre una finestra separata.
             I controlli stanno in una riga a parte, mai sopra il video. -->
        <vlc:VideoView Grid.Row="0" x:Name="PlayerView"/>

        <Border Grid.Row="1" Background="{DynamicResource AppSurfaceBrush}"
                BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="0,1,0,0"
                Padding="16,10,16,12">
            <StackPanel Spacing="8">

                <!-- Barra di avanzamento -->
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <TextBlock x:Name="CurrentTimeText" Grid.Column="0" Text="00:00" FontSize="12"
                               FontFamily="Consolas, Cascadia Mono, monospace"
                               VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <Slider x:Name="SeekSlider" Grid.Column="1" Minimum="0" Maximum="1" Value="0"
                            Focusable="False" ToolTip.Tip="Trascina per spostarti nel video"/>
                    <TextBlock x:Name="TotalTimeText" Grid.Column="2" Text="00:00" FontSize="12"
                               FontFamily="Consolas, Cascadia Mono, monospace"
                               Foreground="{DynamicResource AppTextMutedBrush}"
                               VerticalAlignment="Center" Margin="12,0,0,0"/>
                </Grid>

                <!-- Pulsanti, stato, volume -->
                <Grid ColumnDefinitions="Auto,*,Auto">

                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <Button x:Name="BackButton" Classes="ghost" Focusable="False" ToolTip.Tip="Indietro di 10 secondi (←)">
                            <TextBlock Text="-10s" FontSize="12"/>
                        </Button>
                        <Button x:Name="PlayPauseButton" Classes="accent iconCircle" Width="42" Height="42"
                                Focusable="False" ToolTip.Tip="Play / pausa (Spazio)">
                            <Path x:Name="PlayPauseIcon" Classes="icon" Data="{StaticResource IconPause}" Width="16" Height="16"/>
                        </Button>
                        <Button x:Name="ForwardButton" Classes="ghost" Focusable="False" ToolTip.Tip="Avanti di 10 secondi (→)">
                            <TextBlock Text="+10s" FontSize="12"/>
                        </Button>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Spacing="1" Margin="16,0" VerticalAlignment="Center">
                        <TextBlock x:Name="FileNameText" Text="" FontSize="13" FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="StatusText" Text="In caricamento..." FontSize="11"
                                   Foreground="{DynamicResource AppTextMutedBrush}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <TextBlock Text="Volume" FontSize="11" Foreground="{DynamicResource AppTextMutedBrush}" VerticalAlignment="Center"/>
                        <Slider x:Name="VolumeSlider" Width="110" Minimum="0" Maximum="100" Value="80"
                                Focusable="False" VerticalAlignment="Center" ToolTip.Tip="Volume (↑ / ↓)"/>
                        <Button x:Name="FullscreenButton" Classes="ghost" Focusable="False" ToolTip.Tip="Schermo intero (F), ESC per uscire">
                            <StackPanel Classes="bi"><Path Classes="icon" Data="{StaticResource IconMonitor}"/><TextBlock Text="Schermo intero"/></StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>

                <TextBlock Text="Spazio: play/pausa  ·  ←/→: ±10s  ·  ↑/↓: volume  ·  F: schermo intero  ·  ESC: esci"
                           FontSize="11" Foreground="{DynamicResource AppTextMutedBrush}"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
