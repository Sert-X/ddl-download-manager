<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vlc="clr-namespace:LibVLCSharp.Avalonia;assembly=LibVLCSharp.Avalonia"
        x:Class="DownloadManager.Views.SftpVideoPlayerWindow"
        Title="Anteprima video"
        Width="900" Height="600"
        MinWidth="560" MinHeight="380"
        WindowStartupLocation="CenterScreen"
        Background="Black">

    <Grid RowDefinitions="*, Auto">

        <!-- VideoView dichiarato in XAML: così il suo handle nativo esiste
             prima del Play e VLC non apre una finestra separata.
             I controlli stanno in una riga a parte, mai sopra il video. -->
        <vlc:VideoView Grid.Row="0" x:Name="PlayerView"/>

        <Border Grid.Row="1" Background="#202020" Padding="12,8">
            <StackPanel Spacing="8">

                <!-- Barra di avanzamento -->
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <TextBlock x:Name="CurrentTimeText" Grid.Column="0"
                               Text="00:00" Foreground="White" FontSize="12"
                               VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <Slider x:Name="SeekSlider" Grid.Column="1"
                            Minimum="0" Maximum="1" Value="0"
                            Focusable="False"/>
                    <TextBlock x:Name="TotalTimeText" Grid.Column="2"
                               Text="00:00" Foreground="White" FontSize="12"
                               VerticalAlignment="Center" Margin="10,0,0,0"/>
                </Grid>

                <!-- Pulsanti, stato, volume -->
                <Grid ColumnDefinitions="Auto,*,Auto">

                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                        <Button x:Name="BackButton" Content="-10s" Focusable="False"/>
                        <Button x:Name="PlayPauseButton" Content="Pausa"
                                MinWidth="70" HorizontalContentAlignment="Center"
                                Focusable="False"/>
                        <Button x:Name="ForwardButton" Content="+10s" Focusable="False"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12"
                                Margin="16,0,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="StatusText" Text="In caricamento..."
                                   Foreground="White" FontSize="12"/>
                        <TextBlock x:Name="FileNameText" Text=""
                                   Foreground="#888" FontSize="12"
                                   TextTrimming="CharacterEllipsis" MaxWidth="260"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8"
                                VerticalAlignment="Center">
                        <TextBlock Text="Vol" Foreground="#AAA" FontSize="12"
                                   VerticalAlignment="Center"/>
                        <Slider x:Name="VolumeSlider" Width="100"
                                Minimum="0" Maximum="100" Value="80"
                                Focusable="False" VerticalAlignment="Center"/>
                        <Button x:Name="FullscreenButton" Content="Schermo intero"
                                Focusable="False"/>
                    </StackPanel>
                </Grid>

                <TextBlock Text="Spazio: play/pausa  |  ←/→: ±10s  |  ↑/↓: volume  |  F: schermo intero  |  ESC: esci"
                           Foreground="#666" FontSize="11"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>