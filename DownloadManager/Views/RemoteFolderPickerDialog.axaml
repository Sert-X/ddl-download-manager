<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="using:DownloadManager.Models"
        x:Class="DownloadManager.Views.RemoteFolderPickerDialog"
        Width="620" Height="520"
        WindowStartupLocation="CenterOwner"
        CanResize="True"
        Title="Seleziona cartella remota">

    <DockPanel Margin="15">

        <Grid DockPanel.Dock="Top" ColumnDefinitions="*, Auto, Auto" Margin="0,0,0,8">
            <TextBox Grid.Column="0" x:Name="PathBox"
                     IsReadOnly="True"
                     FontFamily="Consolas,Menlo,monospace"
                     Margin="0,0,8,0"/>
            <Button Grid.Column="1" Content="🔄" Click="OnRefreshClick" Margin="0,0,8,0"
                    ToolTip.Tip="Aggiorna"/>
            <Button Grid.Column="2" Content="⬅ Su" Click="OnGoUpClick"
                    ToolTip.Tip="Cartella superiore"/>
        </Grid>

        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="0,0,0,8">
            <Button Content="🏠 Home" Click="OnHomeClick"/>
            <Button Content="📂 Cartella corrente" Click="OnUseCurrentClick"
                    ToolTip.Tip="Seleziona la cartella attualmente aperta"/>
        </StackPanel>

        <StackPanel DockPanel.Dock="Bottom"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Spacing="10"
                    Margin="0,10,0,0">
            <Button Content="Annulla" Width="100" Click="OnCancelClick" IsCancel="True"/>
            <Button Content="Seleziona" Width="100" Click="OnOkClick" IsDefault="True"
                    Background="#4CAF50" Foreground="White"/>
        </StackPanel>

        <Border BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                BorderThickness="1"
                CornerRadius="4">
            <ListBox x:Name="FoldersList"
                     Background="Transparent"
                     DoubleTapped="OnFolderDoubleTapped">
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="models:SftpRemoteEntry">
                        <Grid ColumnDefinitions="30, *">
                            <TextBlock Grid.Column="0" Text="📁" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="{Binding Name}"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"/>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>
    </DockPanel>
</Window>