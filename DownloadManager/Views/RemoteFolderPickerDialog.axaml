<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="using:DownloadManager.Models"
        x:Class="DownloadManager.Views.RemoteFolderPickerDialog"
        Title="Seleziona cartella remota"
        Width="640" Height="540"
        MinWidth="460" MinHeight="380"
        WindowStartupLocation="CenterOwner"
        CanResize="True"
        ShowInTaskbar="False"
        Background="{DynamicResource AppBackgroundBrush}">

    <DockPanel Margin="20">

        <!-- Intestazione -->
        <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto, *" Margin="0,0,0,16">
            <Border Width="42" Height="42" CornerRadius="21" Background="{DynamicResource AppAccentSoftBrush}">
                <Path Classes="icon accent" Data="{StaticResource IconCloud}" Width="20" Height="20"/>
            </Border>
            <StackPanel Grid.Column="1" Margin="14,0,0,0" Spacing="2" VerticalAlignment="Center">
                <TextBlock x:Name="HeaderText" Text="Seleziona cartella remota" FontSize="15" FontWeight="Bold"/>
                <TextBlock Text="Doppio clic per entrare in una cartella, poi premi Seleziona." FontSize="12"
                           Foreground="{DynamicResource AppTextMutedBrush}"/>
            </StackPanel>
        </Grid>

        <!-- Barra di navigazione -->
        <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto, Auto, Auto, *" Margin="0,0,0,10">
            <Button Grid.Column="0" Classes="iconCircle" Click="OnGoUpClick" ToolTip.Tip="Cartella superiore" Margin="0,0,6,0">
                <Path Classes="icon" Data="{StaticResource IconArrowUp}"/>
            </Button>
            <Button Grid.Column="1" Classes="iconCircle" Click="OnHomeClick" ToolTip.Tip="Cartella home dell'utente SFTP" Margin="0,0,6,0">
                <Path Classes="icon" Data="{StaticResource IconHome}"/>
            </Button>
            <Button Grid.Column="2" Classes="iconCircle" Click="OnRefreshClick" ToolTip.Tip="Ricarica il contenuto" Margin="0,0,10,0">
                <Path Classes="icon" Data="{StaticResource IconRefresh}"/>
            </Button>
            <TextBox Grid.Column="3" x:Name="PathBox" IsReadOnly="True"
                     FontFamily="Consolas, Cascadia Mono, monospace" FontSize="12"
                     VerticalContentAlignment="Center"
                     ToolTip.Tip="Cartella attualmente aperta"/>
        </Grid>

        <!-- Pulsanti -->
        <Grid DockPanel.Dock="Bottom" ColumnDefinitions="*, Auto" Margin="0,14,0,0">
            <Button Grid.Column="0" Classes="ghost" HorizontalAlignment="Left" Click="OnUseCurrentClick"
                    ToolTip.Tip="Seleziona la cartella attualmente aperta (quella nel percorso in alto)">
                <StackPanel Classes="bi"><Path Classes="icon" Data="{StaticResource IconFolder}"/><TextBlock Text="Usa cartella corrente"/></StackPanel>
            </Button>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10">
                <Button Classes="ghost" MinWidth="100" Click="OnCancelClick" IsCancel="True">
                    <TextBlock Text="Annulla"/>
                </Button>
                <Button Classes="accent" MinWidth="120" Click="OnOkClick" IsDefault="True"
                        ToolTip.Tip="Seleziona la cartella evidenziata (o quella corrente se nessuna è evidenziata)">
                    <StackPanel Classes="bi"><Path Classes="icon" Data="{StaticResource IconCheck}"/><TextBlock Text="Seleziona"/></StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Elenco cartelle -->
        <Border Classes="card" Padding="6">
            <Panel>
                <ListBox x:Name="FoldersList" Background="Transparent" DoubleTapped="OnFolderDoubleTapped">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="models:SftpRemoteEntry">
                            <StackPanel Classes="bi">
                                <Path Classes="icon accent" Data="{StaticResource IconFolder}"/>
                                <TextBlock Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock x:Name="StatusText" IsVisible="False"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           TextWrapping="Wrap" TextAlignment="Center" Margin="20"
                           FontSize="12" Foreground="{DynamicResource AppTextMutedBrush}"/>
            </Panel>
        </Border>
    </DockPanel>
</Window>
