<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="DownloadManager.Views.CheckDialog"
        Title="Controlla"
        Width="520"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        ShowInTaskbar="False"
        Background="{DynamicResource AppBackgroundBrush}">

    <Window.Styles>
        <Style Selector="Border.option">
            <Setter Property="Background" Value="{DynamicResource AppSurface2Brush}"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="14,9"/>
        </Style>
        <Style Selector="TextBlock.group">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource AppTextMutedBrush}"/>
            <Setter Property="Margin" Value="2,4,0,0"/>
        </Style>
        <Style Selector="CheckBox:disabled">
            <Setter Property="Opacity" Value="0.45"/>
        </Style>
    </Window.Styles>

    <StackPanel Margin="22" Spacing="14">

        <Grid ColumnDefinitions="Auto, *">
            <Border Width="42" Height="42" CornerRadius="21"
                    Background="{DynamicResource AppAccentSoftBrush}"
                    VerticalAlignment="Top">
                <Path Classes="icon accent" Data="{StaticResource IconCheckCircle}" Width="20" Height="20"/>
            </Border>
            <StackPanel Grid.Column="1" Margin="14,0,0,0" Spacing="6" VerticalAlignment="Center">
                <TextBlock Text="Cosa vuoi controllare?" FontSize="15" FontWeight="Bold"/>
                <TextBlock x:Name="PromptText" FontSize="13" TextWrapping="Wrap"
                           Foreground="{DynamicResource AppTextMutedBrush}"
                           Text="La cartella aperta e tutte le sottocartelle."/>
            </StackPanel>
        </Grid>

        <StackPanel Spacing="8">
            <Grid ColumnDefinitions="*, Auto">
                <TextBlock Classes="group" Text="CARTELLE" VerticalAlignment="Bottom"/>
                <CheckBox Grid.Column="1" x:Name="AllCheck" Content="Seleziona tutto" FontSize="12"/>
            </Grid>
            <Border Classes="option">
                <CheckBox x:Name="ZeroCheck">
                    <Grid ColumnDefinitions="Auto, *" Margin="4,0,0,0">
                        <Path Classes="icon zero" Width="16" Height="16" Data="{StaticResource IconAlertCircle}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <StackPanel Grid.Column="1" Spacing="2">
                            <TextBlock Text="File vuoti (0 byte)" FontWeight="SemiBold"/>
                            <TextBlock Text="Quanti file da 0 byte ci sono nelle sottocartelle (colonna 0 byte, righe viola)" FontSize="12" TextWrapping="Wrap"
                                       Foreground="{DynamicResource AppTextMutedBrush}"/>
                        </StackPanel>
                    </Grid>
                </CheckBox>
            </Border>
            <Border Classes="option">
                <CheckBox x:Name="ContentsCheck">
                    <Grid ColumnDefinitions="Auto, *" Margin="4,0,0,0">
                        <Path Classes="icon accent" Width="16" Height="16" Data="{StaticResource IconFolder}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <StackPanel Grid.Column="1" Spacing="2">
                            <TextBlock Text="Contenuto" FontWeight="SemiBold"/>
                            <TextBlock Text="Numero di cartelle e di file in ogni sottocartella (colonna Contenuto)" FontSize="12" TextWrapping="Wrap"
                                       Foreground="{DynamicResource AppTextMutedBrush}"/>
                        </StackPanel>
                    </Grid>
                </CheckBox>
            </Border>
            <TextBlock x:Name="NoFoldersNote" IsVisible="False" FontSize="11" TextWrapping="Wrap" Margin="2,0,0,0"
                       Foreground="{DynamicResource AppTextMutedBrush}"
                       Text="Qui non ci sono sottocartelle: i file vuoti si vedono già nella colonna 0 byte e il numero di file è nella riga sopra la tabella."/>

            <TextBlock Classes="group" Text="VIDEO"/>
            <Border Classes="option">
                <CheckBox x:Name="WebCheck">
                    <Grid ColumnDefinitions="Auto, *" Margin="4,0,0,0">
                        <Path Classes="icon accent" Width="16" Height="16" Data="{StaticResource IconFilm}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <StackPanel Grid.Column="1" Spacing="2">
                            <TextBlock Text="Codec web" FontWeight="SemiBold"/>
                            <TextBlock Text="Audio e video adatti ai player web (colonna Web)" FontSize="12" TextWrapping="Wrap"
                                       Foreground="{DynamicResource AppTextMutedBrush}"/>
                        </StackPanel>
                    </Grid>
                </CheckBox>
            </Border>
            <Border Classes="option">
                <CheckBox x:Name="LangCheck">
                    <Grid ColumnDefinitions="Auto, *" Margin="4,0,0,0">
                        <Path Classes="icon accent" Width="16" Height="16" Data="{StaticResource IconGlobe}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <StackPanel Grid.Column="1" Spacing="2">
                            <TextBlock Text="Lingua" FontWeight="SemiBold"/>
                            <TextBlock Text="Audio in italiano, come unica traccia o tra le tracce (colonna Lingua)" FontSize="12" TextWrapping="Wrap"
                                       Foreground="{DynamicResource AppTextMutedBrush}"/>
                        </StackPanel>
                    </Grid>
                </CheckBox>
            </Border>
            <Border Classes="option">
                <CheckBox x:Name="DurationCheck">
                    <Grid ColumnDefinitions="Auto, *" Margin="4,0,0,0">
                        <Path Classes="icon accent" Width="16" Height="16" Data="{StaticResource IconClock}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <StackPanel Grid.Column="1" Spacing="2">
                            <TextBlock Text="Durata" FontWeight="SemiBold"/>
                            <TextBlock x:Name="DurationHint" Text="Durata di ogni video e segnalazione dei più corti della soglia (colonna Durata)" FontSize="12" TextWrapping="Wrap"
                                       Foreground="{DynamicResource AppTextMutedBrush}"/>
                        </StackPanel>
                    </Grid>
                </CheckBox>
            </Border>
            <TextBlock x:Name="SpeedNote" FontSize="11" TextWrapping="Wrap" Margin="2,2,0,0" Foreground="{DynamicResource AppTextMutedBrush}"
                       Text="Prima le cartelle (veloce), poi i video. Ogni cartella e ogni video si legge una volta sola, qualunque voce scegli; i video già controllati e non cambiati si saltano."/>
        </StackPanel>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
            <Button Classes="ghost" MinWidth="100" IsCancel="True" Click="OnCancelClick">
                <TextBlock Text="Annulla"/>
            </Button>
            <Button x:Name="OkButton" Classes="accent" MinWidth="120" IsDefault="True" Click="OnOkClick">
                <StackPanel Classes="bi"><Path Classes="icon" Data="{StaticResource IconCheck}"/><TextBlock Text="Controlla"/></StackPanel>
            </Button>
        </StackPanel>
    </StackPanel>
</Window>
