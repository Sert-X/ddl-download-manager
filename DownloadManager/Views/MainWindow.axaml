<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:DownloadManager.ViewModels"
        xmlns:models="using:DownloadManager.Models"
        xmlns:services="using:DownloadManager.Services.Anime"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1500" d:DesignHeight="950"
        x:Class="DownloadManager.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="DDL Download Manager"
        Width="1400" Height="860"
        MinWidth="1150" MinHeight="600">

    <Grid RowDefinitions="Auto, *, Auto, Auto, Auto" Margin="0">

        <!-- HEADER -->
        <Border Grid.Row="0"
                Background="{DynamicResource AppHeaderBrush}"
                BorderBrush="{DynamicResource AppBorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="20,14">
            <Grid ColumnDefinitions="Auto, *, Auto">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
                    <!-- Logo in un riquadro con alone accento -->
                    <Border Width="46" Height="46" CornerRadius="14"
                            Background="{DynamicResource AppAccentSoftBrush}"
                            BorderBrush="{DynamicResource AppAccentBrush}" BorderThickness="1"
                            BoxShadow="0 0 18 0 #403B82F6">
                        <Image Source="avares://DDLDownloadManager/Assets/logo.png"
                               Width="30" Height="30" Stretch="Uniform"
                               RenderOptions.BitmapInterpolationMode="HighQuality"/>
                    </Border>

                    <StackPanel VerticalAlignment="Center" Spacing="1">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock VerticalAlignment="Center" FontSize="21" LetterSpacing="-0.3">
                                <Run Text="DDL" FontWeight="Black" Foreground="{DynamicResource AppAccentGradientBrush}"/>
                                <Run Text="Download Manager" FontWeight="SemiBold" Foreground="{DynamicResource AppTextBrush}"/>
                            </TextBlock>
                            <Border Background="{DynamicResource AppAccentSoftBrush}"
                                    BorderBrush="{DynamicResource AppAccentBrush}" BorderThickness="1"
                                    CornerRadius="999" Padding="7,1" VerticalAlignment="Center"
                                    ToolTip.Tip="Versione installata">
                                <TextBlock Text="{Binding AppVersionText}" FontSize="10" FontWeight="Bold"
                                           Foreground="{DynamicResource AppAccentBrush}"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="Anime  ·  Film e Serie  ·  SFTP  ·  Videobox"
                                   FontSize="11" FontWeight="Medium" LetterSpacing="0.4"
                                   Foreground="{DynamicResource AppTextMutedBrush}"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Button Classes="iconCircle" Command="{Binding CheckUpdatesCommand}" ToolTip.Tip="Controlla aggiornamenti" Margin="0,0,4,0">
                        <Path Classes="icon" Data="{StaticResource IconRefresh}"/>
                    </Button>

                    <Border Classes="proxyBadge"
                            Classes.proxyActive="{Binding IsProxyActive}"
                            Margin="0,0,12,0">
                        <TextBlock Text="{Binding ActiveProxyBadgeText}"
                                FontSize="12" FontWeight="SemiBold"
                                VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="Tema:" VerticalAlignment="Center"
                               Foreground="{DynamicResource AppTextMutedBrush}"
                               Margin="0,0,4,0"/>
                    <RadioButton GroupName="GlobalThemeGroup"
                                 IsChecked="{Binding ThemeVariant, Converter={x:Static vm:ThemeVariantEqualsConverter.Default}, ConverterParameter=Default}">
                        <StackPanel Classes="bi">
                            <Path Classes="icon" Data="{StaticResource IconMonitor}"/>
                            <TextBlock Text="Sistema"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton GroupName="GlobalThemeGroup" ToolTip.Tip="Tema chiaro"
                                 IsChecked="{Binding ThemeVariant, Converter={x:Static vm:ThemeVariantEqualsConverter.Default}, ConverterParameter=Light}">
                        <Path Classes="icon" Data="{StaticResource IconSun}"/>
                    </RadioButton>
                    <RadioButton GroupName="GlobalThemeGroup" ToolTip.Tip="Tema scuro"
                                 IsChecked="{Binding ThemeVariant, Converter={x:Static vm:ThemeVariantEqualsConverter.Default}, ConverterParameter=Dark}">
                        <Path Classes="icon" Data="{StaticResource IconMoon}"/>
                    </RadioButton>
                </StackPanel>
            </Grid>
        </Border>

        <DockPanel Grid.Row="1" Margin="12,10,12,0">
            <TabControl x:Name="MainTabs" Classes="nav" TabStripPlacement="Top" DockPanel.Dock="Top">

                <!-- ============================================================ -->
                <!--  TAB ANIME                                                   -->
                <!-- ============================================================ -->
                <TabItem>
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Path Classes="icon" Data="{StaticResource IconPlayCircle}"/>
                            <TextBlock Text="Anime Download" VerticalAlignment="Center"/>
                            <Border Width="10" Height="10" CornerRadius="5" Background="#EF4444" IsVisible="{Binding AnimeDownload.ShowAnimeRed}" VerticalAlignment="Center" ToolTip.Tip="Ci sono download falliti"/>
                            <Border Width="10" Height="10" CornerRadius="5" Background="#FBBF24" IsVisible="{Binding AnimeDownload.ShowAnimeYellow}" VerticalAlignment="Center" ToolTip.Tip="Download in corso"/>
                            <Border Width="10" Height="10" CornerRadius="5" Background="#22C55E" IsVisible="{Binding AnimeDownload.ShowAnimeGreen}" VerticalAlignment="Center" ToolTip.Tip="Nessuna attività"/>
                        </StackPanel>
                    </TabItem.Header>
                </TabItem>

                <!-- ============================================================ -->
                <!--  TAB FILM/SERIE                                              -->
                <!-- ============================================================ -->
                <TabItem>
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Path Classes="icon" Data="{StaticResource IconFilm}"/>
                            <TextBlock Text="Film/Serie Download" VerticalAlignment="Center"/>
                            <Border Width="10" Height="10" CornerRadius="5" Background="#EF4444" IsVisible="{Binding Streaming.ShowStreamingRed}" VerticalAlignment="Center" ToolTip.Tip="Ci sono download falliti"/>
                            <Border Width="10" Height="10" CornerRadius="5" Background="#FBBF24" IsVisible="{Binding Streaming.ShowStreamingYellow}" VerticalAlignment="Center" ToolTip.Tip="Download in corso"/>
                            <Border Width="10" Height="10" CornerRadius="5" Background="#22C55E" IsVisible="{Binding Streaming.ShowStreamingGreen}" VerticalAlignment="Center" ToolTip.Tip="Nessuna attività"/>
                        </StackPanel>
                    </TabItem.Header>
                </TabItem>

                <!-- ============================================================ -->
                <!--  TAB ACCOUNT                                                 -->
                <!-- ============================================================ -->
                <TabItem>
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Path Classes="icon" Data="{StaticResource IconUser}"/>
                            <TextBlock Text="Account" VerticalAlignment="Center"/>
                            <Border Width="10" Height="10" CornerRadius="5" Background="#EF4444" IsVisible="{Binding Account.HasAccountIssue}" VerticalAlignment="Center" ToolTip.Tip="Account non connesso"/>
                            <Border Width="10" Height="10" CornerRadius="5" Background="#22C55E" IsVisible="{Binding !Account.HasAccountIssue}" VerticalAlignment="Center" ToolTip.Tip="Account connesso"/>
                        </StackPanel>
                    </TabItem.Header>
                </TabItem>

                <!-- ============================================================ -->
                <!--  TAB ORGANIZZA FILE                                          -->
                <!-- ============================================================ -->
                <TabItem>
                    <TabItem.Header>
                        <StackPanel Classes="bi">
                            <Path Classes="icon" Data="{StaticResource IconLayers}"/>
                            <TextBlock Text="Organizza file"/>
                        </StackPanel>
                    </TabItem.Header>
                </TabItem>

                <!-- ============================================================ -->
                <!--  TAB SFTP                                                    -->
                <!-- ============================================================ -->
                <TabItem>
                    <TabItem.Header>
                        <StackPanel Classes="bi">
                            <Path Classes="icon" Data="{StaticResource IconCloud}"/>
                            <TextBlock Text="SFTP" VerticalAlignment="Center"/>
                            <Border Width="9" Height="9" CornerRadius="5" Background="#EF4444" IsVisible="{Binding Sftp.ShowSftpRed}" VerticalAlignment="Center" ToolTip.Tip="Ci sono trasferimenti falliti"/>
                            <Border Width="9" Height="9" CornerRadius="5" Background="#FBBF24" IsVisible="{Binding Sftp.ShowSftpYellow}" VerticalAlignment="Center" ToolTip.Tip="Trasferimento in corso"/>
                            <Border Width="9" Height="9" CornerRadius="5" Background="#22C55E" IsVisible="{Binding Sftp.ShowSftpGreen}" VerticalAlignment="Center" ToolTip.Tip="Connesso, nessuna attività"/>
                            <Border Width="9" Height="9" CornerRadius="5" Background="#8A8FA3" IsVisible="{Binding Sftp.ShowSftpGray}" VerticalAlignment="Center" ToolTip.Tip="SFTP disconnesso"/>
                        </StackPanel>
                    </TabItem.Header>
                </TabItem>

                <!-- ============================================================ -->
                <!--  TAB VIDEBOX CORRECTOR                                       -->
                <!-- ============================================================ -->
                <TabItem>
                    <TabItem.Header>
                        <StackPanel Classes="bi">
                            <Path Classes="icon" Data="{StaticResource IconEdit}"/>
                            <TextBlock Text="Videobox Corrector"/>
                        </StackPanel>
                    </TabItem.Header>
                </TabItem>

                <!-- ============================================================ -->
                <!--  TAB PROXY                                                   -->
                <!-- ============================================================ -->
                <TabItem>
                    <TabItem.Header>
                        <StackPanel Classes="bi">
                            <Path Classes="icon" Data="{StaticResource IconGlobe}"/>
                            <TextBlock Text="Proxy"/>
                        </StackPanel>
                    </TabItem.Header>
                </TabItem>

                <!-- ============================================================ -->
                <!--  TAB DOMINI                                                  -->
                <!-- ============================================================ -->
                <TabItem>
                    <TabItem.Header>
                        <StackPanel Classes="bi">
                            <Path Classes="icon" Data="{StaticResource IconGlobe}"/>
                            <TextBlock Text="Domini" VerticalAlignment="Center"/>
                            <Border Width="9" Height="9" CornerRadius="5" Background="#EF4444" IsVisible="{Binding HasDomainIssues}" VerticalAlignment="Center" ToolTip.Tip="Almeno un dominio non è raggiungibile"/>
                            <Border Width="9" Height="9" CornerRadius="5" Background="#22C55E" IsVisible="{Binding !HasDomainIssues}" VerticalAlignment="Center" ToolTip.Tip="Tutti i domini sono OK"/>
                        </StackPanel>
                    </TabItem.Header>
                </TabItem>
            </TabControl>
            <!-- Contenuti sempre nel visual tree: cambiando tab restano scroll e stato -->
            <Panel ClipToBounds="True">
                <Panel IsVisible="{Binding #MainTabs.SelectedIndex, Converter={x:Static vm:IndexEqualsConverter.Default}, ConverterParameter=0}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" DataContext="{Binding AnimeDownload}">
                    <StackPanel Margin="0,10,0,0">

                        <!-- STATUS -->
                        <ContentControl Theme="{StaticResource StatusBannerTheme}" Content="{Binding StatusMessage}"/>

                        <!-- GUIDA ANIME -->
                        <Border Classes="cardElevated" Margin="0,0,0,12" Padding="0" ClipToBounds="True">
                            <StackPanel>
                                <ToggleButton Classes="guideToggle" x:Name="ToggleGuideAnime" IsChecked="False">
                                    <Grid ColumnDefinitions="*, Auto">
                                        <StackPanel Classes="bi" VerticalAlignment="Center">
                                            <Path Classes="icon accent" Data="{StaticResource IconBulb}"/>
                                            <TextBlock Text="Guida rapida - Anime Download" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource AppTextBrush}"/>
                                        </StackPanel>
                                        <Path Grid.Column="1" Classes="chevron"/>
                                    </Grid>
                                </ToggleButton>
                                <Border IsVisible="{Binding #ToggleGuideAnime.IsChecked}" Background="Transparent" Margin="16,0,16,16" Padding="12">
                                    <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource AppTextMutedBrush}">
                                        <Run FontWeight="Bold" Foreground="{DynamicResource AppTextBrush}">Come si usa</Run><LineBreak/>
                                        <Run FontWeight="SemiBold" Foreground="{DynamicResource AppTextBrush}">• 1. Cerca:</Run> scegli il provider (AnimeWorld o AnimeSaturn), scrivi il titolo e premi Cerca o Invio. Le ricerche recenti restano nel menu a tendina.<LineBreak/>
                                        <Run FontWeight="SemiBold" Foreground="{DynamicResource AppTextBrush}">• 2. Episodi:</Run> fai doppio clic su un risultato: gli episodi compaiono nella tabella a destra.<LineBreak/>
                                        <Run FontWeight="SemiBold" Foreground="{DynamicResource AppTextBrush}">• 3. Selezione:</Run> spunta gli episodi (o usa Seleziona tutti / Deseleziona / Inverti) e premi "Scarica selezionati". Gli episodi già in coda vengono saltati.<LineBreak/>
                                        <Run FontWeight="SemiBold" Foreground="{DynamicResource AppTextBrush}">• 4. Coda:</Run> i download sono raggruppati per serie: espandi un gruppo per vedere ogni episodio, usa i pulsanti del gruppo per avviarlo, metterlo in pausa o annullarlo.<LineBreak/>
                                        <LineBreak/>
                                        <Run FontWeight="Bold" Foreground="{DynamicResource AppTextBrush}">Nome dei file</Run><LineBreak/>
                                        <Run FontWeight="SemiBold" Foreground="{DynamicResource AppTextBrush}">• Pattern:</Run> segnaposto disponibili: {Series} (serie), {Episode} o {Episode:D3} (numero con zeri, es. 001), {Title} (titolo episodio), {OriginalFileName} (nome originale). L'anteprima a destra mostra il risultato.<LineBreak/>
                                        <Run FontWeight="SemiBold" Foreground="{DynamicResource AppTextBrush}">• Cartella:</Run> "Crea sottocartella per serie" salva ogni serie in una cartella con il suo nome, dentro la cartella base.<LineBreak/>
                                        <LineBreak/>
                                        <Run FontWeight="Bold" Foreground="{DynamicResource AppTextBrush}">Suggerimenti</Run><LineBreak/>
                                        <Run FontWeight="SemiBold" Foreground="{DynamicResource AppTextBrush}">• Accodamento:</Run> con tante puntate gli episodi vengono accodati a blocchi: i primi partono subito mentre gli altri vengono preparati. "Stop accodamento" interrompe senza perdere quelli già in coda.<LineBreak/>
                                        <Run FontWeight="SemiBold" Foreground="{DynamicResource AppTextBrush}">• Priorità:</Run> clic destro su un episodio, "Forza Download", per farlo partire prima degli altri.<LineBreak/>
                                        <Run FontWeight="SemiBold" Foreground="{DynamicResource AppTextBrush}">• Download simultanei:</Run> il cursore della coda regola quanti episodi scaricare insieme.<LineBreak/>
                                        <Run FontWeight="SemiBold" Foreground="{DynamicResource AppTextBrush}">• Problemi:</Run> se un provider non risponde controlla la tab Domini (indirizzo aggiornato) e la tab Proxy. Gli errori compaiono anche nel Log globale, che si può filtrare per sezione.
                                    </TextBlock>
                                </Border>
                            </StackPanel>
                        </Border>

                        <Border Classes="cardElevated" Margin="0,0,0,12">
                            <Grid ColumnDefinitions="Auto, *, Auto, Auto">
                                <ComboBox Grid.Column="0" ItemsSource="{Binding AvailableProviders}" SelectedItem="{Binding SelectedProvider, Mode=TwoWay}" MinWidth="140" MinHeight="40" Margin="0,0,8,0" VerticalAlignment="Center" ToolTip.Tip="Scegli da quale sito estrarre gli episodi">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate x:DataType="services:IAnimeProvider">
                                            <TextBlock Text="{Binding Name}"/>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <ComboBox Grid.Column="1" Name="SearchComboBox" IsEditable="True" ItemsSource="{Binding SearchHistory}" PlaceholderText="Cerca un anime..." KeyDown="OnSearchKeyDown" HorizontalAlignment="Stretch" Margin="0,0,8,0" MinHeight="40"/>
                                <Button ToolTip.Tip="Cerca l'anime sul provider selezionato (o premi Invio nel campo di ricerca)" Grid.Column="2" Classes="accent" Click="OnSearchButtonClick" MinWidth="110" Height="40" Margin="0,0,8,0">
                                    <StackPanel Classes="bi" HorizontalAlignment="Center">
                                        <Path Classes="icon" Data="{StaticResource IconSearch}"/>
                                        <TextBlock Text="Cerca"/>
                                    </StackPanel>
                                </Button>
                                <Button Grid.Column="3" Classes="iconCircle" ToolTip.Tip="Svuota cronologia" Click="OnClearSearchHistoryClick">
                                    <Path Classes="icon" Data="{StaticResource IconTrash}"/>
                                </Button>
                            </Grid>
                        </Border>

                        <Border Classes="cardElevated" Margin="0,0,0,12">
                            <Grid ColumnDefinitions="Auto, *, Auto, Auto, Auto" RowDefinitions="Auto, Auto">
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Pattern" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,10,0" ToolTip.Tip="Usa {OriginalFileName} per mantenere il nome originale, o {Episode} per rinominare"/>
                                <ComboBox Grid.Row="0" Grid.Column="1" IsEditable="True" ItemsSource="{Binding NamingPresets}" Text="{Binding NamingPattern, Mode=TwoWay}" HorizontalAlignment="Stretch" Margin="0,0,10,0"/>
                                <Border Grid.Row="0" Grid.Column="2" Background="{DynamicResource AppSurface2Brush}" BorderBrush="{DynamicResource AppAccentBrush}" BorderThickness="1" CornerRadius="6" Padding="10,4" Margin="0,0,10,0" MaxWidth="380">
                                    <TextBlock Text="{Binding PatternPreview}" FontFamily="Consolas,Menlo,monospace" Foreground="{DynamicResource AppAccentBrush}" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                </Border>
                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Cartella base" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,10,10,0" ToolTip.Tip="La cartella locale dove verranno salvati i video"/>
                                <TextBox Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding BaseDownloadFolder}" Margin="0,10,10,0"/>
                                <Button Grid.Row="1" Grid.Column="3" Classes="iconCircle" Click="OnBrowseBaseFolderClick" Margin="0,10,8,0" ToolTip.Tip="Sfoglia">
                                    <Path Classes="icon" Data="{StaticResource IconFolder}"/>
                                </Button>
                                <CheckBox Grid.Row="1" Grid.Column="4" Content="Crea sottocartella per serie" IsChecked="{Binding CreateSeriesFolder}" VerticalAlignment="Center" Margin="0,10,0,0" ToolTip.Tip="Crea una cartella dedicata per questa serie"/>
                            </Grid>
                        </Border>

                        <Grid ColumnDefinitions="1*, 1*" Height="480" Margin="0,0,0,12">
                            <Border Grid.Column="0" Classes="cardElevated" Margin="0,0,6,0">
                                <DockPanel>
                                    <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto, Auto, *" Margin="0,0,0,8">
                                        <StackPanel Grid.Column="0" Classes="bi" VerticalAlignment="Center">
                                            <Path Classes="icon accent" Data="{StaticResource IconFilm}"/>
                                            <TextBlock Text="Risultati ricerca" FontWeight="Bold" FontSize="14"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="{Binding SearchResultsCountText}" FontSize="12" Foreground="{DynamicResource AppTextMutedBrush}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" IsVisible="{Binding IsLoadingSearchResults}">
                                            <ProgressBar IsIndeterminate="True" Width="80" Height="4" VerticalAlignment="Center"/>
                                            <TextBlock Text="Ricerca in corso..." FontSize="11" FontStyle="Italic" Foreground="{DynamicResource AppTextMutedBrush}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Grid>
                                    <ListBox Classes="posterGrid" ItemsSource="{Binding SearchResults}" DoubleTapped="OnSearchResultDoubleTapped" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                        <ListBox.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel Orientation="Horizontal"/>
                                            </ItemsPanelTemplate>
                                        </ListBox.ItemsPanel>
                                        <ListBox.ItemTemplate>
                                            <DataTemplate x:DataType="models:AnimeSearchResult">
                                                <StackPanel Width="140" Spacing="8">
                                                    <Border Classes="poster" Width="140" Height="200">
                                                        <Image Source="{Binding Poster}" Stretch="UniformToFill"/>
                                                    </Border>
                                                    <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" TextAlignment="Center"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </DockPanel>
                            </Border>

                            <Border Grid.Column="1" Classes="cardElevated" Margin="6,0,0,0">
                                <DockPanel>
                                    <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto, Auto, Auto, Auto, *" Margin="0,0,0,8">
                                        <StackPanel Grid.Column="0" Classes="bi" VerticalAlignment="Center">
                                            <Path Classes="icon accent" Data="{StaticResource IconTv}"/>
                                            <TextBlock Text="Episodi" FontWeight="Bold" FontSize="14"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="{Binding SelectedAnimeName}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource AppAccentBrush}" Margin="8,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="360" IsVisible="{Binding HasSelectedAnime}" ToolTip.Tip="{Binding SelectedAnimeName}"/>
                                        <TextBlock Grid.Column="2" Text="{Binding EpisodesCountText}" FontSize="12" Foreground="{DynamicResource AppTextMutedBrush}" Margin="12,0,0,0" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="3" Text="{Binding EpisodesSelectedCountText}" FontSize="12" Foreground="{DynamicResource AppAccentBrush}" Margin="12,0,0,0" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                        <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" IsVisible="{Binding IsLoadingEpisodes}">
                                            <ProgressBar IsIndeterminate="True" Width="80" Height="4" VerticalAlignment="Center"/>
                                            <TextBlock Text="Caricamento..." FontSize="11" FontStyle="Italic" Foreground="{DynamicResource AppTextMutedBrush}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Grid>

                                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="6" Margin="0,0,0,8">
                                        <Button ToolTip.Tip="Accoda tutti gli episodi spuntati (quelli già in coda vengono saltati)" Classes="success" Command="{Binding DownloadSelectedEpisodesCommand}" IsEnabled="{Binding CanInteractWithEpisodes}">
                                            <StackPanel Classes="bi"><Path Classes="icon" Data="{StaticResource IconDownload}"/><TextBlock Text="Scarica selezionati"/></StackPanel>
                                        </Button>
                                        <Button ToolTip.Tip="Seleziona tutti gli episodi della lista" Content="Seleziona tutti" Click="OnSelectAllEpisodesClick" IsEnabled="{Binding CanInteractWithEpisodes}"/>
                                        <Button ToolTip.Tip="Toglie la selezione a tutti gli episodi" Content="Deseleziona" Click="OnDeselectAllEpisodesClick" IsEnabled="{Binding CanInteractWithEpisodes}"/>
                                        <Button ToolTip.Tip="Inverte la selezione degli episodi" Content="Inverti" Click="OnInvertEpisodeSelectionClick" IsEnabled="{Binding CanInteractWithEpisodes}"/>
                                    </StackPanel>

                                    <DataGrid Name="EpisodesGrid" ItemsSource="{Binding Episodes}" AutoGenerateColumns="False" SelectionMode="Extended" IsReadOnly="False" SelectionChanged="OnEpisodesSelectionChanged" DoubleTapped="OnEpisodeDoubleTapped" CanUserResizeColumns="True" CanUserReorderColumns="True" CanUserSortColumns="False">
                                        <DataGrid.Columns>
                                            <DataGridTemplateColumn Header="" Width="40">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTextColumn Header="N." Binding="{Binding Number}" Width="60"/>
                                            <DataGridTextColumn Header="Titolo" Binding="{Binding Title}" Width="*"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </DockPanel>
                            </Border>
                        </Grid>

                        <Border Classes="cardElevated" Height="550" Margin="0,0,0,12">
                            <DockPanel>
                                <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto, *" Margin="0,0,0,8">
                                    <StackPanel Grid.Column="0" Classes="bi" VerticalAlignment="Center">
                                        <Path Classes="icon accent" Data="{StaticResource IconDownload}"/>
                                        <TextBlock Text="Download per serie" FontWeight="Bold" FontSize="14"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{Binding SeriesSummaryText}" FontSize="12" Foreground="{DynamicResource AppTextMutedBrush}" Margin="12,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                </Grid>
                                <Border DockPanel.Dock="Top" Background="{DynamicResource AppSurface2Brush}" CornerRadius="8" Padding="12" Margin="0,0,0,10">
                                    <StackPanel Spacing="10">
                                        <WrapPanel Orientation="Horizontal" ItemSpacing="8" LineSpacing="6">
                                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Margin="0,0,10,0">
                                                <TextBlock Text="Download paralleli" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,6,0" ToolTip.Tip="Quanti episodi anime scaricare insieme. Gli slot sono separati da quelli della tab Film/Serie"/>
                                                <Slider Value="{Binding MaxConcurrency}" Minimum="1" Maximum="20" Width="140" TickFrequency="1" IsSnapToTickEnabled="True" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding MaxConcurrency}" Width="24" VerticalAlignment="Center" HorizontalAlignment="Center" FontWeight="Bold" Foreground="{DynamicResource AppAccentBrush}"/>
                                            </StackPanel>
                                            <Button ToolTip.Tip="Avvia tutti i download anime in attesa o in pausa" Classes="success" Command="{Binding StartAllCommand}"><StackPanel Classes="bi"><Path Classes="icon" Data="{StaticResource IconPlay}"/><TextBlock Text="Avvia tutti"/></StackPanel></Button>
                                            <Button ToolTip.Tip="Mette in pausa tutti i download anime in corso" Classes="warning" Command="{Binding PauseAllCommand}"><StackPanel Classes="bi"><Path Classes="icon" Data="{StaticResource IconPause}"/><TextBlock Text="Pausa tutti"/></StackPanel></Button>
                                            <Button ToolTip.Tip="Annulla tutti i download anime non ancora completati" Classes="danger" Command="{Binding CancelAllDownloadsCommand}"><StackPanel Classes="bi"><Path Classes="icon" Data="{StaticResource IconClose}"/><TextBlock Text="Annulla tutti"/></StackPanel></Button>
                                            <Button ToolTip.Tip="Ferma e rimuove dalla lista TUTTI i download anime (i file già scaricati restano su disco)" Command="{Binding DeleteEverythingCommand}"><StackPanel Classes="bi"><Path Classes="icon" Data="{StaticResource IconTrash}"/><TextBlock Text="Elimina tutti"/></StackPanel></Button>
                                            <Button ToolTip.Tip="Interrompe l'accodamento in corso (gli episodi già accodati restano in coda)" Classes="danger" Command="{Binding CancelBatchCommand}" IsVisible="{Binding IsBatchActive}"><StackPanel Classes="bi"><Path Classes="icon" Data="{StaticResource IconStop}"/><TextBlock Text="Stop accodamento"/></StackPanel></Button>
                                            <Button ToolTip.Tip="Rimuove dalla lista i download completati (i file restano su disco)" Command="{Binding ClearCompletedCommand}"><StackPanel Classes="bi"><Path Classes="icon" Data="{StaticResource IconCheckCircle}"/><TextBlock Text="Completati"/></StackPanel></Button>
                                            <Button ToolTip.Tip="Rimuove dalla lista i download annullati" Command="{Binding ClearCancelledDownloadsCommand}"><StackPanel Classes="bi"><Path Classes="icon" Data="{StaticResource IconBan}"/><TextBlock Text="Annullati"/></StackPanel></Button>
                                            <Button ToolTip.Tip="Rimuove dalla lista i download falliti" Command="{Binding ClearFailedDownloadsCommand}"><StackPanel Classes="bi"><Path Classes="icon" Data="{StaticResource IconAlertCircle}"/><TextBlock Text="Failed"/></StackPanel></Button>
                                        </WrapPanel>
                                        <StackPanel Orientation="Horizontal" Spacing="24">
                                            <TextBlock FontSize="12" Foreground="{DynamicResource AppTextMutedBrush}">
                                                <Run Text="Totale:" FontWeight="Bold"/>
                                                <Run Text="{Binding GlobalSizeText}"/>
                                            </TextBlock>
                                            <TextBlock FontSize="12" Foreground="{DynamicResource AppSuccessBrush}">
                                                <Run Text="Velocità:" FontWeight="Bold"/>
                                                <Run Text="{Binding GlobalSpeedText}"/>
                                            </TextBlock>
                                            <TextBlock FontSize="12" Foreground="{DynamicResource AppTextMutedBrush}">
                                                <Run Text="ETA:" FontWeight="Bold"/>
                                                <Run Text="{Binding GlobalEtaText}"/>
                                            </TextBlock>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                    <ItemsControl ItemsSource="{Binding SeriesGroups}" HorizontalAlignment="Stretch">
                                        <ItemsControl.Styles>
                                            <Style Selector="ItemsControl > ContentPresenter">
                                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                            </Style>
                                        </ItemsControl.Styles>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="models:SeriesGroup">
                                                <Expander Theme="{StaticResource DownloadGroupExpanderTheme}" IsExpanded="{Binding IsExpanded, Mode=TwoWay}">
                                                    <Expander.Header>
                                                        <Grid ColumnDefinitions="2*, 130, 110, 1.5*, 100, Auto">
                                                            <TextBlock Grid.Column="0" Text="{Binding Header}" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,10,0"/>
                                                            <TextBlock Grid.Column="1" Text="{Binding TotalSizeText}" VerticalAlignment="Center" FontSize="11" Foreground="{DynamicResource AppTextMutedBrush}" Margin="0,0,10,0"/>
                                                            <TextBlock Grid.Column="2" Text="{Binding TotalSpeedText}" VerticalAlignment="Center" FontSize="11" Foreground="{DynamicResource AppSuccessBrush}" Margin="0,0,10,0"/>
                                                            <Grid Grid.Column="3" ColumnDefinitions="*, Auto" Margin="10,0">
                                                                <ProgressBar Grid.Column="0" Value="{Binding OverallPercentage}" Minimum="0" Maximum="100" Height="14"/>
                                                                <TextBlock Grid.Column="1" Text="{Binding OverallPercentage, StringFormat={}{0:F1}%}" Margin="8,0,0,0" VerticalAlignment="Center" FontSize="11" FontWeight="SemiBold"/>
                                                            </Grid>
                                                            <TextBlock Grid.Column="4" Text="{Binding OverallEtaText}" VerticalAlignment="Center" FontSize="11" Foreground="{DynamicResource AppTextMutedBrush}" Margin="10,0"/>
                                                            <StackPanel Grid.Column="5" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                                                <Button Classes="iconCircle success" Width="30" Height="30" ToolTip.Tip="Avvia serie" Click="OnResumeGroupClick"><Path Classes="icon" Data="{StaticResource IconPlay}"/></Button>
                                                                <Button Classes="iconCircle warning" Width="30" Height="30" ToolTip.Tip="Pausa serie" Click="OnPauseGroupClick"><Path Classes="icon" Data="{StaticResource IconPause}"/></Button>
                                                                <Button Classes="iconCircle" Width="30" Height="30" ToolTip.Tip="Forza priorità" Click="OnForceGroupClick"><Path Classes="icon" Data="{StaticResource IconBolt}"/></Button>
                                                                <Button Classes="iconCircle" Width="30" Height="30" ToolTip.Tip="Rimuovi priorità" Click="OnUnforceGroupClick"><Path Classes="icon" Data="{StaticResource IconBoltOff}"/></Button>
                                                                <Button Classes="iconCircle danger" Width="30" Height="30" ToolTip.Tip="Annulla serie" Click="OnCancelGroupClick"><Path Classes="icon" Data="{StaticResource IconClose}"/></Button>
                                                                <Button Classes="iconCircle" Width="30" Height="30" ToolTip.Tip="Rimuovi serie" Click="OnRemoveGroupClick"><Path Classes="icon" Data="{StaticResource IconTrash}"/></Button>
                                                                <Button Classes="iconCircle" Width="30" Height="30" ToolTip.Tip="Riscarica tutti i failed di questa serie" IsVisible="{Binding HasFailed}" Click="OnRetryFailedGroupClick"><Path Classes="icon" Data="{StaticResource IconRefresh}"/></Button>
                                                                <Button Classes="iconCircle warning" Width="30" Height="30" ToolTip.Tip="Riscarica tutti gli annullati di questa serie" IsVisible="{Binding HasCancelled}" Click="OnRetryCancelledGroupClick"><Path Classes="icon" Data="{StaticResource IconRefresh}"/></Button>
                                                            </StackPanel>
                                                        </Grid>
                                                    </Expander.Header>
                                                    <ItemsControl ItemsSource="{Binding ExpandedItems}" HorizontalAlignment="Stretch">
                                                        <ItemsControl.Styles>
                                                            <Style Selector="ItemsControl > ContentPresenter">
                                                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                                            </Style>
                                                        </ItemsControl.Styles>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate DataType="models:DownloadItem">
                                                                <Border Padding="10,7" Background="{DynamicResource DownloadGroupRowBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="0,0,0,1">
                                                                    <Border.ContextMenu>
                                                                        <ContextMenu>
                                                                            <MenuItem Header="Avvia / Riprendi" Click="OnResumeDownloadClick"><MenuItem.Icon><Path Classes="icon" Data="{StaticResource IconPlay}"/></MenuItem.Icon></MenuItem>
                                                                            <MenuItem Header="Forza Download" Click="OnForceDownloadClick"><MenuItem.Icon><Path Classes="icon" Data="{StaticResource IconBolt}"/></MenuItem.Icon></MenuItem>
                                                                            <MenuItem Header="Rimuovi priorità" Click="OnUnforceDownloadClick"><MenuItem.Icon><Path Classes="icon" Data="{StaticResource IconBoltOff}"/></MenuItem.Icon></MenuItem>
                                                                            <MenuItem Header="Pausa" Click="OnPauseDownloadClick"><MenuItem.Icon><Path Classes="icon" Data="{StaticResource IconPause}"/></MenuItem.Icon></MenuItem>
                                                                            <MenuItem Header="Annulla" Click="OnCancelDownloadClick"><MenuItem.Icon><Path Classes="icon" Data="{StaticResource IconClose}"/></MenuItem.Icon></MenuItem>
                                                                            <Separator/>
                                                                            <MenuItem Header="Rimuovi dalla lista" Click="OnRemoveDownloadClick"><MenuItem.Icon><Path Classes="icon" Data="{StaticResource IconTrash}"/></MenuItem.Icon></MenuItem>
                                                                        </ContextMenu>
                                                                    </Border.ContextMenu>
                                                                    <Grid ColumnDefinitions="24, 2*, 50, 110, 2*, 160, 90, 90, Auto">
                                                                        <Path Grid.Column="0" Classes="icon warn" Width="13" Height="13" HorizontalAlignment="Left" Data="{StaticResource IconBolt}" IsVisible="{Binding IsPriority}"/>
                                                                        <TextBlock Grid.Column="1" Text="{Binding FileName}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" FontWeight="Medium"/>
                                                                        <TextBlock Grid.Column="2" Text="{Binding EpisodeNumber}" VerticalAlignment="Center"/>
                                                                        <TextBlock Grid.Column="3" Text="{Binding Status}" VerticalAlignment="Center" FontSize="11" Foreground="{DynamicResource AppTextMutedBrush}"/>
                                                                        <Grid Grid.Column="4" ColumnDefinitions="*, 44" Margin="0,0,12,0">
                                                                            <ProgressBar Value="{Binding Percentage}" Minimum="0" Maximum="100" Height="14"/>
                                                                            <TextBlock Grid.Column="1" Text="{Binding Percentage, StringFormat={}{0:F0}%}" TextAlignment="Right" VerticalAlignment="Center" FontSize="11"/>
                                                                        </Grid>
                                                                        <TextBlock Grid.Column="5" Text="{Binding SizeText}" VerticalAlignment="Center" FontSize="11" Foreground="{DynamicResource AppTextMutedBrush}" Margin="0,0,15,0"/>
                                                                        <TextBlock Grid.Column="6" Text="{Binding SpeedText}" VerticalAlignment="Center" FontSize="11" Foreground="{DynamicResource AppSuccessBrush}" Margin="0,0,15,0"/>
                                                                        <TextBlock Grid.Column="7" Text="{Binding EtaText}" VerticalAlignment="Center" FontSize="11" Foreground="{DynamicResource AppTextMutedBrush}" Margin="0,0,15,0"/>
                                                                        <StackPanel Grid.Column="8" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center" Margin="8,0,0,0">
                                                                            <Button Classes="iconCircle success" Width="26" Height="26" ToolTip.Tip="Riprendi" IsVisible="{Binding CanResume}" Click="OnDownloadItemResumeClick"><Path Classes="icon" Width="12" Height="12" Data="{StaticResource IconPlay}"/></Button>
                                                                            <Button Classes="iconCircle" Width="26" Height="26" ToolTip.Tip="Forza priorità" IsVisible="{Binding CanForce}" Click="OnDownloadItemForceClick"><Path Classes="icon" Width="12" Height="12" Data="{StaticResource IconBolt}"/></Button>
                                                                            <Button Classes="iconCircle warning" Width="26" Height="26" ToolTip.Tip="Pausa" IsVisible="{Binding CanPause}" Click="OnDownloadItemPauseClick"><Path Classes="icon" Width="12" Height="12" Data="{StaticResource IconPause}"/></Button>
                                                                            <Button Classes="iconCircle danger" Width="26" Height="26" ToolTip.Tip="Annulla" IsVisible="{Binding CanCancel}" Click="OnDownloadItemCancelClick"><Path Classes="icon" Width="12" Height="12" Data="{StaticResource IconClose}"/></Button>
                                                                            <Button Classes="iconCircle" Width="26" Height="26" ToolTip.Tip="Riscarica (elimina .part e ricomincia)" IsVisible="{Binding CanRetry}" Click="OnDownloadItemRetryClick"><Path Classes="icon" Width="12" Height="12" Data="{StaticResource IconRefresh}"/></Button>
                                                                            <Button Classes="iconCircle danger" Width="26" Height="26" ToolTip.Tip="Rimuovi dalla lista" Click="OnDownloadItemRemoveClick"><Path Classes="icon" Width="12" Height="12" Data="{StaticResource IconTrash}"/></Button>
                                                                        </StackPanel>
                                                                    </Grid>
                                                                </Border>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </Expander>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </DockPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
                </Panel>
                <Panel IsVisible="{Binding #MainTabs.SelectedIndex, Converter={x:Static vm:IndexEqualsConverter.Default}, ConverterParameter=1}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" DataContext="{Binding Streaming}">
                    <StackPanel Margin="0,10,0,0">

                        <!-- STATUS -->
                        <ContentControl Theme="{StaticResource StatusBannerTheme}" Content="{Binding StatusMessage}"/>

                        <!-- GUIDA STREAMING -->
                        <Border Classes="cardElevated" Margin="0,0,0,12" Padding="0" ClipToBounds="True">
                            <StackPanel>
                                <ToggleButton Classes="guideToggle" x:Name="ToggleGuideStreaming" IsChecked="False">
                                    <Grid ColumnDefinitions="*, Auto">
                                        <StackPanel Classes="bi" VerticalAlignment="Center">
                                            <Path Classes="icon accent" Data="{StaticResource IconBulb}"/>
                                            <TextBlock Text="Guida rapida - Film e Serie TV" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource AppTextBrush}"/>
                                        </StackPanel>
                                        <Path Grid.Column="1" Classes="chevron"/>
                                    </Grid>
                                </ToggleButton>
                                <Border IsVisible="{Binding #ToggleGuideStreaming.IsChecked}" Background="Transparent" Margin="16,0,16,16" Padding="12">
                                    <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource AppTextMutedBrush}">
                                        <Run FontWeight="Bold" Foreground="{DynamicResource AppTextBrush}">Come si usa</Run><LineBreak/>
                                        <Run FontWeight="SemiBold" Foreground="{DynamicResource AppTextBrush}">• 1. Cerca:</Run> scrivi il titolo di un film o di una serie e premi Cerca o Invio.<LineBreak/>
                                        <Run FontWeight="SemiBold" Foreground="{DynamicResource AppTextBrush}">• 2. Seleziona:</Run> fai clic su un risultato: per le serie compaiono stagioni ed episodi, per i film il pulsante di download.<LineBreak/>
                                        <Run FontWeight="SemiBold" Foreground="{DynamicResource AppTextBrush}">• 3. Qualità:</Run> scegli la qualità (Auto prende la migliore disponibile). Con un account Premium, accedi dalla tab Account per sbloccare il 1080p.<LineBreak/>
                                        <Run FontWeight="SemiBold" Foreground="{DynamicResource AppTextBrush}">• 4. Scarica:</Run> "Scarica selezionati" per gli episodi spuntati, "Scarica stagione" per l'intera stagione, "Scarica tutta la serie" per tutte le stagioni.<LineBreak/>
                                        <LineBreak/>
                                        <Run FontWeight="Bold" Foreground="{DynamicResource AppTextBrush}">Come funziona l'accodamento</Run><LineBreak/>
                                        Gli episodi vengono accodati subito. Il link video di ogni episodio viene estratto quando parte il suo download, perché i link scadono dopo pochi minuti: così anche le code lunghe non falliscono per link scaduti.<LineBreak/>
                                        <LineBreak/>
                                        <Run FontWeight="Bold" Foreground="{DynamicResource AppTextBrush}">Suggerimenti</Run><LineBreak/>
                                        <Run FontWeight="SemiBold" Foreground="{DynamicResource AppTextBrush}">• Nome dei file:</Run> i pattern per film e serie supportano {Series}, {Episode:D2}, {Title} e {Anno}. Le stagioni possono finire in sottocartelle dedicate.<LineBreak/>
                                        <Run FontWeight="SemiBold" Foreground="{DynamicResource AppTextBrush}">• Errore 403 / Cloudflare:</Run> attiva un proxy funzionante per StreamingCommunity nella tab Proxy e controlla nella tab Domini che l'indirizzo sia aggiornato.<LineBreak/>
                                        <Run FontWeight="SemiBold" Foreground="{DynamicResource AppTextBrush}">• Problemi:</Run> filtra il Log globale sulla sezione "Streaming" per vedere i dettagli di ogni estrazione.
                                    </TextBlock>
                                </Border>
                            </StackPanel>
                        </Border>

                        <Border Classes="cardElevated" Margin="0,0,0,12" Background="{DynamicResource AppWarningSoftBrush}" BorderBrush="{DynamicResource AppWarningBrush}" BorderThickness="1">
                            <Grid ColumnDefinitions="Auto, *">
                                <Path Grid.Column="0" Classes="icon warn" Width="22" Height="22" Data="{StaticResource IconAlert}" Margin="0,0,12,0"/>
                                <TextBlock Grid.Column="1" TextWrapping="Wrap" Foreground="{DynamicResource AppTextBrush}">
                                    <Run FontWeight="Bold">Importante:</Run>
                                    <Run>per scaricare da StreamingCommunity è </Run>
                                    <Run FontWeight="Bold">fortemente consigliato</Run>
                                    <Run> usare un Proxy attivo (tab Proxy). Senza proxy, Cloudflare potrebbe bloccare i download con errore 403 dopo pochi minuti di attività. Attiva almeno un proxy funzionante per il provider </Run>
                                    <Run FontWeight="Bold">StreamingCommunity</Run>
                                    <Run>.</Run>
                                </TextBlock>
                            </Grid>
                        </Border>

                        <Border Classes="cardElevated" Margin="0,0,0,12">
                            <Grid ColumnDefinitions="*, Auto, Auto">
                                <ComboBox Grid.Column="0" Name="StreamingSearchComboBox" IsEditable="True" ItemsSource="{Binding SearchHistory}" PlaceholderText="Cerca un film o una serie TV..." KeyDown="OnStreamingSearchKeyDown" HorizontalAlignment="Stretch" Margin="0,0,8,0" MinHeight="40"/>
                                <Button ToolTip.Tip="Cerca film o serie TV (o premi Invio nel campo di ricerca)" Grid.Column="1" Classes="accent" Click="OnStreamingSearchButtonClick" MinWidth="110" Height="40" Margin="0,0,8,0">
                                    <StackPanel Classes="bi" HorizontalAlignment="Center">
                                        <Path Classes="icon" Data="{StaticResource IconSearch}"/>
                                        <TextBlock Text="Cerca"/>
                                    </StackPanel>
                                </Button>
                                <Button Grid.Column="2" Classes="iconCircle" ToolTip.Tip="Svuota cronologia" Click="OnStreamingClearSearchHistoryClick">
                                    <Path Classes="icon" Data="{StaticResource IconTrash}"/>
                                </Button>
                            </Grid>
                        </Border>

                        <Border Classes="cardElevated" Margin="0,0,0,12">
                            <Grid ColumnDefinitions="Auto, *, Auto, Auto, Auto" RowDefinitions="Auto, Auto, Auto, Auto">
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Pattern Film" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,10,0" ToolTip.Tip="Come verrà rinominato il file del film (es. {Series} ({Anno}))"/>
                                <ComboBox Grid.Row="0" Grid.Column="1" IsEditable="True" ItemsSource="{Binding MovieNamingPresets}" Text="{Binding MovieNamingPattern, Mode=TwoWay}" HorizontalAlignment="Stretch" Margin="0,0,10,0"/>
                                <Border Grid.Row="0" Grid.Column="2" Background="{DynamicResource AppSurface2Brush}" BorderBrush="{DynamicResource AppAccentBrush}" BorderThickness="1" CornerRadius="6" Padding="10,4" Margin="0,0,10,0" MaxWidth="380">
                                    <TextBlock Text="{Binding MoviePatternPreview}" FontFamily="Consolas,Menlo,monospace" Foreground="{DynamicResource AppAccentBrush}" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                </Border>

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Pattern Serie" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,10,10,0" ToolTip.Tip="Come verranno rinominati gli episodi (es. {Episode} o S{Season}E{Episode})"/>
                                <ComboBox Grid.Row="1" Grid.Column="1" IsEditable="True" ItemsSource="{Binding SeriesNamingPresets}" Text="{Binding SeriesNamingPattern, Mode=TwoWay}" HorizontalAlignment="Stretch" Margin="0,10,10,0"/>
                                <Border Grid.Row="1" Grid.Column="2" Background="{DynamicResource AppSurface2Brush}" BorderBrush="{DynamicResource AppAccentBrush}" BorderThickness="1" CornerRadius="6" Padding="10,4" Margin="0,10,10,0" MaxWidth="380">
                                    <TextBlock Text="{Binding SeriesPatternPreview}" FontFamily="Consolas,Menlo,monospace" Foreground="{DynamicResource AppAccentBrush}" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                </Border>

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Cartella base" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,10,10,0"/>
                                <TextBox Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding BaseDownloadFolder, Mode=TwoWay}" Margin="0,10,10,0"/>
                                <Button Grid.Row="2" Grid.Column="3" Classes="iconCircle" Click="OnStreamingBrowseBaseFolderClick" Margin="0,10,8,0" ToolTip.Tip="Sfoglia">
                                    <Path Classes="icon" Data="{StaticResource IconFolder}"/>
                                </Button>
                                <CheckBox ToolTip.Tip="Salva ogni serie in una sottocartella con il suo nome dentro la cartella base" Grid.Row="2" Grid.Column="4" Content="Crea sottocartella per serie" IsChecked="{Binding CreateSeriesFolder, Mode=TwoWay}" VerticalAlignment="Center" Margin="0,10,0,0"/>

                                <TextBlock Grid.Row="3" Grid.Column="0" Text="Sottocartella stagione" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,10,10,0" ToolTip.Tip="Pattern per le cartelle delle stagioni (es. 'Stagione {number}'). Lascia vuoto per non creare sottocartelle."/>
                                <TextBox Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding SeasonFolderPattern}" PlaceholderText="Stagione {number} (vuoto = nessuna)" Margin="0,10,10,0"/>
                            </Grid>
                        </Border>

                        <Grid ColumnDefinitions="1*, 1*" Height="500" Margin="0,0,0,12">
                            <Border Grid.Column="0" Classes="cardElevated" Margin="0,0,6,0">
                                <DockPanel>
                                    <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto, Auto, *" Margin="0,0,0,8">
                                        <StackPanel Grid.Column="0" Classes="bi" VerticalAlignment="Center">
                                            <Path Classes="icon accent" Data="{StaticResource IconFilm}"/>
                                            <TextBlock Text="Risultati ricerca" FontWeight="Bold" FontSize="14"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="{Binding SearchResultsCountText}" FontSize="12" Foreground="{DynamicResource AppTextMutedBrush}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" IsVisible="{Binding IsLoadingSearchResults}">
                                            <ProgressBar IsIndeterminate="True" Width="80" Height="4" VerticalAlignment="Center"/>
                                            <TextBlock Text="Ricerca..." FontSize="11" FontStyle="Italic" Foreground="{DynamicResource AppTextMutedBrush}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Grid>
                                    <ListBox Name="StreamingSearchResultsGrid" Classes="posterGrid" ItemsSource="{Binding SearchResults}" SelectedItem="{Binding SelectedResult, Mode=TwoWay}" DoubleTapped="OnStreamingSearchResultDoubleTapped" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                        <ListBox.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel Orientation="Horizontal"/>
                                            </ItemsPanelTemplate>
                                        </ListBox.ItemsPanel>
                                        <ListBox.ItemTemplate>
                                            <DataTemplate x:DataType="models:MovieSearchResult">
                                                <StackPanel Width="140" Spacing="4">
                                                    <Border Classes="poster" Width="140" Height="200">
                                                        <Image Source="{Binding Poster}" Stretch="UniformToFill"/>
                                                    </Border>
                                                    <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" TextAlignment="Center"/>
                                                    <TextBlock FontSize="11" TextAlignment="Center" Foreground="{DynamicResource AppTextMutedBrush}">
                                                        <Run Text="{Binding Year}"/>
                                                        <Run Text=" · "/>
                                                        <Run Text="{Binding Type}"/>
                                                    </TextBlock>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </DockPanel>
                            </Border>

                            <Border Grid.Column="1" Classes="cardElevated" Margin="6,0,0,0">
                                <DockPanel>
                                    <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto, Auto, *" Margin="0,0,0,8">
                                        <StackPanel Grid.Column="0" Classes="bi" VerticalAlignment="Center">
                                            <Path Classes="icon accent" Data="{StaticResource IconTv}"/>
                                            <TextBlock Text="Dettaglio" FontWeight="Bold" FontSize="14"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="{Binding SelectedResultName}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource AppAccentBrush}" Margin="8,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="320" IsVisible="{Binding HasSelectedResult}" ToolTip.Tip="{Binding SelectedResultName}"/>
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="12" HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" IsVisible="{Binding IsLoadingEpisodes}">
                                                <ProgressBar IsIndeterminate="True" Width="80" Height="4" VerticalAlignment="Center"/>
                                                <TextBlock Text="Caricamento..." FontSize="11" FontStyle="Italic" Foreground="{DynamicResource AppTextMutedBrush}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <ComboBox ItemsSource="{Binding Seasons}" SelectedItem="{Binding SelectedSeason, Mode=TwoWay}" MinWidth="160" IsVisible="{Binding IsSelectedResultSeries}" ToolTip.Tip="Seleziona stagione">
                                                <ComboBox.ItemTemplate>
                                                    <DataTemplate x:DataType="models:Season">
                                                        <TextBlock Text="{Binding DisplayName}"/>
                                                    </DataTemplate>
                                                </ComboBox.ItemTemplate>
                                            </ComboBox>
                                        </StackPanel>
                                    </Grid>

                                    <WrapPanel DockPanel.Dock="Top" Orientation="Horizontal" ItemSpacing="14" LineSpacing="8" Margin="0,0,0,8" IsVisible="{Binding HasSelectedResult}">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Text="Qualità:" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                            <ComboBox ItemsSource="{Binding AvailableQualities}" SelectedItem="{Binding SelectedQuality, Mode=TwoWay}" MinWidth="160" ToolTip.Tip="Auto seleziona la qualità migliore disponibile. 1080p richiede l'account Premium.">
                                                <ComboBox.ItemTemplate>
                                                    <DataTemplate x:DataType="models:VideoQuality">
                                                        <TextBlock Text="{Binding DisplayName}"/>
                                                    </DataTemplate>
                                                </ComboBox.ItemTemplate>
                                            </ComboBox>
                                        </StackPanel>

                                        <!-- Lingue audio (anche più di una: finiscono tutte nel file) -->
                                        <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding HasAudioTracks}">
                                            <TextBlock Text="Audio:" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                            <DropDownButton Classes="trackPicker" MinWidth="190" ToolTip.Tip="Lingue di doppiaggio da includere nel file. Puoi sceglierne più di una: la prima è quella predefinita.">
                                                <StackPanel Classes="bi">
                                                    <Path Classes="icon accent" Data="{StaticResource IconPlayCircle}"/>
                                                    <TextBlock Text="{Binding AudioSelectionText}" TextTrimming="CharacterEllipsis" MaxWidth="240"/>
                                                </StackPanel>
                                                <DropDownButton.Flyout>
                                                    <Flyout Placement="BottomEdgeAlignedLeft" FlyoutPresenterClasses="trackFlyout">
                                                        <StackPanel Spacing="6" Width="300">
                                                            <Grid ColumnDefinitions="*, Auto" Margin="4,2,4,2">
                                                                <StackPanel Classes="bi">
                                                                    <Path Classes="icon accent" Data="{StaticResource IconPlayCircle}"/>
                                                                    <TextBlock Text="Audio" FontWeight="Bold"/>
                                                                </StackPanel>
                                                                <TextBlock Grid.Column="1" Text="{Binding AudioCountText}" FontSize="11" VerticalAlignment="Center" Foreground="{DynamicResource AppTextMutedBrush}"/>
                                                            </Grid>
                                                            <Border Height="1" Background="{DynamicResource AppBorderBrush}"/>
                                                            <ItemsControl ItemsSource="{Binding AudioTracks}">
                                                                        <ItemsControl.ItemTemplate>
                                                                            <DataTemplate x:DataType="models:MediaTrack">
                                                                                <Border Classes="trackRow">
                                                                                    <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                                                                                        <Grid ColumnDefinitions="*, Auto, Auto">
                                                                                            <TextBlock Text="{Binding Label}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                                                            <Border Grid.Column="1" Classes="trackBadge warn" IsVisible="{Binding IsForced}" Margin="8,0,0,0"><TextBlock Text="forzati"/></Border>
                                                                                            <Border Grid.Column="2" Classes="trackBadge" IsVisible="{Binding HasLanguage}" Margin="8,0,0,0"><TextBlock Text="{Binding Language}"/></Border>
                                                                                        </Grid>
                                                                                    </CheckBox>
                                                                                </Border>
                                                                            </DataTemplate>
                                                                        </ItemsControl.ItemTemplate>
                                                                    </ItemsControl>
                                                            <Border Height="1" Background="{DynamicResource AppBorderBrush}"/>
                                                            <Grid ColumnDefinitions="*, Auto, Auto" Margin="4,0,0,0">
                                                                <TextBlock Text="Nessuna spunta = italiano" FontSize="11" TextWrapping="Wrap" VerticalAlignment="Center" Foreground="{DynamicResource AppTextMutedBrush}"/>
                                                                <Button Grid.Column="1" Classes="ghost" Padding="10,4" FontSize="11" Command="{Binding SelectAllAudioCommand}" ToolTip.Tip="Seleziona tutte">Tutte</Button>
                                                                <Button Grid.Column="2" Classes="ghost" Padding="10,4" FontSize="11" Command="{Binding SelectNoAudioCommand}" ToolTip.Tip="Togli tutte le spunte">Nessuna</Button>
                                                            </Grid>
                                                        </StackPanel>
                                                    </Flyout>
                                                </DropDownButton.Flyout>
                                            </DropDownButton>
                                        </StackPanel>

                                        <!-- Sottotitoli -->
                                        <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding HasSubtitleTracks}">
                                            <TextBlock Text="Sottotitoli:" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                            <DropDownButton Classes="trackPicker" MinWidth="170" ToolTip.Tip="Sottotitoli da includere nel file come tracce attivabili dal player">
                                                <StackPanel Classes="bi">
                                                    <Path Classes="icon accent" Data="{StaticResource IconList}"/>
                                                    <TextBlock Text="{Binding SubtitleSelectionText}" TextTrimming="CharacterEllipsis" MaxWidth="240"/>
                                                </StackPanel>
                                                <DropDownButton.Flyout>
                                                    <Flyout Placement="BottomEdgeAlignedLeft" FlyoutPresenterClasses="trackFlyout">
                                                        <StackPanel Spacing="6" Width="300">
                                                            <Grid ColumnDefinitions="*, Auto" Margin="4,2,4,2">
                                                                <StackPanel Classes="bi">
                                                                    <Path Classes="icon accent" Data="{StaticResource IconList}"/>
                                                                    <TextBlock Text="Sottotitoli" FontWeight="Bold"/>
                                                                </StackPanel>
                                                                <TextBlock Grid.Column="1" Text="{Binding SubtitleCountText}" FontSize="11" VerticalAlignment="Center" Foreground="{DynamicResource AppTextMutedBrush}"/>
                                                            </Grid>
                                                            <Border Height="1" Background="{DynamicResource AppBorderBrush}"/>
                                                            <ScrollViewer MaxHeight="210" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                                                    <ItemsControl ItemsSource="{Binding SubtitleTracks}">
                                                                        <ItemsControl.ItemTemplate>
                                                                            <DataTemplate x:DataType="models:MediaTrack">
                                                                                <Border Classes="trackRow">
                                                                                    <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                                                                                        <Grid ColumnDefinitions="*, Auto, Auto">
                                                                                            <TextBlock Text="{Binding Label}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                                                            <Border Grid.Column="1" Classes="trackBadge warn" IsVisible="{Binding IsForced}" Margin="8,0,0,0"><TextBlock Text="forzati"/></Border>
                                                                                            <Border Grid.Column="2" Classes="trackBadge" IsVisible="{Binding HasLanguage}" Margin="8,0,0,0"><TextBlock Text="{Binding Language}"/></Border>
                                                                                        </Grid>
                                                                                    </CheckBox>
                                                                                </Border>
                                                                            </DataTemplate>
                                                                        </ItemsControl.ItemTemplate>
                                                                    </ItemsControl>
                                                                    </ScrollViewer>
                                                            <Border Height="1" Background="{DynamicResource AppBorderBrush}"/>
                                                            <Grid ColumnDefinitions="*, Auto, Auto" Margin="4,0,0,0">
                                                                <TextBlock Text="Tracce attivabili dal player" FontSize="11" TextWrapping="Wrap" VerticalAlignment="Center" Foreground="{DynamicResource AppTextMutedBrush}"/>
                                                                <Button Grid.Column="1" Classes="ghost" Padding="10,4" FontSize="11" Command="{Binding SelectAllSubtitlesCommand}" ToolTip.Tip="Seleziona tutte">Tutte</Button>
                                                                <Button Grid.Column="2" Classes="ghost" Padding="10,4" FontSize="11" Command="{Binding SelectNoSubtitlesCommand}" ToolTip.Tip="Togli tutte le spunte">Nessuna</Button>
                                                            </Grid>
                                                        </StackPanel>
                                                    </Flyout>
                                                </DropDownButton.Flyout>
                                            </DropDownButton>
                                            <CheckBox Content="Imprimi nel video" IsChecked="{Binding BurnSubtitles, Mode=TwoWay}" VerticalAlignment="Center"
                                                      ToolTip.Tip="Il primo sottotitolo scelto viene disegnato nell'immagine (sempre visibile, anche su TV e player senza sottotitoli). Richiede la ricodifica del video: l'unione finale è molto più lenta."/>
                                        </StackPanel>
                                    </WrapPanel>

                                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="6" Margin="0,0,0,8" IsVisible="{Binding IsSelectedResultSeries}">
                                        <Button ToolTip.Tip="Accoda tutti gli episodi spuntati (quelli già in coda vengono saltati)" Classes="success" Command="{Binding DownloadSelectedEpisodesCommand}" IsEnabled="{Binding CanInteractWithEpisodes}"><StackPanel Classes="bi"><Path Classes="icon" Data="{StaticResource IconDownload}"/><TextBlock Text="Scarica selezionati"/></StackPanel></Button>
                                        <Button Classes="accent" Command="{Binding DownloadCurrentSeasonCommand}" IsEnabled="{Binding CanInteractWithEpisodes}" ToolTip.Tip="Accoda tutti gli episodi della stagione corrente"><StackPanel Classes="bi"><Path Classes="icon" Data="{StaticResource IconDownload}"/><TextBlock Text="Scarica stagione"/></StackPanel></Button>
                                        <Button Classes="info" Command="{Binding DownloadAllSeasonsCommand}" IsEnabled="{Binding CanInteractWithEpisodes}" ToolTip.Tip="Accoda tutti gli episodi di tutte le stagioni"><StackPanel Classes="bi"><Path Classes="icon" Data="{StaticResource IconLayers}"/><TextBlock Text="Scarica tutta la serie"/></StackPanel></Button>
                                        <Button ToolTip.Tip="Seleziona tutti gli episodi della lista" Content="Seleziona tutti" Click="OnStreamingSelectAllEpisodesClick" IsEnabled="{Binding CanInteractWithEpisodes}"/>
                                        <Button ToolTip.Tip="Toglie la selezione a tutti gli episodi" Content="Deseleziona" Click="OnStreamingDeselectAllEpisodesClick" IsEnabled="{Binding CanInteractWithEpisodes}"/>
                                        <Button ToolTip.Tip="Inverte la selezione degli episodi" Content="Inverti" Click="OnStreamingInvertEpisodeSelectionClick" IsEnabled="{Binding CanInteractWithEpisodes}"/>
                                        <Button ToolTip.Tip="Interrompe l'accodamento in corso (gli episodi già accodati restano in coda)" Classes="danger" Command="{Binding CancelBatchCommand}" IsVisible="{Binding IsBatchActive}"><StackPanel Classes="bi"><Path Classes="icon" Data="{StaticResource IconStop}"/><TextBlock Text="Stop accodamento"/></StackPanel></Button>
                                    </StackPanel>

                                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="6" Margin="0,0,0,8" IsVisible="{Binding IsSelectedResultMovie}">
                                        <Button ToolTip.Tip="Accoda il film selezionato" Classes="success" Command="{Binding DownloadMovieCommand}" CommandParameter="{Binding SelectedResult}" IsEnabled="{Binding CanDownloadMovie}"><StackPanel Classes="bi"><Path Classes="icon" Data="{StaticResource IconDownload}"/><TextBlock Text="Scarica film"/></StackPanel></Button>
                                    </StackPanel>

                                    <DataGrid Name="StreamingEpisodesGrid" ItemsSource="{Binding Episodes}" AutoGenerateColumns="False" SelectionMode="Extended" IsReadOnly="False" IsVisible="{Binding IsSelectedResultSeries}" SelectionChanged="OnStreamingEpisodesSelectionChanged" CanUserResizeColumns="True" CanUserReorderColumns="True" CanUserSortColumns="False">
                                        <DataGrid.Columns>
                                            <DataGridTemplateColumn Header="" Width="40">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTextColumn Header="N." Binding="{Binding Number}" Width="60"/>
                                            <DataGridTextColumn Header="Titolo" Binding="{Binding Title}" Width="*"/>
                                        </DataGrid.Columns>
                                    </DataGrid>

                                    <TextBlock Text="Seleziona un risultato e premi doppio click per i dettagli." FontStyle="Italic" Foreground="{DynamicResource AppTextMutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding !HasSelectedResult}"/>
                                </DockPanel>
                            </Border>
                        </Grid>

                        <Border Classes="cardElevated" Height="550" Margin="0,0,0,12">
                            <DockPanel>
                                <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto, *" Margin="0,0,0,8">
                                    <StackPanel Grid.Column="0" Classes="bi" VerticalAlignment="Center">
                                        <Path Classes="icon accent" Data="{StaticResource IconDownload}"/>
                                        <TextBlock Text="Download per serie (Film/Serie)" FontWeight="Bold" FontSize="14"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{Binding SeriesSummaryText}" FontSize="12" Foreground="{DynamicResource AppTextMutedBrush}" Margin="12,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                </Grid>
                                <Border DockPanel.Dock="Top" Background="{DynamicResource AppSurface2Brush}" CornerRadius="8" Padding="12" Margin="0,0,0,10">
                                    <StackPanel Spacing="10">
                                        <WrapPanel Orientation="Horizontal" ItemSpacing="8" LineSpacing="6">
                                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Margin="0,0,10,0" ToolTip.Tip="Segmenti scaricati contemporaneamente per ogni film/episodio (divisi tra video e tracce audio). Più alto = più veloce; se il server dà errori 503 o rallenta, abbassalo">
                                                <TextBlock Text="Segmenti paralleli" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                <Slider Value="{Binding ConcurrentFragments}" Minimum="4" Maximum="64" Width="120" TickFrequency="4" IsSnapToTickEnabled="True" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding ConcurrentFragments}" Width="24" VerticalAlignment="Center" HorizontalAlignment="Center" FontWeight="Bold" Foreground="{DynamicResource AppAccentBrush}"/>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Margin="0,0,10,0" ToolTip.Tip="Quanti film/episodi scaricare insieme. Gli slot sono separati da quelli della tab Anime">
                                                <TextBlock Text="Download paralleli" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                <Slider Value="{Binding MaxConcurrency}" Minimum="1" Maximum="20" Width="140" TickFrequency="1" IsSnapToTickEnabled="True" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding MaxConcurrency}" Width="24" VerticalAlignment="Center" HorizontalAlignment="Center" FontWeight="Bold" Foreground="{DynamicResource AppAccentBrush}"/>
                                            </StackPanel>
                                            <Button ToolTip.Tip="Avvia tutti i download di film e serie in attesa o in pausa" Classes="success" Command="{Binding StartAllCommand}"><StackPanel Classes="bi"><Path Classes="icon" Data="{StaticResource IconPlay}"/><TextBlock Text="Avvia tutti"/></StackPanel></Button>
                                            <Button ToolTip.Tip="Mette in pausa tutti i download di film e serie in corso" Classes="warning" Command="{Binding PauseAllCommand}"><StackPanel Classes="bi"><Path Classes="icon" Data="{StaticResource IconPause}"/><TextBlock Text="Pausa tutti"/></StackPanel></Button>
                                            <Button ToolTip.Tip="Annulla tutti i download di film e serie non ancora completati" Classes="danger" Command="{Binding CancelAllDownloadsCommand}"><StackPanel Classes="bi"><Path Classes="icon" Data="{StaticResource IconClose}"/><TextBlock Text="Annulla tutti"/></StackPanel></Button>
                                            <Button ToolTip.Tip="Ferma e rimuove dalla lista TUTTI i download di film e serie (i file già scaricati restano su disco)" Command="{Binding DeleteEverythingCommand}"><StackPanel Classes="bi"><Path Classes="icon" Data="{StaticResource IconTrash}"/><TextBlock Text="Elimina tutti"/></StackPanel></Button>
                                            <Button ToolTip.Tip="Rimuove dalla lista i download completati (i file restano su disco)" Command="{Binding ClearCompletedCommand}"><StackPanel Classes="bi"><Path Classes="icon" Data="{StaticResource IconCheckCircle}"/><TextBlock Text="Completati"/></StackPanel></Button>
                                            <Button ToolTip.Tip="Rimuove dalla lista i download annullati" Command="{Binding ClearCancelledDownloadsCommand}"><StackPanel Classes="bi"><Path Classes="icon" Data="{StaticResource IconBan}"/><TextBlock Text="Annullati"/></StackPanel></Button>
                                            <Button ToolTip.Tip="Rimuove dalla lista i download falliti" Command="{Binding ClearFailedDownloadsCommand}"><StackPanel Classes="bi"><Path Classes="icon" Data="{StaticResource IconAlertCircle}"/><TextBlock Text="Failed"/></StackPanel></Button>
                                        </WrapPanel>
                                        <StackPanel Orientation="Horizontal" Spacing="24">
                                            <TextBlock FontSize="12" Foreground="{DynamicResource AppTextMutedBrush}">
                                                <Run Text="Totale:" FontWeight="Bold"/>
                                                <Run Text="{Binding GlobalSizeText}"/>
                                            </TextBlock>
                                            <TextBlock FontSize="12" Foreground="{DynamicResource AppSuccessBrush}">
                                                <Run Text="Velocità:" FontWeight="Bold"/>
                                                <Run Text="{Binding GlobalSpeedText}"/>
                                            </TextBlock>
                                            <TextBlock FontSize="12" Foreground="{DynamicResource AppTextMutedBrush}">
                                                <Run Text="ETA:" FontWeight="Bold"/>
                                                <Run Text="{Binding GlobalEtaText}"/>
                                            </TextBlock>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                    <ItemsControl ItemsSource="{Binding SeriesGroups}" HorizontalAlignment="Stretch">
                                        <ItemsControl.Styles>
                                            <Style Selector="ItemsControl > ContentPresenter">
                                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                            </Style>
                                        </ItemsControl.Styles>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="models:SeriesGroup">
                                                <Expander Theme="{StaticResource DownloadGroupExpanderTheme}" IsExpanded="{Binding IsExpanded, Mode=TwoWay}">
                                                    <Expander.Header>
                                                        <Grid ColumnDefinitions="2*, 130, 110, 1.5*, 100, Auto">
                                                            <TextBlock Grid.Column="0" Text="{Binding Header}" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,10,0"/>
                                                            <TextBlock Grid.Column="1" Text="{Binding TotalSizeText}" VerticalAlignment="Center" FontSize="11" Foreground="{DynamicResource AppTextMutedBrush}" Margin="0,0,10,0"/>
                                                            <TextBlock Grid.Column="2" Text="{Binding TotalSpeedText}" VerticalAlignment="Center" FontSize="11" Foreground="{DynamicResource AppSuccessBrush}" Margin="0,0,10,0"/>
                                                            <Grid Grid.Column="3" ColumnDefinitions="*, Auto" Margin="10,0">
                                                                <ProgressBar Grid.Column="0" Value="{Binding OverallPercentage}" Minimum="0" Maximum="100" Height="14"/>
                                                                <TextBlock Grid.Column="1" Text="{Binding OverallPercentage, StringFormat={}{0:F1}%}" Margin="8,0,0,0" VerticalAlignment="Center" FontSize="11" FontWeight="SemiBold"/>
                                                            </Grid>
                                                            <TextBlock Grid.Column="4" Text="{Binding OverallEtaText}" VerticalAlignment="Center" FontSize="11" Foreground="{DynamicResource AppTextMutedBrush}" Margin="10,0"/>
                                                            <StackPanel Grid.Column="5" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                                                <Button Classes="iconCircle success" Width="30" Height="30" ToolTip.Tip="Avvia serie" Click="OnStreamingResumeGroupClick"><Path Classes="icon" Data="{StaticResource IconPlay}"/></Button>
                                                                <Button Classes="iconCircle" Width="30" Height="30" ToolTip.Tip="Forza priorità serie" Click="OnStreamingForceGroupClick"><Path Classes="icon" Data="{StaticResource IconBolt}"/></Button>
                                                                <Button Classes="iconCircle" Width="30" Height="30" ToolTip.Tip="Rimuovi priorità serie" Click="OnStreamingUnforceGroupClick"><Path Classes="icon" Data="{StaticResource IconBoltOff}"/></Button>
                                                                <Button Classes="iconCircle danger" Width="30" Height="30" ToolTip.Tip="Annulla serie" Click="OnStreamingCancelGroupClick"><Path Classes="icon" Data="{StaticResource IconClose}"/></Button>
                                                                <Button Classes="iconCircle" Width="30" Height="30" ToolTip.Tip="Rimuovi serie" Click="OnStreamingRemoveGroupClick"><Path Classes="icon" Data="{StaticResource IconTrash}"/></Button>
                                                                <Button Classes="iconCircle" Width="30" Height="30" ToolTip.Tip="Riscarica failed" IsVisible="{Binding HasFailed}" Click="OnStreamingRetryFailedGroupClick"><Path Classes="icon" Data="{StaticResource IconRefresh}"/></Button>
                                                            </StackPanel>
                                                        </Grid>
                                                    </Expander.Header>
                                                    <ItemsControl ItemsSource="{Binding ExpandedItems}" HorizontalAlignment="Stretch">
                                                        <ItemsControl.Styles>
                                                            <Style Selector="ItemsControl > ContentPresenter">
                                                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                                            </Style>
                                                        </ItemsControl.Styles>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate DataType="models:DownloadItem">
                                                                <Border Padding="10,7" Background="{DynamicResource DownloadGroupRowBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="0,0,0,1">
                                                                    <Grid ColumnDefinitions="24, 2*, 50, 110, 2*, 160, 90, 90, Auto">
                                                                        <Path Grid.Column="0" Classes="icon warn" Width="13" Height="13" HorizontalAlignment="Left" Data="{StaticResource IconBolt}" IsVisible="{Binding IsPriority}"/>
                                                                        <TextBlock Grid.Column="1" Text="{Binding FileName}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" FontWeight="Medium"/>
                                                                        <TextBlock Grid.Column="2" Text="{Binding EpisodeNumber}" VerticalAlignment="Center"/>
                                                                        <TextBlock Grid.Column="3" Text="{Binding Status}" VerticalAlignment="Center" FontSize="11" Foreground="{DynamicResource AppTextMutedBrush}"/>
                                                                        <Grid Grid.Column="4" ColumnDefinitions="*, 44" Margin="0,0,12,0">
                                                                            <ProgressBar Value="{Binding Percentage}" Minimum="0" Maximum="100" Height="14"/>
                                                                            <TextBlock Grid.Column="1" Text="{Binding Percentage, StringFormat={}{0:F0}%}" TextAlignment="Right" VerticalAlignment="Center" FontSize="11"/>
                                                                        </Grid>
                                                                        <TextBlock Grid.Column="5" Text="{Binding SizeText}" VerticalAlignment="Center" FontSize="11" Foreground="{DynamicResource AppTextMutedBrush}" Margin="0,0,15,0"/>
                                                                        <TextBlock Grid.Column="6" Text="{Binding SpeedText}" VerticalAlignment="Center" FontSize="11" Foreground="{DynamicResource AppSuccessBrush}" Margin="0,0,15,0"/>
                                                                        <TextBlock Grid.Column="7" Text="{Binding EtaText}" VerticalAlignment="Center" FontSize="11" Foreground="{DynamicResource AppTextMutedBrush}" Margin="0,0,15,0"/>
                                                                        <StackPanel Grid.Column="8" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center" Margin="8,0,0,0">
                                                                            <Button Classes="iconCircle success" Width="26" Height="26" ToolTip.Tip="Riprendi" IsVisible="{Binding CanResume}" Click="OnStreamingDownloadItemResumeClick"><Path Classes="icon" Width="12" Height="12" Data="{StaticResource IconPlay}"/></Button>
                                                                            <Button Classes="iconCircle" Width="26" Height="26" ToolTip.Tip="Forza priorità" IsVisible="{Binding CanForce}" Click="OnStreamingDownloadItemForceClick"><Path Classes="icon" Width="12" Height="12" Data="{StaticResource IconBolt}"/></Button>
                                                                            <Button Classes="iconCircle danger" Width="26" Height="26" ToolTip.Tip="Annulla" IsVisible="{Binding CanCancel}" Click="OnStreamingDownloadItemCancelClick"><Path Classes="icon" Width="12" Height="12" Data="{StaticResource IconClose}"/></Button>
                                                                            <Button Classes="iconCircle" Width="26" Height="26" ToolTip.Tip="Riscarica" IsVisible="{Binding CanRetry}" Click="OnStreamingDownloadItemRetryClick"><Path Classes="icon" Width="12" Height="12" Data="{StaticResource IconRefresh}"/></Button>
                                                                            <Button Classes="iconCircle danger" Width="26" Height="26" ToolTip.Tip="Rimuovi" Click="OnStreamingDownloadItemRemoveClick"><Path Classes="icon" Width="12" Height="12" Data="{StaticResource IconTrash}"/></Button>
                                                                        </StackPanel>
                                                                    </Grid>
                                                                </Border>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </Expander>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </DockPanel>
                        </Border>
                    </StackPanel>
                    </ScrollViewer>
                </Panel>
                <Panel IsVisible="{Binding #MainTabs.SelectedIndex, Converter={x:Static vm:IndexEqualsConverter.Default}, ConverterParameter=2}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" DataContext="{Binding Account}">
                        <StackPanel Margin="0,10,0,0" Spacing="12">

                            <!-- STATUS -->
                            <ContentControl Theme="{StaticResource StatusBannerTheme}" Content="{Binding StatusMessage}"/>

                            <!-- GUIDA ACCOUNT -->
                            <Border Classes="cardElevated" Margin="0,0,0,12" Padding="0" ClipToBounds="True">
                                <StackPanel>
                                    <ToggleButton Classes="guideToggle" x:Name="ToggleGuideAccount" IsChecked="False">
                                        <Grid ColumnDefinitions="*, Auto">
                                            <StackPanel Classes="bi" VerticalAlignment="Center">
                                                <Path Classes="icon accent" Data="{StaticResource IconBulb}"/>
                                                <TextBlock Text="Guida rapida - Account" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource AppTextBrush}"/>
                                            </StackPanel>
                                            <Path Grid.Column="1" Classes="chevron"/>
                                        </Grid>
                                    </ToggleButton>
                                    <Border IsVisible="{Binding #ToggleGuideAccount.IsChecked}" Background="Transparent" Margin="16,0,16,16" Padding="12">
                                        <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource AppTextMutedBrush}">
                                            <Run FontWeight="Bold" Foreground="{DynamicResource AppTextBrush}">A cosa serve</Run><LineBreak/>
                                            Collega il tuo account StreamingCommunity per scaricare in 1080p (serve un account Premium). Senza login i download funzionano comunque, in qualità standard.<LineBreak/>
                                            <LineBreak/>
                                            <Run FontWeight="Bold" Foreground="{DynamicResource AppTextBrush}">Come si usa</Run><LineBreak/>
                                            <Run FontWeight="SemiBold" Foreground="{DynamicResource AppTextBrush}">• Accedi:</Run> inserisci username (o email) e password e premi Accedi. La sessione viene salvata e riusata ai prossimi avvii.<LineBreak/>
                                            <Run FontWeight="SemiBold" Foreground="{DynamicResource AppTextBrush}">• Disconnetti:</Run> cancella la sessione salvata. Usalo se cambi account o se il login risulta scaduto.<LineBreak/>
                                            <LineBreak/>
                                            <Run FontWeight="Bold" Foreground="{DynamicResource AppTextBrush}">Sicurezza e rete</Run><LineBreak/>
                                            <Run FontWeight="SemiBold" Foreground="{DynamicResource AppTextBrush}">• Cifratura:</Run> le credenziali sono cifrate con DPAPI di Windows: solo il tuo utente può leggerle e non vengono mai salvate in chiaro.<LineBreak/>
                                            <Run FontWeight="SemiBold" Foreground="{DynamicResource AppTextBrush}">• Proxy:</Run> il login passa dal proxy attivo per StreamingCommunity (tab Proxy), così l'IP è lo stesso dei download.<LineBreak/>
                                            <Run FontWeight="SemiBold" Foreground="{DynamicResource AppTextBrush}">• Problemi:</Run> se il login fallisce, controlla nella tab Domini che il dominio di StreamingCommunity sia raggiungibile.
                                        </TextBlock>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <Border Classes="cardElevated" Padding="16">
                                <StackPanel Spacing="6">
                                    <TextBlock Text="{Binding SessionBadge}" FontWeight="Bold" FontSize="16"/>
                                    <TextBlock Text="{Binding SessionDetails}" FontSize="12" Foreground="{DynamicResource AppTextMutedBrush}" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>

                            <Border Classes="cardElevated" Padding="16">
                                <StackPanel Spacing="10">
                                    <TextBlock Text="StreamingCommunity — Account" FontWeight="Bold" FontSize="14"/>
                                    <Grid ColumnDefinitions="120, *" RowDefinitions="Auto, Auto">
                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Username / Email" VerticalAlignment="Center" Margin="0,0,10,8" ToolTip.Tip="La tua email o username di StreamingCommunity"/>
                                        <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding Username, Mode=TwoWay}" Margin="0,0,0,8"/>
                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Password" VerticalAlignment="Center" Margin="0,0,10,0" ToolTip.Tip="La tua password. Verrà salvata cifrata nel PC."/>
                                        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Password, Mode=TwoWay}" PasswordChar="•"/>
                                    </Grid>

                                    <WrapPanel Orientation="Horizontal" ItemSpacing="8">
                                        <Button ToolTip.Tip="Accedi a StreamingCommunity con le credenziali inserite" Classes="success" Command="{Binding LoginCommand}" IsEnabled="{Binding !IsBusy}" IsVisible="{Binding !IsLoggedIn}"><StackPanel Classes="bi"><Path Classes="icon" Data="{StaticResource IconKey}"/><TextBlock Text="Accedi"/></StackPanel></Button>
                                        <Button Command="{Binding ReloadCredentialsCommand}" IsEnabled="{Binding !IsBusy}" IsVisible="{Binding !IsLoggedIn}" ToolTip.Tip="Ricarica nei campi le credenziali salvate (DPAPI)"><StackPanel Classes="bi"><Path Classes="icon" Data="{StaticResource IconUnlock}"/><TextBlock Text="Ricarica credenziali"/></StackPanel></Button>
                                        <Button Command="{Binding SaveCredentialsCommand}" IsEnabled="{Binding !IsBusy}" ToolTip.Tip="Salva le credenziali in modo sicuro per il prossimo avvio"><StackPanel Classes="bi"><Path Classes="icon" Data="{StaticResource IconSave}"/><TextBlock Text="Salva credenziali"/></StackPanel></Button>
                                        <Button Classes="info" Command="{Binding TestSessionCommand}" IsEnabled="{Binding !IsBusy}" ToolTip.Tip="Verifica se i cookie di sessione sono ancora validi"><StackPanel Classes="bi"><Path Classes="icon" Data="{StaticResource IconSearch}"/><TextBlock Text="Testa sessione"/></StackPanel></Button>
                                        <Button ToolTip.Tip="Esci dall'account e cancella la sessione salvata" Classes="warning" Command="{Binding LogoutCommand}" IsVisible="{Binding IsLoggedIn}"><StackPanel Classes="bi"><Path Classes="icon" Data="{StaticResource IconLogOut}"/><TextBlock Text="Disconnetti"/></StackPanel></Button>
                                        <Button Classes="danger" Command="{Binding DeleteCredentialsCommand}" IsEnabled="{Binding !IsBusy}" IsVisible="{Binding HasSavedCredentials}" ToolTip.Tip="Rimuove definitivamente username e password dal DPAPI"><StackPanel Classes="bi"><Path Classes="icon" Data="{StaticResource IconTrash}"/><TextBlock Text="Elimina credenziali"/></StackPanel></Button>
                                        <Button ToolTip.Tip="Accesso in corso, attendi..." Classes="danger" IsVisible="{Binding IsBusy}" IsEnabled="False"><StackPanel Classes="bi"><Path Classes="icon" Data="{StaticResource IconStop}"/><TextBlock Text="Stop"/></StackPanel></Button>
                                    </WrapPanel>
                                </StackPanel>
                            </Border>

                            <Border Classes="cardElevated" Padding="16">
                                <StackPanel Spacing="6">
                                    <StackPanel Classes="bi">
                                        <Path Classes="icon accent" Data="{StaticResource IconInfo}"/>
                                        <TextBlock Text="Note" FontWeight="Bold"/>
                                    </StackPanel>
                                    <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource AppTextMutedBrush}">
                                        Le credenziali vengono salvate cifrate (DPAPI Windows) nella cartella dell'utente. Il login viene eseguito via HTTPS verso StreamingCommunity; i cookie di sessione vengono riutilizzati per i download. Con account Premium la qualità disponibile sale fino a 1080p.
                                    </TextBlock>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Panel>
                <Panel IsVisible="{Binding #MainTabs.SelectedIndex, Converter={x:Static vm:IndexEqualsConverter.Default}, ConverterParameter=3}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" DataContext="{Binding Organizer}">
                    <DockPanel Margin="0,10,0,0">
                        <ContentControl DockPanel.Dock="Top" Theme="{StaticResource StatusBannerTheme}" Content="{Binding CurrentStatusMessage}" IsVisible="{Binding CurrentStatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>

                        <!-- GUIDA ORGANIZER -->
                        <Border DockPanel.Dock="Top" Classes="cardElevated" Margin="0,0,0,12" Padding="0" ClipToBounds="True">
                            <StackPanel>
                                <ToggleButton Classes="guideToggle" x:Name="ToggleGuideOrganizer" IsChecked="False">
                                    <Grid ColumnDefinitions="*, Auto">
                                        <StackPanel Classes="bi" VerticalAlignment="Center">
                                            <Path Classes="icon accent" Data="{StaticResource IconBulb}"/>
                                            <TextBlock Text="Guida rapida - Organizza File" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource AppTextBrush}"/>
                                        </StackPanel>
                                        <Path Grid.Column="1" Classes="chevron"/>
                                    </Grid>
                                </ToggleButton>
                                <Border IsVisible="{Binding #ToggleGuideOrganizer.IsChecked}" Background="Transparent" Margin="16,0,16,16" Padding="12">
                                    <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource AppTextMutedBrush}">
                                        <Run FontWeight="Bold" Foreground="{DynamicResource AppTextBrush}">A cosa serve</Run><LineBreak/>
                                        Rinomina, unisce e divide cartelle di episodi in blocco, sia sul PC (Locale) sia sul server (Remoto, serve la connessione SFTP). Ogni operazione si vede prima in anteprima e si può annullare.<LineBreak/>
                                        <LineBreak/>
                                        <Run FontWeight="Bold" Foreground="{DynamicResource AppTextBrush}">Le tre modalità</Run><LineBreak/>
                                        <Run FontWeight="SemiBold" Foreground="{DynamicResource AppTextBrush}">• Singola cartella:</Run> rinomina i file di una cartella secondo il pattern (es. "ep1.mp4" diventa "Naruto - 001.mp4"). "Episodio iniziale" fissa il numero da cui partire.<LineBreak/>
                                        <Run FontWeight="SemiBold" Foreground="{DynamicResource AppTextBrush}">• Unisci cartelle:</Run> prende i file da più cartelle, nell'ordine dell'elenco, e li sposta in un'unica destinazione rinumerandoli in sequenza.<LineBreak/>
                                        <Run FontWeight="SemiBold" Foreground="{DynamicResource AppTextBrush}">• Dividi cartella:</Run> divide una cartella con molti episodi in sottocartelle: in parti uguali (es. 50 episodi per cartella) oppure a segmenti personalizzati.<LineBreak/>
                                        <LineBreak/>
                                        <Run FontWeight="Bold" Foreground="{DynamicResource AppTextBrush}">Flusso consigliato</Run><LineBreak/>
                                        <Run FontWeight="SemiBold" Foreground="{DynamicResource AppTextBrush}">• 1. Anteprima:</Run> calcola le operazioni senza toccare nulla; la colonna Conflitto segnala nomi già esistenti o duplicati.<LineBreak/>
                                        <Run FontWeight="SemiBold" Foreground="{DynamicResource AppTextBrush}">• 2. Applica:</Run> esegue le operazioni. Se ci sono conflitti l'app si ferma e non applica niente.<LineBreak/>
                                        <Run FontWeight="SemiBold" Foreground="{DynamicResource AppTextBrush}">• 3. Undo:</Run> annulla l'ultimo gruppo di operazioni applicate. La cronologia in basso elenca tutto ciò che è stato fatto.<LineBreak/>
                                        <LineBreak/>
                                        <Run FontWeight="Bold" Foreground="{DynamicResource AppTextBrush}">Segnaposto del pattern</Run><LineBreak/>
                                        {Series} nome della serie · {Episode} o {Episode:D3} numero episodio · {Title} titolo · {Number} numero della sottocartella (Dividi). Una "/" nel pattern crea una sottocartella.
                                    </TextBlock>
                                </Border>
                            </StackPanel>
                        </Border>

                        <Border DockPanel.Dock="Top" Classes="cardElevated" Margin="0,0,0,12">
                            <StackPanel Orientation="Horizontal" Spacing="20">
                                <TextBlock Text="Modalità:" FontWeight="Bold" VerticalAlignment="Center" FontSize="14"/>
                                <RadioButton GroupName="OrganizeMode" IsChecked="{Binding OrganizeModeIsLocal}"><StackPanel Classes="bi"><Path Classes="icon" Data="{StaticResource IconMonitor}"/><TextBlock Text="Locale"/></StackPanel></RadioButton>
                                <RadioButton GroupName="OrganizeMode" IsChecked="{Binding !OrganizeModeIsLocal}" IsEnabled="{Binding IsSftpConnected}"><StackPanel Classes="bi"><Path Classes="icon" Data="{StaticResource IconCloud}"/><TextBlock Text="Remoto (SFTP)"/></StackPanel></RadioButton>
                                <TextBlock Text="(connetti SFTP per abilitare la modalità Remoto)" FontStyle="Italic" FontSize="11" VerticalAlignment="Center" Foreground="{DynamicResource AppTextMutedBrush}" IsVisible="{Binding !IsSftpConnected}"/>
                            </StackPanel>
                        </Border>

                        <DockPanel>
                            <TabControl x:Name="OrganizerTabs" SelectedIndex="{Binding SelectedSubTabIndex}" DockPanel.Dock="Top">
                                <!-- ===== SINGOLA CARTELLA ===== -->
                                <TabItem Header="Singola cartella"/>

                                <!-- ===== UNISCI CARTELLE ===== -->
                                <TabItem Header="Unisci cartelle"/>

                                <!-- ===== DIVIDI CARTELLA ===== -->
                                <TabItem Header="Dividi cartella"/>
                            </TabControl>
                            <!-- Contenuti sempre nel visual tree: cambiando tab restano scroll e stato -->
                            <Panel ClipToBounds="True">
                                <Panel IsVisible="{Binding #OrganizerTabs.SelectedIndex, Converter={x:Static vm:IndexEqualsConverter.Default}, ConverterParameter=0}">
                                    <DockPanel Margin="0,10,0,0">
                                        <Border DockPanel.Dock="Top" Classes="cardElevated" Margin="0,0,0,12">
                                            <StackPanel Spacing="10">
                                                <Grid ColumnDefinitions="Auto, *, Auto">
                                                    <TextBlock Grid.Column="0" Text="{Binding OrganizeFolderLabel}" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,10,0"/>
                                                    <TextBox Grid.Column="1" Text="{Binding OrganizeFolder}" Margin="0,0,8,0"/>
                                                    <Button Grid.Column="2" Classes="iconCircle" ToolTip.Tip="Sfoglia cartelle" Click="OnBrowseOrganizeFolderClick" IsVisible="{Binding OrganizeModeIsLocal}"><Path Classes="icon" Data="{StaticResource IconFolder}"/></Button>
                                                    <Button Grid.Column="2" Classes="iconCircle" ToolTip.Tip="Sfoglia cartelle remote" Click="OnBrowseOrganizeFolderRemoteClick" IsVisible="{Binding !OrganizeModeIsLocal}"><Path Classes="icon" Data="{StaticResource IconFolder}"/></Button>
                                                </Grid>

                                                <Grid ColumnDefinitions="Auto, *, Auto">
                                                    <TextBlock Grid.Column="0" Text="Pattern" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,10,0" ToolTip.Tip="Usa {Number} per il numero sequenziale o {OriginalName} per il nome originale"/>
                                                    <ComboBox Grid.Column="1" IsEditable="True" ItemsSource="{Binding OrganizePatterns}" Text="{Binding OrganizePattern, Mode=TwoWay}" HorizontalAlignment="Stretch" Margin="0,0,10,0"/>
                                                    <Border Grid.Column="2" Background="{DynamicResource AppSurface2Brush}" BorderBrush="{DynamicResource AppAccentBrush}" BorderThickness="1" CornerRadius="6" Padding="10,4" MaxWidth="380">
                                                        <TextBlock Text="{Binding OrganizePatternPreview}" FontFamily="Consolas,Menlo,monospace" Foreground="{DynamicResource AppAccentBrush}" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                    </Border>
                                                </Grid>

                                                <StackPanel Orientation="Horizontal" Spacing="10">
                                                    <TextBlock Text="Episodio iniziale:" VerticalAlignment="Center" FontWeight="SemiBold" ToolTip.Tip="Da che numero vuoi iniziare a contare? (es. 1 o 15)"/>
                                                    <TextBox Text="{Binding OrganizeStartingEpisode, Mode=TwoWay}" Width="80"/>
                                                    <TextBlock Text="(default 1)" FontStyle="Italic" Foreground="{DynamicResource AppTextMutedBrush}" VerticalAlignment="Center"/>
                                                </StackPanel>

                                                <WrapPanel Orientation="Horizontal" ItemSpacing="8" LineSpacing="6">
                                                    <Button ToolTip.Tip="Calcola le rinomine senza modificare nulla: controlla la tabella prima di applicare" Classes="info" Command="{Binding PreviewOrganizeCommand}" IsEnabled="{Binding !IsOrganizeBusy}"><StackPanel Classes="bi"><Path Classes="icon" Data="{StaticResource IconEye}"/><TextBlock Text="Anteprima"/></StackPanel></Button>
                                                    <Button ToolTip.Tip="Esegue le operazioni proposte (annullabili con Undo)" Classes="success" Command="{Binding ApplyOrganizeCommand}" IsEnabled="{Binding !IsOrganizeBusy}"><StackPanel Classes="bi"><Path Classes="icon" Data="{StaticResource IconCheck}"/><TextBlock Text="Applica"/></StackPanel></Button>
                                                    <Button ToolTip.Tip="Annulla l'ultimo gruppo di operazioni applicate (rinomine/spostamenti)" Classes="warning" Command="{Binding UndoLastBatchCommand}" IsEnabled="{Binding !IsOrganizeBusy}"><StackPanel Classes="bi"><Path Classes="icon" Data="{StaticResource IconUndo}"/><TextBlock Text="Undo ultimo batch"/></StackPanel></Button>
                                                    <Button ToolTip.Tip="Svuota la tabella delle operazioni proposte" Command="{Binding ClearPreviewOperationsCommand}" IsEnabled="{Binding !IsOrganizeBusy}"><StackPanel Classes="bi"><Path Classes="icon" Data="{StaticResource IconTrash}"/><TextBlock Text="Svuota proposte"/></StackPanel></Button>
                                                    <Button ToolTip.Tip="Cancella la cronologia delle operazioni (i file non vengono toccati, ma non si potrà più fare Undo)" Command="{Binding ClearHistoryCommand}"><StackPanel Classes="bi"><Path Classes="icon" Data="{StaticResource IconTrash}"/><TextBlock Text="Svuota cronologia"/></StackPanel></Button>
                                                </WrapPanel>
                                            </StackPanel>
                                        </Border>

                                        <Grid RowDefinitions="*, Auto, *">
                                            <Border Grid.Row="0" Classes="cardElevated">
                                                <DockPanel>
                                                    <TextBlock DockPanel.Dock="Top" Text="Operazioni proposte" FontWeight="Bold" FontSize="14" Margin="0,0,0,8"/>
                                                    <DataGrid ItemsSource="{Binding PreviewOperations}" AutoGenerateColumns="False" IsReadOnly="True" CanUserResizeColumns="True" CanUserReorderColumns="True" CanUserSortColumns="False">
                                                        <DataGrid.Columns>
                                                            <DataGridTextColumn Header="Tipo" Binding="{Binding Type}" Width="100"/>
                                                            <DataGridTextColumn Header="Da" Binding="{Binding OriginalPath}" Width="2*"/>
                                                            <DataGridTextColumn Header="A" Binding="{Binding NewPath}" Width="2*"/>
                                                            <DataGridTextColumn Header="Conflitto" Binding="{Binding ConflictReason}" Width="200"/>
                                                        </DataGrid.Columns>
                                                    </DataGrid>
                                                </DockPanel>
                                            </Border>
                                            <Border Grid.Row="1" Height="12"/>
                                            <Border Grid.Row="2" Classes="cardElevated">
                                                <DockPanel>
                                                    <TextBlock DockPanel.Dock="Top" Text="Cronologia operazioni" FontWeight="Bold" FontSize="14" Margin="0,0,0,8"/>
                                                    <DataGrid ItemsSource="{Binding OperationHistory}" AutoGenerateColumns="False" IsReadOnly="True" CanUserResizeColumns="True" CanUserReorderColumns="True" CanUserSortColumns="False">
                                                        <DataGrid.Columns>
                                                            <DataGridTextColumn Header="Data" Binding="{Binding Timestamp, StringFormat='{}{0:dd/MM/yyyy HH:mm:ss}'}" Width="180"/>
                                                            <DataGridTextColumn Header="Tipo" Binding="{Binding Type}" Width="100"/>
                                                            <DataGridTextColumn Header="Descrizione" Binding="{Binding Description}" Width="*"/>
                                                        </DataGrid.Columns>
                                                    </DataGrid>
                                                </DockPanel>
                                            </Border>
                                        </Grid>
                                    </DockPanel>
                                </Panel>
                                <Panel IsVisible="{Binding #OrganizerTabs.SelectedIndex, Converter={x:Static vm:IndexEqualsConverter.Default}, ConverterParameter=1}">
                                    <DockPanel Margin="0,10,0,0">
                                        <Border DockPanel.Dock="Top" Classes="cardElevated" Margin="0,0,0,12">
                                            <StackPanel Spacing="10">
                                                <TextBlock Text="Cartelle sorgente (ordine = priorità, la prima vince)" FontWeight="Bold" FontSize="14"/>
                                                <Grid ColumnDefinitions="*, Auto, Auto" Height="200">
                                                    <Border Grid.Column="0" Background="{DynamicResource AppSurface2Brush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" CornerRadius="8">
                                                        <ListBox ItemsSource="{Binding MergeSourceFolders}" SelectedItem="{Binding SelectedMergeFolder, Mode=TwoWay}" Background="Transparent">
                                                            <ListBox.ItemTemplate>
                                                                <DataTemplate DataType="models:MergeSourceFolder">
                                                                    <Grid ColumnDefinitions="Auto, *, Auto">
                                                                        <TextBlock Grid.Column="0" Text="{Binding Priority, StringFormat='[{0}] '}" FontWeight="Bold" VerticalAlignment="Center" Foreground="{DynamicResource AppAccentBrush}"/>
                                                                        <TextBlock Grid.Column="1" Text="{Binding Path}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                                                        <TextBlock Grid.Column="2" Text="{Binding FileCount, StringFormat=' ({0} file)'}" Foreground="{DynamicResource AppTextMutedBrush}" VerticalAlignment="Center"/>
                                                                    </Grid>
                                                                </DataTemplate>
                                                            </ListBox.ItemTemplate>
                                                        </ListBox>
                                                    </Border>
                                                    <StackPanel Grid.Column="1" Spacing="6" Margin="10,0">
                                                        <Button Classes="iconCircle" Click="OnMergeMoveUpClick" ToolTip.Tip="Sposta su"><Path Classes="icon" Data="{StaticResource IconArrowUp}"/></Button>
                                                        <Button Classes="iconCircle" Click="OnMergeMoveDownClick" ToolTip.Tip="Sposta giù"><Path Classes="icon" Data="{StaticResource IconArrowDown}"/></Button>
                                                        <Button Classes="iconCircle danger" Click="OnMergeRemoveClick" ToolTip.Tip="Rimuovi"><Path Classes="icon" Data="{StaticResource IconClose}"/></Button>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="2" Spacing="6">
                                                        <Button ToolTip.Tip="Aggiunge una cartella sorgente all'elenco da unire" Click="OnMergeAddFolderClick"><StackPanel Classes="bi"><Path Classes="icon" Data="{StaticResource IconPlus}"/><TextBlock Text="Aggiungi cartella"/></StackPanel></Button>
                                                        <Button ToolTip.Tip="Svuota l'elenco delle cartelle da unire" Click="OnMergeClearClick"><StackPanel Classes="bi"><Path Classes="icon" Data="{StaticResource IconTrash}"/><TextBlock Text="Svuota lista"/></StackPanel></Button>
                                                    </StackPanel>
                                                </Grid>

                                                <Grid ColumnDefinitions="Auto, *, Auto">
                                                    <TextBlock Grid.Column="0" Text="{Binding MergeDestinationLabel}" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,10,0"/>
                                                    <TextBox Grid.Column="1" Text="{Binding MergeDestinationFolder}" Margin="0,0,8,0"/>
                                                    <Button Grid.Column="2" Classes="iconCircle" ToolTip.Tip="Sfoglia cartelle" Click="OnBrowseMergeDestClick" IsVisible="{Binding OrganizeModeIsLocal}"><Path Classes="icon" Data="{StaticResource IconFolder}"/></Button>
                                                    <Button Grid.Column="2" Classes="iconCircle" ToolTip.Tip="Sfoglia cartelle remote" Click="OnBrowseMergeDestRemoteClick" IsVisible="{Binding !OrganizeModeIsLocal}"><Path Classes="icon" Data="{StaticResource IconFolder}"/></Button>
                                                </Grid>

                                                <Grid ColumnDefinitions="Auto, *, Auto">
                                                    <TextBlock Grid.Column="0" Text="Pattern" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,10,0"/>
                                                    <ComboBox Grid.Column="1" IsEditable="True" ItemsSource="{Binding OrganizePatterns}" Text="{Binding MergePattern, Mode=TwoWay}" HorizontalAlignment="Stretch" Margin="0,0,10,0"/>
                                                    <Border Grid.Column="2" Background="{DynamicResource AppSurface2Brush}" BorderBrush="{DynamicResource AppAccentBrush}" BorderThickness="1" CornerRadius="6" Padding="10,4" MaxWidth="380">
                                                        <TextBlock Text="{Binding MergePatternPreview}" FontFamily="Consolas,Menlo,monospace" Foreground="{DynamicResource AppAccentBrush}" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                    </Border>
                                                </Grid>

                                                <StackPanel Orientation="Horizontal" Spacing="10">
                                                    <TextBlock Text="Episodio iniziale:" VerticalAlignment="Center" FontWeight="SemiBold" ToolTip.Tip="Da che numero vuoi iniziare a contare? (es. 1 o 15)"/>
                                                    <TextBox Text="{Binding MergeStartingEpisode, Mode=TwoWay}" Width="80"/>
                                                    <TextBlock Text="(default 1)" FontStyle="Italic" Foreground="{DynamicResource AppTextMutedBrush}" VerticalAlignment="Center"/>
                                                </StackPanel>

                                                <WrapPanel Orientation="Horizontal" ItemSpacing="8" LineSpacing="6">
                                                    <Button ToolTip.Tip="Calcola spostamenti e rinumerazione senza modificare nulla: controlla la tabella prima di applicare" Classes="info" Command="{Binding PreviewMergeCommand}" IsEnabled="{Binding !IsMergeBusy}"><StackPanel Classes="bi"><Path Classes="icon" Data="{StaticResource IconEye}"/><TextBlock Text="Anteprima merge"/></StackPanel></Button>
                                                    <Button ToolTip.Tip="Esegue il merge proposto (annullabile con Undo)" Classes="success" Command="{Binding ApplyMergeCommand}" IsEnabled="{Binding !IsMergeBusy}"><StackPanel Classes="bi"><Path Classes="icon" Data="{StaticResource IconCheck}"/><TextBlock Text="Applica merge"/></StackPanel></Button>
                                                    <Button ToolTip.Tip="Annulla l'ultimo gruppo di operazioni applicate (rinomine/spostamenti)" Classes="warning" Command="{Binding UndoLastBatchCommand}" IsEnabled="{Binding !IsMergeBusy}"><StackPanel Classes="bi"><Path Classes="icon" Data="{StaticResource IconUndo}"/><TextBlock Text="Undo ultimo batch"/></StackPanel></Button>
                                                    <Button ToolTip.Tip="Svuota la tabella delle operazioni proposte" Command="{Binding ClearMergePreviewOperationsCommand}" IsEnabled="{Binding !IsMergeBusy}"><StackPanel Classes="bi"><Path Classes="icon" Data="{StaticResource IconTrash}"/><TextBlock Text="Svuota proposte"/></StackPanel></Button>
                                                    <Button ToolTip.Tip="Cancella la cronologia delle operazioni (i file non vengono toccati, ma non si potrà più fare Undo)" Command="{Binding ClearHistoryCommand}"><StackPanel Classes="bi"><Path Classes="icon" Data="{StaticResource IconTrash}"/><TextBlock Text="Svuota cronologia"/></StackPanel></Button>
                                                </WrapPanel>
                                            </StackPanel>
                                        </Border>

                                        <Grid RowDefinitions="*, Auto, *">
                                            <Border Grid.Row="0" Classes="cardElevated">
                                                <DockPanel>
                                                    <TextBlock DockPanel.Dock="Top" Text="Operazioni proposte (rinumerazione sequenziale)" FontWeight="Bold" FontSize="14" Margin="0,0,0,8"/>
                                                    <DataGrid ItemsSource="{Binding MergePreviewOperations}" AutoGenerateColumns="False" IsReadOnly="True" CanUserResizeColumns="True" CanUserReorderColumns="True" CanUserSortColumns="False">
                                                        <DataGrid.Columns>
                                                            <DataGridTextColumn Header="Sorgente" Binding="{Binding SourceFolder}" Width="1*"/>
                                                            <DataGridTextColumn Header="Da" Binding="{Binding OriginalPath}" Width="2*"/>
                                                            <DataGridTextColumn Header="A" Binding="{Binding NewPath}" Width="2*"/>
                                                            <DataGridTextColumn Header="Conflitto" Binding="{Binding ConflictReason}" Width="200"/>
                                                        </DataGrid.Columns>
                                                    </DataGrid>
                                                </DockPanel>
                                            </Border>
                                            <Border Grid.Row="1" Height="12"/>
                                            <Border Grid.Row="2" Classes="cardElevated">
                                                <DockPanel>
                                                    <TextBlock DockPanel.Dock="Top" Text="Cronologia operazioni" FontWeight="Bold" FontSize="14" Margin="0,0,0,8"/>
                                                    <DataGrid ItemsSource="{Binding OperationHistory}" AutoGenerateColumns="False" IsReadOnly="True" CanUserResizeColumns="True" CanUserReorderColumns="True" CanUserSortColumns="False">
                                                        <DataGrid.Columns>
                                                            <DataGridTextColumn Header="Data" Binding="{Binding Timestamp, StringFormat='{}{0:dd/MM/yyyy HH:mm:ss}'}" Width="180"/>
                                                            <DataGridTextColumn Header="Tipo" Binding="{Binding Type}" Width="100"/>
                                                            <DataGridTextColumn Header="Descrizione" Binding="{Binding Description}" Width="*"/>
                                                        </DataGrid.Columns>
                                                    </DataGrid>
                                                </DockPanel>
                                            </Border>
                                        </Grid>
                                    </DockPanel>
                                </Panel>
                                <Panel IsVisible="{Binding #OrganizerTabs.SelectedIndex, Converter={x:Static vm:IndexEqualsConverter.Default}, ConverterParameter=2}">
                                    <DockPanel Margin="0,10,0,0">
                                        <Border DockPanel.Dock="Top" Classes="cardElevated" Margin="0,0,0,12">
                                            <StackPanel Spacing="10">
                                                <Grid ColumnDefinitions="Auto, *, Auto">
                                                    <TextBlock Grid.Column="0" Text="{Binding SplitSourceLabel}" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,10,0"/>
                                                    <TextBox Grid.Column="1" Text="{Binding SplitSourceFolder}" Margin="0,0,8,0"/>
                                                    <Button Grid.Column="2" Classes="iconCircle" ToolTip.Tip="Sfoglia cartelle" Click="OnBrowseSplitSourceClick" IsVisible="{Binding OrganizeModeIsLocal}"><Path Classes="icon" Data="{StaticResource IconFolder}"/></Button>
                                                    <Button Grid.Column="2" Classes="iconCircle" ToolTip.Tip="Sfoglia cartelle remote" Click="OnBrowseSplitSourceRemoteClick" IsVisible="{Binding !OrganizeModeIsLocal}"><Path Classes="icon" Data="{StaticResource IconFolder}"/></Button>
                                                </Grid>

                                                <Grid ColumnDefinitions="Auto, *, Auto">
                                                    <TextBlock Grid.Column="0" Text="{Binding SplitDestinationLabel}" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,10,0"/>
                                                    <TextBox Grid.Column="1" Text="{Binding SplitDestinationFolder}" Margin="0,0,8,0"/>
                                                    <Button Grid.Column="2" Classes="iconCircle" ToolTip.Tip="Sfoglia cartelle" Click="OnBrowseSplitDestClick" IsVisible="{Binding OrganizeModeIsLocal}"><Path Classes="icon" Data="{StaticResource IconFolder}"/></Button>
                                                    <Button Grid.Column="2" Classes="iconCircle" ToolTip.Tip="Sfoglia cartelle remote" Click="OnBrowseSplitDestRemoteClick" IsVisible="{Binding !OrganizeModeIsLocal}"><Path Classes="icon" Data="{StaticResource IconFolder}"/></Button>
                                                </Grid>

                                                <StackPanel Orientation="Horizontal" Spacing="20">
                                                    <TextBlock Text="Modalità:" VerticalAlignment="Center" FontWeight="Bold"/>
                                                    <RadioButton Content="Uniforme" GroupName="SplitDivisionMode" IsChecked="{Binding SplitUniformMode}"/>
                                                    <RadioButton Content="Personalizzato" GroupName="SplitDivisionMode" IsChecked="{Binding !SplitUniformMode}"/>
                                                </StackPanel>

                                                <StackPanel Orientation="Horizontal" Spacing="10" IsVisible="{Binding SplitUniformMode}">
                                                    <TextBlock Text="Episodi per sottocartella:" VerticalAlignment="Center"/>
                                                    <TextBox Text="{Binding SplitUniformEpisodes, Mode=TwoWay}" Width="100"/>
                                                    <TextBlock Text="(l'ultima cartella conterrà il resto)" Foreground="{DynamicResource AppTextMutedBrush}" VerticalAlignment="Center"/>
                                                </StackPanel>

                                                <StackPanel Spacing="6" IsVisible="{Binding !SplitUniformMode}">
                                                    <TextBlock Text="Segmenti" FontWeight="Bold"/>
                                                    <Grid ColumnDefinitions="*, Auto" Height="180">
                                                        <Border Grid.Column="0" Background="{DynamicResource AppSurface2Brush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" CornerRadius="8">
                                                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                                                <ItemsControl ItemsSource="{Binding SplitSegments}">
                                                                    <ItemsControl.ItemTemplate>
                                                                        <DataTemplate DataType="models:SplitSegment">
                                                                            <Grid ColumnDefinitions="40, *, 40" Margin="8,4">
                                                                                <TextBlock Grid.Column="0" Text="{Binding Index, StringFormat='#{0}'}" VerticalAlignment="Center" Opacity="0.6" FontWeight="Bold" Foreground="{DynamicResource AppAccentBrush}"/>
                                                                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                                                                    <TextBlock Text="Episodi:" VerticalAlignment="Center"/>
                                                                                    <TextBox Text="{Binding EpisodeCount, Mode=TwoWay}" Width="100"/>
                                                                                </StackPanel>
                                                                                <Button ToolTip.Tip="Rimuove questo segmento" Grid.Column="2" Classes="iconCircle danger" Width="30" Height="30" Click="OnSplitRemoveSegmentClick"><Path Classes="icon" Data="{StaticResource IconClose}"/></Button>
                                                                            </Grid>
                                                                        </DataTemplate>
                                                                    </ItemsControl.ItemTemplate>
                                                                </ItemsControl>
                                                            </ScrollViewer>
                                                        </Border>
                                                        <StackPanel Grid.Column="1" Spacing="6" Margin="10,0">
                                                            <Button ToolTip.Tip="Aggiunge un segmento: una sottocartella con il numero di episodi indicato" Width="130" Command="{Binding AddSplitSegmentCommand}"><StackPanel Classes="bi" HorizontalAlignment="Center"><Path Classes="icon" Data="{StaticResource IconPlus}"/><TextBlock Text="Aggiungi"/></StackPanel></Button>
                                                            <Button ToolTip.Tip="Rimuove tutti i segmenti" Width="130" Command="{Binding ClearSplitSegmentsCommand}"><StackPanel Classes="bi" HorizontalAlignment="Center"><Path Classes="icon" Data="{StaticResource IconTrash}"/><TextBlock Text="Svuota"/></StackPanel></Button>
                                                        </StackPanel>
                                                    </Grid>
                                                </StackPanel>

                                                <TextBlock Text="{Binding SplitSegmentsSummary}" Foreground="{DynamicResource AppTextMutedBrush}" FontStyle="Italic"/>

                                                <StackPanel Orientation="Horizontal" Spacing="20">
                                                    <TextBlock Text="Numerazione:" VerticalAlignment="Center"/>
                                                    <RadioButton Content="Reset per cartella" GroupName="SplitMode" IsChecked="{Binding !SplitNumberingContinue}"/>
                                                    <RadioButton Content="Continua" GroupName="SplitMode" IsChecked="{Binding SplitNumberingContinue}"/>
                                                </StackPanel>

                                                <Grid ColumnDefinitions="Auto, *, Auto">
                                                    <TextBlock Grid.Column="0" Text="Pattern file" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,10,0"/>
                                                    <ComboBox Grid.Column="1" IsEditable="True" ItemsSource="{Binding OrganizePatterns}" Text="{Binding SplitFilePattern, Mode=TwoWay}" HorizontalAlignment="Stretch" Margin="0,0,10,0"/>
                                                    <Border Grid.Column="2" Background="{DynamicResource AppSurface2Brush}" BorderBrush="{DynamicResource AppAccentBrush}" BorderThickness="1" CornerRadius="6" Padding="10,4" MaxWidth="380">
                                                        <TextBlock Text="{Binding SplitFilePatternPreview}" FontFamily="Consolas,Menlo,monospace" Foreground="{DynamicResource AppAccentBrush}" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                    </Border>
                                                </Grid>

                                                <Grid ColumnDefinitions="Auto, *">
                                                    <TextBlock Grid.Column="0" Text="Nome sottocartella" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,10,0"/>
                                                    <ComboBox Grid.Column="1" IsEditable="True" ItemsSource="{Binding SplitFolderPatterns}" Text="{Binding SplitFolderPattern, Mode=TwoWay}" HorizontalAlignment="Stretch"/>
                                                </Grid>

                                                <TextBlock Foreground="{DynamicResource AppTextMutedBrush}" FontStyle="Italic" FontSize="11" Text="Placeholder: {Number} {Number:D2} {Start} {End}"/>

                                                <WrapPanel Orientation="Horizontal" ItemSpacing="8" LineSpacing="6">
                                                    <Button ToolTip.Tip="Calcola la suddivisione in sottocartelle senza modificare nulla: controlla la tabella prima di applicare" Classes="info" Command="{Binding PreviewSplitCommand}" IsEnabled="{Binding !IsSplitBusy}"><StackPanel Classes="bi"><Path Classes="icon" Data="{StaticResource IconEye}"/><TextBlock Text="Anteprima split"/></StackPanel></Button>
                                                    <Button ToolTip.Tip="Esegue la suddivisione proposta (annullabile con Undo)" Classes="success" Command="{Binding ApplySplitCommand}" IsEnabled="{Binding !IsSplitBusy}"><StackPanel Classes="bi"><Path Classes="icon" Data="{StaticResource IconCheck}"/><TextBlock Text="Applica split"/></StackPanel></Button>
                                                    <Button ToolTip.Tip="Annulla l'ultimo gruppo di operazioni applicate (rinomine/spostamenti)" Classes="warning" Command="{Binding UndoLastBatchCommand}" IsEnabled="{Binding !IsSplitBusy}"><StackPanel Classes="bi"><Path Classes="icon" Data="{StaticResource IconUndo}"/><TextBlock Text="Undo ultimo batch"/></StackPanel></Button>
                                                    <Button ToolTip.Tip="Svuota la tabella delle operazioni proposte" Command="{Binding ClearSplitPreviewOperationsCommand}" IsEnabled="{Binding !IsSplitBusy}"><StackPanel Classes="bi"><Path Classes="icon" Data="{StaticResource IconTrash}"/><TextBlock Text="Svuota proposte"/></StackPanel></Button>
                                                    <Button ToolTip.Tip="Cancella la cronologia delle operazioni (i file non vengono toccati, ma non si potrà più fare Undo)" Command="{Binding ClearHistoryCommand}"><StackPanel Classes="bi"><Path Classes="icon" Data="{StaticResource IconTrash}"/><TextBlock Text="Svuota cronologia"/></StackPanel></Button>
                                                </WrapPanel>
                                            </StackPanel>
                                        </Border>

                                        <Grid RowDefinitions="*, Auto, *">
                                            <Border Grid.Row="0" Classes="cardElevated">
                                                <DockPanel>
                                                    <TextBlock DockPanel.Dock="Top" Text="Operazioni proposte" FontWeight="Bold" FontSize="14" Margin="0,0,0,8"/>
                                                    <DataGrid ItemsSource="{Binding SplitPreviewOperations}" AutoGenerateColumns="False" IsReadOnly="True" CanUserResizeColumns="True" CanUserReorderColumns="True" CanUserSortColumns="False">
                                                        <DataGrid.Columns>
                                                            <DataGridTextColumn Header="Da" Binding="{Binding OriginalPath}" Width="2*"/>
                                                            <DataGridTextColumn Header="A" Binding="{Binding NewPath}" Width="2*"/>
                                                            <DataGridTextColumn Header="Conflitto" Binding="{Binding ConflictReason}" Width="200"/>
                                                        </DataGrid.Columns>
                                                    </DataGrid>
                                                </DockPanel>
                                            </Border>
                                            <Border Grid.Row="1" Height="12"/>
                                            <Border Grid.Row="2" Classes="cardElevated">
                                                <DockPanel>
                                                    <TextBlock DockPanel.Dock="Top" Text="Cronologia operazioni" FontWeight="Bold" FontSize="14" Margin="0,0,0,8"/>
                                                    <DataGrid ItemsSource="{Binding OperationHistory}" AutoGenerateColumns="False" IsReadOnly="True" CanUserResizeColumns="True" CanUserReorderColumns="True" CanUserSortColumns="False">
                                                        <DataGrid.Columns>
                                                            <DataGridTextColumn Header="Data" Binding="{Binding Timestamp, StringFormat='{}{0:dd/MM/yyyy HH:mm:ss}'}" Width="180"/>
                                                            <DataGridTextColumn Header="Tipo" Binding="{Binding Type}" Width="100"/>
                                                            <DataGridTextColumn Header="Descrizione" Binding="{Binding Description}" Width="*"/>
                                                        </DataGrid.Columns>
                                                    </DataGrid>
                                                </DockPanel>
                                            </Border>
                                        </Grid>
                                    </DockPanel>
                                </Panel>
                            </Panel>
                        </DockPanel>
                    </DockPanel>
                </ScrollViewer>
                </Panel>
                <Panel IsVisible="{Binding #MainTabs.SelectedIndex, Converter={x:Static vm:IndexEqualsConverter.Default}, ConverterParameter=4}">
                    <DockPanel Margin="0,10,0,0" DataContext="{Binding Sftp}">
                        <!-- STATUS (in alto, sopra le guide) -->
                        <ContentControl DockPanel.Dock="Top" Theme="{StaticResource StatusBannerTheme}" Content="{Binding SftpStatusMessage}"/>

                        <!-- GUIDA SFTP -->
                        <Border DockPanel.Dock="Top" Classes="cardElevated" Margin="0,0,0,12" Padding="0" ClipToBounds="True">
                            <StackPanel>
                                <ToggleButton Classes="guideToggle" x:Name="ToggleGuideSftp" IsChecked="False">
                                    <Grid ColumnDefinitions="*, Auto">
                                        <StackPanel Classes="bi">
                                            <Path Classes="icon accent" Data="{StaticResource IconBulb}"/>
                                            <TextBlock Text="Guida rapida - SFTP" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource AppTextBrush}"/>
                                        </StackPanel>
                                        <Path Grid.Column="1" Classes="chevron"/>
                                    </Grid>
                                </ToggleButton>
                                <Border IsVisible="{Binding #ToggleGuideSftp.IsChecked}" Background="Transparent" Margin="16,0,16,16" Padding="12">
                                    <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource AppTextMutedBrush}">
                                        <Run FontWeight="Bold" Foreground="{DynamicResource AppTextBrush}">Connessione</Run><LineBreak/>
                                        <Run FontWeight="SemiBold" Foreground="{DynamicResource AppTextBrush}">• Profili:</Run> crea un profilo con host, porta, utente e password (o chiave privata), premi Test per provarlo e poi Connetti. I profili sono salvati e la password è cifrata.<LineBreak/>
                                        <LineBreak/>
                                        <Run FontWeight="Bold" Foreground="{DynamicResource AppTextBrush}">Browser</Run><LineBreak/>
                                        <Run FontWeight="SemiBold" Foreground="{DynamicResource AppTextBrush}">• Upload:</Run> trascina file o cartelle dal pannello locale (sinistra) a quello remoto (destra), oppure usa "Accoda cartella".<LineBreak/>
                                        <Run FontWeight="SemiBold" Foreground="{DynamicResource AppTextBrush}">• Download:</Run> trascina dal pannello remoto a quello locale.<LineBreak/>
                                        <Run FontWeight="SemiBold" Foreground="{DynamicResource AppTextBrush}">• Gestione:</Run> clic destro su un elemento per aprirlo, rinominarlo o eliminarlo; doppio clic su una cartella per entrarci.<LineBreak/>
                                        <Run FontWeight="SemiBold" Foreground="{DynamicResource AppTextBrush}">• Anteprima video:</Run> clic destro su un video remoto, "Anteprima video": lo riproduce in streaming senza scaricarlo (Spazio play/pausa, frecce per spostarti e regolare il volume, F schermo intero).<LineBreak/>
                                        <LineBreak/>
                                        <Run FontWeight="Bold" Foreground="{DynamicResource AppTextBrush}">Code Upload e Download</Run><LineBreak/>
                                        Ogni trasferimento va in coda con avanzamento e velocità. Puoi metterlo in pausa, riprenderlo (riparte da dove era arrivato) o annullarlo. Il numero di trasferimenti simultanei si regola nella coda.<LineBreak/>
                                        <LineBreak/>
                                        <Run FontWeight="Bold" Foreground="{DynamicResource AppTextBrush}">Zero-Byte Checker</Run><LineBreak/>
                                        Cerca file vuoti (0 byte) nelle cartelle remote, di solito upload interrotti. Le cartelle che ne contengono vengono evidenziate in rosso.<LineBreak/>
                                        <LineBreak/>
                                        <Run FontWeight="SemiBold" Foreground="{DynamicResource AppTextBrush}">• Problemi:</Run> se la connessione cade, l'indicatore torna rosso: riconnettiti. I dettagli sono nel Log globale, sezione "SFTP".
                                    </TextBlock>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- CONFIGURAZIONE -->
                        <Border DockPanel.Dock="Top" Classes="cardElevated" Margin="0,0,0,12" Padding="0" ClipToBounds="True">
                            <StackPanel>
                                <ToggleButton Classes="guideToggle" x:Name="ToggleSftpConfigButton" IsChecked="{Binding !IsSftpConnected, Mode=OneWay}">
                                    <Grid ColumnDefinitions="*, Auto">
                                        <StackPanel Classes="bi">
                                            <Path Classes="icon accent" Data="{StaticResource IconPlug}"/>
                                            <TextBlock Text="Configurazione connessione SFTP" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource AppTextBrush}"/>
                                        </StackPanel>
                                        <Path Grid.Column="1" Classes="chevron"/>
                                    </Grid>
                                </ToggleButton>

                                <StackPanel x:Name="SftpConfigBody" IsVisible="{Binding #ToggleSftpConfigButton.IsChecked}" Margin="16,0,16,16" Spacing="12">
                                    <Grid ColumnDefinitions="Auto, *, Auto, Auto, Auto">
                                        <TextBlock Grid.Column="0" Text="Profilo:" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,10,0"/>
                                        <ComboBox Grid.Column="1" ItemsSource="{Binding SftpProfiles}" SelectedItem="{Binding SelectedSftpProfile, Mode=TwoWay}" DisplayMemberBinding="{Binding Name}" HorizontalAlignment="Stretch" Margin="0,0,10,0"/>
                                        <Button ToolTip.Tip="Crea un nuovo profilo di connessione vuoto" Grid.Column="2" Click="OnSftpNewProfileClick" Margin="0,0,8,0"><StackPanel Classes="bi"><Path Classes="icon" Data="{StaticResource IconPlus}"/><TextBlock Text="Nuovo"/></StackPanel></Button>
                                        <Button ToolTip.Tip="Salva il profilo corrente (la password viene cifrata)" Grid.Column="3" Classes="accent" Command="{Binding SftpSaveConfigCommand}" Margin="0,0,8,0"><StackPanel Classes="bi"><Path Classes="icon" Data="{StaticResource IconSave}"/><TextBlock Text="Salva"/></StackPanel></Button>
                                        <Button ToolTip.Tip="Elimina il profilo selezionato" Grid.Column="4" Classes="danger" Command="{Binding SftpDeleteProfileCommand}"><StackPanel Classes="bi"><Path Classes="icon" Data="{StaticResource IconTrash}"/><TextBlock Text="Elimina"/></StackPanel></Button>
                                    </Grid>

                                    <Border Background="{DynamicResource AppSurface2Brush}" CornerRadius="8" Padding="14">
                                        <Grid ColumnDefinitions="Auto, *, Auto, Auto" RowDefinitions="Auto, Auto, Auto, Auto, Auto, Auto">
                                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Nome:" VerticalAlignment="Center" Margin="0,0,10,8"/>
                                            <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding SftpName}" Margin="0,0,10,8"/>
                                            <TextBlock Grid.Row="0" Grid.Column="2" Text="Host:" VerticalAlignment="Center" Margin="20,0,10,8"/>
                                            <TextBox Grid.Row="0" Grid.Column="3" Text="{Binding SftpHost}" Width="260" Margin="0,0,0,8" ToolTip.Tip="I dati di accesso al tuo server SFTP"/>

                                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Username:" VerticalAlignment="Center" Margin="0,0,10,8"/>
                                            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding SftpUsername}" Margin="0,0,10,8"/>
                                            <TextBlock Grid.Row="1" Grid.Column="2" Text="Porta:" VerticalAlignment="Center" Margin="20,0,10,8"/>
                                            <TextBox Grid.Row="1" Grid.Column="3" Text="{Binding SftpPort}" Width="260" Margin="0,0,0,8"/>

                                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Password:" VerticalAlignment="Center" Margin="0,0,10,8"/>
                                            <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding SftpPassword}" PasswordChar="•" Margin="0,0,10,8"/>
                                            <CheckBox ToolTip.Tip="Autenticazione con chiave privata (file .ppk / OpenSSH) invece della password" Grid.Row="2" Grid.Column="2" Grid.ColumnSpan="2" IsChecked="{Binding SftpUseKeyAuth}" Margin="20,0,0,8">
                                                <StackPanel Classes="bi"><Path Classes="icon" Data="{StaticResource IconKey}"/><TextBlock Text="Usa chiave privata SSH"/></StackPanel>
                                            </CheckBox>

                                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Chiave privata:" VerticalAlignment="Center" Margin="0,0,10,8" IsVisible="{Binding SftpUseKeyAuth}"/>
                                            <Grid Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" ColumnDefinitions="*, Auto" IsVisible="{Binding SftpUseKeyAuth}" Margin="0,0,10,8">
                                                <TextBox Grid.Column="0" Text="{Binding SftpPrivateKeyPath}" Margin="0,0,8,0"/>
                                                <Button Grid.Column="1" Classes="iconCircle" Click="OnBrowseSftpKeyClick" ToolTip.Tip="Sfoglia"><Path Classes="icon" Data="{StaticResource IconFolder}"/></Button>
                                            </Grid>

                                            <Grid Grid.Row="3" Grid.Column="3" ColumnDefinitions="Auto, *" IsVisible="{Binding SftpUseKeyAuth}" Margin="0,0,0,8">
                                                <TextBlock Grid.Column="0" Text="Passphrase:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                                <TextBox Grid.Column="1" Text="{Binding SftpPrivateKeyPassphrase}" PasswordChar="•"/>
                                            </Grid>

                                            <TextBlock Grid.Row="4" Grid.Column="0" Text="Cartella remota:" VerticalAlignment="Center" Margin="0,0,10,8"/>
                                            <TextBox Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="3" Text="{Binding SftpRemoteBasePath}" Margin="0,0,0,8"/>

                                            <TextBlock Grid.Row="5" Grid.Column="0" Text="Host key fingerprint:" VerticalAlignment="Center" Margin="0,0,10,8"/>
                                            <TextBox Grid.Row="5" Grid.Column="1" Grid.ColumnSpan="3" Text="{Binding SftpHostKeyFingerprint}" PlaceholderText="(opzionale) ssh-rsa 2048 xx:xx:xx..." Margin="0,0,0,8"/>
                                        </Grid>
                                    </Border>

                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Button ToolTip.Tip="Prova la connessione con i dati inseriti, senza restare collegato" Classes="info" Command="{Binding SftpTestCommand}" IsEnabled="{Binding !IsSftpBusy}"><StackPanel Classes="bi"><Path Classes="icon" Data="{StaticResource IconPlug}"/><TextBlock Text="Test"/></StackPanel></Button>
                                        <Button ToolTip.Tip="Connetti al server SFTP con il profilo corrente" Classes="success" Command="{Binding SftpConnectCommand}" IsEnabled="{Binding !IsSftpBusy}"><StackPanel Classes="bi"><Path Classes="icon" Data="{StaticResource IconBolt}"/><TextBlock Text="Connetti"/></StackPanel></Button>
                                        <Button ToolTip.Tip="Chiude la connessione SFTP" Classes="warning" Command="{Binding SftpDisconnectCommand}" IsVisible="{Binding IsSftpConnected}"><StackPanel Classes="bi"><Path Classes="icon" Data="{StaticResource IconBoltOff}"/><TextBlock Text="Disconnetti"/></StackPanel></Button>
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <DockPanel IsVisible="{Binding IsSftpConnected}">
                            <TabControl x:Name="SftpTabs" DockPanel.Dock="Top">
                                <!-- ===== BROWSER ===== -->
                                <TabItem>
                                    <TabItem.Header>
                                        <StackPanel Classes="bi">
                                            <Path Classes="icon" Data="{StaticResource IconFolder}"/>
                                            <TextBlock Text="Browser" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </TabItem.Header>
                                </TabItem>

                                <!-- ===== UPLOAD QUEUE ===== -->
                                <TabItem>
                                    <TabItem.Header>
                                        <StackPanel Classes="bi">
                                            <Path Classes="icon" Data="{StaticResource IconUpload}"/>
                                            <TextBlock Text="Upload queue" VerticalAlignment="Center"/>
                                            <Border Width="9" Height="9" CornerRadius="5" Background="{DynamicResource AppAccentBrush}" IsVisible="{Binding HasActiveUploads}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </TabItem.Header>
                                </TabItem>

                                <!-- ===== DOWNLOAD QUEUE ===== -->
                                <TabItem>
                                    <TabItem.Header>
                                        <StackPanel Classes="bi">
                                            <Path Classes="icon" Data="{StaticResource IconDownload}"/>
                                            <TextBlock Text="Download queue" VerticalAlignment="Center"/>
                                            <Border Width="9" Height="9" CornerRadius="5" Background="{DynamicResource AppAccentBrush}" IsVisible="{Binding HasActiveDownloads}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </TabItem.Header>
                                </TabItem>
                            </TabControl>
                            <!-- Contenuti sempre nel visual tree: cambiando tab restano scroll e stato -->
                            <Panel ClipToBounds="True">
                                <Panel IsVisible="{Binding #SftpTabs.SelectedIndex, Converter={x:Static vm:IndexEqualsConverter.Default}, ConverterParameter=0}">
                                    <Grid ColumnDefinitions="*, Auto, *" Margin="0,10,0,0">

                                        <!-- FILE LOCALI -->
                                        <Border Grid.Column="0" Classes="cardElevated" Margin="0,0,6,0">
                                            <DockPanel>
                                                <StackPanel DockPanel.Dock="Top" Classes="bi" Margin="0,0,0,10">
                                                    <Path Classes="icon accent" Data="{StaticResource IconMonitor}"/>
                                                    <TextBlock Text="File locali" FontWeight="Bold" FontSize="14" VerticalAlignment="Center"/>
                                                </StackPanel>
                                                <Grid DockPanel.Dock="Top" RowDefinitions="Auto,Auto" Margin="0,0,0,8">
                                                    <Grid Grid.Row="0" ColumnDefinitions="Auto, Auto, *, Auto, Auto, Auto, Auto">
                                                        <Button Grid.Column="0" Classes="iconCircle" Command="{Binding SftpLocalGoUpCommand}" Margin="0,0,6,0" ToolTip.Tip="Indietro"><Path Classes="icon" Data="{StaticResource IconArrowLeft}"/></Button>
                                                        <Button Grid.Column="1" Classes="iconCircle" Command="{Binding SftpLocalHomeCommand}" Margin="0,0,6,0" ToolTip.Tip="Home"><Path Classes="icon" Data="{StaticResource IconHome}"/></Button>
                                                        <TextBox Grid.Column="2" Text="{Binding SftpCurrentLocalPath}" Margin="0,0,6,0" IsReadOnly="True"/>
                                                        <Button Grid.Column="3" Classes="iconCircle" Click="OnSftpLocalRefreshClick" Margin="0,0,6,0" ToolTip.Tip="Aggiorna"><Path Classes="icon" Data="{StaticResource IconRefresh}"/></Button>
                                                        <Button Grid.Column="4" Classes="iconCircle" Click="OnLocalNewFolderClick" Margin="0,0,6,0" ToolTip.Tip="Nuova cartella"><Path Classes="icon" Data="{StaticResource IconPlus}"/></Button>
                                                        <ComboBox Grid.Column="5" ItemsSource="{Binding SortOptions}" SelectedItem="{Binding LocalSortOption, Mode=TwoWay}" MinWidth="110" Margin="0,0,6,0" ToolTip.Tip="Ordina per">
                                                            <ComboBox.ItemTemplate>
                                                                <DataTemplate x:DataType="models:SortOption">
                                                                    <TextBlock Text="{Binding Label}"/>
                                                                </DataTemplate>
                                                            </ComboBox.ItemTemplate>
                                                        </ComboBox>
                                                        <Button Grid.Column="6" Content="{Binding LocalSortDirectionIcon}" Classes="iconCircle" Width="34" Command="{Binding ToggleLocalSortDirectionCommand}" ToolTip.Tip="Inverti direzione (crescente / decrescente)"/>
                                                    </Grid>
                                                    <TextBlock Grid.Row="1" Text="{Binding LocalBrowserStats}" FontSize="11" Foreground="{DynamicResource AppTextMutedBrush}" Margin="0,6,0,0" HorizontalAlignment="Left"/>
                                                </Grid>
                                                <DataGrid Name="LocalFilesGrid" MinHeight="200" ItemsSource="{Binding SftpLocalEntries}" ScrollViewer.HorizontalScrollBarVisibility="Auto" SelectedItem="{Binding SftpSelectedLocalEntry, Mode=TwoWay}" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Extended" SelectionChanged="OnLocalFilesSelectionChanged" DoubleTapped="OnSftpLocalEntryDoubleTapped" KeyDown="OnLocalGridKeyDown" DragDrop.AllowDrop="True" DragDrop.DragOver="OnLocalGridDragOver" DragDrop.Drop="OnLocalGridDrop" CanUserResizeColumns="True" CanUserReorderColumns="True" CanUserSortColumns="False">
                                                    <!-- Un solo menu per tutta la tabella (prima uno per riga, ricreato a ogni riga
                                                         riciclata durante lo scorrimento: era la causa dei blocchi scorrendo veloce) -->
                                                    <DataGrid.ContextMenu>
                                                        <ContextMenu>
                                                            <MenuItem Header="Apri" Click="OnLocalOpenClick"><MenuItem.Icon><Path Classes="icon" Data="{StaticResource IconFolder}"/></MenuItem.Icon></MenuItem>
                                                            <Separator/>
                                                            <MenuItem Header="Rinomina" Click="OnLocalRenameClick"><MenuItem.Icon><Path Classes="icon" Data="{StaticResource IconEdit}"/></MenuItem.Icon></MenuItem>
                                                            <MenuItem Header="Sposta in..." Click="OnLocalMoveClick"><MenuItem.Icon><Path Classes="icon" Data="{StaticResource IconArrowLeft}"/></MenuItem.Icon></MenuItem>
                                                            <MenuItem Header="Elimina" Click="OnLocalDeleteClick"><MenuItem.Icon><Path Classes="icon" Data="{StaticResource IconTrash}"/></MenuItem.Icon></MenuItem>
                                                        </ContextMenu>
                                                    </DataGrid.ContextMenu>
                                                    <DataGrid.Columns>
                                                        <DataGridTemplateColumn Header=" " Width="40" CanUserResize="False">
                                                            <DataGridTemplateColumn.CellTemplate>
                                                                <DataTemplate x:DataType="models:LocalFileEntry">
                                                                    <Panel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                                        <Path Classes="icon" Data="{StaticResource IconFolder}" Stroke="{DynamicResource AppWarningBrush}" IsVisible="{Binding IsDirectory}"/>
                                                                        <Path Classes="icon" Data="{StaticResource IconFile}" Stroke="{DynamicResource AppTextMutedBrush}" IsVisible="{Binding !IsDirectory}"/>
                                                                    </Panel>
                                                                </DataTemplate>
                                                            </DataGridTemplateColumn.CellTemplate>
                                                        </DataGridTemplateColumn>
                                                        <DataGridTextColumn Header="Nome" Binding="{Binding Name}" Width="*" MinWidth="150"/>
                                                        <DataGridTextColumn Header="Dim." Binding="{Binding SizeText}" Width="Auto" MinWidth="70"/>
                                                        <DataGridTextColumn Header="Ultima modifica" Binding="{Binding Modified, StringFormat='{}{0:dd/MM/yyyy HH:mm}'}" Width="Auto" MinWidth="120"/>
                                                    </DataGrid.Columns>
                                                </DataGrid>
                                            </DockPanel>
                                        </Border>

                                        <!-- UPLOAD / DOWNLOAD -->
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="12" Width="130" Margin="10,0">
                                            <Button Classes="success" Command="{Binding SftpUploadSelectedCommand}" Height="46" ToolTip.Tip="Carica i file/cartelle selezionate (o trascina)">
                                                <StackPanel Classes="bi" HorizontalAlignment="Center"><Path Classes="icon" Data="{StaticResource IconUpload}"/><TextBlock Text="Upload"/></StackPanel>
                                            </Button>
                                            <Button Classes="info" Command="{Binding SftpDownloadSelectedCommand}" Height="46" ToolTip.Tip="Scarica i file/cartelle selezionate (o trascina)">
                                                <StackPanel Classes="bi" HorizontalAlignment="Center"><Path Classes="icon" Data="{StaticResource IconDownload}"/><TextBlock Text="Download"/></StackPanel>
                                            </Button>
                                        </StackPanel>

                                        <!-- FILE REMOTI -->
                                        <Border Grid.Column="2" Classes="cardElevated" Margin="6,0,0,0">
                                            <DockPanel>
                                                <StackPanel DockPanel.Dock="Top" Classes="bi" Margin="0,0,0,10">
                                                    <Path Classes="icon accent" Data="{StaticResource IconCloud}"/>
                                                    <TextBlock Text="File remoti" FontWeight="Bold" FontSize="14" VerticalAlignment="Center"/>
                                                </StackPanel>
                                                <Grid DockPanel.Dock="Top" RowDefinitions="Auto,Auto" Margin="0,0,0,8">
                                                    <Grid Grid.Row="0" ColumnDefinitions="Auto, Auto, *, Auto, Auto, Auto, Auto, Auto">
                                                        <Button Grid.Column="0" Classes="iconCircle" Command="{Binding SftpGoUpCommand}" Margin="0,0,6,0" ToolTip.Tip="Indietro"><Path Classes="icon" Data="{StaticResource IconArrowLeft}"/></Button>
                                                        <Button Grid.Column="1" Classes="iconCircle" Command="{Binding SftpGoHomeCommand}" Margin="0,0,6,0" ToolTip.Tip="Home"><Path Classes="icon" Data="{StaticResource IconHome}"/></Button>
                                                        <TextBox Grid.Column="2" Text="{Binding SftpCurrentRemotePath}" Margin="0,0,6,0"/>
                                                        <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="4" Margin="0,0,6,0">
                                                            <Button Classes="iconCircle" Click="OnSftpRefreshClick" IsEnabled="{Binding !IsRefreshingRemote}" ToolTip.Tip="Aggiorna"><Path Classes="icon" Data="{StaticResource IconRefresh}"/></Button>
                                                            <Button Classes="iconCircle" Command="{Binding SftpForceReloadCommand}" IsEnabled="{Binding !IsRefreshingRemote}" ToolTip.Tip="Forza ricarica (riconnette al server)"><Path Classes="icon" Data="{StaticResource IconRepeat}"/></Button>
                                                        </StackPanel>
                                                        <Button Grid.Column="4" Classes="iconCircle" Click="OnRemoteNewFolderClick" Margin="0,0,6,0" ToolTip.Tip="Nuova cartella"><Path Classes="icon" Data="{StaticResource IconPlus}"/></Button>
                                                        <StackPanel Grid.Column="5" Orientation="Horizontal" Spacing="4" Margin="0,0,6,0">
                                                            <Button Classes="iconCircle" Command="{Binding CheckZeroByteFoldersCommand}" IsEnabled="{Binding !IsCheckingZeroByte}" ToolTip.Tip="Analizza la cartella remota per trovare file vuoti (0 byte) da eliminare"><Path Classes="icon" Data="{StaticResource IconSearch}"/></Button>
                                                            <Button Classes="iconCircle danger" Command="{Binding StopZeroByteCheckCommand}" IsVisible="{Binding IsCheckingZeroByte}" ToolTip.Tip="Ferma il check in corso"><Path Classes="icon" Data="{StaticResource IconStop}"/></Button>
                                                        </StackPanel>
                                                        <ComboBox Grid.Column="6" ItemsSource="{Binding SortOptions}" SelectedItem="{Binding RemoteSortOption, Mode=TwoWay}" MinWidth="110" Margin="0,0,6,0" ToolTip.Tip="Ordina per">
                                                            <ComboBox.ItemTemplate>
                                                                <DataTemplate x:DataType="models:SortOption">
                                                                    <TextBlock Text="{Binding Label}"/>
                                                                </DataTemplate>
                                                            </ComboBox.ItemTemplate>
                                                        </ComboBox>
                                                        <Button Grid.Column="7" Content="{Binding RemoteSortDirectionIcon}" Classes="iconCircle" Width="34" Command="{Binding ToggleRemoteSortDirectionCommand}" ToolTip.Tip="Inverti direzione (crescente / decrescente)"/>
                                                    </Grid>
                                                    <TextBlock Grid.Row="1" Text="{Binding RemoteBrowserStats}" FontSize="11" Foreground="{DynamicResource AppTextMutedBrush}" Margin="0,6,0,0" HorizontalAlignment="Left"/>
                                                </Grid>

                                                <Border DockPanel.Dock="Top" IsVisible="{Binding HasRemoteStatus}" Background="{DynamicResource AppSurface2Brush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="10,6" Margin="0,0,0,8">
                                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                                        <TextBlock Text="{Binding RemoteStatusIcon}" FontSize="12" VerticalAlignment="Center"/>
                                                        <TextBlock Text="{Binding RemoteStatusText}" FontSize="12" Foreground="{DynamicResource AppTextBrush}" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Border>

                                                <DataGrid Name="RemoteFilesGrid" MinHeight="200" ItemsSource="{Binding SftpRemoteEntries}" ScrollViewer.HorizontalScrollBarVisibility="Auto" SelectedItem="{Binding SftpSelectedRemoteEntry, Mode=TwoWay}" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Extended" SelectionChanged="OnRemoteFilesSelectionChanged" DoubleTapped="OnSftpEntryDoubleTapped" KeyDown="OnRemoteGridKeyDown" DragDrop.AllowDrop="True" DragDrop.DragOver="OnRemoteGridDragOver" DragDrop.Drop="OnRemoteGridDrop" CanUserResizeColumns="True" CanUserReorderColumns="True" CanUserSortColumns="False">
                                                    <DataGrid.Styles>
                                                        <Style Selector="DataGridRow" x:DataType="models:SftpRemoteEntry">
                                                            <Setter Property="Classes.zeroByte" Value="{Binding HasZeroByteIssue}"/>
                                                        </Style>
                                                    </DataGrid.Styles>
                                                    <DataGrid.ContextMenu>
                                                        <ContextMenu>
                                                            <MenuItem Header="Apri" Click="OnRemoteOpenClick"><MenuItem.Icon><Path Classes="icon" Data="{StaticResource IconFolder}"/></MenuItem.Icon></MenuItem>
                                                            <MenuItem Header="Anteprima video" Click="OnRemotePreviewClick"><MenuItem.Icon><Path Classes="icon" Data="{StaticResource IconPlayCircle}"/></MenuItem.Icon></MenuItem>
                                                            <Separator/>
                                                            <MenuItem Header="Rinomina" Click="OnRemoteRenameClick"><MenuItem.Icon><Path Classes="icon" Data="{StaticResource IconEdit}"/></MenuItem.Icon></MenuItem>
                                                            <MenuItem Header="Sposta in..." Click="OnRemoteMoveClick"><MenuItem.Icon><Path Classes="icon" Data="{StaticResource IconArrowLeft}"/></MenuItem.Icon></MenuItem>
                                                            <MenuItem Header="Elimina" Click="OnRemoteDeleteClick"><MenuItem.Icon><Path Classes="icon" Data="{StaticResource IconTrash}"/></MenuItem.Icon></MenuItem>
                                                        </ContextMenu>
                                                    </DataGrid.ContextMenu>
                                                    <DataGrid.Columns>
                                                        <DataGridTemplateColumn Header=" " Width="40" CanUserResize="False">
                                                            <DataGridTemplateColumn.CellTemplate>
                                                                <DataTemplate x:DataType="models:SftpRemoteEntry">
                                                                    <Panel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                                        <Path Classes="icon" Data="{StaticResource IconFolder}" Stroke="{DynamicResource AppWarningBrush}" IsVisible="{Binding IsDirectory}"/>
                                                                        <Path Classes="icon" Data="{StaticResource IconFile}" Stroke="{DynamicResource AppTextMutedBrush}" IsVisible="{Binding !IsDirectory}"/>
                                                                    </Panel>
                                                                </DataTemplate>
                                                            </DataGridTemplateColumn.CellTemplate>
                                                        </DataGridTemplateColumn>
                                                        <DataGridTextColumn Header="Nome" Binding="{Binding Name}" Width="*" MinWidth="150"/>
                                                        <DataGridTextColumn Header="Contenuto" Binding="{Binding ContentsInfo}" Width="Auto" MinWidth="100"/>
                                                        <DataGridTextColumn Header="Dim." Binding="{Binding SizeText}" Width="Auto" MinWidth="70"/>
                                                        <DataGridTextColumn Header="Ultima modifica" Binding="{Binding Modified, StringFormat='{}{0:dd/MM/yyyy HH:mm}'}" Width="Auto" MinWidth="120"/>
                                                    </DataGrid.Columns>
                                                </DataGrid>
                                            </DockPanel>
                                        </Border>
                                    </Grid>
                                </Panel>
                                <Panel IsVisible="{Binding #SftpTabs.SelectedIndex, Converter={x:Static vm:IndexEqualsConverter.Default}, ConverterParameter=1}">
                                    <DockPanel Margin="0,10,0,0">
                                        <Border DockPanel.Dock="Top" Classes="cardElevated" Margin="0,0,0,12">
                                            <StackPanel Spacing="10">
                                                <Grid ColumnDefinitions="Auto, *, Auto">
                                                    <TextBlock Grid.Column="0" Text="Cartella locale (upload rapido):" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                                    <TextBox Grid.Column="1" Text="{Binding SftpUploadLocalFolder}" Margin="0,0,8,0"/>
                                                    <Button Grid.Column="2" Classes="iconCircle" Click="OnBrowseSftpUploadLocalClick" ToolTip.Tip="Sfoglia"><Path Classes="icon" Data="{StaticResource IconFolder}"/></Button>
                                                </Grid>
                                                <Grid ColumnDefinitions="Auto, *">
                                                    <TextBlock Grid.Column="0" Text="Cartella remota:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                                    <TextBox Grid.Column="1" Text="{Binding SftpUploadRemoteFolder}"/>
                                                </Grid>
                                                <StackPanel Orientation="Horizontal" Spacing="10">
                                                    <TextBlock Text="Upload paralleli:" VerticalAlignment="Center"/>
                                                    <Slider Value="{Binding SftpMaxUploadConcurrency}" Minimum="1" Maximum="16" Width="140" TickFrequency="1" IsSnapToTickEnabled="True"/>
                                                    <TextBlock Text="{Binding SftpMaxUploadConcurrency}" Width="28" VerticalAlignment="Center" FontWeight="Bold" Foreground="{DynamicResource AppAccentBrush}"/>
                                                </StackPanel>
                                                <TextBlock Text="{Binding UploadQueueStats}" FontSize="11" Foreground="{DynamicResource AppTextMutedBrush}" FontStyle="Italic"/>
                                                <WrapPanel Orientation="Horizontal" ItemSpacing="8" LineSpacing="6">
                                                    <Button ToolTip.Tip="Accoda l'upload della cartella locale scelta nella cartella remota di destinazione" Classes="info" Command="{Binding SftpEnqueueFolderCommand}"><StackPanel Classes="bi"><Path Classes="icon" Data="{StaticResource IconQueue}"/><TextBlock Text="Accoda cartella"/></StackPanel></Button>
                                                    <Button ToolTip.Tip="Avvia tutti gli upload in attesa o in pausa" Classes="success" Command="{Binding SftpQueueStartAllCommand}"><StackPanel Classes="bi"><Path Classes="icon" Data="{StaticResource IconPlay}"/><TextBlock Text="Avvia tutti"/></StackPanel></Button>
                                                    <Button ToolTip.Tip="Mette in pausa tutti gli upload in corso" Classes="warning" Command="{Binding SftpQueuePauseAllCommand}"><StackPanel Classes="bi"><Path Classes="icon" Data="{StaticResource IconPause}"/><TextBlock Text="Pausa tutti"/></StackPanel></Button>
                                                    <Button ToolTip.Tip="Annulla tutti gli upload non ancora completati" Classes="danger" Command="{Binding SftpQueueCancelAllCommand}"><StackPanel Classes="bi"><Path Classes="icon" Data="{StaticResource IconClose}"/><TextBlock Text="Annulla tutti"/></StackPanel></Button>
                                                    <Button ToolTip.Tip="Rimuove dalla lista gli upload completati" Command="{Binding SftpQueueClearCompletedCommand}"><StackPanel Classes="bi"><Path Classes="icon" Data="{StaticResource IconCheckCircle}"/><TextBlock Text="Completati"/></StackPanel></Button>
                                                    <Button ToolTip.Tip="Rimuove dalla lista gli upload annullati" Command="{Binding SftpQueueClearCancelledCommand}"><StackPanel Classes="bi"><Path Classes="icon" Data="{StaticResource IconBan}"/><TextBlock Text="Annullati"/></StackPanel></Button>
                                                    <Button ToolTip.Tip="Rimuove dalla lista gli upload falliti" Command="{Binding SftpQueueClearFailedCommand}"><StackPanel Classes="bi"><Path Classes="icon" Data="{StaticResource IconAlertCircle}"/><TextBlock Text="Failed"/></StackPanel></Button>
                                                </WrapPanel>
                                            </StackPanel>
                                        </Border>
                                        <Border Classes="cardElevated">
                                            <DataGrid MinHeight="200" ItemsSource="{Binding SftpUploadJobs}" AutoGenerateColumns="False" IsReadOnly="True" CanUserResizeColumns="True" CanUserReorderColumns="True" CanUserSortColumns="False">
                                                <DataGrid.ContextMenu>
                                                    <ContextMenu>
                                                        <MenuItem Header="Avvia / Riprendi" Click="OnSftpJobResumeClick"><MenuItem.Icon><Path Classes="icon" Data="{StaticResource IconPlay}"/></MenuItem.Icon></MenuItem>
                                                        <MenuItem Header="Pausa" Click="OnSftpJobPauseClick"><MenuItem.Icon><Path Classes="icon" Data="{StaticResource IconPause}"/></MenuItem.Icon></MenuItem>
                                                        <MenuItem Header="Annulla" Click="OnSftpJobCancelClick"><MenuItem.Icon><Path Classes="icon" Data="{StaticResource IconClose}"/></MenuItem.Icon></MenuItem>
                                                        <Separator/>
                                                        <MenuItem Header="Rimuovi" Click="OnSftpJobRemoveClick"><MenuItem.Icon><Path Classes="icon" Data="{StaticResource IconTrash}"/></MenuItem.Icon></MenuItem>
                                                    </ContextMenu>
                                                </DataGrid.ContextMenu>
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="File" Binding="{Binding FileName}" Width="2*"/>
                                                    <DataGridTextColumn Header="Da" Binding="{Binding SourceFolder}" Width="2*"/>
                                                    <DataGridTextColumn Header="A" Binding="{Binding DestinationFolder}" Width="2*"/>
                                                    <DataGridTextColumn Header="Stato" Binding="{Binding Status}" Width="100"/>
                                                    <DataGridTemplateColumn Header="Progresso" Width="2*">
                                                        <DataGridTemplateColumn.CellTemplate>
                                                            <DataTemplate>
                                                                <Grid ColumnDefinitions="*, Auto" Margin="2">
                                                                    <ProgressBar Grid.Column="0" Value="{Binding Percentage}" Minimum="0" Maximum="100" Height="14"/>
                                                                    <TextBlock Grid.Column="1" Text="{Binding Percentage, StringFormat={}{0:F0}%}" Margin="8,0,0,0" VerticalAlignment="Center" FontSize="11"/>
                                                                </Grid>
                                                            </DataTemplate>
                                                        </DataGridTemplateColumn.CellTemplate>
                                                    </DataGridTemplateColumn>
                                                    <DataGridTextColumn Header="Dimensione" Binding="{Binding SizeText}" Width="150"/>
                                                    <DataGridTextColumn Header="Velocità" Binding="{Binding SpeedText}" Width="100"/>
                                                    <DataGridTextColumn Header="ETA" Binding="{Binding EtaText}" Width="100"/>
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </Border>
                                    </DockPanel>
                                </Panel>
                                <Panel IsVisible="{Binding #SftpTabs.SelectedIndex, Converter={x:Static vm:IndexEqualsConverter.Default}, ConverterParameter=2}">
                                    <DockPanel Margin="0,10,0,0">
                                        <Border DockPanel.Dock="Top" Classes="cardElevated" Margin="0,0,0,12">
                                            <StackPanel Spacing="10">
                                                <Grid ColumnDefinitions="Auto, *, Auto">
                                                    <TextBlock Grid.Column="0" Text="Cartella locale (destinazione):" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                                    <TextBox Grid.Column="1" Text="{Binding SftpDownloadLocalFolder}" PlaceholderText="(default: cartella locale corrente)" Margin="0,0,8,0"/>
                                                    <Button Grid.Column="2" Classes="iconCircle" Click="OnBrowseSftpDownloadLocalClick" ToolTip.Tip="Sfoglia"><Path Classes="icon" Data="{StaticResource IconFolder}"/></Button>
                                                </Grid>
                                                <StackPanel Orientation="Horizontal" Spacing="10">
                                                    <TextBlock Text="Download paralleli:" VerticalAlignment="Center"/>
                                                    <Slider Value="{Binding SftpMaxDownloadConcurrency}" Minimum="1" Maximum="16" Width="140" TickFrequency="1" IsSnapToTickEnabled="True"/>
                                                    <TextBlock Text="{Binding SftpMaxDownloadConcurrency}" Width="28" VerticalAlignment="Center" FontWeight="Bold" Foreground="{DynamicResource AppAccentBrush}"/>
                                                </StackPanel>
                                                <TextBlock Text="{Binding DownloadQueueStats}" FontSize="11" Foreground="{DynamicResource AppTextMutedBrush}" FontStyle="Italic"/>
                                                <WrapPanel Orientation="Horizontal" ItemSpacing="8" LineSpacing="6">
                                                    <Button ToolTip.Tip="Avvia tutti i download SFTP in attesa o in pausa" Classes="success" Command="{Binding SftpDownloadQueueStartAllCommand}"><StackPanel Classes="bi"><Path Classes="icon" Data="{StaticResource IconPlay}"/><TextBlock Text="Avvia tutti"/></StackPanel></Button>
                                                    <Button ToolTip.Tip="Mette in pausa tutti i download SFTP in corso" Classes="warning" Command="{Binding SftpDownloadQueuePauseAllCommand}"><StackPanel Classes="bi"><Path Classes="icon" Data="{StaticResource IconPause}"/><TextBlock Text="Pausa tutti"/></StackPanel></Button>
                                                    <Button ToolTip.Tip="Annulla tutti i download SFTP non ancora completati" Classes="danger" Command="{Binding SftpDownloadQueueCancelAllCommand}"><StackPanel Classes="bi"><Path Classes="icon" Data="{StaticResource IconClose}"/><TextBlock Text="Annulla tutti"/></StackPanel></Button>
                                                    <Button ToolTip.Tip="Rimuove dalla lista i download SFTP completati" Command="{Binding SftpDownloadQueueClearCompletedCommand}"><StackPanel Classes="bi"><Path Classes="icon" Data="{StaticResource IconCheckCircle}"/><TextBlock Text="Completati"/></StackPanel></Button>
                                                    <Button ToolTip.Tip="Rimuove dalla lista i download SFTP annullati" Command="{Binding SftpDownloadQueueClearCancelledCommand}"><StackPanel Classes="bi"><Path Classes="icon" Data="{StaticResource IconBan}"/><TextBlock Text="Annullati"/></StackPanel></Button>
                                                    <Button ToolTip.Tip="Rimuove dalla lista i download SFTP falliti" Command="{Binding SftpDownloadQueueClearFailedCommand}"><StackPanel Classes="bi"><Path Classes="icon" Data="{StaticResource IconAlertCircle}"/><TextBlock Text="Failed"/></StackPanel></Button>
                                                </WrapPanel>
                                            </StackPanel>
                                        </Border>
                                        <Border Classes="cardElevated">
                                            <DataGrid MinHeight="200" ItemsSource="{Binding SftpDownloadJobs}" AutoGenerateColumns="False" IsReadOnly="True" CanUserResizeColumns="True" CanUserReorderColumns="True" CanUserSortColumns="False">
                                                <DataGrid.ContextMenu>
                                                    <ContextMenu>
                                                        <MenuItem Header="Avvia / Riprendi" Click="OnSftpDownloadJobResumeClick"><MenuItem.Icon><Path Classes="icon" Data="{StaticResource IconPlay}"/></MenuItem.Icon></MenuItem>
                                                        <MenuItem Header="Pausa" Click="OnSftpDownloadJobPauseClick"><MenuItem.Icon><Path Classes="icon" Data="{StaticResource IconPause}"/></MenuItem.Icon></MenuItem>
                                                        <MenuItem Header="Annulla" Click="OnSftpDownloadJobCancelClick"><MenuItem.Icon><Path Classes="icon" Data="{StaticResource IconClose}"/></MenuItem.Icon></MenuItem>
                                                        <Separator/>
                                                        <MenuItem Header="Rimuovi" Click="OnSftpDownloadJobRemoveClick"><MenuItem.Icon><Path Classes="icon" Data="{StaticResource IconTrash}"/></MenuItem.Icon></MenuItem>
                                                    </ContextMenu>
                                                </DataGrid.ContextMenu>
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="File" Binding="{Binding FileName}" Width="2*"/>
                                                    <DataGridTextColumn Header="Da" Binding="{Binding SourceFolder}" Width="2*"/>
                                                    <DataGridTextColumn Header="A" Binding="{Binding DestinationFolder}" Width="2*"/>
                                                    <DataGridTextColumn Header="Stato" Binding="{Binding Status}" Width="100"/>
                                                    <DataGridTemplateColumn Header="Progresso" Width="2*">
                                                        <DataGridTemplateColumn.CellTemplate>
                                                            <DataTemplate>
                                                                <Grid ColumnDefinitions="*, Auto" Margin="2">
                                                                    <ProgressBar Grid.Column="0" Value="{Binding Percentage}" Minimum="0" Maximum="100" Height="14"/>
                                                                    <TextBlock Grid.Column="1" Text="{Binding Percentage, StringFormat={}{0:F0}%}" Margin="8,0,0,0" VerticalAlignment="Center" FontSize="11"/>
                                                                </Grid>
                                                            </DataTemplate>
                                                        </DataGridTemplateColumn.CellTemplate>
                                                    </DataGridTemplateColumn>
                                                    <DataGridTextColumn Header="Dimensione" Binding="{Binding SizeText}" Width="150"/>
                                                    <DataGridTextColumn Header="Velocità" Binding="{Binding SpeedText}" Width="100"/>
                                                    <DataGridTextColumn Header="ETA" Binding="{Binding EtaText}" Width="100"/>
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </Border>
                                    </DockPanel>
                                </Panel>
                            </Panel>
                        </DockPanel>
                    </DockPanel>
                </Panel>
                <Panel IsVisible="{Binding #MainTabs.SelectedIndex, Converter={x:Static vm:IndexEqualsConverter.Default}, ConverterParameter=5}">
                    <Grid RowDefinitions="Auto, Auto, Auto, *" Margin="0,10,0,10" DataContext="{Binding Videobox}">

                        <!-- STATUS (in alto, sopra la guida) -->
                        <ContentControl Grid.Row="0" Theme="{StaticResource StatusBannerTheme}" Content="{Binding StatusMessage}" IsVisible="{Binding StatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>

                        <!-- GUIDA VIDEOBOX -->
                        <Border Grid.Row="1" Classes="cardElevated" Margin="0,0,0,10" Padding="0" ClipToBounds="True">
                            <StackPanel>
                                <ToggleButton Classes="guideToggle" x:Name="ToggleGuideVideobox" IsChecked="False">
                                    <Grid ColumnDefinitions="*, Auto">
                                        <StackPanel Classes="bi">
                                            <Path Classes="icon accent" Data="{StaticResource IconBulb}"/>
                                            <TextBlock Text="Guida rapida - Videobox Corrector" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource AppTextBrush}"/>
                                        </StackPanel>
                                        <Path Grid.Column="1" Classes="chevron"/>
                                    </Grid>
                                </ToggleButton>
                                <Border IsVisible="{Binding #ToggleGuideVideobox.IsChecked}" Background="Transparent" Margin="16,0,16,16" Padding="12">
                                    <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource AppTextMutedBrush}">
                                        <Run FontWeight="Bold" Foreground="{DynamicResource AppTextBrush}">A cosa serve</Run><LineBreak/>
                                        Corregge i link video dei post del forum (Invision Community): confronta i link di ogni post con i file presenti sul server SFTP e genera i nuovi link sul dominio corretto.<LineBreak/>
                                        <LineBreak/>
                                        <Run FontWeight="Bold" Foreground="{DynamicResource AppTextBrush}">Come si usa</Run><LineBreak/>
                                        <Run FontWeight="SemiBold" Foreground="{DynamicResource AppTextBrush}">• 1. Configura:</Run> apri "Impostazioni e Domini", compila URL e API Key del forum, la cartella base SFTP, il dominio primario e il percorso pubblico, poi salva. L'anteprima mostra il link che verrà generato.<LineBreak/>
                                        <Run FontWeight="SemiBold" Foreground="{DynamicResource AppTextBrush}">• 2. Carica i post:</Run> scegli una categoria: "Carica Pag." carica 50 post, "Carica Tutti" li carica tutti a blocchi. Con la ricerca e "Nascondi OK" restano solo i post da sistemare.<LineBreak/>
                                        <Run FontWeight="SemiBold" Foreground="{DynamicResource AppTextBrush}">• 3. Carica l'albero:</Run> con l'SFTP connesso premi "Carica" sull'albero. Dopo il primo caricamento l'albero si aggiorna da solo: subito per le modifiche fatte dall'app, ogni minuto per quelle esterne.<LineBreak/>
                                        <Run FontWeight="SemiBold" Foreground="{DynamicResource AppTextBrush}">• 4. Mappa:</Run> seleziona un post, clicca la cartella che contiene i suoi episodi e premi "Mappa": ogni link vecchio viene abbinato a un file, in ordine naturale.<LineBreak/>
                                        <Run FontWeight="SemiBold" Foreground="{DynamicResource AppTextBrush}">• 5. Controlla e applica:</Run> nella tabella puoi scambiare gli abbinamenti e togliere la spunta alle righe da non toccare; "Applica" invia i nuovi link al forum.<LineBreak/>
                                        <LineBreak/>
                                        <Run FontWeight="Bold" Foreground="{DynamicResource AppTextBrush}">Significato dei colori</Run><LineBreak/>
                                        <Run Text="●" Foreground="#22C55E"/> <Run FontWeight="SemiBold" Foreground="{DynamicResource AppTextBrush}">Verde:</Run> tutti i link puntano a un dominio valido.<LineBreak/>
                                        <Run Text="●" Foreground="#F59E0B"/> <Run FontWeight="SemiBold" Foreground="{DynamicResource AppTextBrush}">Arancione:</Run> link misti, alcuni validi e altri vecchi.<LineBreak/>
                                        <Run Text="●" Foreground="#EF4444"/> <Run FontWeight="SemiBold" Foreground="{DynamicResource AppTextBrush}">Rosso:</Run> link tutti vecchi, oppure file senza nessun link.<LineBreak/>
                                        <Run Text="●" Foreground="#A855F7"/> <Run FontWeight="SemiBold" Foreground="{DynamicResource AppTextBrush}">Viola:</Run> mismatch, il numero di link del post è diverso dal numero di file nella cartella.
                                    </TextBlock>
                                </Border>
                            </StackPanel>
                        </Border>

                        <Border Grid.Row="2" Classes="cardElevated" Margin="0,0,0,10" Padding="0" ClipToBounds="True">
                            <StackPanel>
                                <ToggleButton Classes="guideToggle" x:Name="ToggleSettingsVideobox" IsChecked="False">
                                    <Grid ColumnDefinitions="*, Auto">
                                        <StackPanel Classes="bi">
                                            <Path Classes="icon accent" Data="{StaticResource IconSettings}"/>
                                            <TextBlock Text="Impostazioni e Domini" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource AppTextBrush}"/>
                                        </StackPanel>
                                        <Path Grid.Column="1" Classes="chevron"/>
                                    </Grid>
                                </ToggleButton>

                                <ScrollViewer IsVisible="{Binding #ToggleSettingsVideobox.IsChecked}" MaxHeight="430" VerticalScrollBarVisibility="Auto">
                                    <StackPanel x:Name="SettingsBodyVideobox" Spacing="12" Margin="16,0,16,16">

                                        <Grid ColumnDefinitions="*, 12, *">
                                            <!-- FORUM IPS + SFTP -->
                                            <Border Grid.Column="0" Classes="card">
                                                <StackPanel Spacing="12">
                                                    <StackPanel Spacing="2">
                                                        <StackPanel Classes="bi">
                                                            <Path Classes="icon accent" Data="{StaticResource IconPlug}"/>
                                                            <TextBlock Text="Connessione" FontWeight="Bold" FontSize="13"/>
                                                        </StackPanel>
                                                        <TextBlock Text="Dove leggere i post (forum IPS) e dove si trovano i file (server SFTP)." FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource AppTextMutedBrush}"/>
                                                    </StackPanel>

                                                    <StackPanel Spacing="4">
                                                        <TextBlock Text="URL del forum IPS" FontSize="12" FontWeight="SemiBold"/>
                                                        <TextBox Text="{Binding ConfigIpsBaseUrl, Mode=TwoWay}" PlaceholderText="https://ddlstreamitaly.cc" ToolTip.Tip="Indirizzo base del forum Invision Community, senza /api"/>
                                                    </StackPanel>

                                                    <StackPanel Spacing="4">
                                                        <TextBlock Text="API Key" FontSize="12" FontWeight="SemiBold"/>
                                                        <TextBox Text="{Binding ConfigIpsApiKey, Mode=TwoWay}" PasswordChar="•" PlaceholderText="Chiave REST API" ToolTip.Tip="Chiave REST API del forum: serve per leggere e aggiornare i post"/>
                                                        <TextBlock Text="AdminCP → Sistema → REST &amp; OAuth → Chiavi API" FontSize="11" Foreground="{DynamicResource AppTextMutedBrush}"/>
                                                    </StackPanel>

                                                    <StackPanel Spacing="4">
                                                        <TextBlock Text="Cartella base SFTP" FontSize="12" FontWeight="SemiBold"/>
                                                        <TextBox Text="{Binding ConfigSftpBasePath, Mode=TwoWay}" PlaceholderText="/media/Anime SUB.ITA" ToolTip.Tip="Radice dell'albero SFTP: viene caricata nell'albero e tolta dal percorso per creare l'URL pubblico"/>
                                                        <TextBlock Text="Radice dell'albero SFTP; viene tolta dal percorso quando si genera il link." FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource AppTextMutedBrush}"/>
                                                    </StackPanel>
                                                </StackPanel>
                                            </Border>

                                            <!-- GENERAZIONE LINK -->
                                            <Border Grid.Column="2" Classes="card">
                                                <StackPanel Spacing="12">
                                                    <StackPanel Spacing="2">
                                                        <StackPanel Classes="bi">
                                                            <Path Classes="icon accent" Data="{StaticResource IconGlobe}"/>
                                                            <TextBlock Text="Generazione link" FontWeight="Bold" FontSize="13"/>
                                                        </StackPanel>
                                                        <TextBlock Text="Come vengono costruiti i nuovi link a partire dal percorso del file." FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource AppTextMutedBrush}"/>
                                                    </StackPanel>

                                                    <StackPanel Spacing="4">
                                                        <TextBlock Text="Dominio primario" FontSize="12" FontWeight="SemiBold"/>
                                                        <TextBox Text="{Binding ConfigPrimaryStorageUrl, Mode=TwoWay}" PlaceholderText="https://ichigolink.top" ToolTip.Tip="Dominio con cui vengono generati i NUOVI link (è anche considerato valido)"/>
                                                    </StackPanel>

                                                    <StackPanel Spacing="4">
                                                        <TextBlock Text="Percorso pubblico" FontSize="12" FontWeight="SemiBold"/>
                                                        <TextBox Text="{Binding ConfigPublicPath, Mode=TwoWay}" PlaceholderText="Anime SUB.ITA" ToolTip.Tip="Cartella pubblica sul web, inserita subito dopo il dominio (può essere vuota)"/>
                                                    </StackPanel>

                                                    <Border Background="{DynamicResource AppInputBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="12,10">
                                                        <StackPanel Spacing="4">
                                                            <StackPanel Classes="bi">
                                                                <Path Classes="icon" Data="{StaticResource IconEye}"/>
                                                                <TextBlock Text="Anteprima" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AppTextMutedBrush}"/>
                                                            </StackPanel>
                                                            <TextBlock Text="{Binding UrlPreviewSource}" FontFamily="Consolas, Cascadia Mono, monospace" FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource AppTextMutedBrush}"/>
                                                            <Path Classes="icon" Data="{StaticResource IconArrowDown}" HorizontalAlignment="Left" Margin="2,0,0,0"/>
                                                            <SelectableTextBlock Text="{Binding UrlPreview}" FontFamily="Consolas, Cascadia Mono, monospace" FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource AppAccentBrush}"/>
                                                        </StackPanel>
                                                    </Border>
                                                </StackPanel>
                                            </Border>
                                        </Grid>

                                        <!-- DOMINI SECONDARI -->
                                        <Border Classes="card">
                                            <StackPanel Spacing="10">
                                                <Grid ColumnDefinitions="*, Auto">
                                                    <StackPanel Spacing="2">
                                                        <StackPanel Classes="bi">
                                                            <Path Classes="icon accent" Data="{StaticResource IconLayers}"/>
                                                            <TextBlock Text="Domini secondari" FontWeight="Bold" FontSize="13"/>
                                                        </StackPanel>
                                                        <TextBlock Text="Mirror considerati validi: i link che puntano qui risultano verdi e non vengono riscritti." FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource AppTextMutedBrush}"/>
                                                    </StackPanel>
                                                    <Button Grid.Column="1" Classes="info" Command="{Binding AddSecondaryDomainCommand}" VerticalAlignment="Center" ToolTip.Tip="Aggiunge una riga per un nuovo dominio valido">
                                                        <StackPanel Classes="bi"><Path Classes="icon" Data="{StaticResource IconPlus}"/><TextBlock Text="Aggiungi dominio"/></StackPanel>
                                                    </Button>
                                                </Grid>

                                                <TextBlock Text="Nessun dominio secondario: è valido solo il dominio primario." FontSize="12" FontStyle="Italic" Foreground="{DynamicResource AppTextMutedBrush}" IsVisible="{Binding !HasSecondaryDomains}"/>

                                                <ItemsControl ItemsSource="{Binding SecondaryDomains}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate><UniformGrid Columns="2"/></ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Grid ColumnDefinitions="*, Auto" Margin="0,0,10,8">
                                                                <TextBox Grid.Column="0" Text="{Binding Url, Mode=TwoWay}" PlaceholderText="https://mirror.example"/>
                                                                <Button Grid.Column="1" Classes="iconCircle danger" Width="30" Height="30" Margin="6,0,0,0" ToolTip.Tip="Rimuovi dominio"
                                                                        Command="{Binding $parent[ItemsControl].((vm:VideoboxTabViewModel)DataContext).RemoveSecondaryDomainCommand}" CommandParameter="{Binding}">
                                                                    <Path Classes="icon" Data="{StaticResource IconClose}"/>
                                                                </Button>
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Border>

                                        <Grid ColumnDefinitions="*, Auto">
                                            <StackPanel Classes="bi" VerticalAlignment="Center">
                                                <Path Classes="icon" Data="{StaticResource IconInfo}"/>
                                                <TextBlock Text="Dopo il salvataggio i colori di post e albero vengono ricalcolati." FontSize="11" Foreground="{DynamicResource AppTextMutedBrush}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <Button Grid.Column="1" Classes="accent" Command="{Binding SaveSettingsCommand}" ToolTip.Tip="Salva tutte le impostazioni e ricalcola i colori">
                                                <StackPanel Classes="bi"><Path Classes="icon" Data="{StaticResource IconSave}"/><TextBlock Text="Salva impostazioni"/></StackPanel>
                                            </Button>
                                        </Grid>
                                    </StackPanel>
                                </ScrollViewer>
                            </StackPanel>
                        </Border>

                        <Grid Grid.Row="3" ColumnDefinitions="340, 10, 300, 10, *">

                            <Grid Grid.Column="0" RowDefinitions="Auto, Auto, *">
                                <Border Classes="cardElevated" Padding="10" Margin="0,0,0,10">
                                    <StackPanel Spacing="10">
                                        <TextBlock Text="Categorie" FontWeight="Bold"/>
                                        <Grid ColumnDefinitions="*, Auto">
                                            <ComboBox Grid.Column="0"
                                                      ItemsSource="{Binding AvailableCategories}"
                                                      SelectedItem="{Binding SelectedCategory, Mode=TwoWay}"
                                                      Margin="0,0,5,0"
                                                      HorizontalAlignment="Stretch"
                                                      ToolTip.Tip="Seleziona la categoria di Videobox di cui caricare i post">
                                                <ComboBox.ItemTemplate>
                                                    <DataTemplate x:DataType="vm:CategoryItem">
                                                        <StackPanel Classes="bi">
                                                            <Path Classes="icon accent" Data="{StaticResource IconLayers}" IsVisible="{Binding IsAll}"/>
                                                            <Path Classes="icon" Data="{StaticResource IconFolder}" Stroke="{DynamicResource AppTextMutedBrush}" IsVisible="{Binding !IsAll}"/>
                                                            <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ComboBox.ItemTemplate>
                                            </ComboBox>
                                            <Button Grid.Column="1" Classes="iconCircle" Command="{Binding LoadCategoriesCommand}" ToolTip.Tip="Ricarica l'elenco delle categorie dal sito"><Path Classes="icon" Data="{StaticResource IconRefresh}"/></Button>
                                        </Grid>
                                        <Grid ColumnDefinitions="*, *" IsVisible="{Binding !IsLoadingPosts}">
                                            <Button Grid.Column="0" Command="{Binding LoadCategoryCommand}" Margin="0,0,5,0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" ToolTip.Tip="Carica solo la prima pagina (50 post)"><StackPanel Classes="bi"><Path Classes="icon" Data="{StaticResource IconRefresh}"/><TextBlock Text="Carica Pag."/></StackPanel></Button>
                                            <Button Grid.Column="1" Classes="accent" Command="{Binding LoadAllCategoryCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" ToolTip.Tip="Carica tutti i post della categoria a blocchi di 50"><StackPanel Classes="bi"><Path Classes="icon" Data="{StaticResource IconDownload}"/><TextBlock Text="Carica Tutti"/></StackPanel></Button>
                                        </Grid>
                                        <!-- Durante il caricamento: avanzamento + Stop al posto dei pulsanti -->
                                        <Grid ColumnDefinitions="*, Auto" IsVisible="{Binding IsLoadingPosts}">
                                            <StackPanel Grid.Column="0" Spacing="5" VerticalAlignment="Center" Margin="2,0,10,0">
                                                <TextBlock Text="{Binding PostsProgressText}" FontSize="11" Foreground="{DynamicResource AppTextMutedBrush}" TextTrimming="CharacterEllipsis"/>
                                                <ProgressBar IsIndeterminate="True" Height="4" MinWidth="0"/>
                                            </StackPanel>
                                            <Button Grid.Column="1" Classes="danger" Command="{Binding StopLoadingPostsCommand}" ToolTip.Tip="Ferma il caricamento dei post (quelli già scaricati restano)"><StackPanel Classes="bi"><Path Classes="icon" Data="{StaticResource IconStop}"/><TextBlock Text="Stop"/></StackPanel></Button>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <Border Grid.Row="1" Classes="cardElevated" Margin="0,0,0,10" Padding="10">
                                    <StackPanel Spacing="10">
                                        <TextBox Text="{Binding SearchQuery, Mode=TwoWay}" PlaceholderText="Cerca post per titolo..." ToolTip.Tip="Filtra i post caricati in memoria per titolo"/>

                                        <StackPanel Spacing="5">
                                            <TextBlock Text="{Binding TotalPostsText}" FontWeight="Bold" FontSize="11" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                            <CheckBox Content="Nascondi OK" HorizontalAlignment="Center" IsChecked="{Binding HideOkPosts, Mode=TwoWay}" FontSize="12" ToolTip.Tip="Nasconde i post che hanno già tutti i link corretti (pallino verde)"/>
                                        </StackPanel>

                                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                                            <ItemsControl ItemsSource="{Binding PageNumbers}">
                                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="4"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Button ToolTip.Tip="Vai a questa pagina di post" Content="{Binding}" Width="30" Height="30" Padding="0" FontSize="11"
                                                                Command="{Binding $parent[ItemsControl].((vm:VideoboxTabViewModel)DataContext).GoToPageCommand}" CommandParameter="{Binding}"/>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                    </StackPanel>
                                </Border>

                                <Border Grid.Row="2" Classes="cardElevated">
                                    <ListBox ItemsSource="{Binding CategoryPosts}" SelectedItem="{Binding SelectedPost, Mode=TwoWay}">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Grid ColumnDefinitions="Auto, *, Auto, Auto">
                                                    <Ellipse Grid.Column="0" Width="10" Height="10" Margin="0,0,8,0" VerticalAlignment="Center"
                                                             Fill="{Binding Status, Converter={x:Static vm:PostStatusToBrushConverter.Default}}"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding Title}" TextTrimming="CharacterEllipsis" FontSize="12" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="2" Text="{Binding LinkCount, StringFormat='[{0}]'}" Foreground="{DynamicResource AppTextMutedBrush}" FontSize="11" Margin="5,0" VerticalAlignment="Center" ToolTip.Tip="Numero di link nel post"/>
                                                    <Button Grid.Column="3" Classes="iconCircle" Width="24" Height="24"
                                                            Command="{Binding $parent[ItemsControl].((vm:VideoboxTabViewModel)DataContext).OpenPostUrlCommand}" CommandParameter="{Binding}"
                                                            ToolTip.Tip="Apri il post nel browser">
                                                        <Path Classes="icon" Data="{StaticResource IconGlobe}" Width="13" Height="13"/>
                                                    </Button>
                                                </Grid>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </Border>
                            </Grid>

                            <Border Grid.Column="2" Classes="cardElevated">
                                <DockPanel>
                                    <Grid DockPanel.Dock="Top" ColumnDefinitions="*, Auto" Margin="0,0,0,10">
                                        <StackPanel Grid.Column="0" Classes="bi">
                                            <Path Classes="icon accent" Data="{StaticResource IconCloud}"/>
                                            <TextBlock Text="Albero SFTP" FontWeight="Bold" FontSize="14"/>
                                        </StackPanel>
                                        <Button Grid.Column="1" Command="{Binding LoadSftpTreeCommand}" IsVisible="{Binding !IsLoadingTree}" ToolTip.Tip="Carica la struttura delle cartelle dal server SFTP"><StackPanel Classes="bi"><Path Classes="icon" Data="{StaticResource IconRefresh}"/><TextBlock Text="Carica"/></StackPanel></Button>
                                        <Button Grid.Column="1" Classes="danger" Command="{Binding StopLoadingTreeCommand}" IsVisible="{Binding IsLoadingTree}" ToolTip.Tip="Ferma il caricamento dell'albero"><StackPanel Classes="bi"><Path Classes="icon" Data="{StaticResource IconStop}"/><TextBlock Text="Stop"/></StackPanel></Button>
                                    </Grid>
                                    <StackPanel DockPanel.Dock="Top" Spacing="5" Margin="2,0,2,10" IsVisible="{Binding IsLoadingTree}">
                                        <TextBlock Text="{Binding TreeProgressText}" FontSize="11" Foreground="{DynamicResource AppTextMutedBrush}"/>
                                        <ProgressBar IsIndeterminate="True" Height="4" MinWidth="0"/>
                                    </StackPanel>

                                    <Border DockPanel.Dock="Top" IsVisible="{Binding !IsSftpConnected}" Background="{DynamicResource AppDangerSoftBrush}" BorderBrush="{DynamicResource AppDangerBrush}" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,0,10">
                                        <StackPanel Spacing="5" HorizontalAlignment="Center">
                                            <StackPanel Classes="bi" HorizontalAlignment="Center">
                                                <Path Classes="icon" Stroke="{DynamicResource AppDangerBrush}" Data="{StaticResource IconBoltOff}"/>
                                                <TextBlock Text="SFTP Disconnesso" FontWeight="Bold" Foreground="{DynamicResource AppDangerBrush}"/>
                                            </StackPanel>
                                            <TextBlock Text="Riconnettiti e ricarica l'albero." FontSize="11" TextWrapping="Wrap" HorizontalAlignment="Center" TextAlignment="Center"/>
                                        </StackPanel>
                                    </Border>

                                    <TreeView ItemsSource="{Binding SftpRootNodes}" SelectedItem="{Binding SelectedSftpNode, Mode=TwoWay}" Background="Transparent" IsEnabled="{Binding IsSftpConnected}">
                                        <TreeView.ItemTemplate>
                                            <TreeDataTemplate ItemsSource="{Binding Children}">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <Ellipse Width="10" Height="10" VerticalAlignment="Center" Fill="{Binding Status, Converter={x:Static vm:NodeStatusToBrushConverter.Default}}"/>
                                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </TreeDataTemplate>
                                        </TreeView.ItemTemplate>
                                    </TreeView>
                                </DockPanel>
                            </Border>

                            <Grid Grid.Column="4" RowDefinitions="Auto, *" IsEnabled="{Binding SelectedPost}">
                                <Border Classes="cardElevated" Margin="0,0,0,10">
                                    <StackPanel Spacing="10">
                                        <TextBlock Text="{Binding CurrentPostTitle}" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource AppAccentBrush}" TextWrapping="Wrap"/>
                                        <Grid ColumnDefinitions="*, Auto">
                                            <TextBox Grid.Column="0" Text="{Binding SftpPathInput, Mode=TwoWay}" Margin="0,0,10,0" PlaceholderText="Seleziona cartella dall'albero..." ToolTip.Tip="Percorso della cartella SFTP contenente i file di questo post"/>
                                            <Button Grid.Column="1" Classes="info" Command="{Binding MapSftpFolderAsync}" ToolTip.Tip="Abbina i file della cartella selezionata ai link del post"><StackPanel Classes="bi"><Path Classes="icon" Data="{StaticResource IconLayers}"/><TextBlock Text="Mappa"/></StackPanel></Button>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <Border Grid.Row="1" Classes="cardElevated">
                                    <DockPanel>
                                        <Grid DockPanel.Dock="Top" ColumnDefinitions="*, Auto" Margin="0,0,0,10">
                                            <TextBlock Grid.Column="0" Text="Anteprima Modifiche" FontWeight="Bold" VerticalAlignment="Center"/>
                                            <Button Grid.Column="1" Classes="success" Command="{Binding ApplyUpdatesAsync}" ToolTip.Tip="Invia i nuovi link a Videobox. I link deselezionati verranno rimossi dal post."><StackPanel Classes="bi"><Path Classes="icon" Data="{StaticResource IconCheck}"/><TextBlock Text="Applica"/></StackPanel></Button>
                                        </Grid>

                                        <DataGrid MinHeight="200"
                                                  ItemsSource="{Binding MappingItems}"
                                                  AutoGenerateColumns="False"
                                                  IsReadOnly="False"
                                                  CanUserResizeColumns="True"
                                                  CanUserReorderColumns="True"
                                                  CanUserSortColumns="False"
                                                  HorizontalScrollBarVisibility="Auto"
                                                  VerticalScrollBarVisibility="Auto">
                                            <DataGrid.Columns>
                                                <DataGridCheckBoxColumn Header="Usa" Binding="{Binding IsSelectedForUpdate}" Width="50"/>
                                                <DataGridTemplateColumn Header="Stato" Width="50" IsReadOnly="True">
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <Ellipse Width="12" Height="12" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                     Fill="{Binding Status, Converter={x:Static vm:StatusToBrushConverter.Default}}"/>
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>

                                                <DataGridTextColumn Header="Vecchio URL" Binding="{Binding OldUrl}" Width="*" MinWidth="200" IsReadOnly="True"/>
                                                <DataGridTextColumn Header="File SFTP" Binding="{Binding SftpFileName}" Width="150" MinWidth="150" IsReadOnly="True"/>
                                                <DataGridTextColumn Header="Nuovo URL" Binding="{Binding NewUrl}" Width="*" MinWidth="200" IsReadOnly="True"/>

                                                <DataGridTemplateColumn Header="Sposta" Width="80" IsReadOnly="True">
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <StackPanel Orientation="Horizontal" Spacing="2" HorizontalAlignment="Center">
                                                                <Button Classes="iconCircle" Width="24" Height="24" ToolTip.Tip="Sposta su"
                                                                        Command="{Binding $parent[DataGrid].((vm:VideoboxTabViewModel)DataContext).SwapUpCommand}" CommandParameter="{Binding}">
                                                                    <Path Classes="icon" Data="{StaticResource IconArrowUp}" Width="12" Height="12"/>
                                                                </Button>
                                                                <Button Classes="iconCircle" Width="24" Height="24" ToolTip.Tip="Sposta giù"
                                                                        Command="{Binding $parent[DataGrid].((vm:VideoboxTabViewModel)DataContext).SwapDownCommand}" CommandParameter="{Binding}">
                                                                    <Path Classes="icon" Data="{StaticResource IconArrowDown}" Width="12" Height="12"/>
                                                                </Button>
                                                            </StackPanel>
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </DockPanel>
                                </Border>
                            </Grid>
                        </Grid>
                    </Grid>
                </Panel>
                <Panel IsVisible="{Binding #MainTabs.SelectedIndex, Converter={x:Static vm:IndexEqualsConverter.Default}, ConverterParameter=6}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" DataContext="{Binding Proxy}">
                    <DockPanel Margin="0,10,0,0">
                        <!-- STATUS (in alto, sopra la guida) -->
                        <ContentControl DockPanel.Dock="Top" Theme="{StaticResource StatusBannerTheme}" Content="{Binding ProxyStatusMessage}"/>

                        <!-- GUIDA PROXY -->
                        <Border DockPanel.Dock="Top" Classes="cardElevated" Margin="0,0,0,12" Padding="0" ClipToBounds="True">
                            <StackPanel>
                                <ToggleButton Classes="guideToggle" x:Name="ToggleGuideProxy" IsChecked="False">
                                    <Grid ColumnDefinitions="*, Auto">
                                        <StackPanel Classes="bi">
                                            <Path Classes="icon accent" Data="{StaticResource IconBulb}"/>
                                            <TextBlock Text="Guida rapida - Proxy" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource AppTextBrush}"/>
                                        </StackPanel>
                                        <Path Grid.Column="1" Classes="chevron"/>
                                    </Grid>
                                </ToggleButton>
                                <Border IsVisible="{Binding #ToggleGuideProxy.IsChecked}" Background="Transparent" Margin="16,0,16,16" Padding="12">
                                    <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource AppTextMutedBrush}">
                                        <Run FontWeight="Bold" Foreground="{DynamicResource AppTextBrush}">A cosa serve</Run><LineBreak/>
                                        Fa passare il traffico dei provider (AnimeWorld, AnimeSaturn, StreamingCommunity) e dei download da un proxy, utile contro blocchi per IP o Cloudflare. Ogni provider ha il suo proxy attivo.<LineBreak/>
                                        <LineBreak/>
                                        <Run FontWeight="Bold" Foreground="{DynamicResource AppTextBrush}">Come si usa</Run><LineBreak/>
                                        <Run FontWeight="SemiBold" Foreground="{DynamicResource AppTextBrush}">• Aggiungi:</Run> "Nuovo" per inserirne uno a mano, oppure importa un file .txt (una riga per proxy, formati host:porta, host:porta:utente:password, protocollo://...).<LineBreak/>
                                        <Run FontWeight="SemiBold" Foreground="{DynamicResource AppTextBrush}">• Testa:</Run> scegli il provider in alto e premi "Test tutti" o "Test selezionati": l'esito compare accanto a ogni proxy. Con "httpbin" provi solo che il proxy funzioni e vedi l'IP di uscita.<LineBreak/>
                                        <Run FontWeight="SemiBold" Foreground="{DynamicResource AppTextBrush}">• Attiva:</Run> seleziona un proxy e premi "Attiva per provider"; se non ha già un test OK viene testato prima. Il badge in alto a destra mostra i provider con un proxy attivo.<LineBreak/>
                                        <Run FontWeight="SemiBold" Foreground="{DynamicResource AppTextBrush}">• Rotazione:</Run> "Ruota al prossimo" passa al proxy successivo funzionante. Se un proxy fallisce durante l'uso, l'app ruota da sola.<LineBreak/>
                                        <LineBreak/>
                                        <Run FontWeight="Bold" Foreground="{DynamicResource AppTextBrush}">Pulizia delle liste</Run><LineBreak/>
                                        Nel riquadro "Rimuovi solo dalla lista corrente", "Rimuovi selezionati" e "Rimuovi falliti" nascondono i proxy solo per il provider corrente, senza cancellarli; "Reset filtri" li fa ricomparire. I pulsanti "Elimina" invece cancellano in modo definitivo.<LineBreak/>
                                        <LineBreak/>
                                        <Run FontWeight="SemiBold" Foreground="{DynamicResource AppTextBrush}">• Opzioni globali:</Run> le caselle dei provider (AnimeWorld, AnimeSaturn, StreamingCommunity, Download) accendono o spengono l'uso del proxy per ogni provider senza perdere la configurazione.
                                    </TextBlock>
                                </Border>
                            </StackPanel>
                        </Border>

                        <Border DockPanel.Dock="Top" Classes="cardElevated" Margin="0,0,0,12">
                            <StackPanel Spacing="8">
                                <StackPanel Classes="bi">
                                    <Path Classes="icon accent" Data="{StaticResource IconGlobe}"/>
                                    <TextBlock Text="Interruttore proxy per provider" FontWeight="Bold" FontSize="14"/>
                                </StackPanel>
                                <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource AppTextMutedBrush}">
                                    Ogni checkbox attiva/disattiva l'uso del proxy per quel provider.
                                    Se disattivato, il provider ignora qualsiasi proxy e va in connessione
                                    diretta (utile se un provider non tollera i proxy). Ogni provider può
                                    avere un proxy diverso: usa il pulsante <Run FontWeight="Bold">Attiva per provider</Run>
                                    più sotto, dopo aver scelto il provider nella ComboBox della toolbar.
                                </TextBlock>
                                <WrapPanel Orientation="Horizontal" ItemSpacing="20" Margin="0,4,0,0">
                                    <CheckBox Content="AnimeWorld" IsChecked="{Binding UseProxyAnimeWorld, Mode=TwoWay}" ToolTip.Tip="Se attivo, usa il proxy per questo provider"/>
                                    <CheckBox Content="AnimeSaturn" IsChecked="{Binding UseProxyAnimeSaturn, Mode=TwoWay}" ToolTip.Tip="Se attivo, usa il proxy per questo provider"/>
                                    <CheckBox Content="StreamingCommunity" IsChecked="{Binding UseProxyStreamingCommunity, Mode=TwoWay}" ToolTip.Tip="Se attivo, usa il proxy per questo provider"/>
                                    <CheckBox Content="Download diretti" IsChecked="{Binding UseProxyDownloads, Mode=TwoWay}" ToolTip.Tip="Se attivo, usa il proxy per i download"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <Border DockPanel.Dock="Top" Classes="cardElevated" Margin="0,0,0,12">
                            <StackPanel Spacing="8">
                                <WrapPanel Orientation="Horizontal" ItemSpacing="8" LineSpacing="6">
                                    <Button ToolTip.Tip="Aggiunge un nuovo proxy vuoto: compila i campi e premi Salva" Classes="accent" Command="{Binding ProxyNewCommand}"><StackPanel Classes="bi"><Path Classes="icon" Data="{StaticResource IconPlus}"/><TextBlock Text="Nuovo"/></StackPanel></Button>
                                    <Button Click="OnProxyImportFileClick" ToolTip.Tip="Importa da file .txt o .csv"><StackPanel Classes="bi"><Path Classes="icon" Data="{StaticResource IconFolder}"/><TextBlock Text="Importa"/></StackPanel></Button>
                                    <Button ToolTip.Tip="Salva le modifiche al proxy selezionato" Command="{Binding ProxySaveCommand}" IsEnabled="{Binding !IsProxyBusy}"><StackPanel Classes="bi"><Path Classes="icon" Data="{StaticResource IconSave}"/><TextBlock Text="Salva"/></StackPanel></Button>
                                    <Button ToolTip.Tip="Usa il proxy selezionato per il provider scelto in alto (se non ha un test OK lo testa prima)" Classes="success" Command="{Binding ProxyActivateCommand}" IsEnabled="{Binding CanActivateForProvider}"><StackPanel Classes="bi"><Path Classes="icon" Data="{StaticResource IconBolt}"/><TextBlock Text="Attiva per provider"/></StackPanel></Button>
                                    <Button ToolTip.Tip="Smette di usare un proxy per il provider scelto" Classes="danger" Command="{Binding ProxyDeactivateCommand}" IsEnabled="{Binding CanDeactivateForProvider}"><StackPanel Classes="bi"><Path Classes="icon" Data="{StaticResource IconBoltOff}"/><TextBlock Text="Disattiva per provider"/></StackPanel></Button>
                                    <Button Classes="accent" Command="{Binding ProxyRotateNextCommand}" IsEnabled="{Binding CanRotateForProvider}" ToolTip.Tip="Passa al proxy successivo per il provider selezionato"><StackPanel Classes="bi"><Path Classes="icon" Data="{StaticResource IconRepeat}"/><TextBlock Text="Ruota al prossimo"/></StackPanel></Button>
                                </WrapPanel>

                                <WrapPanel Orientation="Horizontal" ItemSpacing="8" LineSpacing="6">
                                    <TextBlock Text="Selezione:" VerticalAlignment="Center" Foreground="{DynamicResource AppTextMutedBrush}" FontSize="12"/>
                                    <Button ToolTip.Tip="Spunta tutti i proxy visibili" Command="{Binding ProxySelectAllCommand}"><StackPanel Classes="bi"><Path Classes="icon" Data="{StaticResource IconCheck}"/><TextBlock Text="Tutti"/></StackPanel></Button>
                                    <Button ToolTip.Tip="Toglie la spunta a tutti i proxy" Command="{Binding ProxyDeselectAllCommand}"><StackPanel Classes="bi"><Path Classes="icon" Data="{StaticResource IconBan}"/><TextBlock Text="Nessuno"/></StackPanel></Button>
                                    <TextBlock Text="Provider:" VerticalAlignment="Center" Foreground="{DynamicResource AppTextMutedBrush}" FontSize="12"/>
                                    <ComboBox ItemsSource="{Binding TestProviders}" SelectedItem="{Binding SelectedTestProvider, Mode=TwoWay}" MinWidth="180" VerticalAlignment="Center"/>
                                    <TextBlock Text="Bot:" VerticalAlignment="Center" Foreground="{DynamicResource AppTextMutedBrush}" FontSize="12"/>
                                    <Slider Value="{Binding ProxyTestConcurrency}" Minimum="1" Maximum="20" Width="100" TickFrequency="1" IsSnapToTickEnabled="True" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding ProxyTestConcurrency}" Width="20" VerticalAlignment="Center" FontWeight="Bold" Foreground="{DynamicResource AppAccentBrush}"/>
                                    <Button ToolTip.Tip="Testa i proxy spuntati sul provider scelto" Classes="info" Command="{Binding ProxyTestSelectedCommand}" IsEnabled="{Binding !IsProxyBusy}"><StackPanel Classes="bi"><Path Classes="icon" Data="{StaticResource IconPlug}"/><TextBlock Text="Test selezionati"/></StackPanel></Button>
                                    <Button ToolTip.Tip="Testa tutti i proxy visibili sul provider scelto" Classes="info" Command="{Binding ProxyTestAllCommand}" IsEnabled="{Binding !IsProxyBusy}"><StackPanel Classes="bi"><Path Classes="icon" Data="{StaticResource IconPlug}"/><TextBlock Text="Test tutti"/></StackPanel></Button>
                                    <Button ToolTip.Tip="Interrompe i test in corso" Classes="danger" Command="{Binding ProxyStopTestCommand}" IsEnabled="{Binding IsProxyBusy}"><StackPanel Classes="bi"><Path Classes="icon" Data="{StaticResource IconStop}"/><TextBlock Text="Stop test"/></StackPanel></Button>
                                </WrapPanel>

                                <WrapPanel Orientation="Horizontal" ItemSpacing="8" LineSpacing="6">
                                    <TextBlock Text="Rimuovi solo dalla lista corrente:" VerticalAlignment="Center" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AppTextMutedBrush}"/>
                                    <Button Command="{Binding ProxyRemoveFromCurrentListCommand}" ToolTip.Tip="Rimuove il proxy solo dalla lista del provider corrente"><StackPanel Classes="bi"><Path Classes="icon" Data="{StaticResource IconMinus}"/><TextBlock Text="Rimuovi selezionati"/></StackPanel></Button>
                                    <Button Command="{Binding ProxyClearFailedFromCurrentListCommand}" ToolTip.Tip="Rimuove i proxy falliti solo dalla lista del provider corrente"><StackPanel Classes="bi"><Path Classes="icon" Data="{StaticResource IconMinus}"/><TextBlock Text="Rimuovi falliti"/></StackPanel></Button>
                                    <Button Classes="warning" Command="{Binding ProxyResetFiltersCommand}" ToolTip.Tip="Ri-mostra tutti i proxy nascosti in tutte le liste"><StackPanel Classes="bi"><Path Classes="icon" Data="{StaticResource IconUndo}"/><TextBlock Text="Reset filtri"/></StackPanel></Button>
                                </WrapPanel>

                                <WrapPanel Orientation="Horizontal" ItemSpacing="8" LineSpacing="6">
                                    <TextBlock Text="Elimina da tutte le liste:" VerticalAlignment="Center" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AppTextMutedBrush}"/>
                                    <Button ToolTip.Tip="Elimina definitivamente i proxy spuntati" Classes="danger" Command="{Binding ProxyDeleteSelectedCommand}"><StackPanel Classes="bi"><Path Classes="icon" Data="{StaticResource IconTrash}"/><TextBlock Text="Elimina selezionati"/></StackPanel></Button>
                                    <Button ToolTip.Tip="Elimina definitivamente i proxy con test fallito" Classes="danger" Command="{Binding ProxyDeleteFailedCommand}"><StackPanel Classes="bi"><Path Classes="icon" Data="{StaticResource IconTrash}"/><TextBlock Text="Elimina falliti"/></StackPanel></Button>
                                    <Button ToolTip.Tip="Elimina definitivamente tutti i proxy" Classes="danger" Command="{Binding ProxyDeleteAllCommand}"><StackPanel Classes="bi"><Path Classes="icon" Data="{StaticResource IconTrash}"/><TextBlock Text="Elimina tutti"/></StackPanel></Button>
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <Grid ColumnDefinitions="2*, 3*">
                            <Border Grid.Column="0" Classes="cardElevated" Margin="0,0,6,0">
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="0,0,0,8">
                                        <TextBlock Text="Lista proxy" FontWeight="Bold" FontSize="14" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding VisibleCountText}" FontSize="12" Foreground="{DynamicResource AppTextMutedBrush}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <ScrollViewer MaxHeight="600" VerticalScrollBarVisibility="Auto">
                                        <ListBox ItemsSource="{Binding VisibleProxies}" SelectedItem="{Binding SelectedProxy, Mode=TwoWay}" SelectionMode="Multiple" SelectionChanged="OnProxyListSelectionChanged">
                                            <ListBox.Styles>
                                                <Style Selector="ListBoxItem">
                                                    <Setter Property="BorderThickness" Value="2"/>
                                                    <Setter Property="BorderBrush" Value="Transparent"/>
                                                    <Setter Property="Margin" Value="2"/>
                                                    <Setter Property="Padding" Value="6,4"/>
                                                </Style>
                                                <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
                                                    <Setter Property="Background" Value="{DynamicResource AppSurface2Brush}"/>
                                                </Style>
                                            </ListBox.Styles>
                                            <ListBox.ItemTemplate>
                                                <DataTemplate DataType="models:ProxyConfig">
                                                    <Border CornerRadius="6" Padding="8,6" BorderThickness="2" BorderBrush="Transparent">
                                                        <Grid ColumnDefinitions="Auto, Auto, *, Auto, Auto">
                                                            <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected, Mode=TwoWay}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                            <Ellipse Grid.Column="1" Width="12" Height="12" Margin="0,0,8,0" VerticalAlignment="Center" Fill="{Binding IsActiveForSelectedProvider, Converter={x:Static vm:EnabledProxyToBrushConverter.Default}}"/>
                                                            <StackPanel Grid.Column="2">
                                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                                                <TextBlock Text="{Binding DisplayText}" FontSize="11" Foreground="{DynamicResource AppTextMutedBrush}"/>
                                                            </StackPanel>
                                                            <TextBlock Grid.Column="3" Text="{Binding TestResult}" FontSize="11" MaxWidth="220" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="8,0"/>
                                                            <TextBlock Grid.Column="4" Text="{Binding ActiveProvidersText}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource AppAccentBrush}" VerticalAlignment="Center" Margin="8,0,0,0" ToolTip.Tip="Provider per cui è attivo (AW=AnimeWorld, AS=AnimeSaturn, SC=StreamingCommunity, DL=Download diretti)"/>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </ScrollViewer>
                                </DockPanel>
                            </Border>

                            <Border Grid.Column="1" Classes="cardElevated" Margin="6,0,0,0">
                                <ScrollViewer>
                                    <StackPanel Spacing="10" DataContext="{Binding SelectedProxy}">
                                        <TextBlock Text="Dettagli proxy selezionato" FontWeight="Bold" FontSize="14"/>
                                        <Grid ColumnDefinitions="120, *" RowDefinitions="Auto, Auto, Auto, Auto, Auto, Auto, Auto">
                                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Nome:" VerticalAlignment="Center" Margin="0,0,10,4"/>
                                            <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding Name}" Margin="0,0,0,4"/>
                                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Protocollo:" VerticalAlignment="Center" Margin="0,0,10,4"/>
                                            <ComboBox Grid.Row="1" Grid.Column="1" SelectedIndex="{Binding ProtocolIndex, Mode=TwoWay}" HorizontalAlignment="Stretch" Margin="0,0,0,4">
                                                <ComboBoxItem>HTTP</ComboBoxItem>
                                                <ComboBoxItem>SOCKS5</ComboBoxItem>
                                            </ComboBox>
                                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Host:" VerticalAlignment="Center" Margin="0,0,10,4"/>
                                            <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Host}" Margin="0,0,0,4"/>
                                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Porta:" VerticalAlignment="Center" Margin="0,0,10,4"/>
                                            <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding Port}" Margin="0,0,0,4"/>
                                            <TextBlock Grid.Row="4" Grid.Column="0" Text="Autenticazione:" VerticalAlignment="Center" Margin="0,0,10,4"/>
                                            <ComboBox Grid.Row="4" Grid.Column="1" SelectedIndex="{Binding AuthIndex, Mode=TwoWay}" HorizontalAlignment="Stretch" Margin="0,0,0,4">
                                                <ComboBoxItem>Nessuna</ComboBoxItem>
                                                <ComboBoxItem>Username + Password</ComboBoxItem>
                                            </ComboBox>
                                            <TextBlock Grid.Row="5" Grid.Column="0" Text="Username:" VerticalAlignment="Center" Margin="0,0,10,4"/>
                                            <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding Username}" Margin="0,0,0,4"/>
                                            <TextBlock Grid.Row="6" Grid.Column="0" Text="Password:" VerticalAlignment="Center" Margin="0,0,10,4"/>
                                            <TextBox Grid.Row="6" Grid.Column="1" Text="{Binding Password, Mode=TwoWay}" PasswordChar="•" HorizontalAlignment="Stretch" Margin="0,0,0,4"/>
                                        </Grid>

                                        <Border Background="{DynamicResource AppSurface2Brush}" CornerRadius="8" Padding="10">
                                            <StackPanel Spacing="4">
                                                <TextBlock Text="{Binding TestResult}" FontFamily="Consolas,Menlo,monospace" TextWrapping="Wrap"/>
                                                <TextBlock Text="{Binding LastTested, StringFormat='Ultimo test: {0:dd/MM/yyyy HH:mm:ss}'}" FontSize="11" Foreground="{DynamicResource AppTextMutedBrush}"/>
                                                <TextBlock Text="{Binding ProviderResultsText, StringFormat='Provider: {0}'}" FontSize="11" Foreground="{DynamicResource AppAccentBrush}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </ScrollViewer>
                            </Border>
                        </Grid>
                    </DockPanel>
                    </ScrollViewer>
                </Panel>
                <Panel IsVisible="{Binding #MainTabs.SelectedIndex, Converter={x:Static vm:IndexEqualsConverter.Default}, ConverterParameter=7}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" DataContext="{Binding Domains}">
                        <DockPanel Margin="0,10,0,0">
                            <!-- STATUS (in alto, sopra la guida) -->
                            <ContentControl DockPanel.Dock="Top" Theme="{StaticResource StatusBannerTheme}" Content="{Binding StatusMessage}"/>

                            <!-- GUIDA DOMINI -->
                            <Border DockPanel.Dock="Top" Classes="cardElevated" Margin="0,0,0,12" Padding="0" ClipToBounds="True">
                                <StackPanel>
                                    <ToggleButton Classes="guideToggle" x:Name="ToggleGuideDomini" IsChecked="False">
                                        <Grid ColumnDefinitions="*, Auto">
                                            <StackPanel Classes="bi">
                                                <Path Classes="icon accent" Data="{StaticResource IconBulb}"/>
                                                <TextBlock Text="Guida rapida - Domini" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource AppTextBrush}"/>
                                            </StackPanel>
                                            <Path Grid.Column="1" Classes="chevron"/>
                                        </Grid>
                                    </ToggleButton>
                                    <Border IsVisible="{Binding #ToggleGuideDomini.IsChecked}" Background="Transparent" Margin="16,0,16,16" Padding="12">
                                        <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource AppTextMutedBrush}">
                                            <Run FontWeight="Bold" Foreground="{DynamicResource AppTextBrush}">A cosa serve</Run><LineBreak/>
                                            I siti dei provider cambiano spesso indirizzo. Qui vedi il dominio usato per ciascun provider e se risponde.<LineBreak/>
                                            <LineBreak/>
                                            <Run FontWeight="Bold" Foreground="{DynamicResource AppTextBrush}">Come si usa</Run><LineBreak/>
                                            <Run FontWeight="SemiBold" Foreground="{DynamicResource AppTextBrush}">• Test:</Run> "Test tutti" (o il pulsante a spina su una riga) controlla stato HTTP e tempo di risposta. Il pallino è verde se il sito risponde e rosso se non è raggiungibile.<LineBreak/>
                                            <Run FontWeight="SemiBold" Foreground="{DynamicResource AppTextBrush}">• Modifica:</Run> se un sito ha cambiato indirizzo, scrivi quello nuovo e premi il pulsante Salva della riga: i provider useranno subito il nuovo dominio.<LineBreak/>
                                            <Run FontWeight="SemiBold" Foreground="{DynamicResource AppTextBrush}">• Ripristina:</Run> il pulsante con la freccia circolare riporta il dominio predefinito.<LineBreak/>
                                            <LineBreak/>
                                            <Run FontWeight="SemiBold" Foreground="{DynamicResource AppTextBrush}">• Indicatore:</Run> il pallino sulla tab Domini diventa rosso quando almeno un dominio non risponde.
                                        </TextBlock>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <Border DockPanel.Dock="Top" Classes="cardElevated" Margin="0,0,0,12">
                                <WrapPanel Orientation="Horizontal" ItemSpacing="8" LineSpacing="6">
                                    <Button ToolTip.Tip="Verifica che tutti i domini rispondano (stato HTTP e tempo di risposta)" Classes="info" Command="{Binding TestAllCommand}" IsEnabled="{Binding !IsTestingAll}"><StackPanel Classes="bi"><Path Classes="icon" Data="{StaticResource IconPlug}"/><TextBlock Text="Test tutti"/></StackPanel></Button>
                                    <Button ToolTip.Tip="Interrompe il test dei domini" Classes="danger" Command="{Binding StopTestAllCommand}" IsVisible="{Binding IsTestingAll}"><StackPanel Classes="bi"><Path Classes="icon" Data="{StaticResource IconStop}"/><TextBlock Text="Stop"/></StackPanel></Button>
                                </WrapPanel>
                            </Border>

                            <Border Classes="cardElevated">
                                <StackPanel Spacing="4">
                                    <Grid ColumnDefinitions="140, *, 180, 140, Auto, Auto" Margin="10,4,10,8">
                                        <TextBlock Grid.Column="0" Text="Provider" FontWeight="Bold" FontSize="12"/>
                                        <TextBlock Grid.Column="1" Text="URL" FontWeight="Bold" FontSize="12"/>
                                        <TextBlock Grid.Column="2" Text="Stato" FontWeight="Bold" FontSize="12"/>
                                        <TextBlock Grid.Column="3" Text="Ultimo test" FontWeight="Bold" FontSize="12"/>
                                    </Grid>

                                    <ItemsControl ItemsSource="{Binding Domains}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="models:DomainConfig">
                                                <Border Padding="10,7" Background="{DynamicResource DownloadGroupRowBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="0,0,0,1">
                                                    <Grid ColumnDefinitions="140, *, 180, 140, Auto, Auto">
                                                        <TextBlock Grid.Column="0" Text="{Binding ProviderName}" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                                        <TextBox Grid.Column="1" Text="{Binding Url, Mode=TwoWay}" Margin="0,0,8,0" MinHeight="32" VerticalAlignment="Center"/>
                                                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding StatusIcon}" FontSize="14" VerticalAlignment="Center"/>
                                                            <TextBlock Text="{Binding StatusMessage}" FontSize="11" Foreground="{DynamicResource AppTextMutedBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                        </StackPanel>
                                                        <TextBlock Grid.Column="3" Text="{Binding LastTested, StringFormat='{}{0:dd/MM HH:mm:ss}'}" FontSize="11" Foreground="{DynamicResource AppTextMutedBrush}" VerticalAlignment="Center"/>
                                                        <Button Grid.Column="4" Classes="iconCircle" Width="32" Height="32" Margin="4,0" Command="{Binding $parent[ItemsControl].((vm:DomainsTabViewModel)DataContext).TestSingleCommand}" CommandParameter="{Binding}" ToolTip.Tip="Testa la connessione al dominio">
                                                            <Path Classes="icon" Data="{StaticResource IconPlug}"/>
                                                        </Button>
                                                        <StackPanel Grid.Column="5" Orientation="Horizontal" Spacing="4">
                                                            <Button Classes="iconCircle" Width="32" Height="32" Command="{Binding $parent[ItemsControl].((vm:DomainsTabViewModel)DataContext).SaveDomainCommand}" CommandParameter="{Binding}" ToolTip.Tip="Salva il nuovo URL nel database">
                                                                <Path Classes="icon" Data="{StaticResource IconSave}"/>
                                                            </Button>
                                                            <Button Classes="iconCircle" Width="32" Height="32" Command="{Binding $parent[ItemsControl].((vm:DomainsTabViewModel)DataContext).ResetDomainCommand}" CommandParameter="{Binding}" ToolTip.Tip="Ripristina l'URL di default di questo provider" IsEnabled="{Binding IsModified}">
                                                                <Path Classes="icon" Data="{StaticResource IconUndo}"/>
                                                            </Button>
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </DockPanel>
                    </ScrollViewer>
                </Panel>
            </Panel>
        </DockPanel>

        <!-- ============================================================ -->
        <!--  LOG PANEL                                                   -->
        <!-- ============================================================ -->
        <Border Grid.Row="3"
                x:Name="LogPanel"
                Background="{DynamicResource AppSurfaceBrush}"
                BorderBrush="{DynamicResource AppBorderBrush}"
                BorderThickness="1"
                CornerRadius="14"
                MinHeight="43"
                MaxHeight="400"
                Height="150"
                Margin="12,6,12,0"
                ClipToBounds="True">
            <DockPanel>
                <Grid DockPanel.Dock="Top" Height="40" ColumnDefinitions="*, Auto, Auto, Auto, Auto, Auto" Margin="0,0,8,0">
                    <ToggleButton Grid.Column="0" x:Name="ToggleLogButton" Classes="guideToggle"
                                IsChecked="True" Height="40" Padding="14,0"
                                Click="OnToggleLogClick" ToolTip.Tip="Comprimi / espandi log">
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Path Classes="chevron" Margin="0"/>
                            <Path Classes="icon accent" Data="{StaticResource IconList}"/>
                            <TextBlock Text="Log globale" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" Foreground="{DynamicResource AppTextBrush}"/>
                            <Border Background="{DynamicResource AppSurface2Brush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" CornerRadius="999" Padding="8,1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding FilteredLogs.Count}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource AppTextMutedBrush}"/>
                            </Border>
                        </StackPanel>
                    </ToggleButton>
                    <ComboBox Grid.Column="1" ItemsSource="{Binding LogLevelFilters}" SelectedIndex="{Binding SelectedLogLevelFilter}" Height="28" MinWidth="150" FontSize="11" Margin="0,0,6,0" VerticalAlignment="Center" ToolTip.Tip="Mostra tutti i messaggi o solo avvisi/errori"/>
                    <ComboBox Grid.Column="2" ItemsSource="{Binding LogCategories}" SelectedItem="{Binding SelectedLogCategory}" Height="28" MinWidth="150" FontSize="11" Margin="0,0,8,0" VerticalAlignment="Center" ToolTip.Tip="Mostra solo i messaggi di una sezione dell'app"/>
                    <Button Grid.Column="3" FontSize="11" Padding="10,0" Height="28" Command="{Binding CopyLogsCommand}" Margin="0,0,4,0" ToolTip.Tip="Copia negli appunti i log visibili (filtrati)" Classes="ghost"><StackPanel Classes="bi"><Path Classes="icon" Data="{StaticResource IconCopy}"/><TextBlock Text="Copia"/></StackPanel></Button>
                    <Button Grid.Column="4" FontSize="11" Padding="10,0" Height="28" Command="{Binding ExportLogsCommand}" Margin="0,0,4,0" ToolTip.Tip="Salva tutto il log su un file di testo" Classes="ghost"><StackPanel Classes="bi"><Path Classes="icon" Data="{StaticResource IconSave}"/><TextBlock Text="Esporta"/></StackPanel></Button>
                    <Button Grid.Column="5" FontSize="11" Padding="10,0" Height="28" Command="{Binding ClearLogsCommand}" Classes="ghost" ToolTip.Tip="Svuota il log"><StackPanel Classes="bi"><Path Classes="icon" Data="{StaticResource IconTrash}"/><TextBlock Text="Pulisci"/></StackPanel></Button>
                </Grid>
                <Border DockPanel.Dock="Top" Height="1" Background="{DynamicResource AppBorderBrush}"/>
                <ScrollViewer x:Name="LogScrollViewer" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                    <!-- VirtualizingStackPanel: vengono create solo le righe visibili (il log arriva a 2000 voci) -->
                    <ItemsControl x:Name="LogItems" ItemsSource="{Binding FilteredLogs}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><VirtualizingStackPanel/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.Styles>
                            <Style Selector="SelectableTextBlock.logMessage">
                                <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}"/>
                            </Style>
                            <Style Selector="SelectableTextBlock.logMessage.error">
                                <Setter Property="Foreground" Value="{DynamicResource AppDangerBrush}"/>
                            </Style>
                            <Style Selector="SelectableTextBlock.logMessage.warning">
                                <Setter Property="Foreground" Value="{DynamicResource AppWarningBrush}"/>
                            </Style>
                        </ItemsControl.Styles>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Classes="logRow" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="0,0,0,1" Padding="14,4">
                                    <Grid ColumnDefinitions="Auto, Auto, Auto, *">
                                        <SelectableTextBlock Grid.Column="0" Text="{Binding TimestampText}" FontFamily="Cascadia Mono,Consolas,Menlo,monospace" FontSize="11" Foreground="{DynamicResource AppTextMutedBrush}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                        <TextBlock Grid.Column="1" Text="{Binding LevelIcon}" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <Border Grid.Column="2" Background="{DynamicResource AppAccentSoftBrush}" CornerRadius="999" Padding="8,1" MinWidth="64" Margin="0,0,12,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Category}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource AppAccentBrush}" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                        </Border>
                                        <SelectableTextBlock Grid.Column="3" Classes="logMessage" Classes.error="{Binding IsError}" Classes.warning="{Binding IsWarning}" Text="{Binding Message}" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <Border Grid.Row="4" Height="10"/>
    </Grid>
</Window>