<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:h="using:DownloadManager.Helpers"
        xmlns:vm="using:DownloadManager.ViewModels"
        xmlns:models="using:DownloadManager.Models"
        xmlns:services="using:DownloadManager.Services.Anime"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1500" d:DesignHeight="950"
        x:Class="DownloadManager.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="DDL Download Manager"
        Width="1400" Height="860"
        MinWidth="1200" MinHeight="700">

    <Grid RowDefinitions="Auto, *, Auto, Auto, Auto" Margin="0">

        <!-- HEADER -->
        <Border Grid.Row="0"
                Background="{DynamicResource AppHeaderBrush}"
                BorderBrush="{DynamicResource AppBorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="20,14">
            <Grid ColumnDefinitions="Auto, *, Auto">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
                    <!-- Logo in un riquadro con alone accento -->
                    <Border Width="46" Height="46" CornerRadius="14"
                            Background="{DynamicResource AppAccentSoftBrush}"
                            BorderBrush="{DynamicResource AppAccentBrush}" BorderThickness="1"
                            BoxShadow="0 0 18 0 #403B82F6">
                        <Image Source="avares://DDLDownloadManager/Assets/logo.png"
                               Width="30" Height="30" Stretch="Uniform"
                               RenderOptions.BitmapInterpolationMode="HighQuality"/>
                    </Border>

                    <StackPanel VerticalAlignment="Center" Spacing="1">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock VerticalAlignment="Center" FontSize="21" LetterSpacing="-0.3">
                                <Run Text="DDL" FontWeight="Black" Foreground="{DynamicResource AppAccentGradientBrush}"/>
                                <Run Text="Download Manager" FontWeight="SemiBold" Foreground="{DynamicResource AppTextBrush}"/>
                            </TextBlock>
                            <Button Classes="versionBadge" Click="OnShowChangelogClick" VerticalAlignment="Center"
                                    ToolTip.Tip="Novità: cronologia delle versioni">
                                <StackPanel Orientation="Horizontal" Spacing="5">
                                    <TextBlock Text="{Binding AppVersionText}" FontSize="10" FontWeight="Bold"
                                               Foreground="{DynamicResource AppAccentBrush}" VerticalAlignment="Center"/>
                                    <TextBlock Text="· Novità" FontSize="10" FontWeight="SemiBold"
                                               Foreground="{DynamicResource AppAccentBrush}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                        <TextBlock Text="Anime  ·  Film e Serie  ·  SFTP  ·  Videobox"
                                   FontSize="11" FontWeight="Medium" LetterSpacing="0.4"
                                   Foreground="{DynamicResource AppTextMutedBrush}"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Button Classes="iconCircle" Command="{Binding CheckUpdatesCommand}" ToolTip.Tip="Controlla aggiornamenti" Margin="0,0,4,0">
                        <Path Classes="icon" Data="{StaticResource IconRefresh}"/>
                    </Button>
                    <Button Classes="iconCircle bell" Click="OnToggleNotificationsClick" ToolTip.Tip="{Binding Activity.NotificationsTip}">
                        <Panel>
                            <Path Classes="icon accent" Data="{StaticResource IconBell}" IsVisible="{Binding Activity.NotificationsEnabled}"/>
                            <Path Classes="icon bellOff" Data="{StaticResource IconBellOff}" IsVisible="{Binding !Activity.NotificationsEnabled}"/>
                        </Panel>
                    </Button>
                    <Button Classes="iconCircle" ToolTip.Tip="Scorciatoie da tastiera" Margin="0,0,4,0">
                        <Path Classes="icon" Data="{StaticResource IconKeyboard}"/>
                        <Button.Flyout>
                            <Flyout Placement="BottomEdgeAlignedRight">
                                <StackPanel Spacing="6" Margin="4" MinWidth="300">
                                    <TextBlock Text="Scorciatoie da tastiera" FontWeight="Bold" Margin="0,0,0,4"/>
                                    <Grid ColumnDefinitions="110, *" RowDefinitions="Auto, Auto, Auto, Auto, Auto">
                                        <Border Grid.Row="0" Classes="kbd"><TextBlock Text="Ctrl + 1 … 8"/></Border>
                                        <TextBlock Grid.Row="0" Grid.Column="1" Text="Apri la tab (1 = Anime, 2 = Film/Serie, … 8 = Domini)" TextWrapping="Wrap" Margin="10,4,0,4" FontSize="12"/>
                                        <Border Grid.Row="1" Classes="kbd"><TextBlock Text="Ctrl + F"/></Border>
                                        <TextBlock Grid.Row="1" Grid.Column="1" Text="Vai al campo di ricerca della tab aperta" TextWrapping="Wrap" Margin="10,4,0,4" FontSize="12"/>
                                        <Border Grid.Row="2" Classes="kbd"><TextBlock Text="Invio"/></Border>
                                        <TextBlock Grid.Row="2" Grid.Column="1" Text="Nel campo di ricerca: cerca" TextWrapping="Wrap" Margin="10,4,0,4" FontSize="12"/>
                                        <Border Grid.Row="3" Classes="kbd"><TextBlock Text="Ctrl + L"/></Border>
                                        <TextBlock Grid.Row="3" Grid.Column="1" Text="Apri o chiudi il Log globale" TextWrapping="Wrap" Margin="10,4,0,4" FontSize="12"/>
                                        <Border Grid.Row="4" Classes="kbd"><TextBlock Text="Ctrl + H"/></Border>
                                        <TextBlock Grid.Row="4" Grid.Column="1" Text="Cronologia dei download" TextWrapping="Wrap" Margin="10,4,0,4" FontSize="12"/>
                                    </Grid>
                                </StackPanel>
                            </Flyout>
                        </Button.Flyout>
                    </Button>

                    <Border Classes="proxyBadge"
                            Classes.proxyActive="{Binding IsProxyActive}"
                            Margin="0,0,12,0">
                        <TextBlock Text="{Binding ActiveProxyBadgeText}"
                                FontSize="12" FontWeight="SemiBold"
                                VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="Tema:" VerticalAlignment="Center"
                               Foreground="{DynamicResource AppTextMutedBrush}"
                               Margin="0,0,4,0"/>
                    <RadioButton GroupName="GlobalThemeGroup"
                                 IsChecked="{Binding ThemeVariant, Converter={x:Static vm:ThemeVariantEqualsConverter.Default}, ConverterParameter=Default}">
                        <StackPanel Classes="bi">
                            <Path Classes="icon" Data="{StaticResource IconMonitor}"/>
                            <TextBlock Text="Sistema"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton GroupName="GlobalThemeGroup" ToolTip.Tip="Tema chiaro"
                                 IsChecked="{Binding ThemeVariant, Converter={x:Static vm:ThemeVariantEqualsConverter.Default}, ConverterParameter=Light}">
                        <Path Classes="icon" Data="{StaticResource IconSun}"/>
                    </RadioButton>
                    <RadioButton GroupName="GlobalThemeGroup" ToolTip.Tip="Tema scuro"
                                 IsChecked="{Binding ThemeVariant, Converter={x:Static vm:ThemeVariantEqualsConverter.Default}, ConverterParameter=Dark}">
                        <Path Classes="icon" Data="{StaticResource IconMoon}"/>
                    </RadioButton>
                </StackPanel>
            </Grid>
        </Border>

        <DockPanel Grid.Row="1" Margin="12,10,12,0">
            <TabControl x:Name="MainTabs" Classes="nav" TabStripPlacement="Top" DockPanel.Dock="Top">

                <!-- ============================================================ -->
                <!--  TAB ANIME                                                   -->
                <!-- ============================================================ -->
                <TabItem>
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Path Classes="icon" Data="{StaticResource IconPlayCircle}"/>
                            <TextBlock Text="Anime Download" VerticalAlignment="Center"/>
                            <Border Width="10" Height="10" CornerRadius="5" Background="#EF4444" IsVisible="{Binding AnimeDownload.ShowAnimeRed}" VerticalAlignment="Center" ToolTip.Tip="Ci sono download falliti"/>
                            <Border Width="10" Height="10" CornerRadius="5" Background="#FBBF24" IsVisible="{Binding AnimeDownload.ShowAnimeYellow}" VerticalAlignment="Center" ToolTip.Tip="Download in corso"/>
                            <Border Width="10" Height="10" CornerRadius="5" Background="#22C55E" IsVisible="{Binding AnimeDownload.ShowAnimeGreen}" VerticalAlignment="Center" ToolTip.Tip="Nessuna attività"/>
                        </StackPanel>
                    </TabItem.Header>
                </TabItem>

                <!-- ============================================================ -->
                <!--  TAB FILM/SERIE                                              -->
                <!-- ============================================================ -->
                <TabItem>
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Path Classes="icon" Data="{StaticResource IconFilm}"/>
                            <TextBlock Text="Film/Serie Download" VerticalAlignment="Center"/>
                            <Border Width="10" Height="10" CornerRadius="5" Background="#EF4444" IsVisible="{Binding Streaming.ShowStreamingRed}" VerticalAlignment="Center" ToolTip.Tip="Ci sono download falliti"/>
                            <Border Width="10" Height="10" CornerRadius="5" Background="#FBBF24" IsVisible="{Binding Streaming.ShowStreamingYellow}" VerticalAlignment="Center" ToolTip.Tip="Download in corso"/>
                            <Border Width="10" Height="10" CornerRadius="5" Background="#22C55E" IsVisible="{Binding Streaming.ShowStreamingGreen}" VerticalAlignment="Center" ToolTip.Tip="Nessuna attività"/>
                        </StackPanel>
                    </TabItem.Header>
                </TabItem>

                <!-- ============================================================ -->
                <!--  TAB ACCOUNT                                                 -->
                <!-- ============================================================ -->
                <TabItem>
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Path Classes="icon" Data="{StaticResource IconUser}"/>
                            <TextBlock Text="Account" VerticalAlignment="Center"/>
                            <Border Width="10" Height="10" CornerRadius="5" Background="#EF4444" IsVisible="{Binding Account.HasAccountIssue}" VerticalAlignment="Center" ToolTip.Tip="Account non connesso"/>
                            <Border Width="10" Height="10" CornerRadius="5" Background="#22C55E" IsVisible="{Binding !Account.HasAccountIssue}" VerticalAlignment="Center" ToolTip.Tip="Account connesso"/>
                        </StackPanel>
                    </TabItem.Header>
                </TabItem>

                <!-- ============================================================ -->
                <!--  TAB ORGANIZZA FILE                                          -->
                <!-- ============================================================ -->
                <TabItem>
                    <TabItem.Header>
                        <StackPanel Classes="bi">
                            <Path Classes="icon" Data="{StaticResource IconLayers}"/>
                            <TextBlock Text="Organizza file"/>
                        </StackPanel>
                    </TabItem.Header>
                </TabItem>

                <!-- ============================================================ -->
                <!--  TAB SFTP                                                    -->
                <!-- ============================================================ -->
                <TabItem>
                    <TabItem.Header>
                        <StackPanel Classes="bi">
                            <Path Classes="icon" Data="{StaticResource IconCloud}"/>
                            <TextBlock Text="SFTP" VerticalAlignment="Center"/>
                            <Border Width="9" Height="9" CornerRadius="5" Background="#EF4444" IsVisible="{Binding Sftp.ShowSftpRed}" VerticalAlignment="Center" ToolTip.Tip="Ci sono trasferimenti falliti"/>
                            <Border Width="9" Height="9" CornerRadius="5" Background="#FBBF24" IsVisible="{Binding Sftp.ShowSftpYellow}" VerticalAlignment="Center" ToolTip.Tip="Trasferimento in corso"/>
                            <Border Width="9" Height="9" CornerRadius="5" Background="#22C55E" IsVisible="{Binding Sftp.ShowSftpGreen}" VerticalAlignment="Center" ToolTip.Tip="Connesso, nessuna attività"/>
                            <Border Width="9" Height="9" CornerRadius="5" Background="#8A8FA3" IsVisible="{Binding Sftp.ShowSftpGray}" VerticalAlignment="Center" ToolTip.Tip="SFTP disconnesso"/>
                        </StackPanel>
                    </TabItem.Header>
                </TabItem>

                <!-- ============================================================ -->
                <!--  TAB VIDEBOX CORRECTOR                                       -->
                <!-- ============================================================ -->
                <TabItem>
                    <TabItem.Header>
                        <StackPanel Classes="bi">
                            <Path Classes="icon" Data="{StaticResource IconEdit}"/>
                            <TextBlock Text="Videobox Corrector"/>
                        </StackPanel>
                    </TabItem.Header>
                </TabItem>

                <!-- ============================================================ -->
                <!--  TAB PROXY                                                   -->
                <!-- ============================================================ -->
                <TabItem>
                    <TabItem.Header>
                        <StackPanel Classes="bi">
                            <Path Classes="icon" Data="{StaticResource IconGlobe}"/>
                            <TextBlock Text="Proxy"/>
                        </StackPanel>
                    </TabItem.Header>
                </TabItem>

                <!-- ============================================================ -->
                <!--  TAB DOMINI                                                  -->
                <!-- ============================================================ -->
                <TabItem>
                    <TabItem.Header>
                        <StackPanel Classes="bi">
                            <Path Classes="icon" Data="{StaticResource IconGlobe}"/>
                            <TextBlock Text="Domini" VerticalAlignment="Center"/>
                            <Border Width="9" Height="9" CornerRadius="5" Background="#EF4444" IsVisible="{Binding HasDomainIssues}" VerticalAlignment="Center" ToolTip.Tip="Almeno un dominio non è raggiungibile"/>
                            <Border Width="9" Height="9" CornerRadius="5" Background="#22C55E" IsVisible="{Binding !HasDomainIssues}" VerticalAlignment="Center" ToolTip.Tip="Tutti i domini sono OK"/>
                        </StackPanel>
                    </TabItem.Header>
                </TabItem>
            </TabControl>
            <!-- Contenuti sempre nel visual tree: cambiando tab restano scroll e stato -->
            <Panel ClipToBounds="True">
                <Panel IsVisible="{Binding #MainTabs.SelectedIndex, Converter={x:Static vm:IndexEqualsConverter.Default}, ConverterParameter=0}">
                    <!-- Il messaggio di stato sta nella pagina; scorrendo ne compare una copia fissa in alto -->
                    <Panel DataContext="{Binding AnimeDownload}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" h:StickyBanner.Overlay="{Binding #AnimeStickyBanner}">
                    <StackPanel Margin="0,10,0,0">
                        <ContentControl Theme="{StaticResource StatusBannerTheme}" Content="{Binding StatusMessage}"/>

                        <!-- STATUS -->

                        <!-- GUIDA ANIME -->
                        <Border Classes="cardElevated" Margin="0,0,0,12" Padding="0" ClipToBounds="True">
                            <StackPanel>
                                <ToggleButton Classes="guideToggle" x:Name="ToggleGuideAnime" IsChecked="False">
                                    <Grid ColumnDefinitions="*, Auto">
                                        <StackPanel Classes="bi" VerticalAlignment="Center">
                                            <Path Classes="icon accent" Data="{StaticResource IconBulb}"/>
                                            <TextBlock Text="Guida rapida - Anime Download" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource AppTextBrush}"/>
                                        </StackPanel>
                                        <Path Grid.Column="1" Classes="chevron"/>
                                    </Grid>
                                </ToggleButton>
                                <Border IsVisible="{Binding #ToggleGuideAnime.IsChecked}" Background="Transparent" Margin="16,0,16,16" Padding="12,12,4,12">
                                    <ScrollViewer MaxHeight="240" VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
                                    <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource AppTextMutedBrush}">
                                        <Run FontWeight="Bold" Foreground="{DynamicResource AppTextBrush}">Come si usa</Run><LineBreak/>
                                        <Run FontWeight="SemiBold" Foreground="{DynamicResource AppTextBrush}">• 1. Cerca:</Run> scegli il provider (AnimeWorld o AnimeSaturn), scrivi il titolo e premi Cerca o Invio. Le ricerche recenti restano nel menu a tendina.<LineBreak/>
                                        <Run FontWeight="SemiBold" Foreground="{DynamicResource AppTextBrush}">• 2. Dettaglio:</Run> fai doppio clic su un risultato, o passaci sopra e premi "Analizza": gli episodi compaiono nel riquadro Dettaglio a destra.<LineBreak/>
                                        <Run FontWeight="SemiBold" Foreground="{DynamicResource AppTextBrush}">• 3. Selezione:</Run> spunta gli episodi (o usa Seleziona tutti / Deseleziona / Inverti) e premi "Scarica selezionati". Gli episodi già in coda vengono saltati.<LineBreak/>
                                        <Run FontWeight="SemiBold" Foreground="{DynamicResource AppTextBrush}">• 4. Coda:</Run> i download sono raggruppati per serie: espandi un gruppo per vedere ogni episodio, usa i pulsanti del gruppo per avviarlo, metterlo in pausa o annullarlo.<LineBreak/>
                                        <Run FontWeight="SemiBold" Foreground="{DynamicResource AppTextBrush}">• Pulisci:</Run> svuota risultati, Dettaglio e campo di ricerca, come all'apertura dell'app. I download in coda e in corso continuano. La cronologia delle ricerche resta (per svuotarla c'è il cestino).<LineBreak/>
                                        <LineBreak/>
                                        <Run FontWeight="Bold" Foreground="{DynamicResource AppTextBrush}">Nome dei file</Run><LineBreak/>
                                        <Run FontWeight="SemiBold" Foreground="{DynamicResource AppTextBrush}">• Pattern:</Run> segnaposto disponibili: {Series} (serie), {Episode} o {Episode:D3} (numero con zeri, es. 001), {Title} (titolo episodio), {OriginalFileName} (nome originale). L'anteprima a destra mostra il risultato.<LineBreak/>
                                        <Run FontWeight="SemiBold" Foreground="{DynamicResource AppTextBrush}">• Cartella:</Run> "Crea sottocartella per serie" salva ogni serie in una cartella con il suo nome, dentro la cartella base.<LineBreak/>
                                        <LineBreak/>
                                        <Run FontWeight="Bold" Foreground="{DynamicResource AppTextBrush}">Suggerimenti</Run><LineBreak/>
                                        <Run FontWeight="SemiBold" Foreground="{DynamicResource AppTextBrush}">• Accodamento:</Run> con tante puntate gli episodi vengono accodati a blocchi: i primi partono subito mentre gli altri vengono preparati. "Stop accodamento" interrompe senza perdere quelli già in coda.<LineBreak/>
                                        <Run FontWeight="SemiBold" Foreground="{DynamicResource AppTextBrush}">• Priorità:</Run> il fulmine (sulla riga o sulla serie) fa partire subito l'episodio: se i download paralleli sono tutti occupati, quello meno avanzato va in pausa e riparte appena possibile, da dove era arrivato.<LineBreak/>
                                        <Run FontWeight="SemiBold" Foreground="{DynamicResource AppTextBrush}">• Errori:</Run> se un download fallisce per un problema temporaneo (rete, proxy, server occupato) riprova da solo fino a 3 volte (dopo 30 s, 2 e 5 minuti), ripartendo da dove era. Se fallisce ancora la riga diventa rossa con il motivo (tutto il messaggio passandoci sopra) e la serie mostra il badge "N falliti". "Riscarica" riprova a mano.<LineBreak/>
                                        <Run FontWeight="SemiBold" Foreground="{DynamicResource AppTextBrush}">• Cronologia:</Run> tutto ciò che hai scaricato, anche dopo aver pulito la coda (Ctrl+H). Accodando episodi già scaricati in passato l'app chiede se riscaricarli o saltarli; se lo spazio su disco stimato non basta chiede conferma, e con meno di 1 GB libero i download si fermano in pausa.<LineBreak/>
                                        <Run FontWeight="SemiBold" Foreground="{DynamicResource AppTextBrush}">• Notifiche e barra di stato:</Run> con l'app in secondo piano Windows avvisa a fine serie, per i download falliti e se il disco è pieno (campanella in alto per spegnerle). In basso, accanto al Log, si vede sempre cosa sta scaricando, da qualsiasi tab. Le scorciatoie da tastiera sono nel pulsante con la tastiera in alto.<LineBreak/>
                                        <Run FontWeight="SemiBold" Foreground="{DynamicResource AppTextBrush}">• Colori delle barre:</Run> verde completato, blu in download, arancione in pausa, rosso errore, grigio-azzurro in coda, grigio spento annullato. Le colonne restano allineate qualunque sia lo stato; dimensione, velocità e tempo rimanente stanno in un'unica colonna. Ogni serie dice quanti episodi sono in download e quanti in conversione (già scaricati, mentre l'app unisce le tracce o converte il file).<LineBreak/>
                                        <Run FontWeight="SemiBold" Foreground="{DynamicResource AppTextBrush}">• Pulisci lista:</Run> toglie dalla lista completati, annullati o falliti (i file restano su disco). "Elimina tutto…" è in fondo al menu e chiede sempre conferma.<LineBreak/>
                                        <Run FontWeight="SemiBold" Foreground="{DynamicResource AppTextBrush}">• Download simultanei:</Run> il cursore della coda regola quanti episodi scaricare insieme.<LineBreak/>
                                        <Run FontWeight="SemiBold" Foreground="{DynamicResource AppTextBrush}">• Problemi:</Run> se un provider non risponde controlla la tab Domini (indirizzo aggiornato) e la tab Proxy. Gli errori compaiono anche nel Log globale, che si può filtrare per sezione.
                                    </TextBlock>
                                    </ScrollViewer>
                                </Border>
                            </StackPanel>
                        </Border>

                        <Border Classes="cardElevated" Margin="0,0,0,12">
                            <Grid ColumnDefinitions="Auto, *, Auto, Auto, Auto">
                                <ComboBox Grid.Column="0" ItemsSource="{Binding AvailableProviders}" SelectedItem="{Binding SelectedProvider, Mode=TwoWay}" MinWidth="140" MinHeight="40" Margin="0,0,8,0" VerticalAlignment="Center" ToolTip.Tip="Scegli da quale sito estrarre gli episodi">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate x:DataType="services:IAnimeProvider">
                                            <TextBlock Text="{Binding Name}"/>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <ComboBox Grid.Column="1" Name="SearchComboBox" IsEditable="True" ItemsSource="{Binding SearchHistory}" PlaceholderText="Cerca un anime..." KeyDown="OnSearchKeyDown" HorizontalAlignment="Stretch" Margin="0,0,8,0" MinHeight="40"/>
                                <Button ToolTip.Tip="Cerca l'anime sul provider selezionato (o premi Invio nel campo di ricerca)" Grid.Column="2" Classes="accent" Click="OnSearchButtonClick" MinWidth="110" Height="40" Margin="0,0,8,0">
                                    <StackPanel Classes="bi" HorizontalAlignment="Center">
                                        <Path Classes="icon" Data="{StaticResource IconSearch}"/>
                                        <TextBlock Text="Cerca"/>
                                    </StackPanel>
                                </Button>
                                <Button Grid.Column="3" Command="{Binding ClearAllCommand}" Height="40" Margin="0,0,8,0" ToolTip.Tip="Svuota risultati e dettaglio, come all'apertura dell'app. I download in coda e in corso continuano.">
                                    <StackPanel Classes="bi" HorizontalAlignment="Center">
                                        <Path Classes="icon" Data="{StaticResource IconUndo}"/>
                                        <TextBlock Text="Pulisci"/>
                                    </StackPanel>
                                </Button>
                                <Button Grid.Column="4" Classes="iconCircle" ToolTip.Tip="Svuota le ricerche recenti (il menu a tendina del campo di ricerca)" Click="OnClearSearchHistoryClick">
                                    <Path Classes="icon" Data="{StaticResource IconTrash}"/>
                                </Button>
                            </Grid>
                        </Border>

                        <Border Classes="cardElevated" Margin="0,0,0,12" Padding="0" ClipToBounds="True">
                            <StackPanel>
                                <ToggleButton Classes="guideToggle" x:Name="ToggleNamingAnime" IsChecked="False" ToolTip.Tip="Mostra o nascondi pattern del nome file e cartella di destinazione">
                                    <Grid ColumnDefinitions="Auto, *, Auto">
                                        <StackPanel Classes="bi" VerticalAlignment="Center">
                                            <Path Classes="icon accent" Data="{StaticResource IconSettings}"/>
                                            <TextBlock Text="Nome file e cartella" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource AppTextBrush}"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" FontSize="12" Margin="16,0,12,0" VerticalAlignment="Center" HorizontalAlignment="Right" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource AppTextMutedBrush}" IsVisible="{Binding !#ToggleNamingAnime.IsChecked}">
                                            <Run Text="{Binding PatternPreview}" FontFamily="Consolas,Menlo,monospace" Foreground="{DynamicResource AppAccentBrush}"/>
                                            <Run Text="  ·  "/>
                                            <Run Text="{Binding BaseDownloadFolder}"/>
                                        </TextBlock>
                                        <Path Grid.Column="2" Classes="chevron"/>
                                    </Grid>
                                </ToggleButton>
                                <Border IsVisible="{Binding #ToggleNamingAnime.IsChecked}" Margin="16,0,16,16">
                                    <Grid ColumnDefinitions="Auto, *, Auto, Auto, Auto" RowDefinitions="Auto, Auto">
                                        <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,4,0"><TextBlock Text="Pattern" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,6,0"/><h:PatternLegendButton Kind="Anime" Target="{Binding #AnimePatternBox}"/></StackPanel>
                                        <ComboBox x:Name="AnimePatternBox" Grid.Row="0" Grid.Column="1" IsEditable="True" ItemsSource="{Binding NamingPresets}" Text="{Binding NamingPattern, Mode=TwoWay}" HorizontalAlignment="Stretch" Margin="0,0,10,0"/>
                                        <Border Grid.Row="0" Grid.Column="2" Background="{DynamicResource AppSurface2Brush}" BorderBrush="{DynamicResource AppAccentBrush}" BorderThickness="1" CornerRadius="6" Padding="10,4" Margin="0,0,10,0" MaxWidth="380">
                                            <TextBlock Text="{Binding PatternPreview}" FontFamily="Consolas,Menlo,monospace" Foreground="{DynamicResource AppAccentBrush}" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                        </Border>
                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Cartella base" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,10,10,0" ToolTip.Tip="La cartella locale dove verranno salvati i video"/>
                                        <TextBox Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding BaseDownloadFolder}" Margin="0,10,10,0"/>
                                        <Button Grid.Row="1" Grid.Column="3" Classes="iconCircle" Click="OnBrowseBaseFolderClick" Margin="0,10,8,0" ToolTip.Tip="Sfoglia">
                                            <Path Classes="icon" Data="{StaticResource IconFolder}"/>
                                        </Button>
                                        <CheckBox Grid.Row="1" Grid.Column="4" Content="Crea sottocartella per serie" IsChecked="{Binding CreateSeriesFolder}" VerticalAlignment="Center" Margin="0,10,0,0" ToolTip.Tip="Crea una cartella dedicata per questa serie"/>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>

                        <Grid ColumnDefinitions="1*, 1*" Height="720" Margin="0,0,0,12">
                            <Border Grid.Column="0" Classes="cardElevated" Margin="0,0,6,0">
                                <DockPanel>
                                    <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto, Auto, *" Margin="0,0,0,8">
                                        <StackPanel Grid.Column="0" Classes="bi" VerticalAlignment="Center">
                                            <Path Classes="icon accent" Data="{StaticResource IconFilm}"/>
                                            <TextBlock Text="Risultati ricerca" FontWeight="Bold" FontSize="14"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="{Binding SearchResultsCountText}" FontSize="12" Foreground="{DynamicResource AppTextMutedBrush}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" IsVisible="{Binding IsLoadingSearchResults}">
                                            <ProgressBar IsIndeterminate="True" Width="80" Height="4" VerticalAlignment="Center"/>
                                            <TextBlock Text="Ricerca in corso..." FontSize="11" FontStyle="Italic" Foreground="{DynamicResource AppTextMutedBrush}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Grid>
                                    <Panel>
                                    <ListBox Classes="posterGrid" ItemsSource="{Binding SearchResults}" DoubleTapped="OnSearchResultDoubleTapped" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                        <ListBox.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel Orientation="Horizontal"/>
                                            </ItemsPanelTemplate>
                                        </ListBox.ItemsPanel>
                                        <ListBox.ItemTemplate>
                                            <DataTemplate x:DataType="models:AnimeSearchResult">
                                                <StackPanel Width="140" Spacing="8" Background="Transparent">
                                                    <StackPanel.ContextMenu>
                                                        <ContextMenu>
                                                            <MenuItem Header="Apri nel browser" Click="OnOpenResultInBrowserClick"><MenuItem.Icon><Path Classes="icon" Data="{StaticResource IconGlobe}"/></MenuItem.Icon></MenuItem>
                                                            <MenuItem Header="Copia link" Click="OnCopyResultLinkClick"><MenuItem.Icon><Path Classes="icon" Data="{StaticResource IconCopy}"/></MenuItem.Icon></MenuItem>
                                                        </ContextMenu>
                                                    </StackPanel.ContextMenu>
                                                    <Panel Width="140" Height="200">
                                                        <Border Classes="poster" Width="140" Height="200">
                                                            <Image Source="{Binding Poster}" Stretch="UniformToFill"/>
                                                        </Border>
                                                        <Border Classes="posterShade" Width="140" Height="200"/>
                                                        <Button Classes="posterAnalyze" Click="OnAnalyzeAnimeClick">
                                                            <TextBlock Text="Analizza"/>
                                                        </Button>
                                                        <Button Classes="iconCircle" Width="28" Height="28" Padding="0" Margin="0,6,6,0" HorizontalAlignment="Right" VerticalAlignment="Top" Opacity="0.85" ToolTip.Tip="Apri il post nel browser" Click="OnOpenResultInBrowserClick">
                                                            <Path Classes="icon" Data="{StaticResource IconGlobe}" Width="14" Height="14"/>
                                                        </Button>
                                                    </Panel>
                                                    <StackPanel Spacing="2">
                                                        <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" TextAlignment="Center"/>
                                                        <TextBlock Text="{Binding InfoText}" IsVisible="{Binding HasInfo}" FontSize="11" Foreground="{DynamicResource AppTextMutedBrush}" TextAlignment="Center" TextTrimming="CharacterEllipsis"
                                                                   ToolTip.Tip="Anno di uscita e numero di episodi (solo AnimeSaturn)"/>
                                                    </StackPanel>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                    <Border HorizontalAlignment="Center" VerticalAlignment="Top" MaxWidth="380" Margin="16,90,16,16" IsHitTestVisible="False" IsVisible="{Binding ShowResultsPlaceholder}">
                                            <StackPanel Spacing="10" HorizontalAlignment="Center">
                                                <Border Width="72" Height="72" CornerRadius="36" Background="{DynamicResource AppSurface2Brush}" HorizontalAlignment="Center">
                                                    <Path Classes="icon accent" Data="{StaticResource IconSearch}" Width="30" Height="30" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <TextBlock Text="{Binding ResultsPlaceholderTitle}" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"/>
                                                <TextBlock Text="{Binding ResultsPlaceholderText}" FontSize="12" Foreground="{DynamicResource AppTextMutedBrush}" TextAlignment="Center" TextWrapping="Wrap" LineHeight="18"/>
                                            </StackPanel>
                                        </Border>
                                    </Panel>
                                </DockPanel>
                            </Border>

                            <Border Grid.Column="1" Classes="cardElevated" Margin="6,0,0,0">
                                <DockPanel>
                                    <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto, Auto, Auto, Auto, *" Margin="0,0,0,8">
                                        <StackPanel Grid.Column="0" Classes="bi" VerticalAlignment="Center">
                                            <Path Classes="icon accent" Data="{StaticResource IconTv}"/>
                                            <TextBlock Text="Dettaglio" FontWeight="Bold" FontSize="14"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" IsVisible="{Binding IsLoadingEpisodes}">
                                            <ProgressBar IsIndeterminate="True" Width="80" Height="4" VerticalAlignment="Center"/>
                                            <TextBlock Text="Caricamento..." FontSize="11" FontStyle="Italic" Foreground="{DynamicResource AppTextMutedBrush}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Grid>

                                    <Border DockPanel.Dock="Top" Background="{DynamicResource AppSurface2Brush}" CornerRadius="12" Padding="12" Margin="0,0,0,10" IsVisible="{Binding HasSelectedAnime}">
                                        <Grid ColumnDefinitions="Auto, *">
                                            <Border Classes="poster" Width="84" Height="120" VerticalAlignment="Top" Margin="0,0,14,0" Background="{DynamicResource AppHoverBrush}">
                                                <Panel>
                                                    <Path Classes="icon" Data="{StaticResource IconTv}" Width="28" Height="28" Stroke="{DynamicResource AppTextMutedBrush}" HorizontalAlignment="Center"/>
                                                    <Image Source="{Binding SelectedAnime.Poster, FallbackValue={x:Null}}" Stretch="UniformToFill"/>
                                                </Panel>
                                            </Border>
                                            <StackPanel Grid.Column="1" Spacing="8">
                                                <TextBlock Text="{Binding SelectedAnimeName}" FontSize="17" FontWeight="Bold" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis"/>
                                                <WrapPanel Orientation="Horizontal" ItemSpacing="6" LineSpacing="6">
                                                    <Border Classes="moviePill accent"><StackPanel Classes="bi"><Path Classes="icon" Data="{StaticResource IconTv}"/><TextBlock Text="Anime"/></StackPanel></Border>
                                                    <Border Classes="moviePill"><StackPanel Classes="bi"><Path Classes="icon" Data="{StaticResource IconGlobe}"/><TextBlock Text="{Binding SelectedProviderName}"/></StackPanel></Border>
                                                    <Border Classes="moviePill" IsVisible="{Binding HasEpisodesCountPill}"><StackPanel Classes="bi"><Path Classes="icon" Data="{StaticResource IconList}"/><TextBlock Text="{Binding EpisodesCountPill}"/></StackPanel></Border>
                                                    <Border Classes="moviePill accent" IsVisible="{Binding HasSelectedCountPill}"><StackPanel Classes="bi"><Path Classes="icon" Data="{StaticResource IconCheck}"/><TextBlock Text="{Binding SelectedCountPill}"/></StackPanel></Border>
                                                </WrapPanel>

                                                <Grid ColumnDefinitions="Auto, *" RowDefinitions="Auto, Auto">
                                                    <TextBlock Grid.Row="0" Text="Cartella" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AppTextMutedBrush}" VerticalAlignment="Center" Margin="0,0,12,4"/>
                                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding DetailFolder}" FontSize="12" TextTrimming="CharacterEllipsis" Margin="0,0,0,4" ToolTip.Tip="{Binding DetailFolder}"/>
                                                    <TextBlock Grid.Row="1" Text="Esempio file" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AppTextMutedBrush}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding DetailFileName}" FontFamily="Consolas,Menlo,monospace" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource AppAccentBrush}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding DetailFileName}"/>
                                                </Grid>
                                                <TextBlock Text="{Binding AnimeDetailHint}" FontSize="11" Foreground="{DynamicResource AppTextMutedBrush}" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="6" Margin="0,0,0,8" IsVisible="{Binding HasSelectedAnime}">
                                        <Button ToolTip.Tip="Accoda tutti gli episodi spuntati (quelli già in coda vengono saltati)" Classes="success" Command="{Binding DownloadSelectedEpisodesCommand}" IsEnabled="{Binding CanInteractWithEpisodes}">
                                            <StackPanel Classes="bi"><Path Classes="icon" Data="{StaticResource IconDownload}"/><TextBlock Text="Scarica selezionati"/></StackPanel>
                                        </Button>
                                        <Button ToolTip.Tip="Seleziona tutti gli episodi della lista" Content="Seleziona tutti" Click="OnSelectAllEpisodesClick" IsEnabled="{Binding CanInteractWithEpisodes}"/>
                                        <Button ToolTip.Tip="Toglie la selezione a tutti gli episodi" Content="Deseleziona" Click="OnDeselectAllEpisodesClick" IsEnabled="{Binding CanInteractWithEpisodes}"/>
                                        <Button ToolTip.Tip="Inverte la selezione degli episodi" Content="Inverti" Click="OnInvertEpisodeSelectionClick" IsEnabled="{Binding CanInteractWithEpisodes}"/>
                                    </StackPanel>

                                    <Panel>
                                    <DataGrid Name="EpisodesGrid" IsVisible="{Binding HasSelectedAnime}" ItemsSource="{Binding Episodes}" AutoGenerateColumns="False" SelectionMode="Extended" IsReadOnly="False" SelectionChanged="OnEpisodesSelectionChanged" DoubleTapped="OnEpisodeDoubleTapped" CanUserResizeColumns="True" CanUserReorderColumns="True" CanUserSortColumns="False">
                                        <DataGrid.Columns>
                                            <DataGridTemplateColumn Header="" Width="40">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTextColumn Header="N." Binding="{Binding Number}" Width="60"/>
                                            <DataGridTextColumn Header="Titolo" Binding="{Binding Title}" Width="*"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                    <Border HorizontalAlignment="Center" VerticalAlignment="Top" MaxWidth="380" Margin="16,90,16,16" IsHitTestVisible="False" IsVisible="{Binding ShowDetailPlaceholder}">
                                            <StackPanel Spacing="10" HorizontalAlignment="Center">
                                                <Border Width="72" Height="72" CornerRadius="36" Background="{DynamicResource AppSurface2Brush}" HorizontalAlignment="Center">
                                                    <Path Classes="icon accent" Data="{StaticResource IconTv}" Width="30" Height="30" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <TextBlock Text="Nessun anime aperto" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"/>
                                                <TextBlock Text="Fai doppio clic su un risultato, o passaci sopra e premi «Analizza»: qui compaiono gli episodi da spuntare e scaricare." FontSize="12" Foreground="{DynamicResource AppTextMutedBrush}" TextAlignment="Center" TextWrapping="Wrap" LineHeight="18"/>
                                                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" Margin="0,6,0,0">
                                                    <Border Classes="moviePill accent"><StackPanel Classes="bi"><Path Classes="icon" Data="{StaticResource IconSearch}"/><TextBlock Text="1 · Cerca"/></StackPanel></Border>
                                                    <Border Classes="moviePill"><StackPanel Classes="bi"><Path Classes="icon" Data="{StaticResource IconList}"/><TextBlock Text="2 · Analizza"/></StackPanel></Border>
                                                    <Border Classes="moviePill"><StackPanel Classes="bi"><Path Classes="icon" Data="{StaticResource IconDownload}"/><TextBlock Text="3 · Scarica"/></StackPanel></Border>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </Panel>
                                </DockPanel>
                            </Border>
                        </Grid>

                        <Border Classes="cardElevated" Height="550" Margin="0,0,0,12">
                            <DockPanel>
                                <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto, *" Margin="0,0,0,8">
                                    <StackPanel Grid.Column="0" Classes="bi" VerticalAlignment="Center">
                                        <Path Classes="icon accent" Data="{StaticResource IconDownload}"/>
                                        <TextBlock Text="Download per serie" FontWeight="Bold" FontSize="14"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{Binding SeriesSummaryText}" FontSize="12" Foreground="{DynamicResource AppTextMutedBrush}" Margin="12,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                </Grid>
                                <Border DockPanel.Dock="Top" Background="{DynamicResource AppSurface2Brush}" CornerRadius="8" Padding="12" Margin="0,0,0,10">
                                    <StackPanel Spacing="10">
                                        <WrapPanel Orientation="Horizontal" ItemSpacing="8" LineSpacing="6">
                                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Margin="0,0,10,0">
                                                <TextBlock Text="Download paralleli" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,6,0" ToolTip.Tip="Quanti episodi anime scaricare insieme. Gli slot sono separati da quelli della tab Film/Serie"/>
                                                <Slider Value="{Binding MaxConcurrency}" Minimum="1" Maximum="20" Width="140" TickFrequency="1" IsSnapToTickEnabled="True" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding MaxConcurrency}" Width="24" VerticalAlignment="Center" HorizontalAlignment="Center" FontWeight="Bold" Foreground="{DynamicResource AppAccentBrush}"/>
                                            </StackPanel>
                                            <Button ToolTip.Tip="Avvia tutti i download anime in attesa o in pausa" Classes="success" Command="{Binding StartAllCommand}"><StackPanel Classes="bi"><Path Classes="icon" Data="{StaticResource IconPlay}"/><TextBlock Text="Avvia tutti"/></StackPanel></Button>
                                            <Button ToolTip.Tip="Mette in pausa tutti i download anime in corso" Classes="warning" Command="{Binding PauseAllCommand}"><StackPanel Classes="bi"><Path Classes="icon" Data="{StaticResource IconPause}"/><TextBlock Text="Pausa tutti"/></StackPanel></Button>
                                            <Button ToolTip.Tip="Annulla tutti i download anime non ancora completati" Classes="danger" Command="{Binding CancelAllDownloadsCommand}"><StackPanel Classes="bi"><Path Classes="icon" Data="{StaticResource IconClose}"/><TextBlock Text="Annulla tutti"/></StackPanel></Button>
                                            <Button ToolTip.Tip="Interrompe l'accodamento in corso (gli episodi già accodati restano in coda)" Classes="danger" Command="{Binding CancelBatchCommand}" IsVisible="{Binding IsBatchActive}"><StackPanel Classes="bi"><Path Classes="icon" Data="{StaticResource IconStop}"/><TextBlock Text="Stop accodamento"/></StackPanel></Button>
                                            <Border Width="1" Height="26" Background="{DynamicResource AppBorderBrush}" Margin="6,0" VerticalAlignment="Center"/>
                                            <Button ToolTip.Tip="Tutto ciò che hai scaricato, anche dopo aver pulito la coda: ricerca, cartella del file, già scaricati" Click="OnAnimeHistoryClick">
                                                <StackPanel Classes="bi"><Path Classes="icon" Data="{StaticResource IconList}"/><TextBlock Text="Cronologia"/></StackPanel>
                                            </Button>
                                            <Button ToolTip.Tip="Togli dalla lista completati, annullati o falliti (i file restano dove sono). «Elimina tutto» è in fondo al menu e chiede conferma.">
                                                <StackPanel Classes="bi"><Path Classes="icon" Data="{StaticResource IconTrash}"/><TextBlock Text="Pulisci lista"/><Path Classes="icon" Data="{StaticResource IconChevronDownSmall}" Width="10" Height="10" Margin="2,0,0,0"/></StackPanel>
                                                <Button.Flyout>
                                                    <MenuFlyout Placement="BottomEdgeAlignedLeft">
                                                        <MenuItem Header="Rimuovi completati" Command="{Binding ClearCompletedCommand}"><MenuItem.Icon><Path Classes="icon" Data="{StaticResource IconCheckCircle}"/></MenuItem.Icon></MenuItem>
                                                        <MenuItem Header="Rimuovi annullati" Command="{Binding ClearCancelledDownloadsCommand}"><MenuItem.Icon><Path Classes="icon" Data="{StaticResource IconBan}"/></MenuItem.Icon></MenuItem>
                                                        <MenuItem Header="Rimuovi falliti" Command="{Binding ClearFailedDownloadsCommand}"><MenuItem.Icon><Path Classes="icon" Data="{StaticResource IconAlertCircle}"/></MenuItem.Icon></MenuItem>
                                                        <Separator/>
                                                        <MenuItem Classes="dangerItem" Header="Elimina tutto…" Tag="{Binding DeleteEverythingCommand}" CommandParameter="Fermare e togliere dalla lista TUTTI i download anime, anche quelli in corso e in coda? I file già scaricati restano su disco." Click="OnConfirmRemoveAllClick"><MenuItem.Icon><Path Classes="icon" Data="{StaticResource IconTrash}"/></MenuItem.Icon></MenuItem>
                                                    </MenuFlyout>
                                                </Button.Flyout>
                                            </Button>
                                        </WrapPanel>
                                        <StackPanel Orientation="Horizontal" Spacing="24">
                                            <TextBlock FontSize="12" Foreground="{DynamicResource AppTextMutedBrush}">
                                                <Run Text="Totale:" FontWeight="Bold"/>
                                                <Run Text="{Binding GlobalSizeText}"/>
                                            </TextBlock>
                                            <TextBlock FontSize="12" Foreground="{DynamicResource AppSuccessBrush}">
                                                <Run Text="Velocità:" FontWeight="Bold"/>
                                                <Run Text="{Binding GlobalSpeedText}"/>
                                            </TextBlock>
                                            <TextBlock FontSize="12" Foreground="{DynamicResource AppTextMutedBrush}">
                                                <Run Text="ETA:" FontWeight="Bold"/>
                                                <Run Text="{Binding GlobalEtaText}"/>
                                            </TextBlock>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                    <ItemsControl ItemsSource="{Binding SeriesGroups}" HorizontalAlignment="Stretch">
                                        <ItemsControl.Styles>
                                            <Style Selector="ItemsControl > ContentPresenter">
                                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                            </Style>
                                        </ItemsControl.Styles>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="models:SeriesGroup">
                                                <Expander Theme="{StaticResource DownloadGroupExpanderTheme}" IsExpanded="{Binding IsExpanded, Mode=TwoWay}">
                                                    <Expander.Header>
                                                        <Border Classes="groupHeader" Classes.failed="{Binding HasFailed}">
                                                        <Grid ColumnDefinitions="2.6*, 120, 90, 1.3*, 80, 284">
                                                            <DockPanel Grid.Column="0" Margin="0,0,10,0">
                                                                <Border DockPanel.Dock="Left" Classes="failBadge" IsVisible="{Binding HasFailed}" Margin="0,0,8,0" VerticalAlignment="Center"
                                                                        ToolTip.Tip="Alcuni episodi non sono stati scaricati: apri la serie per vedere il motivo, oppure premi «Riscarica i falliti» a destra">
                                                                    <StackPanel Classes="bi"><Path Classes="icon" Data="{StaticResource IconAlert}"/><TextBlock Text="{Binding FailedBadge}"/></StackPanel>
                                                                </Border>
                                                                <TextBlock Text="{Binding Header}" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                            </DockPanel>
                                                            <TextBlock Grid.Column="1" Text="{Binding TotalSizeText}" VerticalAlignment="Center" FontSize="11" Foreground="{DynamicResource AppTextMutedBrush}" Margin="0,0,10,0"/>
                                                            <TextBlock Grid.Column="2" Text="{Binding TotalSpeedText}" VerticalAlignment="Center" FontSize="11" Foreground="{DynamicResource AppSuccessBrush}" Margin="0,0,10,0"/>
                                                            <Grid Grid.Column="3" ColumnDefinitions="*, Auto" Margin="10,0">
                                                                <ProgressBar Grid.Column="0" Value="{Binding OverallPercentage}" Minimum="0" Maximum="100" Height="14" MinWidth="0" Classes.done="{Binding IsAllCompleted}" Classes.paused="{Binding IsAllPaused}"/>
                                                                <TextBlock Grid.Column="1" Text="{Binding OverallPercentage, StringFormat={}{0:F1}%}" Width="50" TextAlignment="Right" Margin="4,0,0,0" VerticalAlignment="Center" FontSize="11" FontWeight="SemiBold"/>
                                                            </Grid>
                                                            <TextBlock Grid.Column="4" Text="{Binding OverallEtaText}" VerticalAlignment="Center" FontSize="11" Foreground="{DynamicResource AppTextMutedBrush}" Margin="10,0"/>
                                                            <StackPanel Grid.Column="5" Orientation="Horizontal" Spacing="4" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                                <Button Classes="iconCircle success" Width="30" Height="30" ToolTip.Tip="Avvia serie" Click="OnResumeGroupClick"><Path Classes="icon" Data="{StaticResource IconPlay}"/></Button>
                                                                <Button Classes="iconCircle warning" Width="30" Height="30" ToolTip.Tip="Pausa serie" Click="OnPauseGroupClick"><Path Classes="icon" Data="{StaticResource IconPause}"/></Button>
                                                                <Button Classes="iconCircle" Width="30" Height="30" ToolTip.Tip="Forza priorità" Click="OnForceGroupClick"><Path Classes="icon" Data="{StaticResource IconBolt}"/></Button>
                                                                <Button Classes="iconCircle" Width="30" Height="30" ToolTip.Tip="Rimuovi priorità" Click="OnUnforceGroupClick"><Path Classes="icon" Data="{StaticResource IconBoltOff}"/></Button>
                                                                <Button Classes="iconCircle danger" Width="30" Height="30" ToolTip.Tip="Annulla serie" Click="OnCancelGroupClick"><Path Classes="icon" Data="{StaticResource IconClose}"/></Button>
                                                                <Button Classes="iconCircle" Width="30" Height="30" ToolTip.Tip="Rimuovi serie" Click="OnRemoveGroupClick"><Path Classes="icon" Data="{StaticResource IconTrash}"/></Button>
                                                                <Button Classes="iconCircle" Width="30" Height="30" ToolTip.Tip="Riscarica i falliti di questa serie" IsVisible="{Binding HasFailed}" Click="OnRetryFailedGroupClick"><Path Classes="icon" Data="{StaticResource IconRefresh}"/></Button>
                                                                <Button Classes="iconCircle warning" Width="30" Height="30" ToolTip.Tip="Riscarica tutti gli annullati di questa serie" IsVisible="{Binding HasCancelled}" Click="OnRetryCancelledGroupClick"><Path Classes="icon" Data="{StaticResource IconRefresh}"/></Button>
                                                            </StackPanel>
                                                        </Grid>
                                                        </Border>
                                                    </Expander.Header>
                                                    <ItemsControl ItemsSource="{Binding ExpandedItems}" HorizontalAlignment="Stretch">
                                                        <ItemsControl.Styles>
                                                            <Style Selector="ItemsControl > ContentPresenter">
                                                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                                            </Style>
                                                        </ItemsControl.Styles>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate DataType="models:DownloadItem">
                                                                <Border Classes="episodeRow" Classes.failed="{Binding IsFailed}" Padding="10,7" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="0,0,0,1">
                                                                    <Border.ContextMenu>
                                                                        <ContextMenu>
                                                                            <MenuItem Header="Avvia / Riprendi" Click="OnResumeDownloadClick"><MenuItem.Icon><Path Classes="icon" Data="{StaticResource IconPlay}"/></MenuItem.Icon></MenuItem>
                                                                            <MenuItem Header="Forza Download" Click="OnForceDownloadClick"><MenuItem.Icon><Path Classes="icon" Data="{StaticResource IconBolt}"/></MenuItem.Icon></MenuItem>
                                                                            <MenuItem Header="Rimuovi priorità" Click="OnUnforceDownloadClick"><MenuItem.Icon><Path Classes="icon" Data="{StaticResource IconBoltOff}"/></MenuItem.Icon></MenuItem>
                                                                            <MenuItem Header="Pausa" Click="OnPauseDownloadClick"><MenuItem.Icon><Path Classes="icon" Data="{StaticResource IconPause}"/></MenuItem.Icon></MenuItem>
                                                                            <MenuItem Header="Annulla" Click="OnCancelDownloadClick"><MenuItem.Icon><Path Classes="icon" Data="{StaticResource IconClose}"/></MenuItem.Icon></MenuItem>
                                                                            <Separator/>
                                                                            <MenuItem Header="Rimuovi dalla lista" Click="OnRemoveDownloadClick"><MenuItem.Icon><Path Classes="icon" Data="{StaticResource IconTrash}"/></MenuItem.Icon></MenuItem>
                                                                        </ContextMenu>
                                                                    </Border.ContextMenu>
                                                                    <Grid ColumnDefinitions="24, 2*, 46, 1.4*, 1.6*, 250, 130">
                                                                        <Path Grid.Column="0" Classes="icon warn" Width="13" Height="13" HorizontalAlignment="Left" Data="{StaticResource IconBolt}" IsVisible="{Binding IsPriority}"/>
                                                                        <Path Grid.Column="0" Classes="icon failIcon" Width="14" Height="14" HorizontalAlignment="Left" Data="{StaticResource IconAlert}" IsVisible="{Binding IsFailed}"/>
                                                                        <TextBlock Grid.Column="1" Text="{Binding FileName}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" FontWeight="Medium"/>
                                                                        <TextBlock Grid.Column="2" Text="{Binding EpisodeNumber}" VerticalAlignment="Center"/>
                                                                        <TextBlock Grid.Column="3" Classes="rowStatus" Text="{Binding StatusText}" ToolTip.Tip="{Binding StatusTip}" TextTrimming="CharacterEllipsis" Margin="0,0,10,0" VerticalAlignment="Center" FontSize="11"/>
                                                                        <Grid Grid.Column="4" ColumnDefinitions="*, 44" Margin="0,0,12,0">
                                                                            <ProgressBar Value="{Binding Percentage}" Minimum="0" Maximum="100" Height="14" MinWidth="0" Classes.done="{Binding IsCompleted}" Classes.failed="{Binding IsFailed}" Classes.paused="{Binding IsPaused}" Classes.queued="{Binding IsQueued}" Classes.cancelled="{Binding IsCancelled}"/>
                                                                            <TextBlock Grid.Column="1" Text="{Binding Percentage, StringFormat={}{0:F0}%}" TextAlignment="Right" VerticalAlignment="Center" FontSize="11"/>
                                                                        </Grid>
                                                                        <TextBlock Grid.Column="5" Text="{Binding InfoText}" ToolTip.Tip="{Binding InfoText}" VerticalAlignment="Center" FontSize="11" Foreground="{DynamicResource AppTextMutedBrush}" TextTrimming="CharacterEllipsis" Margin="0,0,10,0"/>
                                                                        <StackPanel Grid.Column="6" Orientation="Horizontal" Spacing="2" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="8,0,0,0">
                                                                            <Button Classes="iconCircle success" Width="26" Height="26" ToolTip.Tip="Riprendi" IsVisible="{Binding CanResume}" Click="OnDownloadItemResumeClick"><Path Classes="icon" Width="12" Height="12" Data="{StaticResource IconPlay}"/></Button>
                                                                            <Button Classes="iconCircle" Width="26" Height="26" ToolTip.Tip="Forza priorità" IsVisible="{Binding CanForce}" Click="OnDownloadItemForceClick"><Path Classes="icon" Width="12" Height="12" Data="{StaticResource IconBolt}"/></Button>
                                                                            <Button Classes="iconCircle warning" Width="26" Height="26" ToolTip.Tip="Pausa" IsVisible="{Binding CanPause}" Click="OnDownloadItemPauseClick"><Path Classes="icon" Width="12" Height="12" Data="{StaticResource IconPause}"/></Button>
                                                                            <Button Classes="iconCircle danger" Width="26" Height="26" ToolTip.Tip="Annulla" IsVisible="{Binding CanCancel}" Click="OnDownloadItemCancelClick"><Path Classes="icon" Width="12" Height="12" Data="{StaticResource IconClose}"/></Button>
                                                                            <Button Classes="iconCircle" Width="26" Height="26" ToolTip.Tip="Riscarica (elimina .part e ricomincia)" IsVisible="{Binding CanRetry}" Click="OnDownloadItemRetryClick"><Path Classes="icon" Width="12" Height="12" Data="{StaticResource IconRefresh}"/></Button>
                                                                            <Button Classes="iconCircle danger" Width="26" Height="26" ToolTip.Tip="Rimuovi dalla lista" Click="OnDownloadItemRemoveClick"><Path Classes="icon" Width="12" Height="12" Data="{StaticResource IconTrash}"/></Button>
                                                                        </StackPanel>
                                                                    </Grid>
                                                                </Border>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </Expander>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </DockPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
                    <!-- Copia del messaggio fissata in alto, visibile solo scorrendo (StickyBanner) -->
                    <Border x:Name="AnimeStickyBanner" VerticalAlignment="Top" IsVisible="False" Padding="0,10,0,0" Background="{DynamicResource AppBackgroundBrush}">
                        <ContentControl Margin="0,0,0,8" Theme="{StaticResource StatusBannerTheme}" Content="{Binding StatusMessage}"/>
                    </Border>
                    </Panel>
                </Panel>
                <Panel IsVisible="{Binding #MainTabs.SelectedIndex, Converter={x:Static vm:IndexEqualsConverter.Default}, ConverterParameter=1}">
                    <!-- Il messaggio di stato sta nella pagina; scorrendo ne compare una copia fissa in alto -->
                    <Panel DataContext="{Binding Streaming}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" h:StickyBanner.Overlay="{Binding #StreamingStickyBanner}">
                    <StackPanel Margin="0,10,0,0">
                        <ContentControl Theme="{StaticResource StatusBannerTheme}" Content="{Binding StatusMessage}"/>

                        <!-- STATUS -->

                        <!-- GUIDA STREAMING -->
                        <Border Classes="cardElevated" Margin="0,0,0,12" Padding="0" ClipToBounds="True">
                            <StackPanel>
                                <ToggleButton Classes="guideToggle" x:Name="ToggleGuideStreaming" IsChecked="False">
                                    <Grid ColumnDefinitions="*, Auto">
                                        <StackPanel Classes="bi" VerticalAlignment="Center">
                                            <Path Classes="icon accent" Data="{StaticResource IconBulb}"/>
                                            <TextBlock Text="Guida rapida - Film e Serie TV" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource AppTextBrush}"/>
                                        </StackPanel>
                                        <Path Grid.Column="1" Classes="chevron"/>
                                    </Grid>
                                </ToggleButton>
                                <Border IsVisible="{Binding #ToggleGuideStreaming.IsChecked}" Background="Transparent" Margin="16,0,16,16" Padding="12,12,4,12">
                                    <ScrollViewer MaxHeight="240" VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
                                    <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource AppTextMutedBrush}">
                                        <Run FontWeight="Bold" Foreground="{DynamicResource AppTextBrush}">Come si usa</Run><LineBreak/>
                                        <Run FontWeight="SemiBold" Foreground="{DynamicResource AppTextBrush}">• 1. Provider:</Run> scegli StreamingCommunity o CB01 (Maxstream) dal menu a sinistra della ricerca.<LineBreak/>
                                        <Run FontWeight="SemiBold" Foreground="{DynamicResource AppTextBrush}">• 2. Cerca:</Run> scrivi il titolo e premi Cerca o Invio.<LineBreak/>
                                        <Run FontWeight="SemiBold" Foreground="{DynamicResource AppTextBrush}">• 3. Dettaglio:</Run> fai doppio clic su un risultato, o passaci sopra e premi "Analizza": a destra compaiono locandina, informazioni e stagioni con gli episodi (serie) oppure il pulsante "Scarica film".<LineBreak/>
                                        <Run FontWeight="SemiBold" Foreground="{DynamicResource AppTextBrush}">• 4. Scarica:</Run> "Scarica selezionati" per gli episodi spuntati, "Scarica stagione" per la stagione aperta, "Scarica tutta la serie" per tutte le stagioni.<LineBreak/>
                                        <Run FontWeight="SemiBold" Foreground="{DynamicResource AppTextBrush}">• Priorità:</Run> il fulmine fa partire subito un episodio o una serie: se gli slot sono pieni, il download meno avanzato va in pausa e riparte appena possibile.<LineBreak/>
                                        <Run FontWeight="SemiBold" Foreground="{DynamicResource AppTextBrush}">• Errori:</Run> se un download fallisce per un problema temporaneo (rete, proxy, server occupato) riprova da solo fino a 3 volte (dopo 30 s, 2 e 5 minuti), ripartendo da dove era. Se fallisce ancora la riga diventa rossa con il motivo (tutto il messaggio passandoci sopra) e la serie mostra il badge "N falliti". "Riscarica" riprova a mano.<LineBreak/>
                                        <Run FontWeight="SemiBold" Foreground="{DynamicResource AppTextBrush}">• Cronologia:</Run> tutto ciò che hai scaricato, anche dopo aver pulito la coda (Ctrl+H). Accodando episodi già scaricati in passato l'app chiede se riscaricarli o saltarli; se lo spazio su disco stimato non basta chiede conferma, e con meno di 1 GB libero i download si fermano in pausa.<LineBreak/>
                                        <Run FontWeight="SemiBold" Foreground="{DynamicResource AppTextBrush}">• Notifiche e barra di stato:</Run> con l'app in secondo piano Windows avvisa a fine serie, per i download falliti e se il disco è pieno (campanella in alto per spegnerle). In basso, accanto al Log, si vede sempre cosa sta scaricando, da qualsiasi tab. Le scorciatoie da tastiera sono nel pulsante con la tastiera in alto.<LineBreak/>
                                        <Run FontWeight="SemiBold" Foreground="{DynamicResource AppTextBrush}">• Colori delle barre:</Run> verde completato, blu in download, arancione in pausa, rosso errore, grigio-azzurro in coda, grigio spento annullato. Le colonne restano allineate qualunque sia lo stato; dimensione, velocità e tempo rimanente stanno in un'unica colonna. Ogni serie dice quanti episodi sono in download e quanti in conversione (già scaricati, mentre l'app unisce le tracce o converte il file).<LineBreak/>
                                        <Run FontWeight="SemiBold" Foreground="{DynamicResource AppTextBrush}">• Pulisci lista:</Run> toglie dalla lista completati, annullati o falliti (i file restano su disco). "Elimina tutto…" è in fondo al menu e chiede sempre conferma.<LineBreak/>
                                        <Run FontWeight="SemiBold" Foreground="{DynamicResource AppTextBrush}">• Pulisci:</Run> svuota risultati, Dettaglio e campo di ricerca, come all'apertura dell'app. I download in coda e in corso continuano. La cronologia delle ricerche resta (per svuotarla c'è il cestino).<LineBreak/>
                                        <LineBreak/>
                                        <Run FontWeight="Bold" Foreground="{DynamicResource AppTextBrush}">StreamingCommunity</Run><LineBreak/>
                                        <Run FontWeight="SemiBold" Foreground="{DynamicResource AppTextBrush}">• Account:</Run> senza account i download arrivano a 720p; con un account Premium (tab Account) si sblocca il 1080p.<LineBreak/>
                                        <Run FontWeight="SemiBold" Foreground="{DynamicResource AppTextBrush}">• Qualità:</Run> nel Dettaglio scegli la qualità; Auto prende la migliore disponibile.<LineBreak/>
                                        <Run FontWeight="SemiBold" Foreground="{DynamicResource AppTextBrush}">• Audio:</Run> spunta le lingue di doppiaggio da includere nel file: la prima scelta è la traccia predefinita. Nessuna spunta = solo italiano.<LineBreak/>
                                        <Run FontWeight="SemiBold" Foreground="{DynamicResource AppTextBrush}">• Sottotitoli:</Run> spunta i sottotitoli da includere come tracce attivabili dal player. "Imprimi nel video" disegna il primo sottotitolo scelto nell'immagine (sempre visibile), ma richiede la ricodifica e rende l'unione finale molto più lenta.<LineBreak/>
                                        <Run FontWeight="SemiBold" Foreground="{DynamicResource AppTextBrush}">• Proxy:</Run> se compare l'errore 403 o il blocco di Cloudflare, attiva un proxy funzionante per StreamingCommunity nella tab Proxy.<LineBreak/>
                                        <LineBreak/>
                                        <Run FontWeight="Bold" Foreground="{DynamicResource AppTextBrush}">CB01 · Maxstream</Run><LineBreak/>
                                        <Run FontWeight="SemiBold" Foreground="{DynamicResource AppTextBrush}">• Account:</Run> serve un account Maxstream Premium (tab Account): senza, Maxstream mostra un captcha e i download falliscono.<LineBreak/>
                                        <Run FontWeight="SemiBold" Foreground="{DynamicResource AppTextBrush}">• Ricerca e qualità:</Run> vengono lette tutte le pagine di risultati, film e serie; il link migliore (HD/SD) viene scelto al via del download.<LineBreak/>
                                        <Run FontWeight="SemiBold" Foreground="{DynamicResource AppTextBrush}">• ITA e Sub ITA:</Run> il badge SUB ITA indica film e stagioni in lingua originale con sottotitoli italiani. Se una serie ha stagioni in entrambe le versioni compaiono "Scarica tutta la serie ITA" e "Scarica tutta la serie Sub ITA".<LineBreak/>
                                        <Run FontWeight="SemiBold" Foreground="{DynamicResource AppTextBrush}">• Più sezioni:</Run> se la pagina di una serie contiene più blocchi (stagioni, film, OAV, special), nell'elenco stagioni compaiono tutti con il loro nome.<LineBreak/>
                                        <Run FontWeight="SemiBold" Foreground="{DynamicResource AppTextBrush}">• Conversione:</Run> nel Dettaglio scegli cosa fare del file a fine download: Originale, Copia in MP4, MP4 + audio AAC oppure H.264 + AAC per i player web (con il processore o con la scheda video). Sotto il menu è spiegato cosa comporta ogni opzione; "Usa sempre questa" la rende predefinita, modificabile anche in "Nome file e cartella". Le conversioni vengono eseguite una alla volta e l'avanzamento compare nella coda.<LineBreak/>
                                        <Run FontWeight="SemiBold" Foreground="{DynamicResource AppTextBrush}">• Audio e sottotitoli:</Run> con tutte le opzioni MP4 restano tutte le tracce audio e i sottotitoli testuali, con l'italiano sempre come prima traccia audio (predefinita). Le conversioni AAC e H.264 regolano anche il volume (dialoghi in primo piano, -16 LUFS).<LineBreak/>
                                        <Run FontWeight="SemiBold" Foreground="{DynamicResource AppTextBrush}">• Proxy:</Run> per CB01 funzionano solo proxy residenziali (vedi tab Proxy); con la connessione di casa non serve nessun proxy.<LineBreak/>
                                        <LineBreak/>
                                        <Run FontWeight="Bold" Foreground="{DynamicResource AppTextBrush}">Come funziona l'accodamento</Run><LineBreak/>
                                        Gli episodi vengono accodati subito. Il link video di ogni episodio viene estratto quando parte il suo download, perché i link scadono dopo pochi minuti: così anche le code lunghe non falliscono per link scaduti.<LineBreak/>
                                        <LineBreak/>
                                        <Run FontWeight="Bold" Foreground="{DynamicResource AppTextBrush}">Suggerimenti</Run><LineBreak/>
                                        <Run FontWeight="SemiBold" Foreground="{DynamicResource AppTextBrush}">• Nome dei file:</Run> in "Nome file e cartella" ci sono pattern separati per StreamingCommunity e CB01, con {Series}, {Episode:D2}, {Title}, {Anno} e, per CB01, {OriginalFileName} (nome del file su Maxstream). Le stagioni possono finire in sottocartelle dedicate.<LineBreak/>
                                        <Run FontWeight="SemiBold" Foreground="{DynamicResource AppTextBrush}">• Apri nel browser:</Run> dal Dettaglio, o con il clic destro su un risultato, apre la pagina originale sul sito.<LineBreak/>
                                        <Run FontWeight="SemiBold" Foreground="{DynamicResource AppTextBrush}">• Sito non raggiungibile:</Run> controlla nella tab Domini che l'indirizzo del provider sia aggiornato.<LineBreak/>
                                        <Run FontWeight="SemiBold" Foreground="{DynamicResource AppTextBrush}">• Problemi:</Run> filtra il Log globale sulla sezione "Streaming" per vedere i dettagli di ogni estrazione e conversione.
                                    </TextBlock>
                                    </ScrollViewer>
                                </Border>
                            </StackPanel>
                        </Border>

                        <Border Classes="cardElevated" Margin="0,0,0,12">
                            <Grid ColumnDefinitions="Auto, *, Auto, Auto, Auto" RowDefinitions="Auto">
                                <ComboBox Grid.Column="0" ItemsSource="{Binding AvailableProviders}" SelectedItem="{Binding SelectedProvider, Mode=TwoWay}" MinWidth="170" Margin="0,0,8,0" MinHeight="40" ToolTip.Tip="Scegli il provider: StreamingCommunity (HLS) o CB01 (Maxstream)"/>
                                <ComboBox Grid.Column="1" Name="StreamingSearchComboBox" IsEditable="True" ItemsSource="{Binding SearchHistory}" PlaceholderText="Cerca un film o una serie TV..." KeyDown="OnStreamingSearchKeyDown" HorizontalAlignment="Stretch" Margin="0,0,8,0" MinHeight="40"/>
                                <Button ToolTip.Tip="Cerca film o serie TV (o premi Invio nel campo di ricerca)" Grid.Column="2" Classes="accent" Click="OnStreamingSearchButtonClick" MinWidth="110" Height="40" Margin="0,0,8,0">
                                    <StackPanel Classes="bi" HorizontalAlignment="Center">
                                        <Path Classes="icon" Data="{StaticResource IconSearch}"/>
                                        <TextBlock Text="Cerca"/>
                                    </StackPanel>
                                </Button>
                                <Button Grid.Column="3" Command="{Binding ClearAllCommand}" Height="40" Margin="0,0,8,0" ToolTip.Tip="Svuota risultati e dettaglio, come all'apertura dell'app. I download in coda e in corso continuano.">
                                    <StackPanel Classes="bi" HorizontalAlignment="Center">
                                        <Path Classes="icon" Data="{StaticResource IconUndo}"/>
                                        <TextBlock Text="Pulisci"/>
                                    </StackPanel>
                                </Button>
                                <Button Grid.Column="4" Classes="iconCircle" ToolTip.Tip="Svuota le ricerche recenti (il menu a tendina del campo di ricerca)" Click="OnStreamingClearSearchHistoryClick">
                                    <Path Classes="icon" Data="{StaticResource IconTrash}"/>
                                </Button>
                            </Grid>
                        </Border>

                        <Border Classes="cardElevated" Margin="0,0,0,12" Padding="0" ClipToBounds="True">
                            <StackPanel>
                                <ToggleButton Classes="guideToggle" x:Name="ToggleNamingStreaming" IsChecked="False" ToolTip.Tip="Mostra o nascondi pattern del nome file e cartella di destinazione">
                                    <Grid ColumnDefinitions="Auto, *, Auto">
                                        <StackPanel Classes="bi" VerticalAlignment="Center">
                                            <Path Classes="icon accent" Data="{StaticResource IconSettings}"/>
                                            <TextBlock Text="Nome file e cartella" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource AppTextBrush}"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" FontSize="12" Margin="16,0,12,0" VerticalAlignment="Center" HorizontalAlignment="Right" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource AppTextMutedBrush}" IsVisible="{Binding !#ToggleNamingStreaming.IsChecked}">
                                            <Run Text="{Binding SeriesPatternPreview}" FontFamily="Consolas,Menlo,monospace" Foreground="{DynamicResource AppAccentBrush}"/>
                                            <Run Text="  ·  "/>
                                            <Run Text="{Binding BaseDownloadFolder}"/>
                                        </TextBlock>
                                        <Path Grid.Column="2" Classes="chevron"/>
                                    </Grid>
                                </ToggleButton>
                                <Border IsVisible="{Binding #ToggleNamingStreaming.IsChecked}" Margin="16,0,16,16">
                                    <Grid ColumnDefinitions="Auto, *, Auto, Auto, Auto" RowDefinitions="Auto, Auto, Auto, Auto, Auto, Auto, Auto">
                                        <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,4,0" ToolTip.Tip="Nome dei film scaricati da StreamingCommunity"><TextBlock Text="Film · StreamingCommunity" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,6,0"/><h:PatternLegendButton Kind="Movie" Target="{Binding #MoviePatternBox}"/></StackPanel>
                                        <ComboBox x:Name="MoviePatternBox" Grid.Row="0" Grid.Column="1" IsEditable="True" ItemsSource="{Binding MovieNamingPresets}" Text="{Binding MovieNamingPattern, Mode=TwoWay}" HorizontalAlignment="Stretch" Margin="0,0,10,0"/>
                                        <Border Grid.Row="0" Grid.Column="2" Background="{DynamicResource AppSurface2Brush}" BorderBrush="{DynamicResource AppAccentBrush}" BorderThickness="1" CornerRadius="6" Padding="10,4" Margin="0,0,10,0" MaxWidth="380">
                                            <TextBlock Text="{Binding MoviePatternPreview}" FontFamily="Consolas,Menlo,monospace" Foreground="{DynamicResource AppAccentBrush}" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                        </Border>

                                        <StackPanel Grid.Row="1" Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,10,4,0" ToolTip.Tip="Nome degli episodi scaricati da StreamingCommunity"><TextBlock Text="Serie · StreamingCommunity" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,6,0"/><h:PatternLegendButton Kind="Series" Target="{Binding #SeriesPatternBox}"/></StackPanel>
                                        <ComboBox x:Name="SeriesPatternBox" Grid.Row="1" Grid.Column="1" IsEditable="True" ItemsSource="{Binding SeriesNamingPresets}" Text="{Binding SeriesNamingPattern, Mode=TwoWay}" HorizontalAlignment="Stretch" Margin="0,10,10,0"/>
                                        <Border Grid.Row="1" Grid.Column="2" Background="{DynamicResource AppSurface2Brush}" BorderBrush="{DynamicResource AppAccentBrush}" BorderThickness="1" CornerRadius="6" Padding="10,4" Margin="0,10,10,0" MaxWidth="380">
                                            <TextBlock Text="{Binding SeriesPatternPreview}" FontFamily="Consolas,Menlo,monospace" Foreground="{DynamicResource AppAccentBrush}" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                        </Border>

                                        <StackPanel Grid.Row="2" Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,10,4,0" ToolTip.Tip="Nome dei film scaricati da CB01. {OriginalFileName} = nome del file su Maxstream"><TextBlock Text="Film · CB01" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,6,0"/><h:PatternLegendButton Kind="Movie" Target="{Binding #Cb01MoviePatternBox}"/></StackPanel>
                                        <ComboBox x:Name="Cb01MoviePatternBox" Grid.Row="2" Grid.Column="1" IsEditable="True" ItemsSource="{Binding MovieNamingPresets}" Text="{Binding Cb01MovieNamingPattern, Mode=TwoWay}" HorizontalAlignment="Stretch" Margin="0,10,10,0"/>
                                        <Border Grid.Row="2" Grid.Column="2" Background="{DynamicResource AppSurface2Brush}" BorderBrush="{DynamicResource AppAccentBrush}" BorderThickness="1" CornerRadius="6" Padding="10,4" Margin="0,10,10,0" MaxWidth="380">
                                            <TextBlock Text="{Binding Cb01MoviePatternPreview}" FontFamily="Consolas,Menlo,monospace" Foreground="{DynamicResource AppAccentBrush}" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                        </Border>

                                        <StackPanel Grid.Row="3" Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,10,4,0" ToolTip.Tip="Nome degli episodi scaricati da CB01. {OriginalFileName} = nome del file su Maxstream"><TextBlock Text="Serie · CB01" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,6,0"/><h:PatternLegendButton Kind="Series" Target="{Binding #Cb01SeriesPatternBox}"/></StackPanel>
                                        <ComboBox x:Name="Cb01SeriesPatternBox" Grid.Row="3" Grid.Column="1" IsEditable="True" ItemsSource="{Binding SeriesNamingPresets}" Text="{Binding Cb01SeriesNamingPattern, Mode=TwoWay}" HorizontalAlignment="Stretch" Margin="0,10,10,0"/>
                                        <Border Grid.Row="3" Grid.Column="2" Background="{DynamicResource AppSurface2Brush}" BorderBrush="{DynamicResource AppAccentBrush}" BorderThickness="1" CornerRadius="6" Padding="10,4" Margin="0,10,10,0" MaxWidth="380">
                                            <TextBlock Text="{Binding Cb01SeriesPatternPreview}" FontFamily="Consolas,Menlo,monospace" Foreground="{DynamicResource AppAccentBrush}" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                        </Border>

                                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Cartella base" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,10,10,0"/>
                                        <TextBox Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding BaseDownloadFolder, Mode=TwoWay}" Margin="0,10,10,0"/>
                                        <Button Grid.Row="4" Grid.Column="3" Classes="iconCircle" Click="OnStreamingBrowseBaseFolderClick" Margin="0,10,8,0" ToolTip.Tip="Sfoglia">
                                            <Path Classes="icon" Data="{StaticResource IconFolder}"/>
                                        </Button>
                                        <CheckBox ToolTip.Tip="Salva ogni serie in una sottocartella con il suo nome dentro la cartella base" Grid.Row="4" Grid.Column="4" Content="Crea sottocartella per serie" IsChecked="{Binding CreateSeriesFolder, Mode=TwoWay}" VerticalAlignment="Center" Margin="0,10,0,0"/>

                                        <StackPanel Grid.Row="5" Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,10,4,0"><TextBlock Text="Sottocartella stagione" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,6,0"/><h:PatternLegendButton Kind="SeasonFolder" Target="{Binding #SeasonFolderBox}"/></StackPanel>
                                        <TextBox x:Name="SeasonFolderBox" Grid.Row="5" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding SeasonFolderPattern}" PlaceholderText="Stagione {number} (vuoto = nessuna)" Margin="0,10,10,0"/>

                                        <TextBlock Grid.Row="6" Grid.Column="0" Text="Conversione CB01" VerticalAlignment="Top" FontWeight="SemiBold" Margin="0,16,10,0" ToolTip.Tip="Scelta proposta per ogni download CB01: si può cambiare ogni volta nel Dettaglio"/>
                                        <StackPanel Grid.Row="6" Grid.Column="1" Grid.ColumnSpan="4" Spacing="4" Margin="0,10,0,0">
                                            <ComboBox ItemsSource="{Binding ConversionOptions}" SelectedItem="{Binding DefaultConversion, Mode=TwoWay}" HorizontalAlignment="Left" MinWidth="320">
                                                <ComboBox.ItemTemplate>
                                                    <DataTemplate x:DataType="models:VideoConversionOption">
                                                        <TextBlock Text="{Binding Title}"/>
                                                    </DataTemplate>
                                                </ComboBox.ItemTemplate>
                                            </ComboBox>
                                            <TextBlock Text="{Binding DefaultConversion.Details}" FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource AppTextMutedBrush}"/>
                                            <TextBlock Text="{x:Static models:VideoConversionOption.TimingNote}" FontSize="10" FontStyle="Italic" TextWrapping="Wrap" Foreground="{DynamicResource AppTextMutedBrush}" Opacity="0.8"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>

                        <Grid ColumnDefinitions="1*, 1*" Height="800" Margin="0,0,0,12">
                            <Border Grid.Column="0" Classes="cardElevated" Margin="0,0,6,0">
                                <DockPanel>
                                    <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto, Auto, *" Margin="0,0,0,8">
                                        <StackPanel Grid.Column="0" Classes="bi" VerticalAlignment="Center">
                                            <Path Classes="icon accent" Data="{StaticResource IconFilm}"/>
                                            <TextBlock Text="Risultati ricerca" FontWeight="Bold" FontSize="14"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="{Binding SearchResultsCountText}" FontSize="12" Foreground="{DynamicResource AppTextMutedBrush}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" IsVisible="{Binding IsLoadingSearchResults}">
                                            <ProgressBar IsIndeterminate="True" Width="80" Height="4" VerticalAlignment="Center"/>
                                            <TextBlock Text="Ricerca..." FontSize="11" FontStyle="Italic" Foreground="{DynamicResource AppTextMutedBrush}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Grid>
                                    <Panel>
                                    <ListBox Name="StreamingSearchResultsGrid" Classes="posterGrid" ItemsSource="{Binding SearchResults}" SelectedItem="{Binding SelectedResult, Mode=TwoWay}" DoubleTapped="OnStreamingSearchResultDoubleTapped" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                        <ListBox.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel Orientation="Horizontal"/>
                                            </ItemsPanelTemplate>
                                        </ListBox.ItemsPanel>
                                        <ListBox.ItemTemplate>
                                            <DataTemplate x:DataType="models:MovieSearchResult">
                                                <StackPanel Width="140" Spacing="4" Background="Transparent">
                                                    <StackPanel.ContextMenu>
                                                        <ContextMenu>
                                                            <MenuItem Header="Apri nel browser" Click="OnOpenResultInBrowserClick"><MenuItem.Icon><Path Classes="icon" Data="{StaticResource IconGlobe}"/></MenuItem.Icon></MenuItem>
                                                            <MenuItem Header="Copia link" Click="OnCopyResultLinkClick"><MenuItem.Icon><Path Classes="icon" Data="{StaticResource IconCopy}"/></MenuItem.Icon></MenuItem>
                                                        </ContextMenu>
                                                    </StackPanel.ContextMenu>
                                                    <Panel Width="140" Height="200">
                                                        <Border Classes="poster" Width="140" Height="200">
                                                            <Image Source="{Binding Poster}" Stretch="UniformToFill"/>
                                                        </Border>
                                                        <Border Classes="subBadge" Margin="6,8,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" IsVisible="{Binding IsSubIta}" ToolTip.Tip="Lingua originale con sottotitoli italiani"><TextBlock Text="SUB ITA"/></Border>
                                                        <Border Classes="posterShade" Width="140" Height="200"/>
                                                        <Button Classes="posterAnalyze" Click="OnAnalyzeStreamingClick">
                                                            <TextBlock Text="Analizza"/>
                                                        </Button>
                                                        <Button Classes="iconCircle" Width="28" Height="28" Padding="0" Margin="0,6,6,0" HorizontalAlignment="Right" VerticalAlignment="Top" Opacity="0.85" ToolTip.Tip="Apri il post nel browser" Click="OnOpenResultInBrowserClick">
                                                            <Path Classes="icon" Data="{StaticResource IconGlobe}" Width="14" Height="14"/>
                                                        </Button>
                                                    </Panel>
                                                    <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" TextAlignment="Center"/>
                                                    <TextBlock FontSize="11" TextAlignment="Center" Foreground="{DynamicResource AppTextMutedBrush}">
                                                        <Run Text="{Binding YearAndType}"/>
                                                    </TextBlock>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                    <Border HorizontalAlignment="Center" VerticalAlignment="Top" MaxWidth="380" Margin="16,90,16,16" IsHitTestVisible="False" IsVisible="{Binding ShowResultsPlaceholder}">
                                            <StackPanel Spacing="10" HorizontalAlignment="Center">
                                                <Border Width="72" Height="72" CornerRadius="36" Background="{DynamicResource AppSurface2Brush}" HorizontalAlignment="Center">
                                                    <Path Classes="icon accent" Data="{StaticResource IconSearch}" Width="30" Height="30" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <TextBlock Text="{Binding ResultsPlaceholderTitle}" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"/>
                                                <TextBlock Text="{Binding ResultsPlaceholderText}" FontSize="12" Foreground="{DynamicResource AppTextMutedBrush}" TextAlignment="Center" TextWrapping="Wrap" LineHeight="18"/>
                                            </StackPanel>
                                        </Border>
                                    </Panel>
                                </DockPanel>
                            </Border>

                            <Border Grid.Column="1" Classes="cardElevated" Margin="6,0,0,0">
                                <DockPanel>
                                    <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto, Auto, *" Margin="0,0,0,8">
                                        <StackPanel Grid.Column="0" Classes="bi" VerticalAlignment="Center">
                                            <Path Classes="icon accent" Data="{StaticResource IconTv}"/>
                                            <TextBlock Text="Dettaglio" FontWeight="Bold" FontSize="14"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="12" HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" IsVisible="{Binding IsLoadingEpisodes}">
                                                <ProgressBar IsIndeterminate="True" Width="80" Height="4" VerticalAlignment="Center"/>
                                                <TextBlock Text="Caricamento..." FontSize="11" FontStyle="Italic" Foreground="{DynamicResource AppTextMutedBrush}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <ComboBox ItemsSource="{Binding Seasons}" SelectedItem="{Binding SelectedSeason, Mode=TwoWay}" MinWidth="160" IsVisible="{Binding IsSelectedResultSeries}" ToolTip.Tip="Seleziona stagione">
                                                <ComboBox.ItemTemplate>
                                                    <DataTemplate x:DataType="models:Season">
                                                        <TextBlock Text="{Binding DisplayName}"/>
                                                    </DataTemplate>
                                                </ComboBox.ItemTemplate>
                                            </ComboBox>
                                        </StackPanel>
                                    </Grid>

                                    <Border DockPanel.Dock="Top" Background="{DynamicResource AppSurface2Brush}" CornerRadius="12" Padding="12" Margin="0,0,0,10" IsVisible="{Binding IsSelectedResultSeries}">
                                        <Grid ColumnDefinitions="Auto, *">
                                            <Border Classes="poster" Width="84" Height="120" VerticalAlignment="Top" Margin="0,0,14,0" Background="{DynamicResource AppHoverBrush}">
                                                <Panel>
                                                    <Path Classes="icon" Data="{StaticResource IconTv}" Width="28" Height="28" Stroke="{DynamicResource AppTextMutedBrush}" HorizontalAlignment="Center"/>
                                                    <Image Source="{Binding SelectedResult.Poster, FallbackValue={x:Null}}" Stretch="UniformToFill"/>
                                                </Panel>
                                            </Border>
                                            <StackPanel Grid.Column="1" Spacing="8">
                                                <TextBlock Text="{Binding SelectedResultName}" FontSize="17" FontWeight="Bold" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis"/>
                                                <WrapPanel Orientation="Horizontal" ItemSpacing="6" LineSpacing="6">
                                                    <Border Classes="moviePill accent"><StackPanel Classes="bi"><Path Classes="icon" Data="{StaticResource IconTv}"/><TextBlock Text="Serie"/></StackPanel></Border>
                                                    <Border Classes="moviePill" IsVisible="{Binding HasSelectedResultYear}"><TextBlock Text="{Binding SelectedResultYear}"/></Border>
                                                    <Border Classes="moviePill"><StackPanel Classes="bi"><Path Classes="icon" Data="{StaticResource IconGlobe}"/><TextBlock Text="{Binding ProviderDisplayName}"/></StackPanel></Border>
                                                    <Border Classes="moviePill" IsVisible="{Binding HasSeasonsCount}"><StackPanel Classes="bi"><Path Classes="icon" Data="{StaticResource IconLayers}"/><TextBlock Text="{Binding SeasonsCountText}"/></StackPanel></Border>
                                                    <Border Classes="moviePill" IsVisible="{Binding HasSeasonEpisodes}"><StackPanel Classes="bi"><Path Classes="icon" Data="{StaticResource IconList}"/><TextBlock Text="{Binding SeasonEpisodesText}"/></StackPanel></Border>
                                                    <Border Classes="moviePill warn" IsVisible="{Binding SelectedSeason.HasLanguageTag, FallbackValue=False}" ToolTip.Tip="Episodi disponibili solo in lingua originale con sottotitoli italiani (segnati nella tabella)"><StackPanel Classes="bi"><Path Classes="icon" Data="{StaticResource IconList}"/><TextBlock Text="{Binding SelectedSeason.LanguageTag, FallbackValue=''}"/></StackPanel></Border>
                                                    <Border Classes="moviePill accent" IsVisible="{Binding HasSelectedEpisodes}"><StackPanel Classes="bi"><Path Classes="icon" Data="{StaticResource IconCheck}"/><TextBlock Text="{Binding EpisodesSelectedCountText}"/></StackPanel></Border>
                                                </WrapPanel>
                                                <TextBlock Text="{Binding SelectedResultDescription}" TextWrapping="Wrap" MaxLines="3" TextTrimming="CharacterEllipsis" FontSize="12" Foreground="{DynamicResource AppTextMutedBrush}" IsVisible="{Binding HasSelectedResultDescription}"/>
                                                <Grid ColumnDefinitions="Auto, *" RowDefinitions="Auto, Auto">
                                                    <TextBlock Grid.Row="0" Text="Cartella" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AppTextMutedBrush}" VerticalAlignment="Center" Margin="0,0,12,4"/>
                                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding DetailFolder}" FontSize="12" TextTrimming="CharacterEllipsis" Margin="0,0,0,4" ToolTip.Tip="{Binding DetailFolder}"/>
                                                    <TextBlock Grid.Row="1" Text="Esempio file" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AppTextMutedBrush}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding DetailFileName}" FontFamily="Consolas,Menlo,monospace" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource AppAccentBrush}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding DetailFileName}"/>
                                                </Grid>
                                                <TextBlock Text="{Binding SeriesDetailHint}" FontSize="11" Foreground="{DynamicResource AppTextMutedBrush}" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                    <WrapPanel DockPanel.Dock="Top" Orientation="Horizontal" ItemSpacing="14" LineSpacing="8" Margin="0,0,0,8" IsVisible="{Binding HasSelectedResult}">
                                        <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding !IsCb01}">
                                            <TextBlock Text="Qualità:" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                            <ComboBox ItemsSource="{Binding AvailableQualities}" SelectedItem="{Binding SelectedQuality, Mode=TwoWay}" MinWidth="160" ToolTip.Tip="Auto seleziona la qualità migliore disponibile. 1080p richiede l'account Premium.">
                                                <ComboBox.ItemTemplate>
                                                    <DataTemplate x:DataType="models:VideoQuality">
                                                        <TextBlock Text="{Binding DisplayName}"/>
                                                    </DataTemplate>
                                                </ComboBox.ItemTemplate>
                                            </ComboBox>
                                        </StackPanel>

                                        <!-- Lingue audio (anche più di una: finiscono tutte nel file) -->
                                        <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding HasAudioTracks}">
                                            <TextBlock Text="Audio:" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                            <DropDownButton Classes="trackPicker" MinWidth="190" ToolTip.Tip="Lingue di doppiaggio da includere nel file. Puoi sceglierne più di una: la prima è quella predefinita.">
                                                <StackPanel Classes="bi">
                                                    <Path Classes="icon accent" Data="{StaticResource IconPlayCircle}"/>
                                                    <TextBlock Text="{Binding AudioSelectionText}" TextTrimming="CharacterEllipsis" MaxWidth="240"/>
                                                </StackPanel>
                                                <DropDownButton.Flyout>
                                                    <Flyout Placement="BottomEdgeAlignedLeft" FlyoutPresenterClasses="trackFlyout">
                                                        <StackPanel Spacing="6" Width="300">
                                                            <Grid ColumnDefinitions="*, Auto" Margin="4,2,4,2">
                                                                <StackPanel Classes="bi">
                                                                    <Path Classes="icon accent" Data="{StaticResource IconPlayCircle}"/>
                                                                    <TextBlock Text="Audio" FontWeight="Bold"/>
                                                                </StackPanel>
                                                                <TextBlock Grid.Column="1" Text="{Binding AudioCountText}" FontSize="11" VerticalAlignment="Center" Foreground="{DynamicResource AppTextMutedBrush}"/>
                                                            </Grid>
                                                            <Border Height="1" Background="{DynamicResource AppBorderBrush}"/>
                                                            <ItemsControl ItemsSource="{Binding AudioTracks}">
                                                                        <ItemsControl.ItemTemplate>
                                                                            <DataTemplate x:DataType="models:MediaTrack">
                                                                                <Border Classes="trackRow">
                                                                                    <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                                                                                        <Grid ColumnDefinitions="*, Auto, Auto">
                                                                                            <TextBlock Text="{Binding Label}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                                                            <Border Grid.Column="1" Classes="trackBadge warn" IsVisible="{Binding IsForced}" Margin="8,0,0,0"><TextBlock Text="forzati"/></Border>
                                                                                            <Border Grid.Column="2" Classes="trackBadge" IsVisible="{Binding HasLanguage}" Margin="8,0,0,0"><TextBlock Text="{Binding Language}"/></Border>
                                                                                        </Grid>
                                                                                    </CheckBox>
                                                                                </Border>
                                                                            </DataTemplate>
                                                                        </ItemsControl.ItemTemplate>
                                                                    </ItemsControl>
                                                            <Border Height="1" Background="{DynamicResource AppBorderBrush}"/>
                                                            <Grid ColumnDefinitions="*, Auto, Auto" Margin="4,0,0,0">
                                                                <TextBlock Text="Nessuna spunta = italiano" FontSize="11" TextWrapping="Wrap" VerticalAlignment="Center" Foreground="{DynamicResource AppTextMutedBrush}"/>
                                                                <Button Grid.Column="1" Classes="ghost" Padding="10,4" FontSize="11" Command="{Binding SelectAllAudioCommand}" ToolTip.Tip="Seleziona tutte">Tutte</Button>
                                                                <Button Grid.Column="2" Classes="ghost" Padding="10,4" FontSize="11" Command="{Binding SelectNoAudioCommand}" ToolTip.Tip="Togli tutte le spunte">Nessuna</Button>
                                                            </Grid>
                                                        </StackPanel>
                                                    </Flyout>
                                                </DropDownButton.Flyout>
                                            </DropDownButton>
                                        </StackPanel>

                                        <!-- Sottotitoli -->
                                        <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding HasSubtitleTracks}">
                                            <TextBlock Text="Sottotitoli:" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                            <DropDownButton Classes="trackPicker" MinWidth="170" ToolTip.Tip="Sottotitoli da includere nel file come tracce attivabili dal player">
                                                <StackPanel Classes="bi">
                                                    <Path Classes="icon accent" Data="{StaticResource IconList}"/>
                                                    <TextBlock Text="{Binding SubtitleSelectionText}" TextTrimming="CharacterEllipsis" MaxWidth="240"/>
                                                </StackPanel>
                                                <DropDownButton.Flyout>
                                                    <Flyout Placement="BottomEdgeAlignedLeft" FlyoutPresenterClasses="trackFlyout">
                                                        <StackPanel Spacing="6" Width="300">
                                                            <Grid ColumnDefinitions="*, Auto" Margin="4,2,4,2">
                                                                <StackPanel Classes="bi">
                                                                    <Path Classes="icon accent" Data="{StaticResource IconList}"/>
                                                                    <TextBlock Text="Sottotitoli" FontWeight="Bold"/>
                                                                </StackPanel>
                                                                <TextBlock Grid.Column="1" Text="{Binding SubtitleCountText}" FontSize="11" VerticalAlignment="Center" Foreground="{DynamicResource AppTextMutedBrush}"/>
                                                            </Grid>
                                                            <Border Height="1" Background="{DynamicResource AppBorderBrush}"/>
                                                            <ScrollViewer MaxHeight="210" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                                                    <ItemsControl ItemsSource="{Binding SubtitleTracks}">
                                                                        <ItemsControl.ItemTemplate>
                                                                            <DataTemplate x:DataType="models:MediaTrack">
                                                                                <Border Classes="trackRow">
                                                                                    <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                                                                                        <Grid ColumnDefinitions="*, Auto, Auto">
                                                                                            <TextBlock Text="{Binding Label}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                                                            <Border Grid.Column="1" Classes="trackBadge warn" IsVisible="{Binding IsForced}" Margin="8,0,0,0"><TextBlock Text="forzati"/></Border>
                                                                                            <Border Grid.Column="2" Classes="trackBadge" IsVisible="{Binding HasLanguage}" Margin="8,0,0,0"><TextBlock Text="{Binding Language}"/></Border>
                                                                                        </Grid>
                                                                                    </CheckBox>
                                                                                </Border>
                                                                            </DataTemplate>
                                                                        </ItemsControl.ItemTemplate>
                                                                    </ItemsControl>
                                                                    </ScrollViewer>
                                                            <Border Height="1" Background="{DynamicResource AppBorderBrush}"/>
                                                            <Grid ColumnDefinitions="*, Auto, Auto" Margin="4,0,0,0">
                                                                <TextBlock Text="Tracce attivabili dal player" FontSize="11" TextWrapping="Wrap" VerticalAlignment="Center" Foreground="{DynamicResource AppTextMutedBrush}"/>
                                                                <Button Grid.Column="1" Classes="ghost" Padding="10,4" FontSize="11" Command="{Binding SelectAllSubtitlesCommand}" ToolTip.Tip="Seleziona tutte">Tutte</Button>
                                                                <Button Grid.Column="2" Classes="ghost" Padding="10,4" FontSize="11" Command="{Binding SelectNoSubtitlesCommand}" ToolTip.Tip="Togli tutte le spunte">Nessuna</Button>
                                                            </Grid>
                                                        </StackPanel>
                                                    </Flyout>
                                                </DropDownButton.Flyout>
                                            </DropDownButton>
                                            <CheckBox Content="Imprimi nel video" IsChecked="{Binding BurnSubtitles, Mode=TwoWay}" VerticalAlignment="Center"
                                                      ToolTip.Tip="Il primo sottotitolo scelto viene disegnato nell'immagine (sempre visibile, anche su TV e player senza sottotitoli). Richiede la ricodifica del video: l'unione finale è molto più lenta."/>
                                        </StackPanel>
                                    </WrapPanel>

                                    <!-- CB01: conversione a fine download (scelta per questo download) -->
                                    <Panel DockPanel.Dock="Top" IsVisible="{Binding HasSelectedResult}">
                                        <Border IsVisible="{Binding IsCb01}" Background="{DynamicResource AppSurface2Brush}" CornerRadius="10" Padding="12,10" Margin="0,0,0,10">
                                            <StackPanel Spacing="6">
                                                <Grid ColumnDefinitions="Auto, *, Auto">
                                                    <StackPanel Classes="bi" VerticalAlignment="Center" Margin="0,0,10,0">
                                                        <Path Classes="icon accent" Data="{StaticResource IconRefresh}"/>
                                                        <TextBlock Text="Conversione" FontWeight="SemiBold"/>
                                                    </StackPanel>
                                                    <ComboBox Grid.Column="1" ItemsSource="{Binding ConversionOptions}" SelectedItem="{Binding SelectedConversion, Mode=TwoWay}" HorizontalAlignment="Stretch" MaxWidth="360"
                                                              ToolTip.Tip="Cosa fare del video a fine download. Vale per i prossimi download che accodi da qui.">
                                                        <ComboBox.ItemTemplate>
                                                            <DataTemplate x:DataType="models:VideoConversionOption">
                                                                <TextBlock Text="{Binding Title}"/>
                                                            </DataTemplate>
                                                        </ComboBox.ItemTemplate>
                                                    </ComboBox>
                                                    <Panel Grid.Column="2" Margin="10,0,0,0" VerticalAlignment="Center">
                                                        <Border Classes="moviePill accent" IsVisible="{Binding IsSelectedConversionDefault}" ToolTip.Tip="È la tua scelta predefinita (si cambia in &quot;Nome file e cartella&quot;)"><TextBlock Text="Predefinita"/></Border>
                                                        <Button Classes="ghost" Padding="10,4" FontSize="11" Command="{Binding MakeConversionDefaultCommand}" IsVisible="{Binding !IsSelectedConversionDefault}" ToolTip.Tip="Usa questa conversione anche per i prossimi download">Usa sempre questa</Button>
                                                    </Panel>
                                                </Grid>
                                                <TextBlock Text="{Binding SelectedConversion.Details, FallbackValue=''}" FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource AppTextMutedBrush}"/>
                                                <TextBlock Text="{x:Static models:VideoConversionOption.TimingNote}" FontSize="10" FontStyle="Italic" TextWrapping="Wrap" Foreground="{DynamicResource AppTextMutedBrush}" Opacity="0.8"/>
                                            </StackPanel>
                                        </Border>
                                    </Panel>

                                    <WrapPanel DockPanel.Dock="Top" Orientation="Horizontal" ItemSpacing="6" LineSpacing="6" Margin="0,0,0,8" IsVisible="{Binding IsSelectedResultSeries}">
                                        <Button ToolTip.Tip="Accoda tutti gli episodi spuntati (quelli già in coda vengono saltati)" Classes="success" Command="{Binding DownloadSelectedEpisodesCommand}" IsEnabled="{Binding CanInteractWithEpisodes}"><StackPanel Classes="bi"><Path Classes="icon" Data="{StaticResource IconDownload}"/><TextBlock Text="Scarica selezionati"/></StackPanel></Button>
                                        <Button Classes="accent" Command="{Binding DownloadCurrentSeasonCommand}" IsEnabled="{Binding CanInteractWithEpisodes}" ToolTip.Tip="Accoda tutti gli episodi della stagione corrente"><StackPanel Classes="bi"><Path Classes="icon" Data="{StaticResource IconDownload}"/><TextBlock Text="Scarica stagione"/></StackPanel></Button>
                                        <Button Classes="info" Command="{Binding DownloadAllSeasonsCommand}" IsEnabled="{Binding CanInteractWithEpisodes}" IsVisible="{Binding !HasItaAndSubSeasons}" ToolTip.Tip="Accoda tutti gli episodi di tutte le stagioni"><StackPanel Classes="bi"><Path Classes="icon" Data="{StaticResource IconLayers}"/><TextBlock Text="Scarica tutta la serie"/></StackPanel></Button>
                                        <Button Classes="info" Command="{Binding DownloadAllSeasonsCommand}" CommandParameter="ita" IsEnabled="{Binding CanInteractWithEpisodes}" IsVisible="{Binding HasItaAndSubSeasons}" ToolTip.Tip="Accoda tutte le stagioni in italiano"><StackPanel Classes="bi"><Path Classes="icon" Data="{StaticResource IconLayers}"/><TextBlock Text="Scarica tutta la serie ITA"/></StackPanel></Button>
                                        <Button Classes="warning" Command="{Binding DownloadAllSeasonsCommand}" CommandParameter="sub" IsEnabled="{Binding CanInteractWithEpisodes}" IsVisible="{Binding HasItaAndSubSeasons}" ToolTip.Tip="Accoda tutte le stagioni sottotitolate in italiano"><StackPanel Classes="bi"><Path Classes="icon" Data="{StaticResource IconLayers}"/><TextBlock Text="Scarica tutta la serie Sub ITA"/></StackPanel></Button>
                                        <Button ToolTip.Tip="Seleziona tutti gli episodi della lista" Content="Seleziona tutti" Click="OnStreamingSelectAllEpisodesClick" IsEnabled="{Binding CanInteractWithEpisodes}"/>
                                        <Button ToolTip.Tip="Toglie la selezione a tutti gli episodi" Content="Deseleziona" Click="OnStreamingDeselectAllEpisodesClick" IsEnabled="{Binding CanInteractWithEpisodes}"/>
                                        <Button ToolTip.Tip="Inverte la selezione degli episodi" Content="Inverti" Click="OnStreamingInvertEpisodeSelectionClick" IsEnabled="{Binding CanInteractWithEpisodes}"/>
                                        <Button ToolTip.Tip="Interrompe l'accodamento in corso (gli episodi già accodati restano in coda)" Classes="danger" Command="{Binding CancelBatchCommand}" IsVisible="{Binding IsBatchActive}"><StackPanel Classes="bi"><Path Classes="icon" Data="{StaticResource IconStop}"/><TextBlock Text="Stop accodamento"/></StackPanel></Button>
                                    </WrapPanel>

                                    <Panel>
                                    <!-- DETTAGLIO FILM -->
                                    <ScrollViewer IsVisible="{Binding IsSelectedResultMovie}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                        <Grid ColumnDefinitions="Auto, *" Margin="0,4,0,0">
                                            <Border Grid.Column="0" Classes="poster" Width="170" Height="245" VerticalAlignment="Top" Margin="0,0,18,0" Background="{DynamicResource AppSurface2Brush}">
                                                <Panel>
                                                    <Path Classes="icon" Data="{StaticResource IconFilm}" Width="40" Height="40" Stroke="{DynamicResource AppTextMutedBrush}" HorizontalAlignment="Center"/>
                                                    <Image Source="{Binding SelectedResult.Poster, FallbackValue={x:Null}}" Stretch="UniformToFill"/>
                                                </Panel>
                                            </Border>
                                            <StackPanel Grid.Column="1" Spacing="12">
                                                <TextBlock Text="{Binding SelectedResultName}" FontSize="20" FontWeight="Bold" TextWrapping="Wrap"/>
                                                <WrapPanel Orientation="Horizontal" ItemSpacing="6" LineSpacing="6">
                                                    <Border Classes="moviePill accent"><StackPanel Classes="bi"><Path Classes="icon" Data="{StaticResource IconFilm}"/><TextBlock Text="Film"/></StackPanel></Border>
                                                    <Border Classes="moviePill warn" IsVisible="{Binding SelectedResultIsSubIta}" ToolTip.Tip="Lingua originale con sottotitoli italiani"><StackPanel Classes="bi"><Path Classes="icon" Data="{StaticResource IconList}"/><TextBlock Text="Sub ITA"/></StackPanel></Border>
                                                    <Border Classes="moviePill" IsVisible="{Binding HasSelectedResultYear}"><TextBlock Text="{Binding SelectedResultYear}"/></Border>
                                                    <Border Classes="moviePill"><StackPanel Classes="bi"><Path Classes="icon" Data="{StaticResource IconGlobe}"/><TextBlock Text="{Binding ProviderDisplayName}"/></StackPanel></Border>
                                                    <Border Classes="moviePill" IsVisible="{Binding SelectedQuality, Converter={x:Static ObjectConverters.IsNotNull}}"><TextBlock Text="{Binding SelectedQuality.DisplayName, FallbackValue=''}"/></Border>
                                                    <Border Classes="moviePill" IsVisible="{Binding HasAudioTracks}"><StackPanel Classes="bi"><Path Classes="icon" Data="{StaticResource IconPlayCircle}"/><TextBlock Text="{Binding AudioSelectionText}"/></StackPanel></Border>
                                                </WrapPanel>
                                                <TextBlock Text="{Binding SelectedResultDescription}" TextWrapping="Wrap" MaxLines="6" TextTrimming="CharacterEllipsis" FontSize="12" Foreground="{DynamicResource AppTextMutedBrush}" IsVisible="{Binding HasSelectedResultDescription}"/>

                                                <Border Background="{DynamicResource AppSurface2Brush}" CornerRadius="10" Padding="14,12">
                                                    <Grid ColumnDefinitions="Auto, *" RowDefinitions="Auto, Auto">
                                                        <TextBlock Grid.Row="0" Text="File" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AppTextMutedBrush}" VerticalAlignment="Center" Margin="0,0,14,8"/>
                                                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding DetailFileName}" FontFamily="Consolas,Menlo,monospace" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource AppAccentBrush}" TextTrimming="CharacterEllipsis" Margin="0,0,0,8" ToolTip.Tip="{Binding DetailFileName}"/>
                                                        <TextBlock Grid.Row="1" Text="Cartella" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AppTextMutedBrush}" VerticalAlignment="Center" Margin="0,0,14,0"/>
                                                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding DetailFolder}" FontSize="12" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding DetailFolder}"/>
                                                    </Grid>
                                                </Border>

                                                <StackPanel Orientation="Horizontal" Spacing="12">
                                                    <Button ToolTip.Tip="Accoda il film selezionato" Classes="success" Padding="20,10" FontSize="14" Command="{Binding DownloadMovieCommand}" CommandParameter="{Binding SelectedResult}" IsEnabled="{Binding CanDownloadMovie}"><StackPanel Classes="bi"><Path Classes="icon" Data="{StaticResource IconDownload}"/><TextBlock Text="Scarica film" FontWeight="SemiBold"/></StackPanel></Button>
                                                    <Button ToolTip.Tip="Apri la pagina del film nel browser" Click="OnOpenSelectedResultInBrowserClick"><StackPanel Classes="bi"><Path Classes="icon" Data="{StaticResource IconGlobe}"/><TextBlock Text="Apri nel browser"/></StackPanel></Button>
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <ProgressBar IsIndeterminate="True" Width="60" Height="4" MinHeight="4" VerticalAlignment="Center" IsVisible="{Binding IsQualitiesLoading}"/>
                                                    <TextBlock Text="{Binding MovieReadyHint}" FontSize="12" Foreground="{DynamicResource AppTextMutedBrush}" TextWrapping="Wrap"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </Grid>
                                    </ScrollViewer>

                                    <DataGrid Name="StreamingEpisodesGrid" ItemsSource="{Binding Episodes}" AutoGenerateColumns="False" SelectionMode="Extended" IsReadOnly="False" IsVisible="{Binding IsSelectedResultSeries}" SelectionChanged="OnStreamingEpisodesSelectionChanged" CanUserResizeColumns="True" CanUserReorderColumns="True" CanUserSortColumns="False">
                                        <DataGrid.Columns>
                                            <DataGridTemplateColumn Header="" Width="40">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTextColumn Header="N." Binding="{Binding Number}" Width="60"/>
                                            <DataGridTextColumn Header="Titolo" Binding="{Binding Title}" Width="*"/>
                                            <DataGridTemplateColumn Header="Lingua" Width="90">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate x:DataType="models:StreamingEpisode">
                                                        <Border Classes="subBadge" HorizontalAlignment="Left" Margin="8,0,0,0" IsVisible="{Binding IsSubIta}" ToolTip.Tip="Solo in lingua originale con sottotitoli italiani"><TextBlock Text="SUB ITA"/></Border>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                        </DataGrid.Columns>
                                    </DataGrid>

                                    <Border HorizontalAlignment="Center" VerticalAlignment="Top" MaxWidth="380" Margin="16,90,16,16" IsHitTestVisible="False" IsVisible="{Binding ShowDetailPlaceholder}">
                                            <StackPanel Spacing="10" HorizontalAlignment="Center">
                                                <Border Width="72" Height="72" CornerRadius="36" Background="{DynamicResource AppSurface2Brush}" HorizontalAlignment="Center">
                                                    <Path Classes="icon accent" Data="{StaticResource IconTv}" Width="30" Height="30" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <TextBlock Text="Nessun titolo aperto" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"/>
                                                <TextBlock Text="Fai doppio clic su un risultato, o passaci sopra e premi «Analizza»: qui compaiono stagioni, episodi e qualità (per un film, direttamente il pulsante per scaricarlo)." FontSize="12" Foreground="{DynamicResource AppTextMutedBrush}" TextAlignment="Center" TextWrapping="Wrap" LineHeight="18"/>
                                                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" Margin="0,6,0,0">
                                                    <Border Classes="moviePill accent"><StackPanel Classes="bi"><Path Classes="icon" Data="{StaticResource IconSearch}"/><TextBlock Text="1 · Cerca"/></StackPanel></Border>
                                                    <Border Classes="moviePill"><StackPanel Classes="bi"><Path Classes="icon" Data="{StaticResource IconList}"/><TextBlock Text="2 · Analizza"/></StackPanel></Border>
                                                    <Border Classes="moviePill"><StackPanel Classes="bi"><Path Classes="icon" Data="{StaticResource IconDownload}"/><TextBlock Text="3 · Scarica"/></StackPanel></Border>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </Panel>
                                </DockPanel>
                            </Border>
                        </Grid>

                        <Border Classes="cardElevated" Height="550" Margin="0,0,0,12">
                            <DockPanel>
                                <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto, *" Margin="0,0,0,8">
                                    <StackPanel Grid.Column="0" Classes="bi" VerticalAlignment="Center">
                                        <Path Classes="icon accent" Data="{StaticResource IconDownload}"/>
                                        <TextBlock Text="Download per serie (Film/Serie)" FontWeight="Bold" FontSize="14"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{Binding SeriesSummaryText}" FontSize="12" Foreground="{DynamicResource AppTextMutedBrush}" Margin="12,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                </Grid>
                                <Border DockPanel.Dock="Top" Background="{DynamicResource AppSurface2Brush}" CornerRadius="8" Padding="12" Margin="0,0,0,10">
                                    <StackPanel Spacing="10">
                                        <WrapPanel Orientation="Horizontal" ItemSpacing="8" LineSpacing="6">
                                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Margin="0,0,10,0" ToolTip.Tip="Segmenti scaricati contemporaneamente per ogni film/episodio (divisi tra video e tracce audio). Più alto = più veloce; se il server dà errori 503 o rallenta, abbassalo">
                                                <TextBlock Text="Segmenti paralleli" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                <Slider Value="{Binding ConcurrentFragments}" Minimum="4" Maximum="64" Width="120" TickFrequency="4" IsSnapToTickEnabled="True" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding ConcurrentFragments}" Width="24" VerticalAlignment="Center" HorizontalAlignment="Center" FontWeight="Bold" Foreground="{DynamicResource AppAccentBrush}"/>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Margin="0,0,10,0" ToolTip.Tip="Quanti film/episodi scaricare insieme. Gli slot sono separati da quelli della tab Anime">
                                                <TextBlock Text="Download paralleli" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                <Slider Value="{Binding MaxConcurrency}" Minimum="1" Maximum="20" Width="140" TickFrequency="1" IsSnapToTickEnabled="True" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding MaxConcurrency}" Width="24" VerticalAlignment="Center" HorizontalAlignment="Center" FontWeight="Bold" Foreground="{DynamicResource AppAccentBrush}"/>
                                            </StackPanel>
                                            <Button ToolTip.Tip="Avvia tutti i download di film e serie in attesa o in pausa" Classes="success" Command="{Binding StartAllCommand}"><StackPanel Classes="bi"><Path Classes="icon" Data="{StaticResource IconPlay}"/><TextBlock Text="Avvia tutti"/></StackPanel></Button>
                                            <Button ToolTip.Tip="Mette in pausa tutti i download di film e serie in corso" Classes="warning" Command="{Binding PauseAllCommand}"><StackPanel Classes="bi"><Path Classes="icon" Data="{StaticResource IconPause}"/><TextBlock Text="Pausa tutti"/></StackPanel></Button>
                                            <Button ToolTip.Tip="Annulla tutti i download di film e serie non ancora completati" Classes="danger" Command="{Binding CancelAllDownloadsCommand}"><StackPanel Classes="bi"><Path Classes="icon" Data="{StaticResource IconClose}"/><TextBlock Text="Annulla tutti"/></StackPanel></Button>
                                            <Border Width="1" Height="26" Background="{DynamicResource AppBorderBrush}" Margin="6,0" VerticalAlignment="Center"/>
                                            <Button ToolTip.Tip="Tutto ciò che hai scaricato, anche dopo aver pulito la coda: ricerca, cartella del file, già scaricati" Click="OnStreamingHistoryClick">
                                                <StackPanel Classes="bi"><Path Classes="icon" Data="{StaticResource IconList}"/><TextBlock Text="Cronologia"/></StackPanel>
                                            </Button>
                                            <Button ToolTip.Tip="Togli dalla lista completati, annullati o falliti (i file restano dove sono). «Elimina tutto» è in fondo al menu e chiede conferma.">
                                                <StackPanel Classes="bi"><Path Classes="icon" Data="{StaticResource IconTrash}"/><TextBlock Text="Pulisci lista"/><Path Classes="icon" Data="{StaticResource IconChevronDownSmall}" Width="10" Height="10" Margin="2,0,0,0"/></StackPanel>
                                                <Button.Flyout>
                                                    <MenuFlyout Placement="BottomEdgeAlignedLeft">
                                                        <MenuItem Header="Rimuovi completati" Command="{Binding ClearCompletedCommand}"><MenuItem.Icon><Path Classes="icon" Data="{StaticResource IconCheckCircle}"/></MenuItem.Icon></MenuItem>
                                                        <MenuItem Header="Rimuovi annullati" Command="{Binding ClearCancelledDownloadsCommand}"><MenuItem.Icon><Path Classes="icon" Data="{StaticResource IconBan}"/></MenuItem.Icon></MenuItem>
                                                        <MenuItem Header="Rimuovi falliti" Command="{Binding ClearFailedDownloadsCommand}"><MenuItem.Icon><Path Classes="icon" Data="{StaticResource IconAlertCircle}"/></MenuItem.Icon></MenuItem>
                                                        <Separator/>
                                                        <MenuItem Classes="dangerItem" Header="Elimina tutto…" Tag="{Binding DeleteEverythingCommand}" CommandParameter="Fermare e togliere dalla lista TUTTI i download di film e serie, anche quelli in corso e in coda? I file già scaricati restano su disco." Click="OnConfirmRemoveAllClick"><MenuItem.Icon><Path Classes="icon" Data="{StaticResource IconTrash}"/></MenuItem.Icon></MenuItem>
                                                    </MenuFlyout>
                                                </Button.Flyout>
                                            </Button>
                                        </WrapPanel>
                                        <StackPanel Orientation="Horizontal" Spacing="24">
                                            <TextBlock FontSize="12" Foreground="{DynamicResource AppTextMutedBrush}">
                                                <Run Text="Totale:" FontWeight="Bold"/>
                                                <Run Text="{Binding GlobalSizeText}"/>
                                            </TextBlock>
                                            <TextBlock FontSize="12" Foreground="{DynamicResource AppSuccessBrush}">
                                                <Run Text="Velocità:" FontWeight="Bold"/>
                                                <Run Text="{Binding GlobalSpeedText}"/>
                                            </TextBlock>
                                            <TextBlock FontSize="12" Foreground="{DynamicResource AppTextMutedBrush}">
                                                <Run Text="ETA:" FontWeight="Bold"/>
                                                <Run Text="{Binding GlobalEtaText}"/>
                                            </TextBlock>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                    <ItemsControl ItemsSource="{Binding SeriesGroups}" HorizontalAlignment="Stretch">
                                        <ItemsControl.Styles>
                                            <Style Selector="ItemsControl > ContentPresenter">
                                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                            </Style>
                                        </ItemsControl.Styles>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="models:SeriesGroup">
                                                <Expander Theme="{StaticResource DownloadGroupExpanderTheme}" IsExpanded="{Binding IsExpanded, Mode=TwoWay}">
                                                    <Expander.Header>
                                                        <Border Classes="groupHeader" Classes.failed="{Binding HasFailed}">
                                                        <Grid ColumnDefinitions="2.6*, 120, 90, 1.3*, 80, 284">
                                                            <DockPanel Grid.Column="0" Margin="0,0,10,0">
                                                                <Border DockPanel.Dock="Left" Classes="failBadge" IsVisible="{Binding HasFailed}" Margin="0,0,8,0" VerticalAlignment="Center"
                                                                        ToolTip.Tip="Alcuni episodi non sono stati scaricati: apri la serie per vedere il motivo, oppure premi «Riscarica i falliti» a destra">
                                                                    <StackPanel Classes="bi"><Path Classes="icon" Data="{StaticResource IconAlert}"/><TextBlock Text="{Binding FailedBadge}"/></StackPanel>
                                                                </Border>
                                                                <TextBlock Text="{Binding Header}" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                            </DockPanel>
                                                            <TextBlock Grid.Column="1" Text="{Binding TotalSizeText}" VerticalAlignment="Center" FontSize="11" Foreground="{DynamicResource AppTextMutedBrush}" Margin="0,0,10,0"/>
                                                            <TextBlock Grid.Column="2" Text="{Binding TotalSpeedText}" VerticalAlignment="Center" FontSize="11" Foreground="{DynamicResource AppSuccessBrush}" Margin="0,0,10,0"/>
                                                            <Grid Grid.Column="3" ColumnDefinitions="*, Auto" Margin="10,0">
                                                                <ProgressBar Grid.Column="0" Value="{Binding OverallPercentage}" Minimum="0" Maximum="100" Height="14" MinWidth="0" Classes.done="{Binding IsAllCompleted}" Classes.paused="{Binding IsAllPaused}"/>
                                                                <TextBlock Grid.Column="1" Text="{Binding OverallPercentage, StringFormat={}{0:F1}%}" Width="50" TextAlignment="Right" Margin="4,0,0,0" VerticalAlignment="Center" FontSize="11" FontWeight="SemiBold"/>
                                                            </Grid>
                                                            <TextBlock Grid.Column="4" Text="{Binding OverallEtaText}" VerticalAlignment="Center" FontSize="11" Foreground="{DynamicResource AppTextMutedBrush}" Margin="10,0"/>
                                                            <StackPanel Grid.Column="5" Orientation="Horizontal" Spacing="4" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                                <Button Classes="iconCircle success" Width="30" Height="30" ToolTip.Tip="Avvia serie" Click="OnStreamingResumeGroupClick"><Path Classes="icon" Data="{StaticResource IconPlay}"/></Button>
                                                                <Button Classes="iconCircle" Width="30" Height="30" ToolTip.Tip="Forza priorità serie" Click="OnStreamingForceGroupClick"><Path Classes="icon" Data="{StaticResource IconBolt}"/></Button>
                                                                <Button Classes="iconCircle" Width="30" Height="30" ToolTip.Tip="Rimuovi priorità serie" Click="OnStreamingUnforceGroupClick"><Path Classes="icon" Data="{StaticResource IconBoltOff}"/></Button>
                                                                <Button Classes="iconCircle danger" Width="30" Height="30" ToolTip.Tip="Annulla serie" Click="OnStreamingCancelGroupClick"><Path Classes="icon" Data="{StaticResource IconClose}"/></Button>
                                                                <Button Classes="iconCircle" Width="30" Height="30" ToolTip.Tip="Rimuovi serie" Click="OnStreamingRemoveGroupClick"><Path Classes="icon" Data="{StaticResource IconTrash}"/></Button>
                                                                <Button Classes="iconCircle" Width="30" Height="30" ToolTip.Tip="Riscarica i falliti di questa serie" IsVisible="{Binding HasFailed}" Click="OnStreamingRetryFailedGroupClick"><Path Classes="icon" Data="{StaticResource IconRefresh}"/></Button>
                                                            </StackPanel>
                                                        </Grid>
                                                        </Border>
                                                    </Expander.Header>
                                                    <ItemsControl ItemsSource="{Binding ExpandedItems}" HorizontalAlignment="Stretch">
                                                        <ItemsControl.Styles>
                                                            <Style Selector="ItemsControl > ContentPresenter">
                                                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                                            </Style>
                                                        </ItemsControl.Styles>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate DataType="models:DownloadItem">
                                                                <Border Classes="episodeRow" Classes.failed="{Binding IsFailed}" Padding="10,7" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="0,0,0,1">
                                                                    <Grid ColumnDefinitions="24, 2*, 46, 1.4*, 1.6*, 250, 130">
                                                                        <Path Grid.Column="0" Classes="icon warn" Width="13" Height="13" HorizontalAlignment="Left" Data="{StaticResource IconBolt}" IsVisible="{Binding IsPriority}"/>
                                                                        <Path Grid.Column="0" Classes="icon failIcon" Width="14" Height="14" HorizontalAlignment="Left" Data="{StaticResource IconAlert}" IsVisible="{Binding IsFailed}"/>
                                                                        <TextBlock Grid.Column="1" Text="{Binding FileName}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" FontWeight="Medium"/>
                                                                        <TextBlock Grid.Column="2" Text="{Binding EpisodeNumber}" VerticalAlignment="Center"/>
                                                                        <TextBlock Grid.Column="3" Classes="rowStatus" Text="{Binding StatusText}" ToolTip.Tip="{Binding StatusTip}" TextTrimming="CharacterEllipsis" Margin="0,0,10,0" VerticalAlignment="Center" FontSize="11"/>
                                                                        <Grid Grid.Column="4" ColumnDefinitions="*, 44" Margin="0,0,12,0">
                                                                            <ProgressBar Value="{Binding Percentage}" Minimum="0" Maximum="100" Height="14" MinWidth="0" Classes.done="{Binding IsCompleted}" Classes.failed="{Binding IsFailed}" Classes.paused="{Binding IsPaused}" Classes.queued="{Binding IsQueued}" Classes.cancelled="{Binding IsCancelled}"/>
                                                                            <TextBlock Grid.Column="1" Text="{Binding Percentage, StringFormat={}{0:F0}%}" TextAlignment="Right" VerticalAlignment="Center" FontSize="11"/>
                                                                        </Grid>
                                                                        <TextBlock Grid.Column="5" Text="{Binding InfoText}" ToolTip.Tip="{Binding InfoText}" VerticalAlignment="Center" FontSize="11" Foreground="{DynamicResource AppTextMutedBrush}" TextTrimming="CharacterEllipsis" Margin="0,0,10,0"/>
                                                                        <StackPanel Grid.Column="6" Orientation="Horizontal" Spacing="2" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="8,0,0,0">
                                                                            <Button Classes="iconCircle success" Width="26" Height="26" ToolTip.Tip="Riprendi" IsVisible="{Binding CanResume}" Click="OnStreamingDownloadItemResumeClick"><Path Classes="icon" Width="12" Height="12" Data="{StaticResource IconPlay}"/></Button>
                                                                            <Button Classes="iconCircle" Width="26" Height="26" ToolTip.Tip="Forza priorità" IsVisible="{Binding CanForce}" Click="OnStreamingDownloadItemForceClick"><Path Classes="icon" Width="12" Height="12" Data="{StaticResource IconBolt}"/></Button>
                                                                            <Button Classes="iconCircle danger" Width="26" Height="26" ToolTip.Tip="Annulla" IsVisible="{Binding CanCancel}" Click="OnStreamingDownloadItemCancelClick"><Path Classes="icon" Width="12" Height="12" Data="{StaticResource IconClose}"/></Button>
                                                                            <Button Classes="iconCircle" Width="26" Height="26" ToolTip.Tip="Riscarica" IsVisible="{Binding CanRetry}" Click="OnStreamingDownloadItemRetryClick"><Path Classes="icon" Width="12" Height="12" Data="{StaticResource IconRefresh}"/></Button>
                                                                            <Button Classes="iconCircle danger" Width="26" Height="26" ToolTip.Tip="Rimuovi" Click="OnStreamingDownloadItemRemoveClick"><Path Classes="icon" Width="12" Height="12" Data="{StaticResource IconTrash}"/></Button>
                                                                        </StackPanel>
                                                                    </Grid>
                                                                </Border>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </Expander>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </DockPanel>
                        </Border>
                    </StackPanel>
                    </ScrollViewer>
                    <!-- Copia del messaggio fissata in alto, visibile solo scorrendo (StickyBanner) -->
                    <Border x:Name="StreamingStickyBanner" VerticalAlignment="Top" IsVisible="False" Padding="0,10,0,0" Background="{DynamicResource AppBackgroundBrush}">
                        <ContentControl Margin="0,0,0,8" Theme="{StaticResource StatusBannerTheme}" Content="{Binding StatusMessage}"/>
                    </Border>
                    </Panel>
                </Panel>
                <Panel IsVisible="{Binding #MainTabs.SelectedIndex, Converter={x:Static vm:IndexEqualsConverter.Default}, ConverterParameter=2}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" DataContext="{Binding Account}">
                        <StackPanel Margin="0,10,0,0" Spacing="12">

                            <!-- GUIDA UNICA -->
                            <Border Classes="cardElevated" Padding="0" ClipToBounds="True">
                                <StackPanel>
                                    <ToggleButton Classes="guideToggle" x:Name="ToggleGuideAccount" IsChecked="False">
                                        <Grid ColumnDefinitions="*, Auto">
                                            <StackPanel Classes="bi" VerticalAlignment="Center">
                                                <Path Classes="icon accent" Data="{StaticResource IconBulb}"/>
                                                <TextBlock Text="Guida rapida - Account" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource AppTextBrush}"/>
                                            </StackPanel>
                                            <Path Grid.Column="1" Classes="chevron"/>
                                        </Grid>
                                    </ToggleButton>
                                    <Border IsVisible="{Binding #ToggleGuideAccount.IsChecked}" Background="Transparent" Margin="16,0,16,16" Padding="12,12,4,12">
                                        <ScrollViewer MaxHeight="240" VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
                                        <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource AppTextMutedBrush}">
                                            <Run FontWeight="Bold" Foreground="{DynamicResource AppTextBrush}">A cosa servono</Run><LineBreak/>
                                            <Run FontWeight="SemiBold" Foreground="{DynamicResource AppTextBrush}">• StreamingCommunity:</Run> con un account Premium i download arrivano a 1080p. Senza login funzionano comunque, in qualità standard (720p).<LineBreak/>
                                            <Run FontWeight="SemiBold" Foreground="{DynamicResource AppTextBrush}">• CB01 · Maxstream:</Run> i film e le serie di CB01 si scaricano da Maxstream e serve un account Premium. Senza, Maxstream mostra un captcha e i download falliscono. Con il Premium si scarica il file originale, non la versione ridotta dello streaming.<LineBreak/>
                                            <LineBreak/>
                                            <Run FontWeight="Bold" Foreground="{DynamicResource AppTextBrush}">Come si usano (uguale per entrambi)</Run><LineBreak/>
                                            <Run FontWeight="SemiBold" Foreground="{DynamicResource AppTextBrush}">• Accedi:</Run> inserisci username e password e premi Accedi. Vengono mostrati piano, scadenza e giorni rimanenti; la sessione viene salvata e riusata.<LineBreak/>
                                            <Run FontWeight="SemiBold" Foreground="{DynamicResource AppTextBrush}">• Testa sessione:</Run> verifica che la sessione sia ancora valida. Maxstream viene verificato anche da solo a ogni avvio e rinnovato durante i download quando scade.<LineBreak/>
                                            <Run FontWeight="SemiBold" Foreground="{DynamicResource AppTextBrush}">• Disconnetti:</Run> chiude la sessione, le credenziali restano salvate. Elimina credenziali le cancella del tutto.<LineBreak/>
                                            <LineBreak/>
                                            <Run FontWeight="Bold" Foreground="{DynamicResource AppTextBrush}">Rete e sicurezza</Run><LineBreak/>
                                            <Run FontWeight="SemiBold" Foreground="{DynamicResource AppTextBrush}">• Cifratura:</Run> le credenziali sono cifrate con DPAPI di Windows: solo il tuo utente può leggerle.<LineBreak/>
                                            <Run FontWeight="SemiBold" Foreground="{DynamicResource AppTextBrush}">• Proxy:</Run> ogni account usa il proxy attivo per il suo provider (tab Proxy). Il link di download di Maxstream vale solo per l'IP che l'ha chiesto, quindi anche il download esce da quell'IP. Per Maxstream usa solo proxy residenziali e cambia IP il meno possibile: troppi accessi da IP diversi possono far richiedere una nuova verifica del login dal browser.<LineBreak/>
                                            <Run FontWeight="SemiBold" Foreground="{DynamicResource AppTextBrush}">• FlareSolverr:</Run> facoltativo. Serve solo se Cloudflare blocca la connessione diretta a Maxstream (IP da datacenter o VPN); con la connessione di casa non serve.<LineBreak/>
                                            <Run FontWeight="SemiBold" Foreground="{DynamicResource AppTextBrush}">• Problemi:</Run> se un login fallisce, controlla nella tab Domini che il dominio del sito sia raggiungibile.
                                        </TextBlock>
                                        </ScrollViewer>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <!-- DUE BLOCCHI IDENTICI -->
                            <Grid ColumnDefinitions="*, *">
                                <!-- ===== StreamingCommunity ===== -->
                                <Border Grid.Column="0" Classes="cardElevated" Padding="16" Margin="0,0,6,0">
                                    <StackPanel Spacing="12">
                                        <StackPanel Classes="bi">
                                            <Path Classes="icon accent" Data="{StaticResource IconKey}"/>
                                            <TextBlock Text="StreamingCommunity" FontWeight="Bold" FontSize="18"/>
                                        </StackPanel>

                                        <Border Background="{DynamicResource AppSurface2Brush}" CornerRadius="8" Padding="12">
                                            <StackPanel Spacing="4">
                                                <StackPanel Orientation="Horizontal" Spacing="10">
                                                    <Panel VerticalAlignment="Center">
                                                        <Border Width="28" Height="28" CornerRadius="14" Background="{DynamicResource AppSurface2Brush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" IsVisible="{Binding SessionTone, Converter={x:Static h:ToneConverters.Is}, ConverterParameter=off}">
                                                            <Path Classes="icon" Data="{StaticResource IconMinusCircle}" Width="13" Height="13" Stroke="{DynamicResource AppTextMutedBrush}" StrokeThickness="2.1" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                        <Border Width="28" Height="28" CornerRadius="14" Background="{DynamicResource AppSuccessSoftBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="0" IsVisible="{Binding SessionTone, Converter={x:Static h:ToneConverters.Is}, ConverterParameter=premium}">
                                                            <Path Classes="icon" Data="{StaticResource IconCheck}" Width="12" Height="12" Stroke="{DynamicResource AppSuccessBrush}" StrokeThickness="2.1" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                        <Border Width="28" Height="28" CornerRadius="14" Background="{DynamicResource AppInfoSoftBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="0" IsVisible="{Binding SessionTone, Converter={x:Static h:ToneConverters.Is}, ConverterParameter=free}">
                                                            <Path Classes="icon" Data="{StaticResource IconUser}" Width="13" Height="13" Stroke="{DynamicResource AppInfoBrush}" StrokeThickness="2.1" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                    </Panel>
                                                    <TextBlock Text="{Binding SessionBadge}" FontWeight="Bold" FontSize="15" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                                </StackPanel>
                                                <TextBlock Text="{Binding SessionDetails}" FontSize="12" Foreground="{DynamicResource AppTextMutedBrush}" TextWrapping="Wrap" MinHeight="68"/>
                                            </StackPanel>
                                        </Border>

                                        <Grid ColumnDefinitions="90, *" RowDefinitions="Auto, Auto">
                                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Username" VerticalAlignment="Center" Margin="0,0,10,8" ToolTip.Tip="Username o email di StreamingCommunity"/>
                                            <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding Username, Mode=TwoWay}" Margin="0,0,0,8"/>
                                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Password" VerticalAlignment="Center" Margin="0,0,10,0" ToolTip.Tip="Verrà salvata cifrata nel PC"/>
                                            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Password, Mode=TwoWay}" PasswordChar="•"/>
                                        </Grid>

                                        <WrapPanel Orientation="Horizontal" ItemSpacing="8" LineSpacing="6">
                                            <Button ToolTip.Tip="Accedi con le credenziali inserite" Classes="success" Command="{Binding LoginCommand}" IsEnabled="{Binding !IsBusy}" IsVisible="{Binding !IsLoggedIn}"><StackPanel Classes="bi"><Path Classes="icon" Data="{StaticResource IconKey}"/><TextBlock Text="Accedi"/></StackPanel></Button>
                                            <Button Command="{Binding ReloadCredentialsCommand}" IsEnabled="{Binding !IsBusy}" IsVisible="{Binding !IsLoggedIn}" ToolTip.Tip="Ricarica nei campi le credenziali salvate"><StackPanel Classes="bi"><Path Classes="icon" Data="{StaticResource IconUnlock}"/><TextBlock Text="Ricarica credenziali"/></StackPanel></Button>
                                            <Button Command="{Binding SaveCredentialsCommand}" IsEnabled="{Binding !IsBusy}" ToolTip.Tip="Salva le credenziali per il prossimo avvio"><StackPanel Classes="bi"><Path Classes="icon" Data="{StaticResource IconSave}"/><TextBlock Text="Salva credenziali"/></StackPanel></Button>
                                            <Button Classes="info" Command="{Binding TestSessionCommand}" IsEnabled="{Binding !IsBusy}" ToolTip.Tip="Verifica se la sessione è ancora valida"><StackPanel Classes="bi"><Path Classes="icon" Data="{StaticResource IconSearch}"/><TextBlock Text="Testa sessione"/></StackPanel></Button>
                                            <Button Classes="warning" Command="{Binding LogoutCommand}" IsVisible="{Binding IsLoggedIn}" ToolTip.Tip="Esci e cancella la sessione salvata"><StackPanel Classes="bi"><Path Classes="icon" Data="{StaticResource IconLogOut}"/><TextBlock Text="Disconnetti"/></StackPanel></Button>
                                            <Button Classes="danger" Command="{Binding DeleteCredentialsCommand}" IsEnabled="{Binding !IsBusy}" IsVisible="{Binding HasSavedCredentials}" ToolTip.Tip="Rimuove definitivamente username e password"><StackPanel Classes="bi"><Path Classes="icon" Data="{StaticResource IconTrash}"/><TextBlock Text="Elimina credenziali"/></StackPanel></Button>
                                            <Button Classes="danger" IsVisible="{Binding IsBusy}" IsEnabled="False" ToolTip.Tip="Operazione in corso, attendi..."><StackPanel Classes="bi"><Path Classes="icon" Data="{StaticResource IconStop}"/><TextBlock Text="Stop"/></StackPanel></Button>
                                        </WrapPanel>

                                        <ContentControl Theme="{StaticResource StatusBannerTheme}" Content="{Binding StatusMessage}"/>
                                    </StackPanel>
                                </Border>

                                <!-- ===== CB01 · Maxstream ===== -->
                                <Border Grid.Column="1" Classes="cardElevated" Padding="16" Margin="6,0,0,0">
                                    <StackPanel Spacing="12">
                                        <StackPanel Classes="bi">
                                            <Path Classes="icon accent" Data="{StaticResource IconKey}"/>
                                            <TextBlock Text="CB01 · Maxstream" FontWeight="Bold" FontSize="18"/>
                                        </StackPanel>

                                        <Border Background="{DynamicResource AppSurface2Brush}" CornerRadius="8" Padding="12">
                                            <StackPanel Spacing="4">
                                                <StackPanel Orientation="Horizontal" Spacing="10">
                                                    <Panel VerticalAlignment="Center">
                                                        <Border Width="28" Height="28" CornerRadius="14" Background="{DynamicResource AppSurface2Brush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" IsVisible="{Binding MsSessionTone, Converter={x:Static h:ToneConverters.Is}, ConverterParameter=off}">
                                                            <Path Classes="icon" Data="{StaticResource IconMinusCircle}" Width="13" Height="13" Stroke="{DynamicResource AppTextMutedBrush}" StrokeThickness="2.1" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                        <Border Width="28" Height="28" CornerRadius="14" Background="{DynamicResource AppSuccessSoftBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="0" IsVisible="{Binding MsSessionTone, Converter={x:Static h:ToneConverters.Is}, ConverterParameter=premium}">
                                                            <Path Classes="icon" Data="{StaticResource IconCheck}" Width="12" Height="12" Stroke="{DynamicResource AppSuccessBrush}" StrokeThickness="2.1" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                        <Border Width="28" Height="28" CornerRadius="14" Background="{DynamicResource AppWarningSoftBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="0" IsVisible="{Binding MsSessionTone, Converter={x:Static h:ToneConverters.Is}, ConverterParameter=limited}">
                                                            <Path Classes="icon" Data="{StaticResource IconUser}" Width="13" Height="13" Stroke="{DynamicResource AppWarningBrush}" StrokeThickness="2.1" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                        <Border Width="28" Height="28" CornerRadius="14" Background="{DynamicResource AppWarningSoftBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="0" IsVisible="{Binding MsSessionTone, Converter={x:Static h:ToneConverters.Is}, ConverterParameter=pending}">
                                                            <Path Classes="icon" Data="{StaticResource IconClock}" Width="13" Height="13" Stroke="{DynamicResource AppWarningBrush}" StrokeThickness="2.1" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                    </Panel>
                                                    <TextBlock Text="{Binding MsSessionBadge}" FontWeight="Bold" FontSize="15" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                                </StackPanel>
                                                <TextBlock Text="{Binding MsSessionDetails}" FontSize="12" Foreground="{DynamicResource AppTextMutedBrush}" TextWrapping="Wrap" MinHeight="68"/>
                                            </StackPanel>
                                        </Border>

                                        <Grid ColumnDefinitions="90, *" RowDefinitions="Auto, Auto">
                                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Username" VerticalAlignment="Center" Margin="0,0,10,8" ToolTip.Tip="Username di Maxstream"/>
                                            <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding MsUsername, Mode=TwoWay}" Margin="0,0,0,8"/>
                                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Password" VerticalAlignment="Center" Margin="0,0,10,0" ToolTip.Tip="Verrà salvata cifrata nel PC"/>
                                            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding MsPassword, Mode=TwoWay}" PasswordChar="•"/>
                                        </Grid>

                                        <WrapPanel Orientation="Horizontal" ItemSpacing="8" LineSpacing="6">
                                            <Button ToolTip.Tip="Accedi con le credenziali inserite" Classes="success" Command="{Binding MsLoginCommand}" IsEnabled="{Binding !IsMsBusy}" IsVisible="{Binding !IsMsLoggedIn}"><StackPanel Classes="bi"><Path Classes="icon" Data="{StaticResource IconKey}"/><TextBlock Text="Accedi"/></StackPanel></Button>
                                            <Button Command="{Binding MsReloadCredentialsCommand}" IsEnabled="{Binding !IsMsBusy}" IsVisible="{Binding !IsMsLoggedIn}" ToolTip.Tip="Ricarica nei campi le credenziali salvate"><StackPanel Classes="bi"><Path Classes="icon" Data="{StaticResource IconUnlock}"/><TextBlock Text="Ricarica credenziali"/></StackPanel></Button>
                                            <Button Command="{Binding MsSaveCredentialsCommand}" IsEnabled="{Binding !IsMsBusy}" ToolTip.Tip="Salva le credenziali per il prossimo avvio"><StackPanel Classes="bi"><Path Classes="icon" Data="{StaticResource IconSave}"/><TextBlock Text="Salva credenziali"/></StackPanel></Button>
                                            <Button Classes="info" Command="{Binding MsTestSessionCommand}" IsEnabled="{Binding !IsMsBusy}" ToolTip.Tip="Verifica se la sessione è ancora valida e aggiorna la scadenza"><StackPanel Classes="bi"><Path Classes="icon" Data="{StaticResource IconSearch}"/><TextBlock Text="Testa sessione"/></StackPanel></Button>
                                            <Button Classes="warning" Command="{Binding MsLogoutCommand}" IsVisible="{Binding IsMsLoggedIn}" ToolTip.Tip="Esci e chiudi la sessione"><StackPanel Classes="bi"><Path Classes="icon" Data="{StaticResource IconLogOut}"/><TextBlock Text="Disconnetti"/></StackPanel></Button>
                                            <Button Classes="danger" Command="{Binding MsDeleteCredentialsCommand}" IsEnabled="{Binding !IsMsBusy}" IsVisible="{Binding HasMsSavedCredentials}" ToolTip.Tip="Rimuove definitivamente username e password"><StackPanel Classes="bi"><Path Classes="icon" Data="{StaticResource IconTrash}"/><TextBlock Text="Elimina credenziali"/></StackPanel></Button>
                                            <Button Classes="danger" IsVisible="{Binding IsMsBusy}" IsEnabled="False" ToolTip.Tip="Operazione in corso, attendi..."><StackPanel Classes="bi"><Path Classes="icon" Data="{StaticResource IconStop}"/><TextBlock Text="Stop"/></StackPanel></Button>
                                        </WrapPanel>

                                        <ContentControl Theme="{StaticResource StatusBannerTheme}" Content="{Binding MsStatusMessage}"/>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- FLARESOLVERR (facoltativo, condiviso) -->
                            <Border Classes="cardElevated" Padding="16">
                                <StackPanel Spacing="8">
                                    <StackPanel Classes="bi">
                                        <Path Classes="icon accent" Data="{StaticResource IconInfo}"/>
                                        <TextBlock Text="FlareSolverr (facoltativo)" FontWeight="Bold" FontSize="14"/>
                                    </StackPanel>
                                    <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource AppTextMutedBrush}" Text="Usato solo se Cloudflare blocca la connessione diretta a Maxstream. Con la connessione di casa non serve: lascia vuoto."/>
                                    <Grid ColumnDefinitions="90, *">
                                        <TextBlock Grid.Column="0" Text="URL" VerticalAlignment="Center" Margin="0,0,10,0" ToolTip.Tip="Indirizzo del server FlareSolverr (es. http://localhost:8191)"/>
                                        <TextBox Grid.Column="1" Text="{Binding MsFlareSolverrUrl, Mode=TwoWay}" PlaceholderText="vuoto = non usato (es. http://localhost:8191)"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                        </StackPanel>
                    </ScrollViewer>
                </Panel>
                <Panel IsVisible="{Binding #MainTabs.SelectedIndex, Converter={x:Static vm:IndexEqualsConverter.Default}, ConverterParameter=3}">
                    <!-- Il messaggio di stato sta nella pagina; scorrendo ne compare una copia fissa in alto -->
                    <Panel DataContext="{Binding Organizer}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" h:StickyBanner.Overlay="{Binding #OrganizerStickyBanner}">
                    <!-- Le tabelle riempiono la finestra (senza un'altezza la tabella creava una riga
                         grafica per ogni operazione: con migliaia di proposte l'app si bloccava) -->
                    <h:FillViewportPanel>
                    <DockPanel Margin="0,10,0,0">
                        <ContentControl DockPanel.Dock="Top" Theme="{StaticResource StatusBannerTheme}" Content="{Binding CurrentStatusMessage}" IsVisible="{Binding CurrentStatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>

                        <!-- GUIDA ORGANIZER -->
                        <Border DockPanel.Dock="Top" Classes="cardElevated" Margin="0,0,0,12" Padding="0" ClipToBounds="True">
                            <StackPanel>
                                <ToggleButton Classes="guideToggle" x:Name="ToggleGuideOrganizer" IsChecked="False">
                                    <Grid ColumnDefinitions="*, Auto">
                                        <StackPanel Classes="bi" VerticalAlignment="Center">
                                            <Path Classes="icon accent" Data="{StaticResource IconBulb}"/>
                                            <TextBlock Text="Guida rapida - Organizza File" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource AppTextBrush}"/>
                                        </StackPanel>
                                        <Path Grid.Column="1" Classes="chevron"/>
                                    </Grid>
                                </ToggleButton>
                                <Border IsVisible="{Binding #ToggleGuideOrganizer.IsChecked}" Background="Transparent" Margin="16,0,16,16" Padding="12,12,4,12">
                                    <ScrollViewer MaxHeight="240" VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
                                    <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource AppTextMutedBrush}">
                                        <Run FontWeight="Bold" Foreground="{DynamicResource AppTextBrush}">A cosa serve</Run><LineBreak/>
                                        Rinomina, unisce e divide cartelle di episodi in blocco, sia sul PC (Locale) sia sul server (Remoto, serve la connessione SFTP). Ogni operazione si vede prima in anteprima e si può annullare.<LineBreak/>
                                        <LineBreak/>
                                        <Run FontWeight="Bold" Foreground="{DynamicResource AppTextBrush}">Le tre modalità</Run><LineBreak/>
                                        <Run FontWeight="SemiBold" Foreground="{DynamicResource AppTextBrush}">• Singola cartella:</Run> rinomina i file di una cartella secondo il pattern (es. "ep1.mp4" diventa "Frieren - 001.mp4"). "Episodio iniziale" fissa il numero da cui partire.<LineBreak/>
                                        <Run FontWeight="SemiBold" Foreground="{DynamicResource AppTextBrush}">• Unisci cartelle:</Run> prende i file da più cartelle, nell'ordine dell'elenco, e li sposta in un'unica destinazione rinumerandoli in sequenza.<LineBreak/>
                                        <Run FontWeight="SemiBold" Foreground="{DynamicResource AppTextBrush}">• Dividi cartella:</Run> divide una cartella con molti episodi in sottocartelle: in parti uguali (es. 50 episodi per cartella) oppure a segmenti personalizzati.<LineBreak/>
                                        <LineBreak/>
                                        <Run FontWeight="Bold" Foreground="{DynamicResource AppTextBrush}">Flusso consigliato</Run><LineBreak/>
                                        <Run FontWeight="SemiBold" Foreground="{DynamicResource AppTextBrush}">• 1. Anteprima:</Run> calcola le operazioni senza toccare nulla; la colonna Conflitto segnala nomi già esistenti o duplicati.<LineBreak/>
                                        <Run FontWeight="SemiBold" Foreground="{DynamicResource AppTextBrush}">• 2. Applica:</Run> esegue le operazioni. Se ci sono conflitti l'app si ferma e non applica niente. Le rinomine "a catena" non sono conflitti: se elimini un episodio e rinumeri (il 3 diventa 2, il 4 diventa 3...) o due file si scambiano il nome, l'app li sposta prima su nomi temporanei e poi su quelli finali; anche Undo li rimette a posto allo stesso modo.<LineBreak/>
                                        <Run FontWeight="SemiBold" Foreground="{DynamicResource AppTextBrush}">• 3. Undo:</Run> annulla l'ultimo gruppo di operazioni applicate. La cronologia in basso elenca tutto ciò che è stato fatto.<LineBreak/>
                                        <LineBreak/>
                                        <Run FontWeight="Bold" Foreground="{DynamicResource AppTextBrush}">Segnaposto del pattern</Run><LineBreak/>
                                        {Series} nome della serie · {Episode} o {Episode:D3} numero episodio · {Title} titolo. Una "/" nel pattern crea una sottocartella. I menu propongono pattern adatti a ogni modalità.<LineBreak/>
                                        <Run FontWeight="SemiBold" Foreground="{DynamicResource AppTextBrush}">• Dividi, nome sottocartella:</Run> {Number} numero della cartella, {Start}/{End} primo e ultimo episodio, {Series} nome della serie. Anche qui la "/" crea più livelli (es. "{Series}/Parte {Number}"); l'anteprima a destra mostra i nomi delle prime cartelle.<LineBreak/>
                                        <Run FontWeight="SemiBold" Foreground="{DynamicResource AppTextBrush}">• Pulisci ▾:</Run> accanto a Undo, contiene "Svuota proposte" e "Svuota cronologia…"; quest'ultima chiede conferma, perché dopo non si può più annullare quanto fatto.
                                    </TextBlock>
                                    </ScrollViewer>
                                </Border>
                            </StackPanel>
                        </Border>

                        <Border DockPanel.Dock="Top" Classes="cardElevated" Margin="0,0,0,12">
                            <StackPanel Orientation="Horizontal" Spacing="20">
                                <TextBlock Text="Modalità:" FontWeight="Bold" VerticalAlignment="Center" FontSize="14"/>
                                <RadioButton GroupName="OrganizeMode" IsChecked="{Binding OrganizeModeIsLocal}"><StackPanel Classes="bi"><Path Classes="icon" Data="{StaticResource IconMonitor}"/><TextBlock Text="Locale"/></StackPanel></RadioButton>
                                <RadioButton GroupName="OrganizeMode" IsChecked="{Binding !OrganizeModeIsLocal}" IsEnabled="{Binding IsSftpConnected}"><StackPanel Classes="bi"><Path Classes="icon" Data="{StaticResource IconCloud}"/><TextBlock Text="Remoto (SFTP)"/></StackPanel></RadioButton>
                                <TextBlock Text="(apri un server nella tab SFTP per abilitare la modalità Remoto)" FontStyle="Italic" FontSize="11" VerticalAlignment="Center" Foreground="{DynamicResource AppTextMutedBrush}" IsVisible="{Binding !IsSftpConnected}"/>
                                <!-- Server su cui lavorare: uno di quelli aperti nelle schede SFTP, senza riconnettersi -->
                                <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding !OrganizeModeIsLocal}">
                                    <TextBlock Text="Server:" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    <ComboBox ItemsSource="{Binding SftpServers}" SelectedItem="{Binding OrganizerServer, Mode=TwoWay}" MinWidth="200"
                                              ToolTip.Tip="Server su cui lavorare: quelli aperti nelle schede della tab SFTP. Passi dall'uno all'altro senza disconnetterti.">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate x:DataType="vm:RemoteServerTab">
                                                <StackPanel Spacing="1">
                                                    <TextBlock Text="{Binding Name}"/>
                                                    <TextBlock Text="{Binding Host}" FontSize="10" Foreground="{DynamicResource AppTextMutedBrush}"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <DockPanel>
                            <TabControl x:Name="OrganizerTabs" SelectedIndex="{Binding SelectedSubTabIndex}" DockPanel.Dock="Top">
                                <!-- ===== SINGOLA CARTELLA ===== -->
                                <TabItem Header="Singola cartella"/>

                                <!-- ===== UNISCI CARTELLE ===== -->
                                <TabItem Header="Unisci cartelle"/>

                                <!-- ===== DIVIDI CARTELLA ===== -->
                                <TabItem Header="Dividi cartella"/>
                            </TabControl>
                            <!-- Contenuti sempre nel visual tree: cambiando tab restano scroll e stato -->
                            <Panel ClipToBounds="True">
                                <Panel IsVisible="{Binding #OrganizerTabs.SelectedIndex, Converter={x:Static vm:IndexEqualsConverter.Default}, ConverterParameter=0}">
                                    <DockPanel Margin="0,10,0,0">
                                        <Border DockPanel.Dock="Top" Classes="cardElevated" Margin="0,0,0,12">
                                            <StackPanel Spacing="10">
                                                <Grid ColumnDefinitions="Auto, *, Auto">
                                                    <TextBlock Grid.Column="0" Text="{Binding OrganizeFolderLabel}" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,10,0"/>
                                                    <TextBox Grid.Column="1" Text="{Binding OrganizeFolder}" Margin="0,0,8,0"/>
                                                    <Button Grid.Column="2" Classes="iconCircle" ToolTip.Tip="Sfoglia cartelle" Click="OnBrowseOrganizeFolderClick" IsVisible="{Binding OrganizeModeIsLocal}"><Path Classes="icon" Data="{StaticResource IconFolder}"/></Button>
                                                    <Button Grid.Column="2" Classes="iconCircle" ToolTip.Tip="Sfoglia cartelle remote" Click="OnBrowseOrganizeFolderRemoteClick" IsVisible="{Binding !OrganizeModeIsLocal}"><Path Classes="icon" Data="{StaticResource IconFolder}"/></Button>
                                                </Grid>

                                                <Grid ColumnDefinitions="Auto, *, Auto">
                                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,4,0"><TextBlock Text="Pattern" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,6,0"/><h:PatternLegendButton Kind="Organize" Target="{Binding #OrganizePatternBox}"/></StackPanel>
                                                    <ComboBox x:Name="OrganizePatternBox" Grid.Column="1" IsEditable="True" ItemsSource="{Binding OrganizePatterns}" Text="{Binding OrganizePattern, Mode=TwoWay}" HorizontalAlignment="Stretch" Margin="0,0,10,0"/>
                                                    <Border Grid.Column="2" Background="{DynamicResource AppSurface2Brush}" BorderBrush="{DynamicResource AppAccentBrush}" BorderThickness="1" CornerRadius="6" Padding="10,4" MaxWidth="380">
                                                        <TextBlock Text="{Binding OrganizePatternPreview}" FontFamily="Consolas,Menlo,monospace" Foreground="{DynamicResource AppAccentBrush}" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                    </Border>
                                                </Grid>

                                                <TextBlock FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource AppTextMutedBrush}" Margin="0,-4,0,0">
                                                    <Run>La «/» crea una sottocartella nella destinazione: «{Series}/{Episode:D3}» mette i file in «Frieren\005.mp4». {Series} è il nome ricavato dal file (se manca, quello della cartella).</Run>
                                                </TextBlock>

                                                <StackPanel Orientation="Horizontal" Spacing="10">
                                                    <TextBlock Text="Episodio iniziale:" VerticalAlignment="Center" FontWeight="SemiBold" ToolTip.Tip="Da che numero vuoi iniziare a contare? (es. 1 o 15)"/>
                                                    <TextBox Text="{Binding OrganizeStartingEpisode, Mode=TwoWay}" Width="80"/>
                                                    <TextBlock Text="(default 1)" FontStyle="Italic" Foreground="{DynamicResource AppTextMutedBrush}" VerticalAlignment="Center"/>
                                                </StackPanel>

                                                <WrapPanel Orientation="Horizontal" ItemSpacing="8" LineSpacing="6">
                                                    <Button ToolTip.Tip="Calcola le rinomine senza modificare nulla: controlla la tabella prima di applicare" Classes="info" Command="{Binding PreviewOrganizeCommand}" IsEnabled="{Binding !IsOrganizeBusy}"><StackPanel Classes="bi"><Path Classes="icon" Data="{StaticResource IconEye}"/><TextBlock Text="Anteprima"/></StackPanel></Button>
                                                    <Button ToolTip.Tip="Esegue le operazioni proposte (annullabili con Undo)" Classes="success" Command="{Binding ApplyOrganizeCommand}" IsEnabled="{Binding !IsOrganizeBusy}"><StackPanel Classes="bi"><Path Classes="icon" Data="{StaticResource IconCheck}"/><TextBlock Text="Applica"/></StackPanel></Button>
                                                    <Button ToolTip.Tip="Annulla l'ultimo gruppo di operazioni applicate (rinomine/spostamenti)" Classes="warning" Command="{Binding UndoLastBatchCommand}" IsEnabled="{Binding !IsOrganizeBusy}"><StackPanel Classes="bi"><Path Classes="icon" Data="{StaticResource IconUndo}"/><TextBlock Text="Undo ultimo batch"/></StackPanel></Button>
                                                    <Border Width="1" Height="26" Background="{DynamicResource AppBorderBrush}" Margin="6,0" VerticalAlignment="Center"/>
                                                    <Button ToolTip.Tip="Svuota la tabella delle proposte o la cronologia delle operazioni (questa chiede conferma)">
                                                        <StackPanel Classes="bi"><Path Classes="icon" Data="{StaticResource IconTrash}"/><TextBlock Text="Pulisci"/><Path Classes="icon" Data="{StaticResource IconChevronDownSmall}" Width="10" Height="10" Margin="2,0,0,0"/></StackPanel>
                                                        <Button.Flyout>
                                                            <MenuFlyout Placement="BottomEdgeAlignedLeft">
                                                                <MenuItem Header="Svuota proposte" Command="{Binding ClearPreviewOperationsCommand}" IsEnabled="{Binding !IsOrganizeBusy}"><MenuItem.Icon><Path Classes="icon" Data="{StaticResource IconTrash}"/></MenuItem.Icon></MenuItem>
                                                                <Separator/>
                                                                <MenuItem Classes="dangerItem" Header="Svuota cronologia…" Tag="{Binding ClearHistoryCommand}" CommandParameter="Cancellare la cronologia delle operazioni? I file non vengono toccati, ma non si potrà più annullare (Undo) niente di quanto fatto finora." Click="OnConfirmRemoveAllClick"><MenuItem.Icon><Path Classes="icon" Data="{StaticResource IconTrash}"/></MenuItem.Icon></MenuItem>
                                                            </MenuFlyout>
                                                        </Button.Flyout>
                                                    </Button>
                                                </WrapPanel>
                                            </StackPanel>
                                        </Border>

                                        <Grid RowDefinitions="*, Auto, *">
                                            <Border Grid.Row="0" Classes="cardElevated">
                                                <DockPanel>
                                                    <TextBlock DockPanel.Dock="Top" Text="Operazioni proposte" FontWeight="Bold" FontSize="14" Margin="0,0,0,8"/>
                                                    <h:FillSlot MinFill="160">
                                                    <DataGrid ItemsSource="{Binding PreviewOperations}" AutoGenerateColumns="False" IsReadOnly="True" CanUserResizeColumns="True" CanUserReorderColumns="True" CanUserSortColumns="False">
                                                        <DataGrid.Columns>
                                                            <DataGridTextColumn Header="Tipo" Binding="{Binding Type}" Width="100"/>
                                                            <DataGridTextColumn Header="Da" Binding="{Binding OriginalPath}" Width="2*"/>
                                                            <DataGridTextColumn Header="A" Binding="{Binding NewPath}" Width="2*"/>
                                                            <DataGridTextColumn Header="Conflitto" Binding="{Binding ConflictReason}" Width="200"/>
                                                        </DataGrid.Columns>
                                                    </DataGrid>
                                                    </h:FillSlot>
                                                </DockPanel>
                                            </Border>
                                            <Border Grid.Row="1" Height="12"/>
                                            <Border Grid.Row="2" Classes="cardElevated">
                                                <DockPanel>
                                                    <TextBlock DockPanel.Dock="Top" Text="Cronologia operazioni" FontWeight="Bold" FontSize="14" Margin="0,0,0,8"/>
                                                    <h:FillSlot MinFill="160">
                                                    <DataGrid ItemsSource="{Binding OperationHistory}" AutoGenerateColumns="False" IsReadOnly="True" CanUserResizeColumns="True" CanUserReorderColumns="True" CanUserSortColumns="False">
                                                        <DataGrid.Columns>
                                                            <DataGridTextColumn Header="Data" Binding="{Binding Timestamp, StringFormat='{}{0:dd/MM/yyyy HH:mm:ss}'}" Width="180"/>
                                                            <DataGridTextColumn Header="Tipo" Binding="{Binding Type}" Width="100"/>
                                                            <DataGridTextColumn Header="Descrizione" Binding="{Binding Description}" Width="*"/>
                                                        </DataGrid.Columns>
                                                    </DataGrid>
                                                    </h:FillSlot>
                                                </DockPanel>
                                            </Border>
                                        </Grid>
                                    </DockPanel>
                                </Panel>
                                <Panel IsVisible="{Binding #OrganizerTabs.SelectedIndex, Converter={x:Static vm:IndexEqualsConverter.Default}, ConverterParameter=1}">
                                    <DockPanel Margin="0,10,0,0">
                                        <Border DockPanel.Dock="Top" Classes="cardElevated" Margin="0,0,0,12">
                                            <StackPanel Spacing="10">
                                                <TextBlock Text="Cartelle sorgente (ordine = priorità, la prima vince)" FontWeight="Bold" FontSize="14"/>
                                                <Grid ColumnDefinitions="*, Auto, Auto" Height="200">
                                                    <Border Grid.Column="0" Background="{DynamicResource AppSurface2Brush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" CornerRadius="8">
                                                        <ListBox ItemsSource="{Binding MergeSourceFolders}" SelectedItem="{Binding SelectedMergeFolder, Mode=TwoWay}" Background="Transparent">
                                                            <ListBox.ItemTemplate>
                                                                <DataTemplate DataType="models:MergeSourceFolder">
                                                                    <Grid ColumnDefinitions="Auto, *, Auto">
                                                                        <TextBlock Grid.Column="0" Text="{Binding Priority, StringFormat='[{0}] '}" FontWeight="Bold" VerticalAlignment="Center" Foreground="{DynamicResource AppAccentBrush}"/>
                                                                        <TextBlock Grid.Column="1" Text="{Binding Path}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                                                        <TextBlock Grid.Column="2" Text="{Binding FileCount, StringFormat=' ({0} video)'}" Foreground="{DynamicResource AppTextMutedBrush}" VerticalAlignment="Center"/>
                                                                    </Grid>
                                                                </DataTemplate>
                                                            </ListBox.ItemTemplate>
                                                        </ListBox>
                                                    </Border>
                                                    <StackPanel Grid.Column="1" Spacing="6" Margin="10,0">
                                                        <Button Classes="iconCircle" Click="OnMergeMoveUpClick" ToolTip.Tip="Sposta su"><Path Classes="icon" Data="{StaticResource IconArrowUp}"/></Button>
                                                        <Button Classes="iconCircle" Click="OnMergeMoveDownClick" ToolTip.Tip="Sposta giù"><Path Classes="icon" Data="{StaticResource IconArrowDown}"/></Button>
                                                        <Button Classes="iconCircle danger" Click="OnMergeRemoveClick" ToolTip.Tip="Rimuovi"><Path Classes="icon" Data="{StaticResource IconClose}"/></Button>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="2" Spacing="6">
                                                        <Button ToolTip.Tip="Aggiunge una cartella sorgente all'elenco da unire" Click="OnMergeAddFolderClick"><StackPanel Classes="bi"><Path Classes="icon" Data="{StaticResource IconPlus}"/><TextBlock Text="Aggiungi cartella"/></StackPanel></Button>
                                                        <Button ToolTip.Tip="Svuota l'elenco delle cartelle da unire" Click="OnMergeClearClick"><StackPanel Classes="bi"><Path Classes="icon" Data="{StaticResource IconTrash}"/><TextBlock Text="Svuota lista"/></StackPanel></Button>
                                                    </StackPanel>
                                                </Grid>

                                                <Grid ColumnDefinitions="Auto, *, Auto">
                                                    <TextBlock Grid.Column="0" Text="{Binding MergeDestinationLabel}" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,10,0"/>
                                                    <TextBox Grid.Column="1" Text="{Binding MergeDestinationFolder}" Margin="0,0,8,0"/>
                                                    <Button Grid.Column="2" Classes="iconCircle" ToolTip.Tip="Sfoglia cartelle" Click="OnBrowseMergeDestClick" IsVisible="{Binding OrganizeModeIsLocal}"><Path Classes="icon" Data="{StaticResource IconFolder}"/></Button>
                                                    <Button Grid.Column="2" Classes="iconCircle" ToolTip.Tip="Sfoglia cartelle remote" Click="OnBrowseMergeDestRemoteClick" IsVisible="{Binding !OrganizeModeIsLocal}"><Path Classes="icon" Data="{StaticResource IconFolder}"/></Button>
                                                </Grid>

                                                <Grid ColumnDefinitions="Auto, *, Auto">
                                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,4,0"><TextBlock Text="Pattern" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,6,0"/><h:PatternLegendButton Kind="Organize" Target="{Binding #MergePatternBox}"/></StackPanel>
                                                    <ComboBox x:Name="MergePatternBox" Grid.Column="1" IsEditable="True" ItemsSource="{Binding MergePatterns}" Text="{Binding MergePattern, Mode=TwoWay}" HorizontalAlignment="Stretch" Margin="0,0,10,0"/>
                                                    <Border Grid.Column="2" Background="{DynamicResource AppSurface2Brush}" BorderBrush="{DynamicResource AppAccentBrush}" BorderThickness="1" CornerRadius="6" Padding="10,4" MaxWidth="380">
                                                        <TextBlock Text="{Binding MergePatternPreview}" FontFamily="Consolas,Menlo,monospace" Foreground="{DynamicResource AppAccentBrush}" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                    </Border>
                                                </Grid>

                                                <TextBlock FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource AppTextMutedBrush}" Margin="0,-4,0,0">
                                                    <Run>La «/» crea una sottocartella nella destinazione: «{Series}/{Episode:D3}» mette i file in «Frieren\005.mp4». {Series} è il nome ricavato dal file (se manca, quello della cartella).</Run>
                                                </TextBlock>

                                                <StackPanel Orientation="Horizontal" Spacing="10">
                                                    <TextBlock Text="Episodio iniziale:" VerticalAlignment="Center" FontWeight="SemiBold" ToolTip.Tip="Da che numero vuoi iniziare a contare? (es. 1 o 15)"/>
                                                    <TextBox Text="{Binding MergeStartingEpisode, Mode=TwoWay}" Width="80"/>
                                                    <TextBlock Text="(default 1)" FontStyle="Italic" Foreground="{DynamicResource AppTextMutedBrush}" VerticalAlignment="Center"/>
                                                </StackPanel>

                                                <WrapPanel Orientation="Horizontal" ItemSpacing="8" LineSpacing="6">
                                                    <Button ToolTip.Tip="Calcola spostamenti e rinumerazione senza modificare nulla: controlla la tabella prima di applicare" Classes="info" Command="{Binding PreviewMergeCommand}" IsEnabled="{Binding !IsMergeBusy}"><StackPanel Classes="bi"><Path Classes="icon" Data="{StaticResource IconEye}"/><TextBlock Text="Anteprima merge"/></StackPanel></Button>
                                                    <Button ToolTip.Tip="Esegue il merge proposto (annullabile con Undo)" Classes="success" Command="{Binding ApplyMergeCommand}" IsEnabled="{Binding !IsMergeBusy}"><StackPanel Classes="bi"><Path Classes="icon" Data="{StaticResource IconCheck}"/><TextBlock Text="Applica merge"/></StackPanel></Button>
                                                    <Button ToolTip.Tip="Annulla l'ultimo gruppo di operazioni applicate (rinomine/spostamenti)" Classes="warning" Command="{Binding UndoLastBatchCommand}" IsEnabled="{Binding !IsMergeBusy}"><StackPanel Classes="bi"><Path Classes="icon" Data="{StaticResource IconUndo}"/><TextBlock Text="Undo ultimo batch"/></StackPanel></Button>
                                                    <Border Width="1" Height="26" Background="{DynamicResource AppBorderBrush}" Margin="6,0" VerticalAlignment="Center"/>
                                                    <Button ToolTip.Tip="Svuota la tabella delle proposte o la cronologia delle operazioni (questa chiede conferma)">
                                                        <StackPanel Classes="bi"><Path Classes="icon" Data="{StaticResource IconTrash}"/><TextBlock Text="Pulisci"/><Path Classes="icon" Data="{StaticResource IconChevronDownSmall}" Width="10" Height="10" Margin="2,0,0,0"/></StackPanel>
                                                        <Button.Flyout>
                                                            <MenuFlyout Placement="BottomEdgeAlignedLeft">
                                                                <MenuItem Header="Svuota proposte" Command="{Binding ClearMergePreviewOperationsCommand}" IsEnabled="{Binding !IsMergeBusy}"><MenuItem.Icon><Path Classes="icon" Data="{StaticResource IconTrash}"/></MenuItem.Icon></MenuItem>
                                                                <Separator/>
                                                                <MenuItem Classes="dangerItem" Header="Svuota cronologia…" Tag="{Binding ClearHistoryCommand}" CommandParameter="Cancellare la cronologia delle operazioni? I file non vengono toccati, ma non si potrà più annullare (Undo) niente di quanto fatto finora." Click="OnConfirmRemoveAllClick"><MenuItem.Icon><Path Classes="icon" Data="{StaticResource IconTrash}"/></MenuItem.Icon></MenuItem>
                                                            </MenuFlyout>
                                                        </Button.Flyout>
                                                    </Button>
                                                </WrapPanel>
                                            </StackPanel>
                                        </Border>

                                        <Grid RowDefinitions="*, Auto, *">
                                            <Border Grid.Row="0" Classes="cardElevated">
                                                <DockPanel>
                                                    <TextBlock DockPanel.Dock="Top" Text="Operazioni proposte (rinumerazione sequenziale)" FontWeight="Bold" FontSize="14" Margin="0,0,0,8"/>
                                                    <h:FillSlot MinFill="160">
                                                    <DataGrid ItemsSource="{Binding MergePreviewOperations}" AutoGenerateColumns="False" IsReadOnly="True" CanUserResizeColumns="True" CanUserReorderColumns="True" CanUserSortColumns="False">
                                                        <DataGrid.Columns>
                                                            <DataGridTextColumn Header="Sorgente" Binding="{Binding SourceFolder}" Width="1*"/>
                                                            <DataGridTextColumn Header="Da" Binding="{Binding OriginalPath}" Width="2*"/>
                                                            <DataGridTextColumn Header="A" Binding="{Binding NewPath}" Width="2*"/>
                                                            <DataGridTextColumn Header="Conflitto" Binding="{Binding ConflictReason}" Width="200"/>
                                                        </DataGrid.Columns>
                                                    </DataGrid>
                                                    </h:FillSlot>
                                                </DockPanel>
                                            </Border>
                                            <Border Grid.Row="1" Height="12"/>
                                            <Border Grid.Row="2" Classes="cardElevated">
                                                <DockPanel>
                                                    <TextBlock DockPanel.Dock="Top" Text="Cronologia operazioni" FontWeight="Bold" FontSize="14" Margin="0,0,0,8"/>
                                                    <h:FillSlot MinFill="160">
                                                    <DataGrid ItemsSource="{Binding OperationHistory}" AutoGenerateColumns="False" IsReadOnly="True" CanUserResizeColumns="True" CanUserReorderColumns="True" CanUserSortColumns="False">
                                                        <DataGrid.Columns>
                                                            <DataGridTextColumn Header="Data" Binding="{Binding Timestamp, StringFormat='{}{0:dd/MM/yyyy HH:mm:ss}'}" Width="180"/>
                                                            <DataGridTextColumn Header="Tipo" Binding="{Binding Type}" Width="100"/>
                                                            <DataGridTextColumn Header="Descrizione" Binding="{Binding Description}" Width="*"/>
                                                        </DataGrid.Columns>
                                                    </DataGrid>
                                                    </h:FillSlot>
                                                </DockPanel>
                                            </Border>
                                        </Grid>
                                    </DockPanel>
                                </Panel>
                                <Panel IsVisible="{Binding #OrganizerTabs.SelectedIndex, Converter={x:Static vm:IndexEqualsConverter.Default}, ConverterParameter=2}">
                                    <DockPanel Margin="0,10,0,0">
                                        <Border DockPanel.Dock="Top" Classes="cardElevated" Margin="0,0,0,12">
                                            <StackPanel Spacing="10">
                                                <Grid ColumnDefinitions="Auto, *, Auto">
                                                    <TextBlock Grid.Column="0" Text="{Binding SplitSourceLabel}" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,10,0"/>
                                                    <TextBox Grid.Column="1" Text="{Binding SplitSourceFolder}" Margin="0,0,8,0"/>
                                                    <Button Grid.Column="2" Classes="iconCircle" ToolTip.Tip="Sfoglia cartelle" Click="OnBrowseSplitSourceClick" IsVisible="{Binding OrganizeModeIsLocal}"><Path Classes="icon" Data="{StaticResource IconFolder}"/></Button>
                                                    <Button Grid.Column="2" Classes="iconCircle" ToolTip.Tip="Sfoglia cartelle remote" Click="OnBrowseSplitSourceRemoteClick" IsVisible="{Binding !OrganizeModeIsLocal}"><Path Classes="icon" Data="{StaticResource IconFolder}"/></Button>
                                                </Grid>

                                                <Grid ColumnDefinitions="Auto, *, Auto">
                                                    <TextBlock Grid.Column="0" Text="{Binding SplitDestinationLabel}" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,10,0"/>
                                                    <TextBox Grid.Column="1" Text="{Binding SplitDestinationFolder}" Margin="0,0,8,0"/>
                                                    <Button Grid.Column="2" Classes="iconCircle" ToolTip.Tip="Sfoglia cartelle" Click="OnBrowseSplitDestClick" IsVisible="{Binding OrganizeModeIsLocal}"><Path Classes="icon" Data="{StaticResource IconFolder}"/></Button>
                                                    <Button Grid.Column="2" Classes="iconCircle" ToolTip.Tip="Sfoglia cartelle remote" Click="OnBrowseSplitDestRemoteClick" IsVisible="{Binding !OrganizeModeIsLocal}"><Path Classes="icon" Data="{StaticResource IconFolder}"/></Button>
                                                </Grid>

                                                <StackPanel Orientation="Horizontal" Spacing="20">
                                                    <TextBlock Text="Modalità:" VerticalAlignment="Center" FontWeight="Bold"/>
                                                    <RadioButton Content="Uniforme" GroupName="SplitDivisionMode" IsChecked="{Binding SplitUniformMode}"/>
                                                    <RadioButton Content="Personalizzato" GroupName="SplitDivisionMode" IsChecked="{Binding !SplitUniformMode}"/>
                                                </StackPanel>

                                                <StackPanel Orientation="Horizontal" Spacing="10" IsVisible="{Binding SplitUniformMode}">
                                                    <TextBlock Text="Episodi per sottocartella:" VerticalAlignment="Center"/>
                                                    <TextBox Text="{Binding SplitUniformEpisodes, Mode=TwoWay}" Width="100"/>
                                                    <TextBlock Text="(l'ultima cartella conterrà il resto)" Foreground="{DynamicResource AppTextMutedBrush}" VerticalAlignment="Center"/>
                                                </StackPanel>

                                                <StackPanel Spacing="6" IsVisible="{Binding !SplitUniformMode}">
                                                    <TextBlock Text="Segmenti" FontWeight="Bold"/>
                                                    <Grid ColumnDefinitions="*, Auto" Height="180">
                                                        <Border Grid.Column="0" Background="{DynamicResource AppSurface2Brush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" CornerRadius="8">
                                                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                                                <ItemsControl ItemsSource="{Binding SplitSegments}">
                                                                    <ItemsControl.ItemTemplate>
                                                                        <DataTemplate DataType="models:SplitSegment">
                                                                            <Grid ColumnDefinitions="40, *, 40" Margin="8,4">
                                                                                <TextBlock Grid.Column="0" Text="{Binding Index, StringFormat='#{0}'}" VerticalAlignment="Center" Opacity="0.6" FontWeight="Bold" Foreground="{DynamicResource AppAccentBrush}"/>
                                                                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                                                                    <TextBlock Text="Episodi:" VerticalAlignment="Center"/>
                                                                                    <TextBox Text="{Binding EpisodeCount, Mode=TwoWay}" Width="100"/>
                                                                                </StackPanel>
                                                                                <Button ToolTip.Tip="Rimuove questo segmento" Grid.Column="2" Classes="iconCircle danger" Width="30" Height="30" Click="OnSplitRemoveSegmentClick"><Path Classes="icon" Data="{StaticResource IconClose}"/></Button>
                                                                            </Grid>
                                                                        </DataTemplate>
                                                                    </ItemsControl.ItemTemplate>
                                                                </ItemsControl>
                                                            </ScrollViewer>
                                                        </Border>
                                                        <StackPanel Grid.Column="1" Spacing="6" Margin="10,0">
                                                            <Button ToolTip.Tip="Aggiunge un segmento: una sottocartella con il numero di episodi indicato" Width="130" Command="{Binding AddSplitSegmentCommand}"><StackPanel Classes="bi" HorizontalAlignment="Center"><Path Classes="icon" Data="{StaticResource IconPlus}"/><TextBlock Text="Aggiungi"/></StackPanel></Button>
                                                            <Button ToolTip.Tip="Rimuove tutti i segmenti" Width="130" Command="{Binding ClearSplitSegmentsCommand}"><StackPanel Classes="bi" HorizontalAlignment="Center"><Path Classes="icon" Data="{StaticResource IconTrash}"/><TextBlock Text="Svuota"/></StackPanel></Button>
                                                        </StackPanel>
                                                    </Grid>
                                                </StackPanel>

                                                <TextBlock Text="{Binding SplitSegmentsSummary}" Foreground="{DynamicResource AppTextMutedBrush}" FontStyle="Italic"/>

                                                <StackPanel Orientation="Horizontal" Spacing="20">
                                                    <TextBlock Text="Numerazione:" VerticalAlignment="Center"/>
                                                    <RadioButton Content="Reset per cartella" GroupName="SplitMode" IsChecked="{Binding !SplitNumberingContinue}"/>
                                                    <RadioButton Content="Continua" GroupName="SplitMode" IsChecked="{Binding SplitNumberingContinue}"/>
                                                </StackPanel>

                                                <Grid ColumnDefinitions="Auto, *, Auto">
                                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,4,0"><TextBlock Text="Pattern file" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,6,0"/><h:PatternLegendButton Kind="Organize" Target="{Binding #SplitFilePatternBox}"/></StackPanel>
                                                    <ComboBox x:Name="SplitFilePatternBox" Grid.Column="1" IsEditable="True" ItemsSource="{Binding SplitFilePatterns}" Text="{Binding SplitFilePattern, Mode=TwoWay}" HorizontalAlignment="Stretch" Margin="0,0,10,0"/>
                                                    <Border Grid.Column="2" Background="{DynamicResource AppSurface2Brush}" BorderBrush="{DynamicResource AppAccentBrush}" BorderThickness="1" CornerRadius="6" Padding="10,4" MaxWidth="380">
                                                        <TextBlock Text="{Binding SplitFilePatternPreview}" FontFamily="Consolas,Menlo,monospace" Foreground="{DynamicResource AppAccentBrush}" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                    </Border>
                                                </Grid>

                                                <Grid ColumnDefinitions="Auto, *, Auto">
                                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,4,0"><TextBlock Text="Nome sottocartella" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,6,0"/><h:PatternLegendButton Kind="SplitFolder" Target="{Binding #SplitFolderPatternBox}"/></StackPanel>
                                                    <ComboBox x:Name="SplitFolderPatternBox" Grid.Column="1" IsEditable="True" ItemsSource="{Binding SplitFolderPatterns}" Text="{Binding SplitFolderPattern, Mode=TwoWay}" HorizontalAlignment="Stretch" Margin="0,0,10,0"/>
                                                    <Border Grid.Column="2" Background="{DynamicResource AppSurface2Brush}" BorderBrush="{DynamicResource AppAccentBrush}" BorderThickness="1" CornerRadius="6" Padding="10,4" MaxWidth="380"
                                                            ToolTip.Tip="Nomi delle prime sottocartelle, con le dimensioni e la numerazione scelte. Una «/» crea più livelli di cartelle.">
                                                        <TextBlock Text="{Binding SplitFolderPatternPreview}" FontFamily="Consolas,Menlo,monospace" Foreground="{DynamicResource AppAccentBrush}" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                    </Border>
                                                </Grid>


                                                <WrapPanel Orientation="Horizontal" ItemSpacing="8" LineSpacing="6">
                                                    <Button ToolTip.Tip="Calcola la suddivisione in sottocartelle senza modificare nulla: controlla la tabella prima di applicare" Classes="info" Command="{Binding PreviewSplitCommand}" IsEnabled="{Binding !IsSplitBusy}"><StackPanel Classes="bi"><Path Classes="icon" Data="{StaticResource IconEye}"/><TextBlock Text="Anteprima split"/></StackPanel></Button>
                                                    <Button ToolTip.Tip="Esegue la suddivisione proposta (annullabile con Undo)" Classes="success" Command="{Binding ApplySplitCommand}" IsEnabled="{Binding !IsSplitBusy}"><StackPanel Classes="bi"><Path Classes="icon" Data="{StaticResource IconCheck}"/><TextBlock Text="Applica split"/></StackPanel></Button>
                                                    <Button ToolTip.Tip="Annulla l'ultimo gruppo di operazioni applicate (rinomine/spostamenti)" Classes="warning" Command="{Binding UndoLastBatchCommand}" IsEnabled="{Binding !IsSplitBusy}"><StackPanel Classes="bi"><Path Classes="icon" Data="{StaticResource IconUndo}"/><TextBlock Text="Undo ultimo batch"/></StackPanel></Button>
                                                    <Border Width="1" Height="26" Background="{DynamicResource AppBorderBrush}" Margin="6,0" VerticalAlignment="Center"/>
                                                    <Button ToolTip.Tip="Svuota la tabella delle proposte o la cronologia delle operazioni (questa chiede conferma)">
                                                        <StackPanel Classes="bi"><Path Classes="icon" Data="{StaticResource IconTrash}"/><TextBlock Text="Pulisci"/><Path Classes="icon" Data="{StaticResource IconChevronDownSmall}" Width="10" Height="10" Margin="2,0,0,0"/></StackPanel>
                                                        <Button.Flyout>
                                                            <MenuFlyout Placement="BottomEdgeAlignedLeft">
                                                                <MenuItem Header="Svuota proposte" Command="{Binding ClearSplitPreviewOperationsCommand}" IsEnabled="{Binding !IsSplitBusy}"><MenuItem.Icon><Path Classes="icon" Data="{StaticResource IconTrash}"/></MenuItem.Icon></MenuItem>
                                                                <Separator/>
                                                                <MenuItem Classes="dangerItem" Header="Svuota cronologia…" Tag="{Binding ClearHistoryCommand}" CommandParameter="Cancellare la cronologia delle operazioni? I file non vengono toccati, ma non si potrà più annullare (Undo) niente di quanto fatto finora." Click="OnConfirmRemoveAllClick"><MenuItem.Icon><Path Classes="icon" Data="{StaticResource IconTrash}"/></MenuItem.Icon></MenuItem>
                                                            </MenuFlyout>
                                                        </Button.Flyout>
                                                    </Button>
                                                </WrapPanel>
                                            </StackPanel>
                                        </Border>

                                        <Grid RowDefinitions="*, Auto, *">
                                            <Border Grid.Row="0" Classes="cardElevated">
                                                <DockPanel>
                                                    <TextBlock DockPanel.Dock="Top" Text="Operazioni proposte" FontWeight="Bold" FontSize="14" Margin="0,0,0,8"/>
                                                    <h:FillSlot MinFill="160">
                                                    <DataGrid ItemsSource="{Binding SplitPreviewOperations}" AutoGenerateColumns="False" IsReadOnly="True" CanUserResizeColumns="True" CanUserReorderColumns="True" CanUserSortColumns="False">
                                                        <DataGrid.Columns>
                                                            <DataGridTextColumn Header="Da" Binding="{Binding OriginalPath}" Width="2*"/>
                                                            <DataGridTextColumn Header="A" Binding="{Binding NewPath}" Width="2*"/>
                                                            <DataGridTextColumn Header="Conflitto" Binding="{Binding ConflictReason}" Width="200"/>
                                                        </DataGrid.Columns>
                                                    </DataGrid>
                                                    </h:FillSlot>
                                                </DockPanel>
                                            </Border>
                                            <Border Grid.Row="1" Height="12"/>
                                            <Border Grid.Row="2" Classes="cardElevated">
                                                <DockPanel>
                                                    <TextBlock DockPanel.Dock="Top" Text="Cronologia operazioni" FontWeight="Bold" FontSize="14" Margin="0,0,0,8"/>
                                                    <h:FillSlot MinFill="160">
                                                    <DataGrid ItemsSource="{Binding OperationHistory}" AutoGenerateColumns="False" IsReadOnly="True" CanUserResizeColumns="True" CanUserReorderColumns="True" CanUserSortColumns="False">
                                                        <DataGrid.Columns>
                                                            <DataGridTextColumn Header="Data" Binding="{Binding Timestamp, StringFormat='{}{0:dd/MM/yyyy HH:mm:ss}'}" Width="180"/>
                                                            <DataGridTextColumn Header="Tipo" Binding="{Binding Type}" Width="100"/>
                                                            <DataGridTextColumn Header="Descrizione" Binding="{Binding Description}" Width="*"/>
                                                        </DataGrid.Columns>
                                                    </DataGrid>
                                                    </h:FillSlot>
                                                </DockPanel>
                                            </Border>
                                        </Grid>
                                    </DockPanel>
                                </Panel>
                            </Panel>
                        </DockPanel>
                    </DockPanel>
                    </h:FillViewportPanel>
                </ScrollViewer>
                    <!-- Copia del messaggio fissata in alto, visibile solo scorrendo (StickyBanner) -->
                    <Border x:Name="OrganizerStickyBanner" VerticalAlignment="Top" IsVisible="False" Padding="0,10,0,0" Background="{DynamicResource AppBackgroundBrush}">
                        <ContentControl Margin="0,0,0,8" Theme="{StaticResource StatusBannerTheme}" Content="{Binding CurrentStatusMessage}" IsVisible="{Binding CurrentStatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                    </Border>
                    </Panel>
                </Panel>
                <Panel IsVisible="{Binding #MainTabs.SelectedIndex, Converter={x:Static vm:IndexEqualsConverter.Default}, ConverterParameter=4}">
                    <!-- La pagina riempie la finestra; se è troppo bassa scorre (le tabelle restano utilizzabili) -->
                    <Panel DataContext="{Binding Sftp}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" h:StickyBanner.Overlay="{Binding #SftpStickyBanner}">
                    <h:FillViewportPanel>
                    <DockPanel Margin="0,10,0,0">
                        <!-- STATUS (in alto, sopra le guide) -->
                        <ContentControl DockPanel.Dock="Top" Theme="{StaticResource StatusBannerTheme}" Content="{Binding SftpStatusMessage}"/>

                        <!-- GUIDA SFTP -->
                        <Border DockPanel.Dock="Top" Classes="cardElevated" Margin="0,0,0,12" Padding="0" ClipToBounds="True">
                            <StackPanel>
                                <ToggleButton Classes="guideToggle" x:Name="ToggleGuideSftp" IsChecked="False">
                                    <Grid ColumnDefinitions="*, Auto">
                                        <StackPanel Classes="bi">
                                            <Path Classes="icon accent" Data="{StaticResource IconBulb}"/>
                                            <TextBlock Text="Guida rapida - SFTP" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource AppTextBrush}"/>
                                        </StackPanel>
                                        <Path Grid.Column="1" Classes="chevron"/>
                                    </Grid>
                                </ToggleButton>
                                <Border IsVisible="{Binding #ToggleGuideSftp.IsChecked}" Background="Transparent" Margin="16,0,16,16" Padding="12,12,4,12">
                                    <ScrollViewer MaxHeight="240" VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
                                    <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource AppTextMutedBrush}">
                                        <Run FontWeight="Bold" Foreground="{DynamicResource AppTextBrush}">Profili</Run><LineBreak/>
                                        In "Configurazione connessione SFTP" crei un profilo per ogni server: nome, host, porta, utente e password (o chiave privata SSH), più la cartella da cui partire. "Test" prova i dati senza restare collegato. I profili restano salvati e la password è cifrata.<LineBreak/>
                                        <LineBreak/>
                                        <Run FontWeight="Bold" Foreground="{DynamicResource AppTextBrush}">Connettersi: le schede</Run><LineBreak/>
                                        <Run FontWeight="SemiBold" Foreground="{DynamicResource AppTextBrush}">• Due pannelli, tutti e due a schede:</Run> a destra i server, a sinistra <Run FontWeight="SemiBold">Locale</Run> (i file del PC) più i server che vuoi. Un pannello vuoto mostra i profili: un clic su "Connetti" e il server diventa una scheda.<LineBreak/>
                                        <Run FontWeight="SemiBold" Foreground="{DynamicResource AppTextBrush}">• Altri server:</Run> "+ Connetti server" apre un altro server in una nuova scheda; un clic sul nome della scheda per passarci. Ogni scheda ha la sua connessione e ricorda la sua cartella. Lo stesso server può stare a destra e a sinistra: i due pannelli si aggiornano a vicenda.<LineBreak/>
                                        <Run FontWeight="SemiBold" Foreground="{DynamicResource AppTextBrush}">• Disconnettere:</Run> il simbolo rosso dentro la scheda, accanto al nome, disconnette quel server; quello grande in fondo alla barra disconnette il server della scheda aperta. Upload, download e copie già in coda continuano comunque.<LineBreak/>
                                        <LineBreak/>
                                        <Run FontWeight="Bold" Foreground="{DynamicResource AppTextBrush}">Lavorare sui file</Run><LineBreak/>
                                        <Run FontWeight="SemiBold" Foreground="{DynamicResource AppTextBrush}">• Upload:</Run> con "Locale" a sinistra, trascina file o cartelle a destra oppure usa la freccia "Upload": vanno nella cartella aperta della <Run FontWeight="SemiBold">scheda di destra</Run>. Per mandare file diversi su server diversi, passa all'altra scheda e carica lì.<LineBreak/>
                                        <Run FontWeight="SemiBold" Foreground="{DynamicResource AppTextBrush}">• Download:</Run> trascina da destra a sinistra (o "Download"): i file finiscono nella cartella locale aperta.<LineBreak/>
                                        <Run FontWeight="SemiBold" Foreground="{DynamicResource AppTextBrush}">• Copia tra server:</Run> con un server a sinistra le frecce al centro diventano "Copia": i file selezionati vanno nella cartella aperta dall'altra parte, cartelle comprese. I dati passano dal PC in streaming, senza file temporanei.<LineBreak/>
                                        <Run FontWeight="SemiBold" Foreground="{DynamicResource AppTextBrush}">• Gestione:</Run> clic destro per aprire, rinominare, duplicare (fatto dal server stesso), spostare ("Sposta in…") o eliminare; doppio clic su una cartella per entrarci. Ogni tabella ha il suo ordinamento (nome, dimensione, data, tipo).<LineBreak/>
                                        <Run FontWeight="SemiBold" Foreground="{DynamicResource AppTextBrush}">• Anteprima video:</Run> clic destro su un video, "Anteprima video": lo riproduce subito, quelli sui server in streaming senza scaricarli (Spazio play/pausa, frecce per spostarti e per il volume, F schermo intero).<LineBreak/>
                                        <Run FontWeight="SemiBold" Foreground="{DynamicResource AppTextBrush}">• Stato:</Run> sotto i pulsanti di ogni tabella, a destra del conteggio, compaiono "Lettura cartella in corso…" e l'avanzamento dei controlli, senza spostare la tabella.<LineBreak/>
                                        <LineBreak/>
                                        <Run FontWeight="Bold" Foreground="{DynamicResource AppTextBrush}">Code: Upload, Download, Server ↔ Server</Run><LineBreak/>
                                        Ogni trasferimento va in coda con avanzamento, velocità e tempo rimanente; la colonna "Server" dice su quale server. Pausa, ripresa (riparte da dove era arrivato) e annulla sono sia in alto, per tutti, sia sulla riga, per uno solo. Il numero di trasferimenti simultanei vale <Run FontWeight="SemiBold">per ogni server</Run>: con 6 sono 6 su un server e 6 sull'altro. Una copia tra server messa in pausa riparte dall'inizio del file. "Pulisci lista" toglie completati, annullati o falliti; "Elimina tutto…" è in fondo al menu e chiede conferma. Le barre hanno i colori dello stato (verde completato, blu in corso, arancione in pausa, rosso errore, grigio-azzurro in coda, grigio annullato) e in basso, accanto al Log, la barra di stato mostra upload (↑), download (↓) e copie (⇄) in corso da qualsiasi tab; a fine coda, con l'app in secondo piano, arriva una notifica di Windows.<LineBreak/>
                                        <LineBreak/>
                                        <Run FontWeight="Bold" Foreground="{DynamicResource AppTextBrush}">Controllo dei file a 0 byte</Run><LineBreak/>
                                        La lente nella barra di una scheda controlla le sottocartelle della cartella aperta e cerca file vuoti (0 byte), di solito upload interrotti: le cartelle che ne contengono diventano rosse e la colonna "Contenuto" ne riassume il contenuto.<LineBreak/>
                                        <Run FontWeight="SemiBold" Foreground="{DynamicResource AppTextBrush}">• Più server insieme:</Run> ogni server ha il suo controllo, quindi puoi avviarlo su più schede e vanno in contemporanea; lo Stop ferma solo quello della scheda su cui lo premi.<LineBreak/>
                                        <Run FontWeight="SemiBold" Foreground="{DynamicResource AppTextBrush}">• Stesso server in due pannelli:</Run> esiti e avanzamento compaiono in tempo reale in entrambi.<LineBreak/>
                                        <Run FontWeight="SemiBold" Foreground="{DynamicResource AppTextBrush}">• Sempre aggiornato:</Run> dopo un controllo, in quella cartella le sottocartelle nuove, rinominate o arrivate con un upload vengono controllate da sole, senza rifarlo a mano.<LineBreak/>
                                        <LineBreak/>
                                        <Run FontWeight="Bold" Foreground="{DynamicResource AppTextBrush}">Altre tab</Run><LineBreak/>
                                        <Run FontWeight="SemiBold" Foreground="{DynamicResource AppTextBrush}">• Organizza file:</Run> in modalità Remoto lavora su uno qualsiasi dei server aperti qui (menu "Server"), senza disconnettersi.<LineBreak/>
                                        <Run FontWeight="SemiBold" Foreground="{DynamicResource AppTextBrush}">• Videobox Corrector:</Run> ogni modifica fatta qui, su qualsiasi server e da qualsiasi pannello, aggiorna in pochi istanti gli alberi delle sorgenti di quel server.<LineBreak/>
                                        <LineBreak/>
                                        <Run FontWeight="SemiBold" Foreground="{DynamicResource AppTextBrush}">• Problemi:</Run> se una connessione cade, disconnetti la scheda e riaprila. I dettagli sono nel Log globale, sezione "SFTP".
                                    </TextBlock>
                                    </ScrollViewer>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- CONFIGURAZIONE -->
                        <Border DockPanel.Dock="Top" Classes="cardElevated" Margin="0,0,0,12" Padding="0" ClipToBounds="True">
                            <StackPanel>
                                <ToggleButton Classes="guideToggle" x:Name="ToggleSftpConfigButton" IsChecked="{Binding !HasSftpProfiles, Mode=OneWay}">
                                    <Grid ColumnDefinitions="*, Auto">
                                        <StackPanel Classes="bi">
                                            <Path Classes="icon accent" Data="{StaticResource IconPlug}"/>
                                            <TextBlock Text="Configurazione connessione SFTP" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource AppTextBrush}"/>
                                        </StackPanel>
                                        <Path Grid.Column="1" Classes="chevron"/>
                                    </Grid>
                                </ToggleButton>

                                <StackPanel x:Name="SftpConfigBody" IsVisible="{Binding #ToggleSftpConfigButton.IsChecked}" Margin="16,0,16,16" Spacing="12">
                                    <Grid ColumnDefinitions="Auto, *, Auto, Auto, Auto">
                                        <TextBlock Grid.Column="0" Text="Profilo:" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,10,0"/>
                                        <ComboBox Grid.Column="1" ItemsSource="{Binding SftpProfiles}" SelectedItem="{Binding SelectedSftpProfile, Mode=TwoWay}" DisplayMemberBinding="{Binding Name}" HorizontalAlignment="Stretch" Margin="0,0,10,0"/>
                                        <Button ToolTip.Tip="Crea un nuovo profilo di connessione vuoto" Grid.Column="2" Click="OnSftpNewProfileClick" Margin="0,0,8,0"><StackPanel Classes="bi"><Path Classes="icon" Data="{StaticResource IconPlus}"/><TextBlock Text="Nuovo"/></StackPanel></Button>
                                        <Button ToolTip.Tip="Salva il profilo corrente (la password viene cifrata)" Grid.Column="3" Classes="accent" Command="{Binding SftpSaveConfigCommand}" Margin="0,0,8,0"><StackPanel Classes="bi"><Path Classes="icon" Data="{StaticResource IconSave}"/><TextBlock Text="Salva"/></StackPanel></Button>
                                        <Button ToolTip.Tip="Elimina il profilo selezionato" Grid.Column="4" Classes="danger" Command="{Binding SftpDeleteProfileCommand}"><StackPanel Classes="bi"><Path Classes="icon" Data="{StaticResource IconTrash}"/><TextBlock Text="Elimina"/></StackPanel></Button>
                                    </Grid>

                                    <Border Background="{DynamicResource AppSurface2Brush}" CornerRadius="8" Padding="14">
                                        <Grid ColumnDefinitions="Auto, *, Auto, Auto" RowDefinitions="Auto, Auto, Auto, Auto, Auto, Auto">
                                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Nome:" VerticalAlignment="Center" Margin="0,0,10,8"/>
                                            <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding SftpName}" Margin="0,0,10,8"/>
                                            <TextBlock Grid.Row="0" Grid.Column="2" Text="Host:" VerticalAlignment="Center" Margin="20,0,10,8"/>
                                            <TextBox Grid.Row="0" Grid.Column="3" Text="{Binding SftpHost}" Width="260" Margin="0,0,0,8" ToolTip.Tip="I dati di accesso al tuo server SFTP"/>

                                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Username:" VerticalAlignment="Center" Margin="0,0,10,8"/>
                                            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding SftpUsername}" Margin="0,0,10,8"/>
                                            <TextBlock Grid.Row="1" Grid.Column="2" Text="Porta:" VerticalAlignment="Center" Margin="20,0,10,8"/>
                                            <TextBox Grid.Row="1" Grid.Column="3" Text="{Binding SftpPort}" Width="260" Margin="0,0,0,8"/>

                                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Password:" VerticalAlignment="Center" Margin="0,0,10,8"/>
                                            <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding SftpPassword}" PasswordChar="•" Margin="0,0,10,8"/>
                                            <CheckBox ToolTip.Tip="Autenticazione con chiave privata (file .ppk / OpenSSH) invece della password" Grid.Row="2" Grid.Column="2" Grid.ColumnSpan="2" IsChecked="{Binding SftpUseKeyAuth}" Margin="20,0,0,8">
                                                <StackPanel Classes="bi"><Path Classes="icon" Data="{StaticResource IconKey}"/><TextBlock Text="Usa chiave privata SSH"/></StackPanel>
                                            </CheckBox>

                                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Chiave privata:" VerticalAlignment="Center" Margin="0,0,10,8" IsVisible="{Binding SftpUseKeyAuth}"/>
                                            <Grid Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" ColumnDefinitions="*, Auto" IsVisible="{Binding SftpUseKeyAuth}" Margin="0,0,10,8">
                                                <TextBox Grid.Column="0" Text="{Binding SftpPrivateKeyPath}" Margin="0,0,8,0"/>
                                                <Button Grid.Column="1" Classes="iconCircle" Click="OnBrowseSftpKeyClick" ToolTip.Tip="Sfoglia"><Path Classes="icon" Data="{StaticResource IconFolder}"/></Button>
                                            </Grid>

                                            <Grid Grid.Row="3" Grid.Column="3" ColumnDefinitions="Auto, *" IsVisible="{Binding SftpUseKeyAuth}" Margin="0,0,0,8">
                                                <TextBlock Grid.Column="0" Text="Passphrase:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                                <TextBox Grid.Column="1" Text="{Binding SftpPrivateKeyPassphrase}" PasswordChar="•"/>
                                            </Grid>

                                            <TextBlock Grid.Row="4" Grid.Column="0" Text="Cartella remota:" VerticalAlignment="Center" Margin="0,0,10,8"/>
                                            <TextBox Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="3" Text="{Binding SftpRemoteBasePath}" Margin="0,0,0,8"/>

                                            <TextBlock Grid.Row="5" Grid.Column="0" Text="Host key fingerprint:" VerticalAlignment="Center" Margin="0,0,10,8"/>
                                            <TextBox Grid.Row="5" Grid.Column="1" Grid.ColumnSpan="3" Text="{Binding SftpHostKeyFingerprint}" PlaceholderText="(opzionale) ssh-rsa 2048 xx:xx:xx..." Margin="0,0,0,8"/>
                                        </Grid>
                                    </Border>

                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Button ToolTip.Tip="Prova la connessione con i dati inseriti, senza restare collegato" Classes="info" Command="{Binding SftpTestCommand}" IsEnabled="{Binding !IsSftpBusy}"><StackPanel Classes="bi"><Path Classes="icon" Data="{StaticResource IconPlug}"/><TextBlock Text="Test"/></StackPanel></Button>
                                        <TextBlock VerticalAlignment="Center" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource AppTextMutedBrush}"
                                                   Text="Qui crei e modifichi i profili. Per connetterti apri il Browser: nel pannello &quot;File remoti&quot; ogni server aperto diventa una scheda."/>
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <DockPanel>
                            <TabControl x:Name="SftpTabs" DockPanel.Dock="Top">
                                <!-- ===== BROWSER ===== -->
                                <TabItem>
                                    <TabItem.Header>
                                        <StackPanel Classes="bi">
                                            <Path Classes="icon" Data="{StaticResource IconFolder}"/>
                                            <TextBlock Text="Browser" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </TabItem.Header>
                                </TabItem>

                                <!-- ===== UPLOAD QUEUE ===== -->
                                <TabItem>
                                    <TabItem.Header>
                                        <StackPanel Classes="bi">
                                            <Path Classes="icon" Data="{StaticResource IconUpload}"/>
                                            <TextBlock Text="Upload queue" VerticalAlignment="Center"/>
                                            <Border Width="9" Height="9" CornerRadius="5" Background="{DynamicResource AppAccentBrush}" IsVisible="{Binding HasActiveUploads}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </TabItem.Header>
                                </TabItem>

                                <!-- ===== DOWNLOAD QUEUE ===== -->
                                <TabItem>
                                    <TabItem.Header>
                                        <StackPanel Classes="bi">
                                            <Path Classes="icon" Data="{StaticResource IconDownload}"/>
                                            <TextBlock Text="Download queue" VerticalAlignment="Center"/>
                                            <Border Width="9" Height="9" CornerRadius="5" Background="{DynamicResource AppAccentBrush}" IsVisible="{Binding HasActiveDownloads}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </TabItem.Header>
                                </TabItem>

                                <!-- ===== SERVER ↔ SERVER ===== -->
                                <TabItem>
                                    <TabItem.Header>
                                        <StackPanel Classes="bi">
                                            <Path Classes="icon" Data="{StaticResource IconRepeat}"/>
                                            <TextBlock Text="Server ↔ Server" VerticalAlignment="Center"/>
                                            <Border Width="9" Height="9" CornerRadius="5" Background="{DynamicResource AppAccentBrush}" IsVisible="{Binding HasActiveRelays}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </TabItem.Header>
                                </TabItem>
                            </TabControl>
                            <!-- Contenuti sempre nel visual tree: cambiando tab restano scroll e stato -->
                            <Panel ClipToBounds="True">
                                <Panel IsVisible="{Binding #SftpTabs.SelectedIndex, Converter={x:Static vm:IndexEqualsConverter.Default}, ConverterParameter=0}">
                                    <Grid ColumnDefinitions="*, Auto, *" Margin="0,10,0,0">

                                        <!-- FILE LOCALI -->
                                        <Border Grid.Column="0" Classes="cardElevated" Margin="0,0,6,0">
                                            <DockPanel>
                                                <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto, *" Margin="0,0,0,10">
                                                    <StackPanel Classes="bi" Margin="0,0,12,0" VerticalAlignment="Center">
                                                        <Path Classes="icon accent" Data="{StaticResource IconMonitor}" IsVisible="{Binding IsLocalMode}"/>
                                                        <Path Classes="icon accent" Data="{StaticResource IconCloud}" IsVisible="{Binding IsServer2Mode}"/>
                                                        <TextBlock Text="File locali" FontWeight="Bold" FontSize="14" VerticalAlignment="Center" IsVisible="{Binding IsLocalMode}"/>
                                                        <TextBlock Text="{Binding Server2Name}" FontWeight="Bold" FontSize="14" VerticalAlignment="Center" IsVisible="{Binding IsServer2Mode}" TextTrimming="CharacterEllipsis" MaxWidth="180"/>
                                                    </StackPanel>
                                                    <!-- Locale, poi un server per scheda: "+" ne apre un altro -->
                                                    <ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                                                        <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right">
                                                            <Button Padding="10,4" FontSize="12" Classes.accent="{Binding IsLocalMode}" Command="{Binding ShowLocalPaneCommand}" ToolTip.Tip="Mostra i file del PC (upload e download)">
                                                                <StackPanel Classes="bi"><Path Classes="icon" Data="{StaticResource IconMonitor}"/><TextBlock Text="Locale"/></StackPanel>
                                                            </Button>
                                                            <ItemsControl ItemsSource="{Binding LeftTabs}">
                                                                <ItemsControl.ItemsPanel>
                                                                    <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="6"/></ItemsPanelTemplate>
                                                                </ItemsControl.ItemsPanel>
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate x:DataType="vm:RemoteServerTab">
                                                                        <Border Classes="serverTab" Classes.active="{Binding IsActive}">
                                                                            <StackPanel Orientation="Horizontal">
                                                                                <Button Classes="ghost tabName" ToolTip.Tip="{Binding TabTooltip}"
                                                                                        Command="{Binding $parent[ItemsControl].((vm:SftpTabViewModel)DataContext).SelectLeftTabCommand}" CommandParameter="{Binding}">
                                                                                    <StackPanel Classes="bi">
                                                                                        <Path Classes="icon" Data="{StaticResource IconCloud}"/>
                                                                                        <TextBlock Text="{Binding Name}" MaxWidth="150" TextTrimming="CharacterEllipsis"/>
                                                                                    </StackPanel>
                                                                                </Button>
                                                                                <Rectangle Classes="tabSep"/>
                                                                                <Button Classes="ghost tabClose" ToolTip.Tip="{Binding Name, StringFormat='Disconnetti {0} e chiudi la sua scheda'}"
                                                                                        Command="{Binding $parent[ItemsControl].((vm:SftpTabViewModel)DataContext).CloseLeftTabCommand}" CommandParameter="{Binding}">
                                                                                    <Path Classes="icon" Data="{StaticResource IconBoltOff}"/>
                                                                                </Button>
                                                                            </StackPanel>
                                                                        </Border>
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                            <Button Padding="10,4" FontSize="12" Classes.accent="{Binding IsLeftAdding}" Command="{Binding ShowServer2PaneCommand}" ToolTip.Tip="Apri un server SFTP in una nuova scheda di questo pannello">
                                                                <StackPanel Classes="bi"><Path Classes="icon" Data="{StaticResource IconPlus}"/><TextBlock Text="Connetti server"/></StackPanel>
                                                            </Button>
                                                        </StackPanel>
                                                    </ScrollViewer>
                                                </Grid>

                                                <!-- Pannello di sinistra: connessione di un server, i file della scheda aperta oppure i file locali -->
                                                <Panel>
                                                    <!-- ===== SECONDO SERVER: connessione ===== -->
                                                    <ScrollViewer IsVisible="{Binding ShowServer2Connect}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                                        <Border MaxWidth="520" Margin="0,16" Padding="24,22" HorizontalAlignment="Center" VerticalAlignment="Center" CornerRadius="16"
                                                                Background="{DynamicResource AppInputBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1">
                                                            <StackPanel Spacing="14">
                                                                <Border Width="56" Height="56" CornerRadius="28" HorizontalAlignment="Center" Background="{DynamicResource AppAccentSoftBrush}">
                                                                    <Path Classes="icon accent" Width="26" Height="26" Data="{StaticResource IconCloud}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                </Border>
                                                                <StackPanel Spacing="4">
                                                                    <TextBlock Text="Connetti un server" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center"/>
                                                                    <TextBlock Text="Ogni server aperto diventa una scheda qui sopra, come a destra. Tra due server i file si copiano con le frecce al centro: i dati passano dal PC in streaming, senza occupare spazio su disco." FontSize="12" TextWrapping="Wrap" TextAlignment="Center" Foreground="{DynamicResource AppTextMutedBrush}"/>
                                                                </StackPanel>
                                                                <ItemsControl ItemsSource="{Binding SftpProfiles}" IsEnabled="{Binding !IsServer2Busy}">
                                                                    <ItemsControl.ItemsPanel>
                                                                        <ItemsPanelTemplate><StackPanel Spacing="8"/></ItemsPanelTemplate>
                                                                    </ItemsControl.ItemsPanel>
                                                                    <ItemsControl.ItemTemplate>
                                                                        <DataTemplate x:DataType="models:SftpConfig">
                                                                            <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="14,10"
                                                                                    Command="{Binding $parent[ItemsControl].((vm:SftpTabViewModel)DataContext).Server2ConnectProfileCommand}" CommandParameter="{Binding}" ToolTip.Tip="Connetti a questo server">
                                                                                <Grid ColumnDefinitions="Auto, *, Auto">
                                                                                    <Path Classes="icon accent" Width="18" Height="18" Data="{StaticResource IconCloud}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                                                                    <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                                                                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                                                        <TextBlock Text="{Binding Host}" FontSize="11" Foreground="{DynamicResource AppTextMutedBrush}" TextTrimming="CharacterEllipsis"/>
                                                                                    </StackPanel>
                                                                                    <StackPanel Grid.Column="2" Classes="bi" VerticalAlignment="Center" Margin="12,0,0,0">
                                                                                        <Path Classes="icon accent" Data="{StaticResource IconPlug}"/>
                                                                                        <TextBlock Text="Connetti" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource AppAccentBrush}"/>
                                                                                    </StackPanel>
                                                                                </Grid>
                                                                            </Button>
                                                                        </DataTemplate>
                                                                    </ItemsControl.ItemTemplate>
                                                                </ItemsControl>
                                                                <TextBlock IsVisible="{Binding !HasSftpProfiles}" FontSize="12" TextWrapping="Wrap" TextAlignment="Center" Foreground="{DynamicResource AppWarningBrush}"
                                                                           Text="Nessun profilo salvato: creane uno in &quot;Configurazione connessione SFTP&quot; qui sopra."/>
                                                                <ProgressBar IsIndeterminate="True" Height="4" MinWidth="0" IsVisible="{Binding IsServer2Busy}"/>
                                                                <Button HorizontalAlignment="Center" Command="{Binding CancelLeftAddCommand}" IsVisible="{Binding CanCancelLeftAdd}" ToolTip.Tip="Torna alla scheda aperta">
                                                                    <TextBlock Text="Annulla"/>
                                                                </Button>
                                                                <TextBlock FontSize="11" TextWrapping="Wrap" TextAlignment="Center" Foreground="{DynamicResource AppTextMutedBrush}"
                                                                           Text="Ogni scheda ha la sua connessione: lo stesso server può essere aperto anche a destra."/>
                                                            </StackPanel>
                                                        </Border>
                                                    </ScrollViewer>

                                                    <!-- ===== SECONDO SERVER: file ===== -->
                                                    <DockPanel IsVisible="{Binding ShowServer2Browser}">
                                                        <Grid DockPanel.Dock="Top" RowDefinitions="Auto,Auto" Margin="0,0,0,8">
                                                            <Grid Grid.Row="0" ColumnDefinitions="Auto, Auto, *, Auto, Auto, Auto, Auto, Auto, Auto">
                                                                <Button Grid.Column="0" Classes="iconCircle" Command="{Binding Server2GoUpCommand}" Margin="0,0,6,0" ToolTip.Tip="Indietro"><Path Classes="icon" Data="{StaticResource IconArrowLeft}"/></Button>
                                                                <Button Grid.Column="1" Classes="iconCircle" Command="{Binding Server2GoHomeCommand}" Margin="0,0,6,0" ToolTip.Tip="Home"><Path Classes="icon" Data="{StaticResource IconHome}"/></Button>
                                                                <TextBox Grid.Column="2" Text="{Binding Server2Path}" Margin="0,0,6,0" KeyDown="OnServer2PathKeyDown" ToolTip.Tip="Percorso sul server della scheda (Invio per aprirlo)"/>
                                                                <Button Grid.Column="3" Classes="iconCircle" Command="{Binding Server2RefreshCommand}" Margin="0,0,6,0" ToolTip.Tip="Aggiorna"><Path Classes="icon" Data="{StaticResource IconRefresh}"/></Button>
                                                                <Button Grid.Column="4" Classes="iconCircle" Click="OnServer2NewFolderClick" Margin="0,0,6,0" ToolTip.Tip="Nuova cartella"><Path Classes="icon" Data="{StaticResource IconPlus}"/></Button>
                                                                <StackPanel Grid.Column="5" Orientation="Horizontal" Spacing="4" Margin="0,0,6,0">
                                                                    <Button Classes="iconCircle" Command="{Binding CheckServer2ZeroByteCommand}" IsEnabled="{Binding !IsServer2CheckingZeroByte}" ToolTip.Tip="Analizza la cartella di questo server per trovare file vuoti (0 byte). Se lo stesso server è aperto anche a destra, i risultati sono condivisi"><Path Classes="icon" Data="{StaticResource IconSearch}"/></Button>
                                                                    <Button Classes="iconCircle danger" Command="{Binding StopServer2ZeroByteCommand}" IsVisible="{Binding IsServer2CheckingZeroByte}" ToolTip.Tip="Ferma il check in corso"><Path Classes="icon" Data="{StaticResource IconStop}"/></Button>
                                                                </StackPanel>
                                                                <ComboBox Grid.Column="6" ItemsSource="{Binding SortOptions}" SelectedItem="{Binding Server2SortOption, Mode=TwoWay}" MinWidth="110" Margin="0,0,6,0" ToolTip.Tip="Ordina per">
                                                                    <ComboBox.ItemTemplate>
                                                                        <DataTemplate x:DataType="models:SortOption">
                                                                            <TextBlock Text="{Binding Label}"/>
                                                                        </DataTemplate>
                                                                    </ComboBox.ItemTemplate>
                                                                </ComboBox>
                                                                <Button Grid.Column="7" Classes="iconCircle" Width="34" Margin="0,0,6,0" Command="{Binding ToggleServer2SortDirectionCommand}" ToolTip.Tip="Inverti direzione (crescente / decrescente)"><Panel><Path Classes="icon" Data="{StaticResource IconArrowUp}" IsVisible="{Binding Server2SortAscending}"/><Path Classes="icon" Data="{StaticResource IconArrowDown}" IsVisible="{Binding !Server2SortAscending}"/></Panel></Button>
                                                                <Button Grid.Column="8" Classes="iconCircle danger" Command="{Binding Server2DisconnectCommand}" ToolTip.Tip="Disconnetti il server di questa scheda e chiudi la scheda"><Path Classes="icon" Data="{StaticResource IconBoltOff}"/></Button>
                                                            </Grid>
                                                            <!-- Statistiche e stato sulla stessa riga, ad altezza fissa: la tabella non si sposta -->
                                                            <Grid Grid.Row="1" ColumnDefinitions="*, Auto" Margin="0,6,0,0" Height="18">
                                                                <TextBlock Text="{Binding Server2Stats}" FontSize="11" Foreground="{DynamicResource AppTextMutedBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" Margin="10,0,0,0" IsVisible="{Binding HasServer2Status}">
                                                                    <Panel VerticalAlignment="Center"><Path Classes="icon accent" Width="12" Height="12" Data="{StaticResource IconSearch}" IsVisible="{Binding IsServer2CheckingZeroByte}"/><Path Classes="icon accent" Width="12" Height="12" Data="{StaticResource IconRefresh}" IsVisible="{Binding !IsServer2CheckingZeroByte}"/></Panel>
                                                                    <TextBlock Text="{Binding Server2StatusText}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AppAccentBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="420"/>
                                                                </StackPanel>
                                                            </Grid>
                                                        </Grid>
                                                        <h:FillSlot>
                                                        <DataGrid Name="Server2FilesGrid" MinHeight="0" ItemsSource="{Binding Server2Entries}" ScrollViewer.HorizontalScrollBarVisibility="Auto" SelectedItem="{Binding SelectedServer2Entry, Mode=TwoWay}" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Extended" SelectionChanged="OnServer2SelectionChanged" DoubleTapped="OnServer2DoubleTapped" KeyDown="OnServer2GridKeyDown" CanUserResizeColumns="True" CanUserReorderColumns="True" CanUserSortColumns="False">
                                                            <DataGrid.Styles>
                                                                <Style Selector="DataGridRow" x:DataType="models:SftpRemoteEntry">
                                                                    <Setter Property="Classes.zeroByte" Value="{Binding HasZeroByteIssue}"/>
                                                                </Style>
                                                            </DataGrid.Styles>
                                                            <DataGrid.ContextMenu>
                                                                <ContextMenu Opening="OnFileMenuOpening">
                                                                    <MenuItem Header="Apri" Tag="dir" Click="OnServer2OpenClick"><MenuItem.Icon><Path Classes="icon" Data="{StaticResource IconFolder}"/></MenuItem.Icon></MenuItem>
                                                                    <MenuItem Header="Anteprima video" Tag="video" Click="OnServer2PreviewClick"><MenuItem.Icon><Path Classes="icon" Data="{StaticResource IconPlayCircle}"/></MenuItem.Icon></MenuItem>
                                                                    <Separator/>
                                                                    <MenuItem Header="Rinomina" Click="OnServer2RenameClick"><MenuItem.Icon><Path Classes="icon" Data="{StaticResource IconEdit}"/></MenuItem.Icon></MenuItem>
                                                                    <MenuItem Header="Duplica..." Click="OnServer2DuplicateClick"><MenuItem.Icon><Path Classes="icon" Data="{StaticResource IconCopy}"/></MenuItem.Icon></MenuItem>
                                                                    <MenuItem Header="Sposta in..." Click="OnServer2MoveClick"><MenuItem.Icon><Path Classes="icon" Data="{StaticResource IconArrowLeft}"/></MenuItem.Icon></MenuItem>
                                                                    <MenuItem Header="Copia nella scheda di destra" Click="OnServer2CopyToMainClick"><MenuItem.Icon><Path Classes="icon" Data="{StaticResource IconArrowRight}"/></MenuItem.Icon></MenuItem>
                                                                    <Separator/>
                                                                    <MenuItem Header="Elimina" Click="OnServer2DeleteClick"><MenuItem.Icon><Path Classes="icon" Data="{StaticResource IconTrash}"/></MenuItem.Icon></MenuItem>
                                                                </ContextMenu>
                                                            </DataGrid.ContextMenu>
                                                            <DataGrid.Columns>
                                                                <DataGridTemplateColumn Header=" " Width="40" CanUserResize="False">
                                                                    <DataGridTemplateColumn.CellTemplate>
                                                                        <DataTemplate x:DataType="models:SftpRemoteEntry">
                                                                            <Panel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                                                <Path Classes="icon" Data="{StaticResource IconFolder}" Stroke="{DynamicResource AppWarningBrush}" IsVisible="{Binding IsDirectory}"/>
                                                                                <Path Classes="icon" Data="{StaticResource IconFile}" Stroke="{DynamicResource AppTextMutedBrush}" IsVisible="{Binding !IsDirectory}"/>
                                                                            </Panel>
                                                                        </DataTemplate>
                                                                    </DataGridTemplateColumn.CellTemplate>
                                                                </DataGridTemplateColumn>
                                                                <DataGridTextColumn Header="Nome" Binding="{Binding Name}" Width="*" MinWidth="150"/>
                                                                <DataGridTextColumn Header="Contenuto" Binding="{Binding ContentsInfo}" Width="Auto" MinWidth="100"/>
                                                                <DataGridTextColumn Header="Dim." Binding="{Binding SizeText}" Width="Auto" MinWidth="70"/>
                                                                <DataGridTextColumn Header="Ultima modifica" Binding="{Binding Modified, StringFormat='{}{0:dd/MM/yyyy HH:mm}'}" Width="Auto" MinWidth="120"/>
                                                            </DataGrid.Columns>
                                                        </DataGrid>
                                                        </h:FillSlot>
                                                    </DockPanel>

                                                    <!-- ===== FILE LOCALI ===== -->
                                                    <DockPanel IsVisible="{Binding IsLocalMode}">
                                                    <Grid DockPanel.Dock="Top" RowDefinitions="Auto,Auto" Margin="0,0,0,8">
                                                        <Grid Grid.Row="0" ColumnDefinitions="Auto, Auto, *, Auto, Auto, Auto, Auto">
                                                            <Button Grid.Column="0" Classes="iconCircle" Command="{Binding SftpLocalGoUpCommand}" Margin="0,0,6,0" ToolTip.Tip="Indietro"><Path Classes="icon" Data="{StaticResource IconArrowLeft}"/></Button>
                                                            <Button Grid.Column="1" Classes="iconCircle" Command="{Binding SftpLocalHomeCommand}" Margin="0,0,6,0" ToolTip.Tip="Home"><Path Classes="icon" Data="{StaticResource IconHome}"/></Button>
                                                            <TextBox Grid.Column="2" Text="{Binding SftpCurrentLocalPath}" Margin="0,0,6,0" IsReadOnly="True"/>
                                                            <Button Grid.Column="3" Classes="iconCircle" Click="OnSftpLocalRefreshClick" Margin="0,0,6,0" ToolTip.Tip="Aggiorna"><Path Classes="icon" Data="{StaticResource IconRefresh}"/></Button>
                                                            <Button Grid.Column="4" Classes="iconCircle" Click="OnLocalNewFolderClick" Margin="0,0,6,0" ToolTip.Tip="Nuova cartella"><Path Classes="icon" Data="{StaticResource IconPlus}"/></Button>
                                                            <ComboBox Grid.Column="5" ItemsSource="{Binding SortOptions}" SelectedItem="{Binding LocalSortOption, Mode=TwoWay}" MinWidth="110" Margin="0,0,6,0" ToolTip.Tip="Ordina per">
                                                                <ComboBox.ItemTemplate>
                                                                    <DataTemplate x:DataType="models:SortOption">
                                                                        <TextBlock Text="{Binding Label}"/>
                                                                    </DataTemplate>
                                                                </ComboBox.ItemTemplate>
                                                            </ComboBox>
                                                            <Button Grid.Column="6" Classes="iconCircle" Width="34" Command="{Binding ToggleLocalSortDirectionCommand}" ToolTip.Tip="Inverti direzione (crescente / decrescente)"><Panel><Path Classes="icon" Data="{StaticResource IconArrowUp}" IsVisible="{Binding LocalSortAscending}"/><Path Classes="icon" Data="{StaticResource IconArrowDown}" IsVisible="{Binding !LocalSortAscending}"/></Panel></Button>
                                                        </Grid>
                                                        <!-- Statistiche e stato sulla stessa riga, ad altezza fissa: la tabella non si sposta -->
                                                        <Grid Grid.Row="1" ColumnDefinitions="*, Auto" Margin="0,6,0,0" Height="18">
                                                            <TextBlock Text="{Binding LocalBrowserStats}" FontSize="11" Foreground="{DynamicResource AppTextMutedBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" Margin="10,0,0,0" IsVisible="{Binding HasLocalStatus}">
                                                                <Path Classes="icon accent" Width="12" Height="12" VerticalAlignment="Center" Data="{StaticResource IconRefresh}"/>
                                                                <TextBlock Text="{Binding LocalStatusText}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AppAccentBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="420"/>
                                                            </StackPanel>
                                                        </Grid>
                                                    </Grid>
                                                    <h:FillSlot>
                                                    <DataGrid Name="LocalFilesGrid" MinHeight="0" ItemsSource="{Binding SftpLocalEntries}" ScrollViewer.HorizontalScrollBarVisibility="Auto" SelectedItem="{Binding SftpSelectedLocalEntry, Mode=TwoWay}" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Extended" SelectionChanged="OnLocalFilesSelectionChanged" DoubleTapped="OnSftpLocalEntryDoubleTapped" KeyDown="OnLocalGridKeyDown" DragDrop.AllowDrop="True" DragDrop.DragOver="OnLocalGridDragOver" DragDrop.Drop="OnLocalGridDrop" CanUserResizeColumns="True" CanUserReorderColumns="True" CanUserSortColumns="False">
                                                        <!-- Un solo menu per tutta la tabella (prima uno per riga, ricreato a ogni riga
                                                             riciclata durante lo scorrimento: era la causa dei blocchi scorrendo veloce) -->
                                                        <DataGrid.ContextMenu>
                                                            <ContextMenu Opening="OnFileMenuOpening">
                                                                <MenuItem Header="Apri" Tag="dir" Click="OnLocalOpenClick"><MenuItem.Icon><Path Classes="icon" Data="{StaticResource IconFolder}"/></MenuItem.Icon></MenuItem>
                                                                <MenuItem Header="Anteprima video" Tag="video" Click="OnLocalPreviewClick"><MenuItem.Icon><Path Classes="icon" Data="{StaticResource IconPlayCircle}"/></MenuItem.Icon></MenuItem>
                                                                <Separator/>
                                                                <MenuItem Header="Rinomina" Click="OnLocalRenameClick"><MenuItem.Icon><Path Classes="icon" Data="{StaticResource IconEdit}"/></MenuItem.Icon></MenuItem>
                                                                <MenuItem Header="Duplica..." Click="OnLocalDuplicateClick"><MenuItem.Icon><Path Classes="icon" Data="{StaticResource IconCopy}"/></MenuItem.Icon></MenuItem>
                                                                <MenuItem Header="Sposta in..." Click="OnLocalMoveClick"><MenuItem.Icon><Path Classes="icon" Data="{StaticResource IconArrowLeft}"/></MenuItem.Icon></MenuItem>
                                                                <MenuItem Header="Elimina" Click="OnLocalDeleteClick"><MenuItem.Icon><Path Classes="icon" Data="{StaticResource IconTrash}"/></MenuItem.Icon></MenuItem>
                                                            </ContextMenu>
                                                        </DataGrid.ContextMenu>
                                                        <DataGrid.Columns>
                                                            <DataGridTemplateColumn Header=" " Width="40" CanUserResize="False">
                                                                <DataGridTemplateColumn.CellTemplate>
                                                                    <DataTemplate x:DataType="models:LocalFileEntry">
                                                                        <Panel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                                            <Path Classes="icon" Data="{StaticResource IconFolder}" Stroke="{DynamicResource AppWarningBrush}" IsVisible="{Binding IsDirectory}"/>
                                                                            <Path Classes="icon" Data="{StaticResource IconFile}" Stroke="{DynamicResource AppTextMutedBrush}" IsVisible="{Binding !IsDirectory}"/>
                                                                        </Panel>
                                                                    </DataTemplate>
                                                                </DataGridTemplateColumn.CellTemplate>
                                                            </DataGridTemplateColumn>
                                                            <DataGridTextColumn Header="Nome" Binding="{Binding Name}" Width="*" MinWidth="150"/>
                                                            <DataGridTextColumn Header="Dim." Binding="{Binding SizeText}" Width="Auto" MinWidth="70"/>
                                                            <DataGridTextColumn Header="Ultima modifica" Binding="{Binding Modified, StringFormat='{}{0:dd/MM/yyyy HH:mm}'}" Width="Auto" MinWidth="120"/>
                                                        </DataGrid.Columns>
                                                    </DataGrid>
                                                    </h:FillSlot>
                                                    </DockPanel>
                                                </Panel>
                                            </DockPanel>
                                        </Border>

                                        <!-- UPLOAD / DOWNLOAD -->
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="12" Width="130" Margin="10,0" IsVisible="{Binding IsLocalMode}">
                                            <Button Classes="success" Command="{Binding SftpUploadSelectedCommand}" Height="46" ToolTip.Tip="Carica i file/cartelle selezionate (o trascina)">
                                                <StackPanel Classes="bi" HorizontalAlignment="Center"><Path Classes="icon" Data="{StaticResource IconUpload}"/><TextBlock Text="Upload"/></StackPanel>
                                            </Button>
                                            <Button Classes="info" Command="{Binding SftpDownloadSelectedCommand}" Height="46" ToolTip.Tip="Scarica i file/cartelle selezionate (o trascina)">
                                                <StackPanel Classes="bi" HorizontalAlignment="Center"><Path Classes="icon" Data="{StaticResource IconDownload}"/><TextBlock Text="Download"/></StackPanel>
                                            </Button>
                                        </StackPanel>
                                        <!-- SERVER ↔ SERVER -->
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="12" Width="130" Margin="10,0" IsVisible="{Binding IsServer2Mode}">
                                            <Button Classes="success" Command="{Binding CopyServer2ToMainCommand}" IsEnabled="{Binding IsServer2Connected}" Height="46" ToolTip.Tip="Copia i file/cartelle selezionati a sinistra nella cartella aperta della scheda di destra">
                                                <StackPanel Classes="bi" HorizontalAlignment="Center"><TextBlock Text="Copia"/><Path Classes="icon" Data="{StaticResource IconArrowRight}"/></StackPanel>
                                            </Button>
                                            <Button Classes="info" Command="{Binding CopyMainToServer2Command}" IsEnabled="{Binding IsServer2Connected}" Height="46" ToolTip.Tip="Copia i file/cartelle selezionati a destra nella cartella aperta della scheda di sinistra">
                                                <StackPanel Classes="bi" HorizontalAlignment="Center"><Path Classes="icon" Data="{StaticResource IconArrowLeft}"/><TextBlock Text="Copia"/></StackPanel>
                                            </Button>
                                        </StackPanel>

                                        <!-- FILE REMOTI -->
                                        <Border Grid.Column="2" Classes="cardElevated" Margin="6,0,0,0">
                                            <DockPanel>
                                                <!-- Un server per scheda: si passa dall'uno all'altro, "+" ne apre un altro -->
                                                <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto, *" Margin="0,0,0,10">
                                                    <StackPanel Classes="bi" Margin="0,0,12,0" VerticalAlignment="Center">
                                                        <Path Classes="icon accent" Data="{StaticResource IconCloud}"/>
                                                        <TextBlock Text="File remoti" FontWeight="Bold" FontSize="14" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                    <ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                                                        <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right">
                                                            <ItemsControl ItemsSource="{Binding RemoteTabs}">
                                                                <ItemsControl.ItemsPanel>
                                                                    <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="6"/></ItemsPanelTemplate>
                                                                </ItemsControl.ItemsPanel>
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate x:DataType="vm:RemoteServerTab">
                                                                        <Border Classes="serverTab" Classes.active="{Binding IsActive}">
                                                                            <StackPanel Orientation="Horizontal">
                                                                                <Button Classes="ghost tabName" ToolTip.Tip="{Binding TabTooltip}"
                                                                                        Command="{Binding $parent[ItemsControl].((vm:SftpTabViewModel)DataContext).SelectRemoteTabCommand}" CommandParameter="{Binding}">
                                                                                    <StackPanel Classes="bi">
                                                                                        <Path Classes="icon" Data="{StaticResource IconCloud}"/>
                                                                                        <TextBlock Text="{Binding Name}" MaxWidth="150" TextTrimming="CharacterEllipsis"/>
                                                                                    </StackPanel>
                                                                                </Button>
                                                                                <Rectangle Classes="tabSep"/>
                                                                                <Button Classes="ghost tabClose" ToolTip.Tip="{Binding Name, StringFormat='Disconnetti {0} e chiudi la sua scheda'}"
                                                                                        Command="{Binding $parent[ItemsControl].((vm:SftpTabViewModel)DataContext).CloseRemoteTabCommand}" CommandParameter="{Binding}">
                                                                                    <Path Classes="icon" Data="{StaticResource IconBoltOff}"/>
                                                                                </Button>
                                                                            </StackPanel>
                                                                        </Border>
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                            <Button Padding="10,4" FontSize="12" Classes.accent="{Binding IsAddingRemoteTab}" Command="{Binding AddRemoteTabCommand}" ToolTip.Tip="Apri un altro server SFTP in una nuova scheda">
                                                                <StackPanel Classes="bi"><Path Classes="icon" Data="{StaticResource IconPlus}"/><TextBlock Text="Connetti server"/></StackPanel>
                                                            </Button>
                                                        </StackPanel>
                                                    </ScrollViewer>
                                                </Grid>

                                                <!-- Pannello di destra: file della scheda aperta, oppure il riquadro per connettere un server -->
                                                <Panel>
                                                    <!-- ===== File del server della scheda aperta ===== -->
                                                    <DockPanel IsVisible="{Binding ShowRemoteBrowser}">
                                                    <Grid DockPanel.Dock="Top" RowDefinitions="Auto,Auto" Margin="0,0,0,8">
                                                        <Grid Grid.Row="0" ColumnDefinitions="Auto, Auto, *, Auto, Auto, Auto, Auto, Auto, Auto">
                                                            <Button Grid.Column="0" Classes="iconCircle" Command="{Binding SftpGoUpCommand}" Margin="0,0,6,0" ToolTip.Tip="Indietro"><Path Classes="icon" Data="{StaticResource IconArrowLeft}"/></Button>
                                                            <Button Grid.Column="1" Classes="iconCircle" Command="{Binding SftpGoHomeCommand}" Margin="0,0,6,0" ToolTip.Tip="Home"><Path Classes="icon" Data="{StaticResource IconHome}"/></Button>
                                                            <TextBox Grid.Column="2" Text="{Binding SftpCurrentRemotePath}" Margin="0,0,6,0"/>
                                                            <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="4" Margin="0,0,6,0">
                                                                <Button Classes="iconCircle" Click="OnSftpRefreshClick" IsEnabled="{Binding !IsRefreshingRemote}" ToolTip.Tip="Aggiorna"><Path Classes="icon" Data="{StaticResource IconRefresh}"/></Button>
                                                                <Button Classes="iconCircle" Command="{Binding SftpForceReloadCommand}" IsEnabled="{Binding !IsRefreshingRemote}" ToolTip.Tip="Forza ricarica (riconnette al server)"><Path Classes="icon" Data="{StaticResource IconRepeat}"/></Button>
                                                            </StackPanel>
                                                            <Button Grid.Column="4" Classes="iconCircle" Click="OnRemoteNewFolderClick" Margin="0,0,6,0" ToolTip.Tip="Nuova cartella"><Path Classes="icon" Data="{StaticResource IconPlus}"/></Button>
                                                            <StackPanel Grid.Column="5" Orientation="Horizontal" Spacing="4" Margin="0,0,6,0">
                                                                <Button Classes="iconCircle" Command="{Binding CheckZeroByteFoldersCommand}" IsEnabled="{Binding !IsCheckingZeroByte}" ToolTip.Tip="Analizza la cartella remota per trovare file vuoti (0 byte) da eliminare"><Path Classes="icon" Data="{StaticResource IconSearch}"/></Button>
                                                                <Button Classes="iconCircle danger" Command="{Binding StopZeroByteCheckCommand}" IsVisible="{Binding IsCheckingZeroByte}" ToolTip.Tip="Ferma il check in corso"><Path Classes="icon" Data="{StaticResource IconStop}"/></Button>
                                                            </StackPanel>
                                                            <ComboBox Grid.Column="6" ItemsSource="{Binding SortOptions}" SelectedItem="{Binding RemoteSortOption, Mode=TwoWay}" MinWidth="110" Margin="0,0,6,0" ToolTip.Tip="Ordina per">
                                                                <ComboBox.ItemTemplate>
                                                                    <DataTemplate x:DataType="models:SortOption">
                                                                        <TextBlock Text="{Binding Label}"/>
                                                                    </DataTemplate>
                                                                </ComboBox.ItemTemplate>
                                                            </ComboBox>
                                                            <Button Grid.Column="7" Classes="iconCircle" Width="34" Command="{Binding ToggleRemoteSortDirectionCommand}" ToolTip.Tip="Inverti direzione (crescente / decrescente)"><Panel><Path Classes="icon" Data="{StaticResource IconArrowUp}" IsVisible="{Binding RemoteSortAscending}"/><Path Classes="icon" Data="{StaticResource IconArrowDown}" IsVisible="{Binding !RemoteSortAscending}"/></Panel></Button>
                                                            <Button Grid.Column="8" Classes="iconCircle danger" Margin="6,0,0,0" Command="{Binding DisconnectActiveRemoteTabCommand}" ToolTip.Tip="Disconnetti il server di questa scheda e chiudi la scheda"><Path Classes="icon" Data="{StaticResource IconBoltOff}"/></Button>
                                                        </Grid>
                                                        <!-- Statistiche e stato sulla stessa riga, ad altezza fissa: la tabella non si sposta -->
                                                        <Grid Grid.Row="1" ColumnDefinitions="*, Auto" Margin="0,6,0,0" Height="18">
                                                            <TextBlock Text="{Binding RemoteBrowserStats}" FontSize="11" Foreground="{DynamicResource AppTextMutedBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" Margin="10,0,0,0" IsVisible="{Binding HasRemoteStatus}">
                                                                <Panel VerticalAlignment="Center"><Path Classes="icon accent" Width="12" Height="12" Data="{StaticResource IconSearch}" IsVisible="{Binding IsCheckingZeroByte}"/><Path Classes="icon accent" Width="12" Height="12" Data="{StaticResource IconRefresh}" IsVisible="{Binding !IsCheckingZeroByte}"/></Panel>
                                                                <TextBlock Text="{Binding RemoteStatusText}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AppAccentBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="420"/>
                                                            </StackPanel>
                                                        </Grid>
                                                    </Grid>

                                                    <h:FillSlot>
                                                    <DataGrid Name="RemoteFilesGrid" MinHeight="0" ItemsSource="{Binding SftpRemoteEntries}" ScrollViewer.HorizontalScrollBarVisibility="Auto" SelectedItem="{Binding SftpSelectedRemoteEntry, Mode=TwoWay}" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Extended" SelectionChanged="OnRemoteFilesSelectionChanged" DoubleTapped="OnSftpEntryDoubleTapped" KeyDown="OnRemoteGridKeyDown" DragDrop.AllowDrop="True" DragDrop.DragOver="OnRemoteGridDragOver" DragDrop.Drop="OnRemoteGridDrop" CanUserResizeColumns="True" CanUserReorderColumns="True" CanUserSortColumns="False">
                                                        <DataGrid.Styles>
                                                            <Style Selector="DataGridRow" x:DataType="models:SftpRemoteEntry">
                                                                <Setter Property="Classes.zeroByte" Value="{Binding HasZeroByteIssue}"/>
                                                            </Style>
                                                        </DataGrid.Styles>
                                                        <DataGrid.ContextMenu>
                                                            <ContextMenu Opening="OnFileMenuOpening">
                                                                <MenuItem Header="Apri" Tag="dir" Click="OnRemoteOpenClick"><MenuItem.Icon><Path Classes="icon" Data="{StaticResource IconFolder}"/></MenuItem.Icon></MenuItem>
                                                                <MenuItem Header="Anteprima video" Tag="video" Click="OnRemotePreviewClick"><MenuItem.Icon><Path Classes="icon" Data="{StaticResource IconPlayCircle}"/></MenuItem.Icon></MenuItem>
                                                                <Separator/>
                                                                <MenuItem Header="Rinomina" Click="OnRemoteRenameClick"><MenuItem.Icon><Path Classes="icon" Data="{StaticResource IconEdit}"/></MenuItem.Icon></MenuItem>
                                                                <MenuItem Header="Duplica..." Click="OnRemoteDuplicateClick"><MenuItem.Icon><Path Classes="icon" Data="{StaticResource IconCopy}"/></MenuItem.Icon></MenuItem>
                                                                <MenuItem Header="Sposta in..." Click="OnRemoteMoveClick"><MenuItem.Icon><Path Classes="icon" Data="{StaticResource IconArrowLeft}"/></MenuItem.Icon></MenuItem>
                                                                <MenuItem Header="Copia nella scheda di sinistra" Click="OnRemoteCopyToServer2Click" IsVisible="{Binding IsServer2Connected}"><MenuItem.Icon><Path Classes="icon" Data="{StaticResource IconRepeat}"/></MenuItem.Icon></MenuItem>
                                                                <MenuItem Header="Elimina" Click="OnRemoteDeleteClick"><MenuItem.Icon><Path Classes="icon" Data="{StaticResource IconTrash}"/></MenuItem.Icon></MenuItem>
                                                            </ContextMenu>
                                                        </DataGrid.ContextMenu>
                                                        <DataGrid.Columns>
                                                            <DataGridTemplateColumn Header=" " Width="40" CanUserResize="False">
                                                                <DataGridTemplateColumn.CellTemplate>
                                                                    <DataTemplate x:DataType="models:SftpRemoteEntry">
                                                                        <Panel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                                            <Path Classes="icon" Data="{StaticResource IconFolder}" Stroke="{DynamicResource AppWarningBrush}" IsVisible="{Binding IsDirectory}"/>
                                                                            <Path Classes="icon" Data="{StaticResource IconFile}" Stroke="{DynamicResource AppTextMutedBrush}" IsVisible="{Binding !IsDirectory}"/>
                                                                        </Panel>
                                                                    </DataTemplate>
                                                                </DataGridTemplateColumn.CellTemplate>
                                                            </DataGridTemplateColumn>
                                                            <DataGridTextColumn Header="Nome" Binding="{Binding Name}" Width="*" MinWidth="150"/>
                                                            <DataGridTextColumn Header="Contenuto" Binding="{Binding ContentsInfo}" Width="Auto" MinWidth="100"/>
                                                            <DataGridTextColumn Header="Dim." Binding="{Binding SizeText}" Width="Auto" MinWidth="70"/>
                                                            <DataGridTextColumn Header="Ultima modifica" Binding="{Binding Modified, StringFormat='{}{0:dd/MM/yyyy HH:mm}'}" Width="Auto" MinWidth="120"/>
                                                        </DataGrid.Columns>
                                                    </DataGrid>
                                                    </h:FillSlot>
                                                    </DockPanel>
                                                    <ScrollViewer IsVisible="{Binding ShowRemoteConnect}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                                        <Border MaxWidth="520" Margin="0,16" Padding="24,22" HorizontalAlignment="Center" VerticalAlignment="Center" CornerRadius="16"
                                                                Background="{DynamicResource AppInputBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1">
                                                            <StackPanel Spacing="14">
                                                                <Border Width="56" Height="56" CornerRadius="28" HorizontalAlignment="Center" Background="{DynamicResource AppAccentSoftBrush}">
                                                                    <Path Classes="icon accent" Width="26" Height="26" Data="{StaticResource IconCloud}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                </Border>
                                                                <StackPanel Spacing="4">
                                                                    <TextBlock Text="Connetti un server SFTP" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center"/>
                                                                    <TextBlock Text="Ogni server aperto diventa una scheda qui sopra: passi dall'uno all'altro con un clic e carichi file diversi su server diversi." FontSize="12" TextWrapping="Wrap" TextAlignment="Center" Foreground="{DynamicResource AppTextMutedBrush}"/>
                                                                </StackPanel>
                                                                <ItemsControl ItemsSource="{Binding SftpProfiles}" IsEnabled="{Binding !IsRemoteConnecting}">
                                                                    <ItemsControl.ItemsPanel>
                                                                        <ItemsPanelTemplate><StackPanel Spacing="8"/></ItemsPanelTemplate>
                                                                    </ItemsControl.ItemsPanel>
                                                                    <ItemsControl.ItemTemplate>
                                                                        <DataTemplate x:DataType="models:SftpConfig">
                                                                            <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="14,10"
                                                                                    Command="{Binding $parent[ItemsControl].((vm:SftpTabViewModel)DataContext).ConnectProfileCommand}" CommandParameter="{Binding}" ToolTip.Tip="Connetti a questo server">
                                                                                <Grid ColumnDefinitions="Auto, *, Auto">
                                                                                    <Path Classes="icon accent" Width="18" Height="18" Data="{StaticResource IconCloud}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                                                                    <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                                                                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                                                        <TextBlock Text="{Binding Host}" FontSize="11" Foreground="{DynamicResource AppTextMutedBrush}" TextTrimming="CharacterEllipsis"/>
                                                                                    </StackPanel>
                                                                                    <StackPanel Grid.Column="2" Classes="bi" VerticalAlignment="Center" Margin="12,0,0,0">
                                                                                        <Path Classes="icon accent" Data="{StaticResource IconPlug}"/>
                                                                                        <TextBlock Text="Connetti" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource AppAccentBrush}"/>
                                                                                    </StackPanel>
                                                                                </Grid>
                                                                            </Button>
                                                                        </DataTemplate>
                                                                    </ItemsControl.ItemTemplate>
                                                                </ItemsControl>
                                                                <TextBlock IsVisible="{Binding !HasSftpProfiles}" FontSize="12" TextWrapping="Wrap" TextAlignment="Center" Foreground="{DynamicResource AppWarningBrush}"
                                                                           Text="Nessun profilo salvato: creane uno in &quot;Configurazione connessione SFTP&quot; qui sopra."/>
                                                                <ProgressBar IsIndeterminate="True" Height="4" MinWidth="0" IsVisible="{Binding IsRemoteConnecting}"/>
                                                                <Button HorizontalAlignment="Center" Command="{Binding CancelAddRemoteTabCommand}" IsVisible="{Binding CanCancelAddTab}" ToolTip.Tip="Torna alla scheda aperta">
                                                                    <TextBlock Text="Annulla"/>
                                                                </Button>
                                                                <TextBlock FontSize="11" TextWrapping="Wrap" TextAlignment="Center" Foreground="{DynamicResource AppTextMutedBrush}"
                                                                           Text="I profili si creano e si modificano in &quot;Configurazione connessione SFTP&quot; qui sopra."/>
                                                            </StackPanel>
                                                        </Border>
                                                    </ScrollViewer>
                                                </Panel>
                                            </DockPanel>
                                        </Border>
                                    </Grid>
                                </Panel>
                                <Panel IsVisible="{Binding #SftpTabs.SelectedIndex, Converter={x:Static vm:IndexEqualsConverter.Default}, ConverterParameter=1}">
                                    <DockPanel Margin="0,10,0,0">
                                        <Border DockPanel.Dock="Top" Classes="cardElevated" Margin="0,0,0,12">
                                            <StackPanel Spacing="10">
                                                <Grid ColumnDefinitions="Auto, *, Auto">
                                                    <TextBlock Grid.Column="0" Text="Cartella locale (upload rapido):" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                                    <TextBox Grid.Column="1" Text="{Binding SftpUploadLocalFolder}" Margin="0,0,8,0"/>
                                                    <Button Grid.Column="2" Classes="iconCircle" Click="OnBrowseSftpUploadLocalClick" ToolTip.Tip="Sfoglia"><Path Classes="icon" Data="{StaticResource IconFolder}"/></Button>
                                                </Grid>
                                                <Grid ColumnDefinitions="Auto, *">
                                                    <TextBlock Grid.Column="0" Text="Cartella remota:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                                    <TextBox Grid.Column="1" Text="{Binding SftpUploadRemoteFolder}"/>
                                                </Grid>
                                                <StackPanel Orientation="Horizontal" Spacing="10">
                                                    <TextBlock Text="Upload paralleli:" VerticalAlignment="Center"/>
                                                    <Slider Value="{Binding SftpMaxUploadConcurrency}" Minimum="1" Maximum="16" Width="140" TickFrequency="1" IsSnapToTickEnabled="True"/>
                                                    <TextBlock Text="{Binding SftpMaxUploadConcurrency}" Width="28" VerticalAlignment="Center" FontWeight="Bold" Foreground="{DynamicResource AppAccentBrush}"/>
                                                </StackPanel>
                                                <TextBlock Text="{Binding UploadQueueStats}" FontSize="11" Foreground="{DynamicResource AppTextMutedBrush}" FontStyle="Italic"/>
                                                <WrapPanel Orientation="Horizontal" ItemSpacing="8" LineSpacing="6">
                                                    <Button ToolTip.Tip="Accoda l'upload della cartella locale scelta nella cartella remota di destinazione" Classes="info" Command="{Binding SftpEnqueueFolderCommand}"><StackPanel Classes="bi"><Path Classes="icon" Data="{StaticResource IconQueue}"/><TextBlock Text="Accoda cartella"/></StackPanel></Button>
                                                    <Button ToolTip.Tip="Avvia tutti gli upload in attesa o in pausa" Classes="success" Command="{Binding SftpQueueStartAllCommand}"><StackPanel Classes="bi"><Path Classes="icon" Data="{StaticResource IconPlay}"/><TextBlock Text="Avvia tutti"/></StackPanel></Button>
                                                    <Button ToolTip.Tip="Mette in pausa tutti gli upload in corso" Classes="warning" Command="{Binding SftpQueuePauseAllCommand}"><StackPanel Classes="bi"><Path Classes="icon" Data="{StaticResource IconPause}"/><TextBlock Text="Pausa tutti"/></StackPanel></Button>
                                                    <Button ToolTip.Tip="Annulla tutti gli upload non ancora completati" Classes="danger" Command="{Binding SftpQueueCancelAllCommand}"><StackPanel Classes="bi"><Path Classes="icon" Data="{StaticResource IconClose}"/><TextBlock Text="Annulla tutti"/></StackPanel></Button>
                                                    <Border Width="1" Height="26" Background="{DynamicResource AppBorderBrush}" Margin="6,0" VerticalAlignment="Center"/>
                                                    <Button ToolTip.Tip="Togli dalla lista completati, annullati o falliti (i file restano dove sono). «Elimina tutto» è in fondo al menu e chiede conferma.">
                                                        <StackPanel Classes="bi"><Path Classes="icon" Data="{StaticResource IconTrash}"/><TextBlock Text="Pulisci lista"/><Path Classes="icon" Data="{StaticResource IconChevronDownSmall}" Width="10" Height="10" Margin="2,0,0,0"/></StackPanel>
                                                        <Button.Flyout>
                                                            <MenuFlyout Placement="BottomEdgeAlignedLeft">
                                                                <MenuItem Header="Rimuovi completati" Command="{Binding SftpQueueClearCompletedCommand}"><MenuItem.Icon><Path Classes="icon" Data="{StaticResource IconCheckCircle}"/></MenuItem.Icon></MenuItem>
                                                                <MenuItem Header="Rimuovi annullati" Command="{Binding SftpQueueClearCancelledCommand}"><MenuItem.Icon><Path Classes="icon" Data="{StaticResource IconBan}"/></MenuItem.Icon></MenuItem>
                                                                <MenuItem Header="Rimuovi falliti" Command="{Binding SftpQueueClearFailedCommand}"><MenuItem.Icon><Path Classes="icon" Data="{StaticResource IconAlertCircle}"/></MenuItem.Icon></MenuItem>
                                                                <Separator/>
                                                                <MenuItem Classes="dangerItem" Header="Elimina tutto…" Tag="{Binding SftpQueueRemoveAllCommand}" CommandParameter="Fermare e togliere dalla lista TUTTI gli upload, anche quelli in corso e in coda? I file già caricati restano sul server." Click="OnConfirmRemoveAllClick"><MenuItem.Icon><Path Classes="icon" Data="{StaticResource IconTrash}"/></MenuItem.Icon></MenuItem>
                                                            </MenuFlyout>
                                                        </Button.Flyout>
                                                    </Button>
                                                </WrapPanel>
                                            </StackPanel>
                                        </Border>
                                        <Border Classes="cardElevated">
                                            <h:FillSlot>
                                            <DataGrid MinHeight="0" ItemsSource="{Binding SftpUploadJobs}" AutoGenerateColumns="False" IsReadOnly="True" CanUserResizeColumns="True" CanUserReorderColumns="True" CanUserSortColumns="False">
                                                <DataGrid.ContextMenu>
                                                    <ContextMenu>
                                                        <MenuItem Header="Avvia / Riprendi" Click="OnSftpJobResumeClick"><MenuItem.Icon><Path Classes="icon" Data="{StaticResource IconPlay}"/></MenuItem.Icon></MenuItem>
                                                        <MenuItem Header="Pausa" Click="OnSftpJobPauseClick"><MenuItem.Icon><Path Classes="icon" Data="{StaticResource IconPause}"/></MenuItem.Icon></MenuItem>
                                                        <MenuItem Header="Annulla" Click="OnSftpJobCancelClick"><MenuItem.Icon><Path Classes="icon" Data="{StaticResource IconClose}"/></MenuItem.Icon></MenuItem>
                                                        <Separator/>
                                                        <MenuItem Header="Rimuovi" Click="OnSftpJobRemoveClick"><MenuItem.Icon><Path Classes="icon" Data="{StaticResource IconTrash}"/></MenuItem.Icon></MenuItem>
                                                    </ContextMenu>
                                                </DataGrid.ContextMenu>
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="File" Binding="{Binding FileName}" Width="2*"/>
                                                    <DataGridTextColumn Header="Server" Binding="{Binding ServerName}" Width="130"/>
                                                    <DataGridTextColumn Header="Da" Binding="{Binding SourceFolder}" Width="2*"/>
                                                    <DataGridTextColumn Header="A" Binding="{Binding DestinationFolder}" Width="2*"/>
                                                    <DataGridTextColumn Header="Stato" Binding="{Binding Status}" Width="100"/>
                                                    <DataGridTemplateColumn Header="Progresso" Width="2*">
                                                        <DataGridTemplateColumn.CellTemplate>
                                                            <DataTemplate>
                                                                <Grid ColumnDefinitions="*, Auto" Margin="2">
                                                                    <ProgressBar Grid.Column="0" Value="{Binding Percentage}" Minimum="0" Maximum="100" Height="14" Classes.done="{Binding IsCompleted}" Classes.failed="{Binding IsFailed}" Classes.paused="{Binding IsPaused}" Classes.queued="{Binding IsQueued}" Classes.cancelled="{Binding IsCancelled}"/>
                                                                    <TextBlock Grid.Column="1" Text="{Binding Percentage, StringFormat={}{0:F0}%}" Margin="8,0,0,0" VerticalAlignment="Center" FontSize="11"/>
                                                                </Grid>
                                                            </DataTemplate>
                                                        </DataGridTemplateColumn.CellTemplate>
                                                    </DataGridTemplateColumn>
                                                    <DataGridTextColumn Header="Dimensione" Binding="{Binding SizeText}" Width="150"/>
                                                    <DataGridTextColumn Header="Velocità" Binding="{Binding SpeedText}" Width="100"/>
                                                    <DataGridTextColumn Header="ETA" Binding="{Binding EtaText}" Width="100"/>
                                                    <DataGridTemplateColumn Header="Azioni" Width="Auto">
                                                        <DataGridTemplateColumn.CellTemplate>
                                                            <DataTemplate>
                                                                <StackPanel Orientation="Horizontal" Spacing="4" Margin="4,2" VerticalAlignment="Center">
                                                                    <Button Classes="iconCircle success" Width="26" Height="26" ToolTip.Tip="Riprendi" IsVisible="{Binding CanResume}" Click="OnSftpJobResumeClick"><Path Classes="icon" Width="12" Height="12" Data="{StaticResource IconPlay}"/></Button>
                                                                    <Button Classes="iconCircle warning" Width="26" Height="26" ToolTip.Tip="Pausa" IsVisible="{Binding CanPause}" Click="OnSftpJobPauseClick"><Path Classes="icon" Width="12" Height="12" Data="{StaticResource IconPause}"/></Button>
                                                                    <Button Classes="iconCircle danger" Width="26" Height="26" ToolTip.Tip="Annulla" IsVisible="{Binding CanCancel}" Click="OnSftpJobCancelClick"><Path Classes="icon" Width="12" Height="12" Data="{StaticResource IconClose}"/></Button>
                                                                    <Button Classes="iconCircle" Width="26" Height="26" ToolTip.Tip="Riprova (upload da capo)" IsVisible="{Binding CanRetry}" Click="OnSftpJobResumeClick"><Path Classes="icon" Width="12" Height="12" Data="{StaticResource IconRefresh}"/></Button>
                                                                    <Button Classes="iconCircle danger" Width="26" Height="26" ToolTip.Tip="Rimuovi dalla lista" Click="OnSftpJobRemoveClick"><Path Classes="icon" Width="12" Height="12" Data="{StaticResource IconTrash}"/></Button>
                                                                </StackPanel>
                                                            </DataTemplate>
                                                        </DataGridTemplateColumn.CellTemplate>
                                                    </DataGridTemplateColumn>
                                                </DataGrid.Columns>
                                            </DataGrid>
                                            </h:FillSlot>
                                        </Border>
                                    </DockPanel>
                                </Panel>
                                <Panel IsVisible="{Binding #SftpTabs.SelectedIndex, Converter={x:Static vm:IndexEqualsConverter.Default}, ConverterParameter=2}">
                                    <DockPanel Margin="0,10,0,0">
                                        <Border DockPanel.Dock="Top" Classes="cardElevated" Margin="0,0,0,12">
                                            <StackPanel Spacing="10">
                                                <Grid ColumnDefinitions="Auto, *, Auto">
                                                    <TextBlock Grid.Column="0" Text="Cartella locale (destinazione):" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                                    <TextBox Grid.Column="1" Text="{Binding SftpDownloadLocalFolder}" PlaceholderText="(default: cartella locale corrente)" Margin="0,0,8,0"/>
                                                    <Button Grid.Column="2" Classes="iconCircle" Click="OnBrowseSftpDownloadLocalClick" ToolTip.Tip="Sfoglia"><Path Classes="icon" Data="{StaticResource IconFolder}"/></Button>
                                                </Grid>
                                                <StackPanel Orientation="Horizontal" Spacing="10">
                                                    <TextBlock Text="Download paralleli:" VerticalAlignment="Center"/>
                                                    <Slider Value="{Binding SftpMaxDownloadConcurrency}" Minimum="1" Maximum="16" Width="140" TickFrequency="1" IsSnapToTickEnabled="True"/>
                                                    <TextBlock Text="{Binding SftpMaxDownloadConcurrency}" Width="28" VerticalAlignment="Center" FontWeight="Bold" Foreground="{DynamicResource AppAccentBrush}"/>
                                                </StackPanel>
                                                <TextBlock Text="{Binding DownloadQueueStats}" FontSize="11" Foreground="{DynamicResource AppTextMutedBrush}" FontStyle="Italic"/>
                                                <WrapPanel Orientation="Horizontal" ItemSpacing="8" LineSpacing="6">
                                                    <Button ToolTip.Tip="Avvia tutti i download SFTP in attesa o in pausa" Classes="success" Command="{Binding SftpDownloadQueueStartAllCommand}"><StackPanel Classes="bi"><Path Classes="icon" Data="{StaticResource IconPlay}"/><TextBlock Text="Avvia tutti"/></StackPanel></Button>
                                                    <Button ToolTip.Tip="Mette in pausa tutti i download SFTP in corso" Classes="warning" Command="{Binding SftpDownloadQueuePauseAllCommand}"><StackPanel Classes="bi"><Path Classes="icon" Data="{StaticResource IconPause}"/><TextBlock Text="Pausa tutti"/></StackPanel></Button>
                                                    <Button ToolTip.Tip="Annulla tutti i download SFTP non ancora completati" Classes="danger" Command="{Binding SftpDownloadQueueCancelAllCommand}"><StackPanel Classes="bi"><Path Classes="icon" Data="{StaticResource IconClose}"/><TextBlock Text="Annulla tutti"/></StackPanel></Button>
                                                    <Border Width="1" Height="26" Background="{DynamicResource AppBorderBrush}" Margin="6,0" VerticalAlignment="Center"/>
                                                    <Button ToolTip.Tip="Togli dalla lista completati, annullati o falliti (i file restano dove sono). «Elimina tutto» è in fondo al menu e chiede conferma.">
                                                        <StackPanel Classes="bi"><Path Classes="icon" Data="{StaticResource IconTrash}"/><TextBlock Text="Pulisci lista"/><Path Classes="icon" Data="{StaticResource IconChevronDownSmall}" Width="10" Height="10" Margin="2,0,0,0"/></StackPanel>
                                                        <Button.Flyout>
                                                            <MenuFlyout Placement="BottomEdgeAlignedLeft">
                                                                <MenuItem Header="Rimuovi completati" Command="{Binding SftpDownloadQueueClearCompletedCommand}"><MenuItem.Icon><Path Classes="icon" Data="{StaticResource IconCheckCircle}"/></MenuItem.Icon></MenuItem>
                                                                <MenuItem Header="Rimuovi annullati" Command="{Binding SftpDownloadQueueClearCancelledCommand}"><MenuItem.Icon><Path Classes="icon" Data="{StaticResource IconBan}"/></MenuItem.Icon></MenuItem>
                                                                <MenuItem Header="Rimuovi falliti" Command="{Binding SftpDownloadQueueClearFailedCommand}"><MenuItem.Icon><Path Classes="icon" Data="{StaticResource IconAlertCircle}"/></MenuItem.Icon></MenuItem>
                                                                <Separator/>
                                                                <MenuItem Classes="dangerItem" Header="Elimina tutto…" Tag="{Binding SftpDownloadQueueRemoveAllCommand}" CommandParameter="Fermare e togliere dalla lista TUTTI i download SFTP, anche quelli in corso e in coda? I file già scaricati restano su disco." Click="OnConfirmRemoveAllClick"><MenuItem.Icon><Path Classes="icon" Data="{StaticResource IconTrash}"/></MenuItem.Icon></MenuItem>
                                                            </MenuFlyout>
                                                        </Button.Flyout>
                                                    </Button>
                                                </WrapPanel>
                                            </StackPanel>
                                        </Border>
                                        <Border Classes="cardElevated">
                                            <h:FillSlot>
                                            <DataGrid MinHeight="0" ItemsSource="{Binding SftpDownloadJobs}" AutoGenerateColumns="False" IsReadOnly="True" CanUserResizeColumns="True" CanUserReorderColumns="True" CanUserSortColumns="False">
                                                <DataGrid.ContextMenu>
                                                    <ContextMenu>
                                                        <MenuItem Header="Avvia / Riprendi" Click="OnSftpDownloadJobResumeClick"><MenuItem.Icon><Path Classes="icon" Data="{StaticResource IconPlay}"/></MenuItem.Icon></MenuItem>
                                                        <MenuItem Header="Pausa" Click="OnSftpDownloadJobPauseClick"><MenuItem.Icon><Path Classes="icon" Data="{StaticResource IconPause}"/></MenuItem.Icon></MenuItem>
                                                        <MenuItem Header="Annulla" Click="OnSftpDownloadJobCancelClick"><MenuItem.Icon><Path Classes="icon" Data="{StaticResource IconClose}"/></MenuItem.Icon></MenuItem>
                                                        <Separator/>
                                                        <MenuItem Header="Rimuovi" Click="OnSftpDownloadJobRemoveClick"><MenuItem.Icon><Path Classes="icon" Data="{StaticResource IconTrash}"/></MenuItem.Icon></MenuItem>
                                                    </ContextMenu>
                                                </DataGrid.ContextMenu>
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="File" Binding="{Binding FileName}" Width="2*"/>
                                                    <DataGridTextColumn Header="Server" Binding="{Binding ServerName}" Width="130"/>
                                                    <DataGridTextColumn Header="Da" Binding="{Binding SourceFolder}" Width="2*"/>
                                                    <DataGridTextColumn Header="A" Binding="{Binding DestinationFolder}" Width="2*"/>
                                                    <DataGridTextColumn Header="Stato" Binding="{Binding Status}" Width="100"/>
                                                    <DataGridTemplateColumn Header="Progresso" Width="2*">
                                                        <DataGridTemplateColumn.CellTemplate>
                                                            <DataTemplate>
                                                                <Grid ColumnDefinitions="*, Auto" Margin="2">
                                                                    <ProgressBar Grid.Column="0" Value="{Binding Percentage}" Minimum="0" Maximum="100" Height="14" Classes.done="{Binding IsCompleted}" Classes.failed="{Binding IsFailed}" Classes.paused="{Binding IsPaused}" Classes.queued="{Binding IsQueued}" Classes.cancelled="{Binding IsCancelled}"/>
                                                                    <TextBlock Grid.Column="1" Text="{Binding Percentage, StringFormat={}{0:F0}%}" Margin="8,0,0,0" VerticalAlignment="Center" FontSize="11"/>
                                                                </Grid>
                                                            </DataTemplate>
                                                        </DataGridTemplateColumn.CellTemplate>
                                                    </DataGridTemplateColumn>
                                                    <DataGridTextColumn Header="Dimensione" Binding="{Binding SizeText}" Width="150"/>
                                                    <DataGridTextColumn Header="Velocità" Binding="{Binding SpeedText}" Width="100"/>
                                                    <DataGridTextColumn Header="ETA" Binding="{Binding EtaText}" Width="100"/>
                                                    <DataGridTemplateColumn Header="Azioni" Width="Auto">
                                                        <DataGridTemplateColumn.CellTemplate>
                                                            <DataTemplate>
                                                                <StackPanel Orientation="Horizontal" Spacing="4" Margin="4,2" VerticalAlignment="Center">
                                                                    <Button Classes="iconCircle success" Width="26" Height="26" ToolTip.Tip="Riprendi" IsVisible="{Binding CanResume}" Click="OnSftpDownloadJobResumeClick"><Path Classes="icon" Width="12" Height="12" Data="{StaticResource IconPlay}"/></Button>
                                                                    <Button Classes="iconCircle warning" Width="26" Height="26" ToolTip.Tip="Pausa" IsVisible="{Binding CanPause}" Click="OnSftpDownloadJobPauseClick"><Path Classes="icon" Width="12" Height="12" Data="{StaticResource IconPause}"/></Button>
                                                                    <Button Classes="iconCircle danger" Width="26" Height="26" ToolTip.Tip="Annulla" IsVisible="{Binding CanCancel}" Click="OnSftpDownloadJobCancelClick"><Path Classes="icon" Width="12" Height="12" Data="{StaticResource IconClose}"/></Button>
                                                                    <Button Classes="iconCircle" Width="26" Height="26" ToolTip.Tip="Riprova (download da capo)" IsVisible="{Binding CanRetry}" Click="OnSftpDownloadJobResumeClick"><Path Classes="icon" Width="12" Height="12" Data="{StaticResource IconRefresh}"/></Button>
                                                                    <Button Classes="iconCircle danger" Width="26" Height="26" ToolTip.Tip="Rimuovi dalla lista" Click="OnSftpDownloadJobRemoveClick"><Path Classes="icon" Width="12" Height="12" Data="{StaticResource IconTrash}"/></Button>
                                                                </StackPanel>
                                                            </DataTemplate>
                                                        </DataGridTemplateColumn.CellTemplate>
                                                    </DataGridTemplateColumn>
                                                </DataGrid.Columns>
                                            </DataGrid>
                                            </h:FillSlot>
                                        </Border>
                                    </DockPanel>
                                </Panel>
                                <Panel IsVisible="{Binding #SftpTabs.SelectedIndex, Converter={x:Static vm:IndexEqualsConverter.Default}, ConverterParameter=3}">
                                    <DockPanel Margin="0,10,0,0">
                                        <Border DockPanel.Dock="Top" Classes="cardElevated" Margin="0,0,0,12">
                                            <StackPanel Spacing="10">
                                                <TextBlock Text="Copie da un server SFTP a un altro. Nel Browser apri un server anche nel pannello di sinistra (&quot;+ Connetti server&quot;), seleziona i file e usa le frecce al centro. I dati passano dal PC in streaming (letti da un server e scritti sull'altro insieme): niente file temporanei, ma la velocità dipende dalla tua connessione." FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource AppTextMutedBrush}"/>
                                                <StackPanel Orientation="Horizontal" Spacing="10">
                                                    <TextBlock Text="Copie parallele:" VerticalAlignment="Center"/>
                                                    <Slider Value="{Binding SftpMaxRelayConcurrency}" Minimum="1" Maximum="8" Width="140" TickFrequency="1" IsSnapToTickEnabled="True"/>
                                                    <TextBlock Text="{Binding SftpMaxRelayConcurrency}" Width="28" VerticalAlignment="Center" FontWeight="Bold" Foreground="{DynamicResource AppAccentBrush}"/>
                                                </StackPanel>
                                                <TextBlock Text="{Binding RelayQueueStats}" FontSize="11" Foreground="{DynamicResource AppTextMutedBrush}" FontStyle="Italic"/>
                                                <WrapPanel Orientation="Horizontal" ItemSpacing="8" LineSpacing="6">
                                                    <Button ToolTip.Tip="Avvia tutte le copie in attesa, in pausa o fallite" Classes="success" Command="{Binding RelayQueueStartAllCommand}"><StackPanel Classes="bi"><Path Classes="icon" Data="{StaticResource IconPlay}"/><TextBlock Text="Avvia tutti"/></StackPanel></Button>
                                                    <Button ToolTip.Tip="Mette in pausa tutte le copie (ripartono dall'inizio del file)" Classes="warning" Command="{Binding RelayQueuePauseAllCommand}"><StackPanel Classes="bi"><Path Classes="icon" Data="{StaticResource IconPause}"/><TextBlock Text="Pausa tutti"/></StackPanel></Button>
                                                    <Button ToolTip.Tip="Annulla tutte le copie non ancora completate" Classes="danger" Command="{Binding RelayQueueCancelAllCommand}"><StackPanel Classes="bi"><Path Classes="icon" Data="{StaticResource IconClose}"/><TextBlock Text="Annulla tutti"/></StackPanel></Button>
                                                    <Border Width="1" Height="26" Background="{DynamicResource AppBorderBrush}" Margin="6,0" VerticalAlignment="Center"/>
                                                    <Button ToolTip.Tip="Togli dalla lista completati, annullati o falliti (i file restano dove sono). «Elimina tutto» è in fondo al menu e chiede conferma.">
                                                        <StackPanel Classes="bi"><Path Classes="icon" Data="{StaticResource IconTrash}"/><TextBlock Text="Pulisci lista"/><Path Classes="icon" Data="{StaticResource IconChevronDownSmall}" Width="10" Height="10" Margin="2,0,0,0"/></StackPanel>
                                                        <Button.Flyout>
                                                            <MenuFlyout Placement="BottomEdgeAlignedLeft">
                                                                <MenuItem Header="Rimuovi completati" Command="{Binding RelayQueueClearCompletedCommand}"><MenuItem.Icon><Path Classes="icon" Data="{StaticResource IconCheckCircle}"/></MenuItem.Icon></MenuItem>
                                                                <MenuItem Header="Rimuovi annullati" Command="{Binding RelayQueueClearCancelledCommand}"><MenuItem.Icon><Path Classes="icon" Data="{StaticResource IconBan}"/></MenuItem.Icon></MenuItem>
                                                                <MenuItem Header="Rimuovi falliti" Command="{Binding RelayQueueClearFailedCommand}"><MenuItem.Icon><Path Classes="icon" Data="{StaticResource IconAlertCircle}"/></MenuItem.Icon></MenuItem>
                                                                <Separator/>
                                                                <MenuItem Classes="dangerItem" Header="Elimina tutto…" Tag="{Binding RelayQueueRemoveAllCommand}" CommandParameter="Fermare e togliere dalla lista TUTTE le copie tra server, anche quelle in corso e in coda? I file già copiati restano sul server." Click="OnConfirmRemoveAllClick"><MenuItem.Icon><Path Classes="icon" Data="{StaticResource IconTrash}"/></MenuItem.Icon></MenuItem>
                                                            </MenuFlyout>
                                                        </Button.Flyout>
                                                    </Button>
                                                </WrapPanel>
                                            </StackPanel>
                                        </Border>
                                        <Border Classes="cardElevated">
                                            <h:FillSlot>
                                            <DataGrid MinHeight="0" ItemsSource="{Binding SftpRelayJobs}" AutoGenerateColumns="False" IsReadOnly="True" CanUserResizeColumns="True" CanUserReorderColumns="True" CanUserSortColumns="False">
                                                <DataGrid.ContextMenu>
                                                    <ContextMenu>
                                                        <MenuItem Header="Avvia / Riprendi" Click="OnRelayJobResumeClick"><MenuItem.Icon><Path Classes="icon" Data="{StaticResource IconPlay}"/></MenuItem.Icon></MenuItem>
                                                        <MenuItem Header="Pausa" Click="OnRelayJobPauseClick"><MenuItem.Icon><Path Classes="icon" Data="{StaticResource IconPause}"/></MenuItem.Icon></MenuItem>
                                                        <MenuItem Header="Annulla" Click="OnRelayJobCancelClick"><MenuItem.Icon><Path Classes="icon" Data="{StaticResource IconClose}"/></MenuItem.Icon></MenuItem>
                                                        <Separator/>
                                                        <MenuItem Header="Rimuovi" Click="OnRelayJobRemoveClick"><MenuItem.Icon><Path Classes="icon" Data="{StaticResource IconTrash}"/></MenuItem.Icon></MenuItem>
                                                    </ContextMenu>
                                                </DataGrid.ContextMenu>
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="File" Binding="{Binding FileName}" Width="2*"/>
                                                    <DataGridTextColumn Header="Da" Binding="{Binding SourceFolder}" Width="2*"/>
                                                    <DataGridTextColumn Header="A" Binding="{Binding DestinationFolder}" Width="2*"/>
                                                    <DataGridTextColumn Header="Stato" Binding="{Binding Status}" Width="100"/>
                                                    <DataGridTemplateColumn Header="Progresso" Width="2*">
                                                        <DataGridTemplateColumn.CellTemplate>
                                                            <DataTemplate>
                                                                <Grid ColumnDefinitions="*, Auto" Margin="2">
                                                                    <ProgressBar Grid.Column="0" Value="{Binding Percentage}" Minimum="0" Maximum="100" Height="14" Classes.done="{Binding IsCompleted}" Classes.failed="{Binding IsFailed}" Classes.paused="{Binding IsPaused}" Classes.queued="{Binding IsQueued}" Classes.cancelled="{Binding IsCancelled}"/>
                                                                    <TextBlock Grid.Column="1" Text="{Binding Percentage, StringFormat={}{0:F0}%}" Margin="8,0,0,0" VerticalAlignment="Center" FontSize="11"/>
                                                                </Grid>
                                                            </DataTemplate>
                                                        </DataGridTemplateColumn.CellTemplate>
                                                    </DataGridTemplateColumn>
                                                    <DataGridTextColumn Header="Dimensione" Binding="{Binding SizeText}" Width="150"/>
                                                    <DataGridTextColumn Header="Velocità" Binding="{Binding SpeedText}" Width="100"/>
                                                    <DataGridTextColumn Header="ETA" Binding="{Binding EtaText}" Width="100"/>
                                                    <DataGridTemplateColumn Header="Azioni" Width="Auto">
                                                        <DataGridTemplateColumn.CellTemplate>
                                                            <DataTemplate>
                                                                <StackPanel Orientation="Horizontal" Spacing="4" Margin="4,2" VerticalAlignment="Center">
                                                                    <Button Classes="iconCircle success" Width="26" Height="26" ToolTip.Tip="Riprendi" IsVisible="{Binding CanResume}" Click="OnRelayJobResumeClick"><Path Classes="icon" Width="12" Height="12" Data="{StaticResource IconPlay}"/></Button>
                                                                    <Button Classes="iconCircle warning" Width="26" Height="26" ToolTip.Tip="Pausa" IsVisible="{Binding CanPause}" Click="OnRelayJobPauseClick"><Path Classes="icon" Width="12" Height="12" Data="{StaticResource IconPause}"/></Button>
                                                                    <Button Classes="iconCircle danger" Width="26" Height="26" ToolTip.Tip="Annulla" IsVisible="{Binding CanCancel}" Click="OnRelayJobCancelClick"><Path Classes="icon" Width="12" Height="12" Data="{StaticResource IconClose}"/></Button>
                                                                    <Button Classes="iconCircle" Width="26" Height="26" ToolTip.Tip="Riprova (copia da capo)" IsVisible="{Binding CanRetry}" Click="OnRelayJobResumeClick"><Path Classes="icon" Width="12" Height="12" Data="{StaticResource IconRefresh}"/></Button>
                                                                    <Button Classes="iconCircle danger" Width="26" Height="26" ToolTip.Tip="Rimuovi dalla lista" Click="OnRelayJobRemoveClick"><Path Classes="icon" Width="12" Height="12" Data="{StaticResource IconTrash}"/></Button>
                                                                </StackPanel>
                                                            </DataTemplate>
                                                        </DataGridTemplateColumn.CellTemplate>
                                                    </DataGridTemplateColumn>
                                                </DataGrid.Columns>
                                            </DataGrid>
                                            </h:FillSlot>
                                        </Border>
                                    </DockPanel>
                                </Panel>
                            </Panel>
                        </DockPanel>
                    </DockPanel>
                    </h:FillViewportPanel>
                    </ScrollViewer>
                    <!-- Copia del messaggio fissata in alto, visibile solo scorrendo (StickyBanner) -->
                    <Border x:Name="SftpStickyBanner" VerticalAlignment="Top" IsVisible="False" Padding="0,10,0,0" Background="{DynamicResource AppBackgroundBrush}">
                        <ContentControl Margin="0,0,0,8" Theme="{StaticResource StatusBannerTheme}" Content="{Binding SftpStatusMessage}"/>
                    </Border>
                    </Panel>
                </Panel>
                <Panel IsVisible="{Binding #MainTabs.SelectedIndex, Converter={x:Static vm:IndexEqualsConverter.Default}, ConverterParameter=5}">
                    <!-- La pagina riempie la finestra; se è troppo bassa scorre (le tabelle restano utilizzabili) -->
                    <Panel DataContext="{Binding Videobox}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" h:StickyBanner.Overlay="{Binding #VideoboxStickyBanner}">
                    <h:FillViewportPanel>
                    <Grid RowDefinitions="Auto, Auto, Auto, *" Margin="0,10,0,10">

                        <!-- STATUS (in alto, sopra la guida) -->
                        <ContentControl Grid.Row="0" Theme="{StaticResource StatusBannerTheme}" Content="{Binding StatusMessage}" IsVisible="{Binding StatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>

                        <!-- GUIDA VIDEOBOX -->
                        <Border Grid.Row="1" Classes="cardElevated" Margin="0,0,0,10" Padding="0" ClipToBounds="True">
                            <StackPanel>
                                <ToggleButton Classes="guideToggle" x:Name="ToggleGuideVideobox" IsChecked="False">
                                    <Grid ColumnDefinitions="*, Auto">
                                        <StackPanel Classes="bi">
                                            <Path Classes="icon accent" Data="{StaticResource IconBulb}"/>
                                            <TextBlock Text="Guida rapida - Videobox Corrector" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource AppTextBrush}"/>
                                        </StackPanel>
                                        <Path Grid.Column="1" Classes="chevron"/>
                                    </Grid>
                                </ToggleButton>
                                <Border IsVisible="{Binding #ToggleGuideVideobox.IsChecked}" Background="Transparent" Margin="16,0,16,16" Padding="12,12,4,12">
                                    <ScrollViewer MaxHeight="240" VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
                                    <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource AppTextMutedBrush}">
                                        <Run FontWeight="Bold" Foreground="{DynamicResource AppTextBrush}">A cosa serve</Run><LineBreak/>
                                        Corregge i link video dei post del forum (Invision Community): confronta i link di ogni post con i file presenti sul server SFTP e genera i nuovi link sul dominio corretto.<LineBreak/>
                                        <LineBreak/>
                                        <Run FontWeight="Bold" Foreground="{DynamicResource AppTextBrush}">Come si usa</Run><LineBreak/>
                                        <Run FontWeight="SemiBold" Foreground="{DynamicResource AppTextBrush}">• 1. Configura:</Run> apri "Impostazioni e Domini", compila URL e API Key del forum e aggiungi le <Run FontWeight="SemiBold">sorgenti SFTP</Run>: per ognuna la connessione (un profilo della tab SFTP, anche su server diversi), la cartella sul server, il dominio e il percorso pubblico. L'anteprima mostra il link che verrà generato. Salva.<LineBreak/>
                                        <Run FontWeight="SemiBold" Foreground="{DynamicResource AppTextBrush}">• 2. Carica i post:</Run> scegli una categoria: "Carica Pag." carica 50 post, "Carica Tutti" li carica tutti a blocchi. Con la ricerca e i filtri colorati sotto (clic su un colore per mostrarlo o nasconderlo, "Da sistemare" nasconde i verdi) restano solo i post che ti interessano.<LineBreak/>
                                        <Run FontWeight="SemiBold" Foreground="{DynamicResource AppTextBrush}">• 3. Carica l'albero:</Run> scegli dal menu <Run FontWeight="SemiBold">Sorgenti</Run> quali caricare (la scelta resta salvata e vale per tutte le categorie: cambiando categoria alberi e spunte non cambiano) e premi "Carica": ogni sorgente compare come radice dell'albero, e i colori confrontano i post con i file di tutte. Dopo il caricamento l'albero si aggiorna da solo.<LineBreak/>
                                        <Run FontWeight="SemiBold" Foreground="{DynamicResource AppTextBrush}">• 4. Mappa:</Run> seleziona un post, clicca la cartella con i suoi episodi (o un singolo file, per i film) e premi "Mappa": i link vengono abbinati ai file in ordine naturale, col dominio della sorgente del file. Funziona anche con i post <Run FontWeight="SemiBold">senza link</Run>: viene creata una riga per ogni file. Per un film in più parti mappa un file alla volta: va sulla riga selezionata e poi passa alla successiva. Col clic destro puoi copiare titoli, percorsi e link.<LineBreak/>
                                        <Run FontWeight="SemiBold" Foreground="{DynamicResource AppTextBrush}">• 5. Controlla:</Run> ogni riga mostra il file che il post ha ora sul forum e quello che diventerà (in grande il nome del file, sotto server e cartella; l'indirizzo completo passando il mouse). Sopra la tabella i conteggi e un riepilogo: verde se file e link coincidono, arancione se no. Con le frecce di "Ordine" scambi gli abbinamenti. La spunta "Usa" decide cosa va sul forum: una riga senza spunta viene tolta dal post ("verrà tolto dal post"); I file hanno la precedenza: dopo "Mappa" (cartella o singolo file) le righe rimaste senza file perdono la spunta e vengono tolte; se i file sono più dei link, quelli mancanti vengono aggiunti. Per un film in più parti mappa un file alla volta: ognuno riprende la spunta sulla sua riga. Se rimetti la spunta a una riga senza file, quella resta com'è. Con Ctrl (righe sparse) o Maiusc (un intervallo) selezioni più righe: Spazio, o il clic destro, mette o toglie la spunta a tutte insieme.<LineBreak/>
                                        <Run FontWeight="SemiBold" Foreground="{DynamicResource AppTextBrush}">• 6. Applica:</Run> invia al forum i nuovi link e il titolo. La tabella si ricarica con i link salvati dal forum: ogni riga dice "✓ salvato sul forum" (verde) oppure "inviato, non ancora confermato" (arancione, aggiunta in fondo se il forum non l'ha restituita). Il post resta aperto e selezionato anche se diventa verde e i verdi sono nascosti. Sotto i conteggi compare il riepilogo dell'ultimo invio, con quanti link il forum ha salvato davvero.<LineBreak/>
                                        <Run FontWeight="SemiBold" Foreground="{DynamicResource AppTextBrush}">• Rinomina:</Run> il titolo del post in alto si può modificare: "Rinomina" cambia solo il titolo e lascia i link come sono sul forum.<LineBreak/>
                                        <LineBreak/>
                                        <Run FontWeight="Bold" Foreground="{DynamicResource AppTextBrush}">Significato dei colori</Run><LineBreak/>
                                        <Run Text="●" Foreground="#22C55E"/> <Run FontWeight="SemiBold" Foreground="{DynamicResource AppTextBrush}">Verde:</Run> tutti i link puntano a un dominio valido.<LineBreak/>
                                        <Run Text="●" Foreground="#F59E0B"/> <Run FontWeight="SemiBold" Foreground="{DynamicResource AppTextBrush}">Arancione:</Run> link misti, alcuni validi e altri vecchi.<LineBreak/>
                                        <Run Text="●" Foreground="#EF4444"/> <Run FontWeight="SemiBold" Foreground="{DynamicResource AppTextBrush}">Rosso:</Run> link tutti vecchi, oppure file senza nessun link.<LineBreak/>
                                        <Run Text="●" Foreground="#A855F7"/> <Run FontWeight="SemiBold" Foreground="{DynamicResource AppTextBrush}">Viola:</Run> mismatch, il numero di link del post è diverso dal numero di file nella cartella. Il confronto si fa con la cartella della sorgente che ha lo stesso dominio del link: due sorgenti con lo stesso percorso su server diversi (es. "Anime" su DDL 1 e DDL 2) non si confondono.<LineBreak/>
                                        <Run Text="●" Foreground="Gray"/> <Run FontWeight="SemiBold" Foreground="{DynamicResource AppTextBrush}">Grigio:</Run> post senza link video (si possono mappare lo stesso: vedi il punto 4).<LineBreak/>
                                        <LineBreak/>
                                        <Run FontWeight="Bold" Foreground="{DynamicResource AppTextBrush}">Aggiornamenti automatici</Run><LineBreak/>
                                        L'albero si aggiorna da solo quando i file cambiano (dall'app subito, dall'esterno ogni minuto); i post visibili si rileggono dal forum ogni 30 secondi (titoli e link modificati, post nuovi o eliminati) senza perdere la selezione.
                                    </TextBlock>
                                    </ScrollViewer>
                                </Border>
                            </StackPanel>
                        </Border>

                        <Border Grid.Row="2" Classes="cardElevated" Margin="0,0,0,10" Padding="0" ClipToBounds="True">
                            <StackPanel>
                                <ToggleButton Classes="guideToggle" x:Name="ToggleSettingsVideobox" IsChecked="False">
                                    <Grid ColumnDefinitions="*, Auto">
                                        <StackPanel Classes="bi">
                                            <Path Classes="icon accent" Data="{StaticResource IconSettings}"/>
                                            <TextBlock Text="Impostazioni e Domini" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource AppTextBrush}"/>
                                        </StackPanel>
                                        <Path Grid.Column="1" Classes="chevron"/>
                                    </Grid>
                                </ToggleButton>

                                <ScrollViewer IsVisible="{Binding #ToggleSettingsVideobox.IsChecked}" MaxHeight="560" VerticalScrollBarVisibility="Auto">
                                    <StackPanel x:Name="SettingsBodyVideobox" Spacing="12" Margin="16,0,16,16">

                                        <!-- FORUM IPS -->
                                        <Border Classes="card">
                                            <StackPanel Spacing="12">
                                                <StackPanel Spacing="2">
                                                    <StackPanel Classes="bi">
                                                        <Path Classes="icon accent" Data="{StaticResource IconPlug}"/>
                                                        <TextBlock Text="Forum IPS" FontWeight="Bold" FontSize="13"/>
                                                    </StackPanel>
                                                    <TextBlock Text="Dove leggere e aggiornare i post." FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource AppTextMutedBrush}"/>
                                                </StackPanel>
                                                <Grid ColumnDefinitions="*, 12, *">
                                                    <StackPanel Grid.Column="0" Spacing="4">
                                                        <TextBlock Text="URL del forum IPS" FontSize="12" FontWeight="SemiBold"/>
                                                        <TextBox Text="{Binding ConfigIpsBaseUrl, Mode=TwoWay}" PlaceholderText="https://ddlstreamitaly.cc" ToolTip.Tip="Indirizzo base del forum Invision Community, senza /api"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="2" Spacing="4">
                                                        <TextBlock Text="API Key" FontSize="12" FontWeight="SemiBold"/>
                                                        <TextBox Text="{Binding ConfigIpsApiKey, Mode=TwoWay}" PasswordChar="•" PlaceholderText="Chiave REST API" ToolTip.Tip="Chiave REST API del forum (AdminCP → Sistema → REST &amp; OAuth → Chiavi API)"/>
                                                    </StackPanel>
                                                </Grid>
                                            </StackPanel>
                                        </Border>

                                        <!-- SORGENTI SFTP -->
                                        <Border Classes="card">
                                            <StackPanel Spacing="12">
                                                <Grid ColumnDefinitions="*, Auto">
                                                    <StackPanel Spacing="2">
                                                        <StackPanel Classes="bi">
                                                            <Path Classes="icon accent" Data="{StaticResource IconCloud}"/>
                                                            <TextBlock Text="Sorgenti SFTP" FontWeight="Bold" FontSize="13"/>
                                                        </StackPanel>
                                                        <TextBlock Text="Cartelle (anche su server diversi) caricate insieme nell'albero. Ogni sorgente ha il suo dominio e percorso pubblico per generare i link." FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource AppTextMutedBrush}"/>
                                                    </StackPanel>
                                                    <Button Grid.Column="1" Classes="info" Command="{Binding AddSourceCommand}" VerticalAlignment="Center" ToolTip.Tip="Aggiunge una nuova sorgente (cartella su un server SFTP)">
                                                        <StackPanel Classes="bi"><Path Classes="icon" Data="{StaticResource IconPlus}"/><TextBlock Text="Aggiungi sorgente"/></StackPanel>
                                                    </Button>
                                                </Grid>

                                                <TextBlock Text="Nessuna sorgente: aggiungine una per caricare l'albero SFTP." FontSize="12" FontStyle="Italic" Foreground="{DynamicResource AppTextMutedBrush}" IsVisible="{Binding !HasSources}"/>

                                                <ItemsControl ItemsSource="{Binding Sources}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate><StackPanel Spacing="10"/></ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate x:DataType="models:VideoboxSource">
                                                            <Border Background="{DynamicResource AppInputBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="12">
                                                                <StackPanel Spacing="10">
                                                                    <Grid ColumnDefinitions="*, 12, *, Auto">
                                                                        <StackPanel Grid.Column="0" Spacing="4">
                                                                            <TextBlock Text="Nome" FontSize="12" FontWeight="SemiBold"/>
                                                                            <TextBox Text="{Binding Name, Mode=TwoWay}" PlaceholderText="Es. Anime server A" ToolTip.Tip="Nome mostrato nell'albero"/>
                                                                        </StackPanel>
                                                                        <StackPanel Grid.Column="2" Spacing="4">
                                                                            <TextBlock Text="Connessione SFTP" FontSize="12" FontWeight="SemiBold"/>
                                                                            <ComboBox HorizontalAlignment="Stretch"
                                                                                      ItemsSource="{Binding $parent[ItemsControl].((vm:VideoboxTabViewModel)DataContext).SftpProfiles}"
                                                                                      SelectedItem="{Binding Profile, Mode=TwoWay}"
                                                                                      PlaceholderText="Scegli la connessione"
                                                                                      ToolTip.Tip="Profilo salvato nella tab SFTP (connessione dedicata, indipendente) oppure la connessione già aperta nella tab SFTP">
                                                                                <ComboBox.ItemTemplate>
                                                                                    <DataTemplate x:DataType="models:SftpProfileOption">
                                                                                        <TextBlock Text="{Binding Name}"/>
                                                                                    </DataTemplate>
                                                                                </ComboBox.ItemTemplate>
                                                                            </ComboBox>
                                                                        </StackPanel>
                                                                        <Button Grid.Column="3" Classes="iconCircle danger" Width="32" Height="32" Margin="10,18,0,0" VerticalAlignment="Top" ToolTip.Tip="Rimuovi sorgente"
                                                                                Command="{Binding $parent[ItemsControl].((vm:VideoboxTabViewModel)DataContext).RemoveSourceCommand}" CommandParameter="{Binding}">
                                                                            <Path Classes="icon" Data="{StaticResource IconClose}"/>
                                                                        </Button>
                                                                    </Grid>
                                                                    <Grid ColumnDefinitions="1.3*, 12, *, 12, *">
                                                                        <StackPanel Grid.Column="0" Spacing="4">
                                                                            <TextBlock Text="Cartella sul server" FontSize="12" FontWeight="SemiBold"/>
                                                                            <TextBox Text="{Binding RootPath, Mode=TwoWay}" PlaceholderText="/media/Anime SUB.ITA" ToolTip.Tip="Cartella caricata nell'albero; viene tolta dal percorso quando si genera il link"/>
                                                                        </StackPanel>
                                                                        <StackPanel Grid.Column="2" Spacing="4">
                                                                            <TextBlock Text="Dominio" FontSize="12" FontWeight="SemiBold"/>
                                                                            <TextBox Text="{Binding Domain, Mode=TwoWay}" PlaceholderText="https://ichigolink.top" ToolTip.Tip="Dominio dei link generati per i file di questa sorgente (è anche considerato valido)"/>
                                                                        </StackPanel>
                                                                        <StackPanel Grid.Column="4" Spacing="4">
                                                                            <TextBlock Text="Percorso pubblico" FontSize="12" FontWeight="SemiBold"/>
                                                                            <TextBox Text="{Binding PublicPath, Mode=TwoWay}" PlaceholderText="Anime SUB.ITA" ToolTip.Tip="Cartella pubblica sul web, subito dopo il dominio (può essere vuota)"/>
                                                                        </StackPanel>
                                                                    </Grid>
                                                                    <StackPanel Classes="bi">
                                                                        <Path Classes="icon" Data="{StaticResource IconEye}"/>
                                                                        <TextBlock Text="{Binding UrlPreviewSource}" FontFamily="Consolas, Cascadia Mono, monospace" FontSize="11" Foreground="{DynamicResource AppTextMutedBrush}" TextTrimming="CharacterEllipsis" MaxWidth="420"/>
                                                                        <TextBlock Text="→" Foreground="{DynamicResource AppTextMutedBrush}"/>
                                                                        <SelectableTextBlock Text="{Binding UrlPreview}" FontFamily="Consolas, Cascadia Mono, monospace" FontSize="11" Foreground="{DynamicResource AppAccentBrush}" TextWrapping="Wrap"/>
                                                                    </StackPanel>
                                                                </StackPanel>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Border>

                                        <!-- DOMINI SECONDARI -->
                                        <Border Classes="card">
                                            <StackPanel Spacing="10">
                                                <Grid ColumnDefinitions="*, Auto">
                                                    <StackPanel Spacing="2">
                                                        <StackPanel Classes="bi">
                                                            <Path Classes="icon accent" Data="{StaticResource IconLayers}"/>
                                                            <TextBlock Text="Domini secondari" FontWeight="Bold" FontSize="13"/>
                                                        </StackPanel>
                                                        <TextBlock Text="Mirror considerati validi: i link che puntano qui risultano verdi e non vengono riscritti." FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource AppTextMutedBrush}"/>
                                                    </StackPanel>
                                                    <Button Grid.Column="1" Classes="info" Command="{Binding AddSecondaryDomainCommand}" VerticalAlignment="Center" ToolTip.Tip="Aggiunge una riga per un nuovo dominio valido">
                                                        <StackPanel Classes="bi"><Path Classes="icon" Data="{StaticResource IconPlus}"/><TextBlock Text="Aggiungi dominio"/></StackPanel>
                                                    </Button>
                                                </Grid>

                                                <TextBlock Text="Nessun dominio secondario: è valido solo il dominio primario." FontSize="12" FontStyle="Italic" Foreground="{DynamicResource AppTextMutedBrush}" IsVisible="{Binding !HasSecondaryDomains}"/>

                                                <ItemsControl ItemsSource="{Binding SecondaryDomains}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate><UniformGrid Columns="2"/></ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Grid ColumnDefinitions="*, Auto" Margin="0,0,10,8">
                                                                <TextBox Grid.Column="0" Text="{Binding Url, Mode=TwoWay}" PlaceholderText="https://mirror.example"/>
                                                                <Button Grid.Column="1" Classes="iconCircle danger" Width="30" Height="30" Margin="6,0,0,0" ToolTip.Tip="Rimuovi dominio"
                                                                        Command="{Binding $parent[ItemsControl].((vm:VideoboxTabViewModel)DataContext).RemoveSecondaryDomainCommand}" CommandParameter="{Binding}">
                                                                    <Path Classes="icon" Data="{StaticResource IconClose}"/>
                                                                </Button>
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Border>

                                        <Grid ColumnDefinitions="*, Auto">
                                            <StackPanel Classes="bi" VerticalAlignment="Center">
                                                <Path Classes="icon" Data="{StaticResource IconInfo}"/>
                                                <TextBlock Text="Dopo il salvataggio i colori di post e albero vengono ricalcolati." FontSize="11" Foreground="{DynamicResource AppTextMutedBrush}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <Button Grid.Column="1" Classes="accent" Command="{Binding SaveSettingsCommand}" ToolTip.Tip="Salva tutte le impostazioni e ricalcola i colori">
                                                <StackPanel Classes="bi"><Path Classes="icon" Data="{StaticResource IconSave}"/><TextBlock Text="Salva impostazioni"/></StackPanel>
                                            </Button>
                                        </Grid>
                                    </StackPanel>
                                </ScrollViewer>
                            </StackPanel>
                        </Border>

                        <Grid Grid.Row="3" ColumnDefinitions="340, 10, 300, 10, *">

                            <Grid Grid.Column="0" RowDefinitions="Auto, Auto, *">
                                <Border Classes="cardElevated" Padding="10" Margin="0,0,0,10">
                                    <StackPanel Spacing="10">
                                        <TextBlock Text="Categorie" FontWeight="Bold"/>
                                        <Grid ColumnDefinitions="*, Auto">
                                            <ComboBox Grid.Column="0"
                                                      ItemsSource="{Binding AvailableCategories}"
                                                      SelectedItem="{Binding SelectedCategory, Mode=TwoWay}"
                                                      Margin="0,0,5,0"
                                                      HorizontalAlignment="Stretch"
                                                      ToolTip.Tip="Seleziona la categoria di Videobox di cui caricare i post">
                                                <ComboBox.ItemTemplate>
                                                    <DataTemplate x:DataType="vm:CategoryItem">
                                                        <StackPanel Classes="bi">
                                                            <Path Classes="icon accent" Data="{StaticResource IconLayers}" IsVisible="{Binding IsAll}"/>
                                                            <Path Classes="icon" Data="{StaticResource IconFolder}" Stroke="{DynamicResource AppTextMutedBrush}" IsVisible="{Binding !IsAll}"/>
                                                            <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ComboBox.ItemTemplate>
                                            </ComboBox>
                                            <Button Grid.Column="1" Classes="iconCircle" Command="{Binding LoadCategoriesCommand}" ToolTip.Tip="Ricarica l'elenco delle categorie dal sito"><Path Classes="icon" Data="{StaticResource IconRefresh}"/></Button>
                                        </Grid>
                                        <Grid ColumnDefinitions="*, *" IsVisible="{Binding !IsLoadingPosts}">
                                            <Button Grid.Column="0" Command="{Binding LoadCategoryCommand}" Margin="0,0,5,0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" ToolTip.Tip="Carica solo la prima pagina (50 post)"><StackPanel Classes="bi"><Path Classes="icon" Data="{StaticResource IconRefresh}"/><TextBlock Text="Carica Pag."/></StackPanel></Button>
                                            <Button Grid.Column="1" Classes="accent" Command="{Binding LoadAllCategoryCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" ToolTip.Tip="Carica tutti i post della categoria a blocchi di 50"><StackPanel Classes="bi"><Path Classes="icon" Data="{StaticResource IconDownload}"/><TextBlock Text="Carica Tutti"/></StackPanel></Button>
                                        </Grid>
                                        <!-- Durante il caricamento: avanzamento + Stop al posto dei pulsanti -->
                                        <Grid ColumnDefinitions="*, Auto" IsVisible="{Binding IsLoadingPosts}">
                                            <StackPanel Grid.Column="0" Spacing="5" VerticalAlignment="Center" Margin="2,0,10,0">
                                                <TextBlock Text="{Binding PostsProgressText}" FontSize="11" Foreground="{DynamicResource AppTextMutedBrush}" TextTrimming="CharacterEllipsis"/>
                                                <ProgressBar IsIndeterminate="True" Height="4" MinWidth="0"/>
                                            </StackPanel>
                                            <Button Grid.Column="1" Classes="danger" Command="{Binding StopLoadingPostsCommand}" ToolTip.Tip="Ferma il caricamento dei post (quelli già scaricati restano)"><StackPanel Classes="bi"><Path Classes="icon" Data="{StaticResource IconStop}"/><TextBlock Text="Stop"/></StackPanel></Button>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <Border Grid.Row="1" Classes="cardElevated" Margin="0,0,0,10" Padding="10">
                                    <StackPanel Spacing="10">
                                        <TextBox x:Name="VbPostSearchBox" Text="{Binding SearchQuery, Mode=TwoWay}" PlaceholderText="Cerca post per titolo..." ToolTip.Tip="Filtra i post caricati in memoria per titolo"/>

                                        <StackPanel Spacing="5">
                                            <TextBlock Text="{Binding TotalPostsText}" FontWeight="Bold" FontSize="11" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                            <!-- Filtro per colore: ogni chip mostra/nasconde i post di quel colore -->
                                            <WrapPanel HorizontalAlignment="Center" ItemSpacing="4" LineSpacing="4">
                                                <ToggleButton Classes="statusChip" IsChecked="{Binding ShowValidPosts, Mode=TwoWay}" ToolTip.Tip="Verdi: tutti i link corretti. Clic per mostrarli o nasconderli">
                                                    <StackPanel Orientation="Horizontal" Spacing="5">
                                                        <Ellipse Width="9" Height="9" VerticalAlignment="Center" Fill="#22C55E"/>
                                                        <TextBlock Text="{Binding CountValidPosts}" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </ToggleButton>
                                                <ToggleButton Classes="statusChip" IsChecked="{Binding ShowMixedPosts, Mode=TwoWay}" ToolTip.Tip="Gialli: solo alcuni link puntano ai domini impostati. Clic per mostrarli o nasconderli">
                                                    <StackPanel Orientation="Horizontal" Spacing="5">
                                                        <Ellipse Width="9" Height="9" VerticalAlignment="Center" Fill="#F59E0B"/>
                                                        <TextBlock Text="{Binding CountMixedPosts}" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </ToggleButton>
                                                <ToggleButton Classes="statusChip" IsChecked="{Binding ShowInvalidPosts, Mode=TwoWay}" ToolTip.Tip="Rossi: nessun link punta ai domini impostati. Clic per mostrarli o nasconderli">
                                                    <StackPanel Orientation="Horizontal" Spacing="5">
                                                        <Ellipse Width="9" Height="9" VerticalAlignment="Center" Fill="#EF4444"/>
                                                        <TextBlock Text="{Binding CountInvalidPosts}" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </ToggleButton>
                                                <ToggleButton Classes="statusChip" IsChecked="{Binding ShowMismatchPosts, Mode=TwoWay}" ToolTip.Tip="Viola: il numero di link è diverso dal numero di file nella cartella. Clic per mostrarli o nasconderli">
                                                    <StackPanel Orientation="Horizontal" Spacing="5">
                                                        <Ellipse Width="9" Height="9" VerticalAlignment="Center" Fill="#A855F7"/>
                                                        <TextBlock Text="{Binding CountMismatchPosts}" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </ToggleButton>
                                                <ToggleButton Classes="statusChip" IsChecked="{Binding ShowUnknownPosts, Mode=TwoWay}" ToolTip.Tip="Grigi: post senza link video. Clic per mostrarli o nasconderli">
                                                    <StackPanel Orientation="Horizontal" Spacing="5">
                                                        <Ellipse Width="9" Height="9" VerticalAlignment="Center" Fill="#8B92A8"/>
                                                        <TextBlock Text="{Binding CountUnknownPosts}" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </ToggleButton>
                                            </WrapPanel>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="4">
                                                <Button Classes="ghost" Padding="8,2" FontSize="11" Command="{Binding ShowPostsToFixCommand}" ToolTip.Tip="Nasconde i verdi: restano solo i post da sistemare">Da sistemare</Button>
                                                <Button Classes="ghost" Padding="8,2" FontSize="11" Command="{Binding ShowAllPostsCommand}" ToolTip.Tip="Mostra i post di tutti i colori">Tutti</Button>
                                            </StackPanel>
                                        </StackPanel>

                                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                                            <ItemsControl ItemsSource="{Binding PageNumbers}">
                                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="4"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Button ToolTip.Tip="Vai a questa pagina di post" Content="{Binding}" Width="30" Height="30" Padding="0" FontSize="11"
                                                                Command="{Binding $parent[ItemsControl].((vm:VideoboxTabViewModel)DataContext).GoToPageCommand}" CommandParameter="{Binding}"/>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                    </StackPanel>
                                </Border>

                                <Border Grid.Row="2" Classes="cardElevated">
                                    <h:FillSlot>
                                    <ListBox ItemsSource="{Binding CategoryPosts}" SelectedItem="{Binding SelectedPost, Mode=TwoWay}">
                                        <ListBox.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="Copia titolo" Click="OnVbCopyPostTitleClick"><MenuItem.Icon><Path Classes="icon" Data="{StaticResource IconCopy}"/></MenuItem.Icon></MenuItem>
                                                <MenuItem Header="Copia indirizzo del post" Click="OnVbCopyPostUrlClick"><MenuItem.Icon><Path Classes="icon" Data="{StaticResource IconGlobe}"/></MenuItem.Icon></MenuItem>
                                                <MenuItem Header="Copia tutti i link video" Click="OnVbCopyPostLinksClick"><MenuItem.Icon><Path Classes="icon" Data="{StaticResource IconList}"/></MenuItem.Icon></MenuItem>
                                                <Separator/>
                                                <MenuItem Header="Apri nel browser" Click="OnVbOpenPostClick"><MenuItem.Icon><Path Classes="icon" Data="{StaticResource IconGlobe}"/></MenuItem.Icon></MenuItem>
                                            </ContextMenu>
                                        </ListBox.ContextMenu>
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Grid ColumnDefinitions="Auto, *, Auto, Auto">
                                                    <Ellipse Grid.Column="0" Width="10" Height="10" Margin="0,0,8,0" VerticalAlignment="Center"
                                                             Fill="{Binding Status, Converter={x:Static vm:PostStatusToBrushConverter.Default}}"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding Title}" TextTrimming="CharacterEllipsis" FontSize="12" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="2" Text="{Binding LinkCount, StringFormat='[{0}]'}" Foreground="{DynamicResource AppTextMutedBrush}" FontSize="11" Margin="5,0" VerticalAlignment="Center" ToolTip.Tip="Numero di link nel post"/>
                                                    <Button Grid.Column="3" Classes="iconCircle" Width="24" Height="24"
                                                            Command="{Binding $parent[ItemsControl].((vm:VideoboxTabViewModel)DataContext).OpenPostUrlCommand}" CommandParameter="{Binding}"
                                                            ToolTip.Tip="Apri il post nel browser">
                                                        <Path Classes="icon" Data="{StaticResource IconGlobe}" Width="13" Height="13"/>
                                                    </Button>
                                                </Grid>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                    </h:FillSlot>
                                </Border>
                            </Grid>

                            <Border Grid.Column="2" Classes="cardElevated">
                                <DockPanel>
                                    <Grid DockPanel.Dock="Top" ColumnDefinitions="*, Auto" Margin="0,0,0,10">
                                        <StackPanel Grid.Column="0" Classes="bi">
                                            <Path Classes="icon accent" Data="{StaticResource IconCloud}"/>
                                            <TextBlock Text="Albero SFTP" FontWeight="Bold" FontSize="14"/>
                                        </StackPanel>
                                        <Button Grid.Column="1" Command="{Binding LoadSftpTreeCommand}" IsVisible="{Binding !IsLoadingTree}" ToolTip.Tip="Carica la struttura delle cartelle dal server SFTP"><StackPanel Classes="bi"><Path Classes="icon" Data="{StaticResource IconRefresh}"/><TextBlock Text="Carica"/></StackPanel></Button>
                                        <Button Grid.Column="1" Classes="danger" Command="{Binding StopLoadingTreeCommand}" IsVisible="{Binding IsLoadingTree}" ToolTip.Tip="Ferma il caricamento dell'albero"><StackPanel Classes="bi"><Path Classes="icon" Data="{StaticResource IconStop}"/><TextBlock Text="Stop"/></StackPanel></Button>
                                    </Grid>
                                    <StackPanel DockPanel.Dock="Top" Spacing="5" Margin="2,0,2,10" IsVisible="{Binding IsLoadingTree}">
                                        <TextBlock Text="{Binding TreeProgressText}" FontSize="11" Foreground="{DynamicResource AppTextMutedBrush}"/>
                                        <!-- Barra vera quando il totale è noto, altrimenti animata -->
                                        <ProgressBar IsIndeterminate="{Binding !HasTreeTotal}" Minimum="0" Maximum="{Binding TreeFoldersTotal}" Value="{Binding TreeFoldersReadShown}" Height="4" MinWidth="0"/>
                                    </StackPanel>

                                    <!-- Sorgenti da caricare (scelta ricordata per categoria) -->
                                    <DropDownButton DockPanel.Dock="Top" Classes="trackPicker" HorizontalAlignment="Stretch" Margin="0,0,0,10" IsVisible="{Binding HasSources}"
                                                    ToolTip.Tip="Sorgenti da caricare nell'albero. La scelta resta salvata e vale per tutte le categorie.">
                                        <StackPanel Classes="bi">
                                            <Path Classes="icon accent" Data="{StaticResource IconLayers}"/>
                                            <TextBlock Text="{Binding SourcesSelectionText}"/>
                                        </StackPanel>
                                        <DropDownButton.Flyout>
                                            <Flyout Placement="BottomEdgeAlignedLeft" FlyoutPresenterClasses="trackFlyout">
                                                <StackPanel Spacing="6" Width="300">
                                                    <Grid ColumnDefinitions="*, Auto" Margin="4,2,4,2">
                                                        <StackPanel Classes="bi">
                                                            <Path Classes="icon accent" Data="{StaticResource IconLayers}"/>
                                                            <TextBlock Text="Sorgenti" FontWeight="Bold"/>
                                                        </StackPanel>
                                                        <TextBlock Grid.Column="1" Text="{Binding SelectedCategory.Name}" FontSize="11" VerticalAlignment="Center" Foreground="{DynamicResource AppTextMutedBrush}" MaxWidth="140" TextTrimming="CharacterEllipsis"/>
                                                    </Grid>
                                                    <Border Height="1" Background="{DynamicResource AppBorderBrush}"/>
                                                    <ItemsControl ItemsSource="{Binding Sources}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate x:DataType="models:VideoboxSource">
                                                                <Border Classes="trackRow">
                                                                    <CheckBox IsChecked="{Binding IsEnabled, Mode=TwoWay}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                                                                        <StackPanel Spacing="1">
                                                                            <TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis"/>
                                                                            <TextBlock Text="{Binding RootPath}" FontSize="10" Foreground="{DynamicResource AppTextMutedBrush}" TextTrimming="CharacterEllipsis"/>
                                                                        </StackPanel>
                                                                    </CheckBox>
                                                                </Border>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                    <Border Height="1" Background="{DynamicResource AppBorderBrush}"/>
                                                    <Grid ColumnDefinitions="*, Auto, Auto" Margin="4,0,0,0">
                                                        <TextBlock Text="Poi premi Carica" FontSize="11" VerticalAlignment="Center" Foreground="{DynamicResource AppTextMutedBrush}"/>
                                                        <Button Grid.Column="1" Classes="ghost" Padding="10,4" FontSize="11" Command="{Binding EnableAllSourcesCommand}">Tutte</Button>
                                                        <Button Grid.Column="2" Classes="ghost" Padding="10,4" FontSize="11" Command="{Binding EnableNoSourcesCommand}">Nessuna</Button>
                                                    </Grid>
                                                </StackPanel>
                                            </Flyout>
                                        </DropDownButton.Flyout>
                                    </DropDownButton>

                                    <h:FillSlot>
                                    <TreeView ItemsSource="{Binding SftpRootNodes}" SelectedItem="{Binding SelectedSftpNode, Mode=TwoWay}" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                        <TreeView.Styles>
                                            <Style Selector="TextBlock.sourceRoot"><Setter Property="FontWeight" Value="Bold"/></Style>
                                        </TreeView.Styles>
                                        <TreeView.ContextMenu>
                                            <ContextMenu Opening="OnVbTreeMenuOpening">
                                                <MenuItem Header="Togli dall'albero" Tag="sourceRoot" Click="OnVbDiscardSourceClick" ToolTip.Tip="Toglie questa sorgente dall'albero e dal menu Sorgenti (per la categoria scelta)"><MenuItem.Icon><Path Classes="icon" Data="{StaticResource IconClose}"/></MenuItem.Icon></MenuItem>
                                                <Separator Tag="sourceRoot"/>
                                                <MenuItem Header="Copia nome" Click="OnVbCopyNodeNameClick"><MenuItem.Icon><Path Classes="icon" Data="{StaticResource IconCopy}"/></MenuItem.Icon></MenuItem>
                                                <MenuItem Header="Copia percorso SFTP" Click="OnVbCopyNodePathClick"><MenuItem.Icon><Path Classes="icon" Data="{StaticResource IconFolder}"/></MenuItem.Icon></MenuItem>
                                                <MenuItem Header="Copia link pubblico" Click="OnVbCopyNodeUrlClick"><MenuItem.Icon><Path Classes="icon" Data="{StaticResource IconGlobe}"/></MenuItem.Icon></MenuItem>
                                                <MenuItem Header="Copia link di tutti i file" Click="OnVbCopyNodeAllUrlsClick"><MenuItem.Icon><Path Classes="icon" Data="{StaticResource IconList}"/></MenuItem.Icon></MenuItem>
                                            </ContextMenu>
                                        </TreeView.ContextMenu>
                                        <TreeView.ItemTemplate>
                                            <TreeDataTemplate ItemsSource="{Binding Children}" x:DataType="vm:SftpNode">
                                                <!-- Grid (non StackPanel): il nome ha una larghezza massima, quindi i nomi lunghi
                                                     si accorciano con "…" e scorrono passandoci sopra col mouse -->
                                                <Grid ColumnDefinitions="Auto, Auto, *">
                                                    <Ellipse Width="10" Height="10" VerticalAlignment="Center" Margin="0,0,6,0" Fill="{Binding Status, Converter={x:Static vm:NodeStatusToBrushConverter.Default}}"/>
                                                    <Path Grid.Column="1" Classes="icon accent" Margin="0,0,6,0" Data="{StaticResource IconCloud}" IsVisible="{Binding IsSourceRoot}"/>
                                                    <TextBlock Grid.Column="2" Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Classes.sourceRoot="{Binding IsSourceRoot}"/>
                                                </Grid>
                                            </TreeDataTemplate>
                                        </TreeView.ItemTemplate>
                                    </TreeView>
                                    </h:FillSlot>
                                </DockPanel>
                            </Border>

                            <!-- POST E MAPPATURA: scheda del post in alto, anteprima delle modifiche sotto -->
                            <Grid Grid.Column="4" RowDefinitions="Auto, *">
                                <Grid.Styles>
                                    <!-- Etichette piccole sopra i campi -->
                                    <Style Selector="TextBlock.fieldLabel">
                                        <Setter Property="FontSize" Value="11"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                        <Setter Property="LetterSpacing" Value="0.6"/>
                                        <Setter Property="Foreground" Value="{DynamicResource AppTextMutedBrush}"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                    </Style>
                                    <!-- Chip: conteggi e stati -->
                                    <Style Selector="Border.chip">
                                        <Setter Property="CornerRadius" Value="999"/>
                                        <Setter Property="Padding" Value="9,3"/>
                                        <Setter Property="Background" Value="{DynamicResource AppSurface2Brush}"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                    </Style>
                                    <Style Selector="Border.chip TextBlock">
                                        <Setter Property="FontSize" Value="12"/>
                                        <Setter Property="Foreground" Value="{DynamicResource AppTextMutedBrush}"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                    </Style>
                                    <Style Selector="Border.chip TextBlock.value">
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                        <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}"/>
                                    </Style>
                                    <Style Selector="Border.chip.ok"><Setter Property="Background" Value="{DynamicResource AppSuccessSoftBrush}"/></Style>
                                    <Style Selector="Border.chip.ok TextBlock"><Setter Property="Foreground" Value="{DynamicResource AppSuccessBrush}"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
                                    <Style Selector="Border.chip.ok Path.icon"><Setter Property="Stroke" Value="{DynamicResource AppSuccessBrush}"/></Style>
                                    <Style Selector="Border.chip.warn"><Setter Property="Background" Value="{DynamicResource AppWarningSoftBrush}"/></Style>
                                    <Style Selector="Border.chip.warn TextBlock"><Setter Property="Foreground" Value="{DynamicResource AppWarningBrush}"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
                                    <Style Selector="Border.chip.warn Path.icon"><Setter Property="Stroke" Value="{DynamicResource AppWarningBrush}"/></Style>
                                    <Style Selector="Border.chip.info"><Setter Property="Background" Value="{DynamicResource AppInfoSoftBrush}"/></Style>
                                    <Style Selector="Border.chip.info TextBlock"><Setter Property="Foreground" Value="{DynamicResource AppInfoBrush}"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
                                    <Style Selector="Border.chip.info Path.icon"><Setter Property="Stroke" Value="{DynamicResource AppInfoBrush}"/></Style>
                                    <Style Selector="Border.chip Path.icon">
                                        <Setter Property="Width" Value="12"/>
                                        <Setter Property="Height" Value="12"/>
                                    </Style>
                                </Grid.Styles>

                                <!-- ===== Nessun post: cosa fare ===== -->
                                <Border Grid.RowSpan="2" Classes="cardElevated" IsVisible="{Binding SelectedPost, Converter={x:Static ObjectConverters.IsNull}}">
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="420" Spacing="14" Margin="20">
                                        <Border Width="56" Height="56" CornerRadius="28" HorizontalAlignment="Center" Background="{DynamicResource AppAccentSoftBrush}">
                                            <Path Classes="icon accent" Width="26" Height="26" Data="{StaticResource IconLayers}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock Text="Seleziona un post" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center"/>
                                        <TextBlock Text="Qui vedrai i link del post e potrai abbinarli ai file del server." FontSize="12" TextWrapping="Wrap" TextAlignment="Center" Foreground="{DynamicResource AppTextMutedBrush}"/>
                                        <StackPanel Spacing="8" HorizontalAlignment="Center" Margin="0,4,0,0">
                                            <StackPanel Classes="bi"><Border Classes="chip"><TextBlock Classes="value" Text="1"/></Border><TextBlock Text="Scegli un post dalla lista a sinistra" FontSize="12"/></StackPanel>
                                            <StackPanel Classes="bi"><Border Classes="chip"><TextBlock Classes="value" Text="2"/></Border><TextBlock Text="Clicca la sua cartella (o il file) nell'albero SFTP" FontSize="12"/></StackPanel>
                                            <StackPanel Classes="bi"><Border Classes="chip"><TextBlock Classes="value" Text="3"/></Border><TextBlock Text="Premi Mappa, controlla l'anteprima e Applica" FontSize="12"/></StackPanel>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <!-- ===== Scheda del post ===== -->
                                <Border Classes="cardElevated" Margin="0,0,0,10" IsVisible="{Binding SelectedPost, Converter={x:Static ObjectConverters.IsNotNull}}">
                                    <StackPanel Spacing="10">
                                        <Grid ColumnDefinitions="*, Auto">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <TextBlock Classes="fieldLabel" Text="POST"/>
                                                <Border Classes="chip">
                                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                                        <Ellipse Width="8" Height="8" VerticalAlignment="Center" Fill="{Binding SelectedPost.Status, Converter={x:Static vm:PostStatusToBrushConverter.Default}}"/>
                                                        <TextBlock Text="{Binding SelectedPost.Status, Converter={x:Static vm:PostStatusToTextConverter.Default}}"/>
                                                    </StackPanel>
                                                </Border>
                                                <Border Classes="chip">
                                                    <TextBlock><Run Text="{Binding SelectedPost.LinkCount}" FontWeight="SemiBold" Foreground="{DynamicResource AppTextBrush}"/><Run Text=" link sul forum"/></TextBlock>
                                                </Border>
                                            </StackPanel>
                                            <Button Grid.Column="1" Classes="iconCircle" Width="30" Height="30" ToolTip.Tip="Apri il post nel browser"
                                                    Command="{Binding OpenPostUrlCommand}" CommandParameter="{Binding SelectedPost}">
                                                <Path Classes="icon" Width="14" Height="14" Data="{StaticResource IconGlobe}"/>
                                            </Button>
                                        </Grid>
                                        <Grid ColumnDefinitions="*, Auto">
                                            <TextBox Grid.Column="0" Text="{Binding EditablePostTitle, Mode=TwoWay}" Margin="0,0,10,0"
                                                     FontWeight="SemiBold" FontSize="15" PlaceholderText="Titolo del post"
                                                     ToolTip.Tip="Titolo del post sul forum: modificalo e premi Rinomina (oppure Applica, che lo invia insieme ai link)"/>
                                            <Button Grid.Column="1" Classes="info" Command="{Binding RenamePostCommand}" IsEnabled="{Binding IsTitleChanged}" ToolTip.ShowOnDisabled="True"
                                                    ToolTip.Tip="Cambia solo il titolo del post sul forum: i link restano quelli attuali. Si attiva quando modifichi il titolo.">
                                                <StackPanel Classes="bi"><Path Classes="icon" Data="{StaticResource IconEdit}"/><TextBlock Text="Rinomina"/></StackPanel>
                                            </Button>
                                        </Grid>
                                        <Rectangle Height="1" Fill="{DynamicResource AppBorderBrush}" Margin="0,2"/>
                                        <StackPanel Classes="bi">
                                            <Path Classes="icon" Width="12" Height="12" Data="{StaticResource IconFolder}" Stroke="{DynamicResource AppTextMutedBrush}"/>
                                            <TextBlock Classes="fieldLabel" Text="CARTELLA O FILE SUL SERVER"/>
                                        </StackPanel>
                                        <Grid ColumnDefinitions="*, Auto">
                                            <TextBox Grid.Column="0" Text="{Binding SftpPathInput, Mode=TwoWay}" Margin="0,0,10,0" PlaceholderText="Clicca una cartella o un file nell'albero SFTP..."
                                                     ToolTip.Tip="Cartella SFTP con i file del post (serie) oppure un singolo file (film)"/>
                                            <Button Grid.Column="1" Classes="accent" Command="{Binding MapSftpFolderAsync}" IsEnabled="{Binding SftpPathInput, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" ToolTip.ShowOnDisabled="True"
                                                    ToolTip.Tip="Cartella: abbina i suoi file ai link del post, in ordine. File: lo abbina alla riga selezionata nella tabella (o alla prima da mappare) Si attiva quando scegli una cartella o un file nell'albero.">
                                                <StackPanel Classes="bi"><Path Classes="icon" Data="{StaticResource IconLayers}"/><TextBlock Text="Mappa"/></StackPanel>
                                            </Button>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- ===== Anteprima delle modifiche ===== -->
                                <Border Grid.Row="1" Classes="cardElevated" ClipToBounds="True" IsVisible="{Binding SelectedPost, Converter={x:Static ObjectConverters.IsNotNull}}">
                                    <DockPanel>
                                        <Grid DockPanel.Dock="Top" ColumnDefinitions="*, Auto" Margin="0,0,0,10">
                                            <StackPanel Spacing="8">
                                                <TextBlock Text="Anteprima modifiche" FontWeight="Bold" FontSize="14"/>
                                                <WrapPanel Orientation="Horizontal" ItemSpacing="6" LineSpacing="6">
                                                    <Border Classes="chip" ToolTip.Tip="Link attuali del post sul forum">
                                                        <TextBlock><Run Text="Sul forum "/><Run Classes="value" Text="{Binding OldLinkCount}" FontWeight="SemiBold" Foreground="{DynamicResource AppTextBrush}"/></TextBlock>
                                                    </Border>
                                                    <Border Classes="chip" ToolTip.Tip="Link nuovi dalla mappatura (righe con Usa spuntato)">
                                                        <TextBlock><Run Text="Nuovi "/><Run Text="{Binding NewLinkCount}" FontWeight="SemiBold" Foreground="{DynamicResource AppTextBrush}"/></TextBlock>
                                                    </Border>
                                                    <Border Classes="chip" ToolTip.Tip="File SFTP abbinati alle righe della tabella">
                                                        <TextBlock><Run Text="File SFTP "/><Run Text="{Binding SftpFileCount}" FontWeight="SemiBold" Foreground="{DynamicResource AppTextBrush}"/></TextBlock>
                                                    </Border>
                                                    <Border Classes="chip ok" IsVisible="{Binding MappingSummaryOk}">
                                                        <StackPanel Classes="bi"><Path Classes="icon" Data="{StaticResource IconCheck}"/><TextBlock Text="{Binding MappingSummaryText}"/></StackPanel>
                                                    </Border>
                                                    <Border Classes="chip warn" IsVisible="{Binding MappingSummaryWarn}">
                                                        <StackPanel Classes="bi"><Path Classes="icon" Data="{StaticResource IconAlertCircle}"/><TextBlock Text="{Binding MappingSummaryText}"/></StackPanel>
                                                    </Border>
                                                    <Border Classes="chip info" IsVisible="{Binding MappingSummaryInfo}">
                                                        <StackPanel Classes="bi"><Path Classes="icon" Data="{StaticResource IconLayers}"/><TextBlock Text="{Binding MappingSummaryText}"/></StackPanel>
                                                    </Border>
                                                </WrapPanel>
                                            </StackPanel>
                                            <Button Grid.Column="1" Classes="success" VerticalAlignment="Top" Command="{Binding ApplyUpdatesAsync}" IsEnabled="{Binding HasMappingItems}" ToolTip.ShowOnDisabled="True"
                                                    ToolTip.Tip="Invia i nuovi link (e il titolo) a Videobox. I link deselezionati verranno rimossi dal post. Si attiva quando la tabella contiene dei link. Suggerimento: con Ctrl o Maiusc selezioni più righe, poi Spazio (o clic destro) per metterle o toglierle tutte insieme.">
                                                <StackPanel Classes="bi"><Path Classes="icon" Data="{StaticResource IconCheck}"/><TextBlock Text="Applica"/></StackPanel>
                                            </Button>
                                        </Grid>
                                        <Border DockPanel.Dock="Top" Classes="chip ok" HorizontalAlignment="Left" Margin="0,0,0,10" IsVisible="{Binding HasLastApplySummary}">
                                            <TextBlock Text="{Binding LastApplySummary}" TextWrapping="Wrap"/>
                                        </Border>

                                        <Panel>
                                            <h:FillSlot>
                                            <DataGrid Name="MappingGrid" MinHeight="0"
                                                      ItemsSource="{Binding MappingItems}"
                                                      SelectionMode="Extended"
                                                      SelectionChanged="OnMappingSelectionChanged"
                                                      SelectedItem="{Binding SelectedMappingItem, Mode=TwoWay}"
                                                      AutoGenerateColumns="False"
                                                      IsReadOnly="False"
                                                      CanUserResizeColumns="True"
                                                      CanUserReorderColumns="False"
                                                      CanUserSortColumns="False"
                                                      HorizontalScrollBarVisibility="Disabled"
                                                      VerticalScrollBarVisibility="Auto">
                            <DataGrid.ContextMenu>
                            <ContextMenu>
                            <MenuItem Header="Usa le righe selezionate" Command="{Binding UseSelectedRowsCommand}" InputGesture="Space"><MenuItem.Icon><Path Classes="icon" Data="{StaticResource IconCheck}"/></MenuItem.Icon></MenuItem>
                            <MenuItem Header="Non usare le righe selezionate (verranno tolte)" Command="{Binding SkipSelectedRowsCommand}"><MenuItem.Icon><Path Classes="icon" Data="{StaticResource IconClose}"/></MenuItem.Icon></MenuItem>
                            <Separator/>
                            <MenuItem Header="Copia vecchio URL" Click="OnVbCopyOldUrlClick"><MenuItem.Icon><Path Classes="icon" Data="{StaticResource IconCopy}"/></MenuItem.Icon></MenuItem>
                            <MenuItem Header="Copia nuovo URL" Click="OnVbCopyNewUrlClick"><MenuItem.Icon><Path Classes="icon" Data="{StaticResource IconCopy}"/></MenuItem.Icon></MenuItem>
                            <MenuItem Header="Copia nome file SFTP" Click="OnVbCopyFileNameClick"><MenuItem.Icon><Path Classes="icon" Data="{StaticResource IconFile}"/></MenuItem.Icon></MenuItem>
                            <Separator/>
                            <MenuItem Header="Copia tutti i vecchi URL" Click="OnVbCopyAllOldUrlsClick"><MenuItem.Icon><Path Classes="icon" Data="{StaticResource IconList}"/></MenuItem.Icon></MenuItem>
                            <MenuItem Header="Copia tutti i nuovi URL" Click="OnVbCopyAllNewUrlsClick"><MenuItem.Icon><Path Classes="icon" Data="{StaticResource IconList}"/></MenuItem.Icon></MenuItem>
                            </ContextMenu>
                            </DataGrid.ContextMenu>
                                                <DataGrid.Columns>
                                                    <DataGridCheckBoxColumn Header="Usa" Binding="{Binding IsSelectedForUpdate}" Width="52"/>
                                                    <DataGridTemplateColumn Header="#" Width="44" IsReadOnly="True">
                                                        <DataGridTemplateColumn.CellTemplate>
                                                            <DataTemplate x:DataType="vm:EpisodeMappingItem">
                                                                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Margin="2,0">
                                                                    <Ellipse Width="9" Height="9" VerticalAlignment="Center" Fill="{Binding Status, Converter={x:Static vm:StatusToBrushConverter.Default}}"
                                                                             ToolTip.Tip="{Binding Status, Converter={x:Static vm:MappingStatusToTextConverter.Default}}"/>
                                                                    <TextBlock Text="{Binding Index}" FontSize="12" VerticalAlignment="Center" Foreground="{DynamicResource AppTextMutedBrush}"/>
                                                                </StackPanel>
                                                            </DataTemplate>
                                                        </DataGridTemplateColumn.CellTemplate>
                                                    </DataGridTemplateColumn>
                                                    <DataGridTemplateColumn Header="Sul forum ora" Width="*" MinWidth="170" IsReadOnly="True">
                                                        <DataGridTemplateColumn.CellTemplate>
                                                            <DataTemplate x:DataType="vm:EpisodeMappingItem">
                                                                <StackPanel Spacing="1" VerticalAlignment="Center" Margin="4,6" ToolTip.Tip="{Binding OldUrl}">
                                                                    <TextBlock Text="{Binding OldName}" FontWeight="Medium" TextTrimming="PrefixCharacterEllipsis"/>
                                                                    <TextBlock Text="{Binding OldWhere}" FontSize="11" Foreground="{DynamicResource AppTextMutedBrush}" TextTrimming="PrefixCharacterEllipsis" IsVisible="{Binding HasOld}"/>
                                                                </StackPanel>
                                                            </DataTemplate>
                                                        </DataGridTemplateColumn.CellTemplate>
                                                    </DataGridTemplateColumn>
                                                    <DataGridTemplateColumn Header="" Width="28" IsReadOnly="True" CanUserResize="False">
                                                        <DataGridTemplateColumn.CellTemplate>
                                                            <DataTemplate x:DataType="vm:EpisodeMappingItem">
                                                                <Path Classes="icon" Width="12" Height="12" HorizontalAlignment="Center" VerticalAlignment="Center" Data="{StaticResource IconArrowRight}"
                                                                      Stroke="{DynamicResource AppTextMutedBrush}" IsVisible="{Binding ShowNew}"/>
                                                            </DataTemplate>
                                                        </DataGridTemplateColumn.CellTemplate>
                                                    </DataGridTemplateColumn>
                                                    <DataGridTemplateColumn Header="Diventa" Width="*" MinWidth="170" IsReadOnly="True">
                                                        <DataGridTemplateColumn.CellTemplate>
                                                            <DataTemplate x:DataType="vm:EpisodeMappingItem">
                                                                <Panel Margin="4,6" VerticalAlignment="Center">
                                                                    <StackPanel Spacing="1" IsVisible="{Binding ShowNew}" ToolTip.Tip="{Binding NewUrl}">
                                                                        <TextBlock Text="{Binding NewName}" FontWeight="SemiBold" Foreground="{DynamicResource AppAccentBrush}" TextTrimming="PrefixCharacterEllipsis"/>
                                                                        <TextBlock Text="{Binding NewWhere}" FontSize="11" Foreground="{DynamicResource AppTextMutedBrush}" TextTrimming="PrefixCharacterEllipsis"/>
                                                                    </StackPanel>
                                                                    <TextBlock Classes="unchanged" Classes.saved="{Binding IsSavedOnForum}" Classes.notConfirmed="{Binding IsNotConfirmed}"
                                                                               Text="{Binding UnchangedText}" FontSize="12"
                                                                               VerticalAlignment="Center" IsVisible="{Binding !ShowNew}"/>
                                                                </Panel>
                                                            </DataTemplate>
                                                        </DataGridTemplateColumn.CellTemplate>
                                                    </DataGridTemplateColumn>
                                                    <DataGridTemplateColumn Header="Ordine" Width="90" IsReadOnly="True" CanUserResize="False">
                                                        <DataGridTemplateColumn.CellTemplate>
                                                            <DataTemplate x:DataType="vm:EpisodeMappingItem">
                                                                <StackPanel Orientation="Horizontal" Spacing="2" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                                    <Button Classes="iconCircle" Width="26" Height="26" ToolTip.Tip="Scambia con la riga sopra"
                                                                            Command="{Binding $parent[DataGrid].((vm:VideoboxTabViewModel)DataContext).SwapUpCommand}" CommandParameter="{Binding}">
                                                                        <Path Classes="icon" Data="{StaticResource IconArrowUp}" Width="12" Height="12"/>
                                                                    </Button>
                                                                    <Button Classes="iconCircle" Width="26" Height="26" ToolTip.Tip="Scambia con la riga sotto"
                                                                            Command="{Binding $parent[DataGrid].((vm:VideoboxTabViewModel)DataContext).SwapDownCommand}" CommandParameter="{Binding}">
                                                                        <Path Classes="icon" Data="{StaticResource IconArrowDown}" Width="12" Height="12"/>
                                                                    </Button>
                                                                </StackPanel>
                                                            </DataTemplate>
                                                        </DataGridTemplateColumn.CellTemplate>
                                                    </DataGridTemplateColumn>
                                                </DataGrid.Columns>
                                            </DataGrid>
                                            </h:FillSlot>

                                            <!-- Post aperto ma tabella vuota: cosa fare -->
                                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8" MaxWidth="360" IsVisible="{Binding ShowMappingHint}">
                                                <Path Classes="icon" Width="28" Height="28" HorizontalAlignment="Center" Data="{StaticResource IconLayers}" Stroke="{DynamicResource AppTextMutedBrush}"/>
                                                <TextBlock Text="Nessun link da mostrare" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                                <TextBlock Text="Clicca la cartella del post nell'albero SFTP e premi Mappa: i file verranno abbinati ai link in ordine." FontSize="12"
                                                           TextWrapping="Wrap" TextAlignment="Center" Foreground="{DynamicResource AppTextMutedBrush}"/>
                                            </StackPanel>
                                        </Panel>
                                    </DockPanel>
                                </Border>
                            </Grid>
                        </Grid>
                    </Grid>
                    </h:FillViewportPanel>
                    </ScrollViewer>
                    <!-- Copia del messaggio fissata in alto, visibile solo scorrendo (StickyBanner) -->
                    <Border x:Name="VideoboxStickyBanner" VerticalAlignment="Top" IsVisible="False" Padding="0,10,0,0" Background="{DynamicResource AppBackgroundBrush}">
                        <ContentControl Margin="0,0,0,8" Theme="{StaticResource StatusBannerTheme}" Content="{Binding StatusMessage}" IsVisible="{Binding StatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                    </Border>
                    </Panel>
                </Panel>
                <Panel IsVisible="{Binding #MainTabs.SelectedIndex, Converter={x:Static vm:IndexEqualsConverter.Default}, ConverterParameter=6}">
                    <!-- Il messaggio di stato sta nella pagina; scorrendo ne compare una copia fissa in alto -->
                    <Panel DataContext="{Binding Proxy}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" h:StickyBanner.Overlay="{Binding #ProxyStickyBanner}">
                    <DockPanel Margin="0,10,0,0">
                        <DockPanel.Styles>
                            <!-- Pillole di stato (stesso linguaggio visivo dei pulsanti colorati dell'app) -->
                            <Style Selector="Border.pill">
                                <Setter Property="CornerRadius" Value="11"/>
                                <Setter Property="Padding" Value="9,3"/>
                                <Setter Property="Background" Value="{DynamicResource AppSurface2Brush}"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                            </Style>
                            <Style Selector="Border.pill TextBlock">
                                <Setter Property="FontSize" Value="12"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="Foreground" Value="{DynamicResource AppTextMutedBrush}"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                            </Style>
                            <Style Selector="Border.pill Path.icon">
                                <Setter Property="Width" Value="11"/>
                                <Setter Property="Height" Value="11"/>
                                <Setter Property="StrokeThickness" Value="2.2"/>
                                <Setter Property="Stroke" Value="{DynamicResource AppTextMutedBrush}"/>
                            </Style>
                            <Style Selector="Border.pill StackPanel.bi"><Setter Property="Spacing" Value="4"/></Style>
                            <Style Selector="Border.pill.ok"><Setter Property="Background" Value="{DynamicResource AppSuccessSoftBrush}"/></Style>
                            <Style Selector="Border.pill.ok TextBlock"><Setter Property="Foreground" Value="{DynamicResource AppSuccessBrush}"/></Style>
                            <Style Selector="Border.pill.ok Path.icon"><Setter Property="Stroke" Value="{DynamicResource AppSuccessBrush}"/></Style>
                            <Style Selector="Border.pill.failed"><Setter Property="Background" Value="{DynamicResource AppDangerSoftBrush}"/></Style>
                            <Style Selector="Border.pill.failed TextBlock"><Setter Property="Foreground" Value="{DynamicResource AppDangerBrush}"/></Style>
                            <Style Selector="Border.pill.failed Path.icon"><Setter Property="Stroke" Value="{DynamicResource AppDangerBrush}"/></Style>
                            <Style Selector="Border.pill.untested"><Setter Property="Background" Value="{DynamicResource AppWarningSoftBrush}"/></Style>
                            <Style Selector="Border.pill.untested TextBlock"><Setter Property="Foreground" Value="{DynamicResource AppWarningBrush}"/></Style>
                            <Style Selector="Border.pill.untested Path.icon"><Setter Property="Stroke" Value="{DynamicResource AppWarningBrush}"/></Style>
                            <Style Selector="Border.pill.info"><Setter Property="Background" Value="{DynamicResource AppInfoSoftBrush}"/></Style>
                            <Style Selector="Border.pill.info TextBlock"><Setter Property="Foreground" Value="{DynamicResource AppInfoBrush}"/></Style>
                            <Style Selector="Border.pill.info Path.icon"><Setter Property="Stroke" Value="{DynamicResource AppInfoBrush}"/></Style>
                            <Style Selector="Border.pill.active"><Setter Property="Background" Value="{DynamicResource AppAccentBrush}"/></Style>
                            <Style Selector="Border.pill.active TextBlock"><Setter Property="Foreground" Value="White"/></Style>
                            <Style Selector="Border.pill.active Path.icon"><Setter Property="Stroke" Value="White"/></Style>
                            <Style Selector="Border.pill.absent">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}"/>
                                <Setter Property="BorderThickness" Value="1"/>
                                <Setter Property="Opacity" Value="0.45"/>
                            </Style>
                            <Style Selector="Border.pill.ring">
                                <Setter Property="BorderBrush" Value="{DynamicResource AppAccentBrush}"/>
                                <Setter Property="BorderThickness" Value="1.5"/>
                            </Style>

                            <!-- Pallino "ha un proxy attivo" sulle schede -->
                            <Style Selector="Ellipse.dot">
                                <Setter Property="Width" Value="8"/>
                                <Setter Property="Height" Value="8"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="Fill" Value="{DynamicResource AppBorderBrush}"/>
                            </Style>
                            <Style Selector="Ellipse.dot.on"><Setter Property="Fill" Value="{DynamicResource AppSuccessBrush}"/></Style>

                            <!-- Icona tonda del riquadro "proxy attivo" -->
                            <Style Selector="Border.badgeIcon">
                                <Setter Property="Width" Value="42"/>
                                <Setter Property="Height" Value="42"/>
                                <Setter Property="CornerRadius" Value="21"/>
                                <Setter Property="Background" Value="{DynamicResource AppSurface2Brush}"/>
                                <Setter Property="VerticalAlignment" Value="Top"/>
                            </Style>
                            <Style Selector="Border.badgeIcon Path.icon">
                                <Setter Property="Width" Value="20"/>
                                <Setter Property="Height" Value="20"/>
                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                <Setter Property="Stroke" Value="{DynamicResource AppTextMutedBrush}"/>
                            </Style>
                            <Style Selector="Border.badgeIcon.on"><Setter Property="Background" Value="{DynamicResource AppSuccessSoftBrush}"/></Style>
                            <Style Selector="Border.badgeIcon.on Path.icon"><Setter Property="Stroke" Value="{DynamicResource AppSuccessBrush}"/></Style>

                            <!-- Esito dell'attivazione -->
                            <Style Selector="Border.result">
                                <Setter Property="CornerRadius" Value="8"/>
                                <Setter Property="Padding" Value="12,8"/>
                                <Setter Property="BorderThickness" Value="1"/>
                                <Setter Property="Background" Value="{DynamicResource AppDangerSoftBrush}"/>
                                <Setter Property="BorderBrush" Value="{DynamicResource AppDangerBrush}"/>
                            </Style>
                            <Style Selector="Border.result Path.icon"><Setter Property="Stroke" Value="{DynamicResource AppDangerBrush}"/></Style>
                            <Style Selector="Border.result.ok">
                                <Setter Property="Background" Value="{DynamicResource AppSuccessSoftBrush}"/>
                                <Setter Property="BorderBrush" Value="{DynamicResource AppSuccessBrush}"/>
                            </Style>
                            <Style Selector="Border.result.ok Path.icon"><Setter Property="Stroke" Value="{DynamicResource AppSuccessBrush}"/></Style>

                            <Style Selector="TextBlock.mono">
                                <Setter Property="FontFamily" Value="Consolas,Cascadia Mono,Menlo,monospace"/>
                            </Style>
                            <Style Selector="TextBlock.section">
                                <Setter Property="FontSize" Value="11"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="Foreground" Value="{DynamicResource AppTextMutedBrush}"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                            </Style>
                        </DockPanel.Styles>
                        <ContentControl DockPanel.Dock="Top" Theme="{StaticResource StatusBannerTheme}" Content="{Binding ProxyStatusMessage}"/>


                        <!-- GUIDA PROXY -->
                        <Border DockPanel.Dock="Top" Classes="cardElevated" Margin="0,0,0,12" Padding="0" ClipToBounds="True">
                            <StackPanel>
                                <ToggleButton Classes="guideToggle" x:Name="ToggleGuideProxy" IsChecked="False">
                                    <Grid ColumnDefinitions="*, Auto">
                                        <StackPanel Classes="bi">
                                            <Path Classes="icon accent" Data="{StaticResource IconBulb}"/>
                                            <TextBlock Text="Guida rapida - Proxy" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource AppTextBrush}"/>
                                        </StackPanel>
                                        <Path Grid.Column="1" Classes="chevron"/>
                                    </Grid>
                                </ToggleButton>
                                <Border IsVisible="{Binding #ToggleGuideProxy.IsChecked}" Background="Transparent" Margin="16,0,16,16" Padding="12,12,4,12">
                                    <ScrollViewer MaxHeight="240" VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
                                    <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource AppTextMutedBrush}">
                                        <Run FontWeight="Bold" Foreground="{DynamicResource AppTextBrush}">Come è organizzata</Run><LineBreak/>
                                        Tutti i proxy stanno nell'<Run FontWeight="SemiBold" Foreground="{DynamicResource AppTextBrush}">Archivio</Run>. Ogni provider ha la sua <Run FontWeight="SemiBold" Foreground="{DynamicResource AppTextBrush}">lista</Run>, con l'esito dei test solo per quel sito e un solo proxy attivo, mostrato nel riquadro "Proxy attivo" in cima alla scheda. Lo stesso proxy può funzionare per un sito e non per un altro.<LineBreak/>
                                        <LineBreak/>
                                        <Run FontWeight="Bold" Foreground="{DynamicResource AppTextBrush}">Stati</Run><LineBreak/>
                                        <Run FontWeight="SemiBold" Foreground="{DynamicResource AppSuccessBrush}">• Funziona:</Run> ha superato l'ultimo test su questo sito (con il tempo di risposta).<LineBreak/>
                                        <Run FontWeight="SemiBold" Foreground="{DynamicResource AppWarningBrush}">• Da testare:</Run> mai provato su questo sito.<LineBreak/>
                                        <Run FontWeight="SemiBold" Foreground="{DynamicResource AppDangerBrush}">• Fallito:</Run> l'ultimo test non è andato, ma è ancora in lista (succede se l'esclusione automatica è spenta).<LineBreak/>
                                        <Run FontWeight="SemiBold" Foreground="{DynamicResource AppTextBrush}">• Escluso:</Run> tolto solo dalla lista di questo sito (fallito al test o escluso a mano). Non viene più testato né riaggiunto quando importi; resta valido per gli altri siti. "Ripristina" lo rimette in lista.<LineBreak/>
                                        <LineBreak/>
                                        <Run FontWeight="Bold" Foreground="{DynamicResource AppTextBrush}">Attivare</Run><LineBreak/>
                                        <Run FontWeight="SemiBold" Foreground="{DynamicResource AppTextBrush}">• Attiva il più veloce:</Run> riprova i funzionanti dal più rapido e attiva il primo che risponde ancora.<LineBreak/>
                                        <Run FontWeight="SemiBold" Foreground="{DynamicResource AppTextBrush}">• Attiva selezionato:</Run> verifica il proxy scelto nella lista e lo attiva solo se funziona.<LineBreak/>
                                        <Run FontWeight="SemiBold" Foreground="{DynamicResource AppTextBrush}">• Interruttore:</Run> spento, il sito usa la connessione diretta anche se c'è un proxy attivo.<LineBreak/>
                                        <LineBreak/>
                                        <Run FontWeight="Bold" Foreground="{DynamicResource AppTextBrush}">Testare</Run><LineBreak/>
                                        <Run FontWeight="SemiBold" Foreground="{DynamicResource AppTextBrush}">• Testa da testare / Ritesta tutti:</Run> solo la lista aperta. <Run FontWeight="SemiBold" Foreground="{DynamicResource AppTextBrush}">Testa tutti i provider:</Run> ritesta tutte le liste una dopo l'altra (anche dall'Archivio); "Stop" ferma tutto.<LineBreak/>
                                        <Run FontWeight="SemiBold" Foreground="{DynamicResource AppTextBrush}">• Test CB01:</Run> prova la home di Maxstream, la sua pagina di login e la home di CB01, e segnala se Cloudflare chiede la verifica.<LineBreak/>
                                        <LineBreak/>
                                        <Run FontWeight="Bold" Foreground="{DynamicResource AppTextBrush}">CB01 · Maxstream</Run><LineBreak/>
                                        <Run FontWeight="SemiBold" Foreground="{DynamicResource AppTextBrush}">• Solo residenziali:</Run> Cloudflare blocca login e link di Maxstream da proxy di datacenter o VPN, anche quando il test risulta OK. Usa proxy residenziali (IP di casa o mobili, meglio se fissi) oppure lascia il proxy spento: con la connessione di casa CB01 funziona.<LineBreak/>
                                        <Run FontWeight="SemiBold" Foreground="{DynamicResource AppTextBrush}">• Account:</Run> ogni cambio di IP è un nuovo accesso all'account Maxstream: alternare molti proxy diversi può portare Maxstream a chiedere di verificare di nuovo il login dal browser.<LineBreak/>
                                        <LineBreak/>
                                        <Run FontWeight="Bold" Foreground="{DynamicResource AppTextBrush}">Aggiungere e togliere</Run><LineBreak/>
                                        <Run FontWeight="SemiBold" Foreground="{DynamicResource AppTextBrush}">• Importa:</Run> incolla una lista o caricala da file, per tutte le liste o solo per alcune. I doppioni vengono saltati.<LineBreak/>
                                        <Run FontWeight="SemiBold" Foreground="{DynamicResource AppTextBrush}">• Togli da tutte le liste:</Run> resta solo nell'archivio. <Run FontWeight="SemiBold" Foreground="{DynamicResource AppTextBrush}">Elimina</Run> lo cancella definitivamente; "Pulisci archivio" elimina in un colpo i proxy falliti o esclusi ovunque.
                                    </TextBlock>
                                    </ScrollViewer>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- SCHEDE: una lista per provider + archivio -->
                        <Border DockPanel.Dock="Top" Classes="cardElevated" Margin="0,0,0,12" Padding="8">
                            <ListBox ItemsSource="{Binding Tabs}" SelectedItem="{Binding SelectedTab, Mode=TwoWay}" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                                </ListBox.ItemsPanel>
                                <ListBox.Styles>
                                    <Style Selector="ListBoxItem">
                                        <Setter Property="Margin" Value="0,0,6,0"/>
                                        <Setter Property="Padding" Value="14,8"/>
                                        <Setter Property="CornerRadius" Value="8"/>
                                    </Style>
                                </ListBox.Styles>
                                <ListBox.ItemTemplate>
                                    <DataTemplate x:DataType="vm:ProxyListTab">
                                        <StackPanel Spacing="6">
                                            <StackPanel Orientation="Horizontal" Spacing="7">
                                                <Ellipse Classes="dot" Classes.on="{Binding HasActive}" IsVisible="{Binding !IsArchive}" ToolTip.Tip="Verde = c'è un proxy attivo"/>
                                                <Path Classes="icon" Data="{StaticResource IconLayers}" Width="12" Height="12" IsVisible="{Binding IsArchive}"/>
                                                <TextBlock Text="{Binding Title}" FontWeight="Bold"/>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                <Border Classes="pill ok" IsVisible="{Binding HasOk}" ToolTip.Tip="Funzionanti"><StackPanel Classes="bi"><Path Classes="icon" Data="{StaticResource IconCheck}"/><TextBlock Text="{Binding OkCount}"/></StackPanel></Border>
                                                <Border Classes="pill untested" IsVisible="{Binding HasUntested}" ToolTip.Tip="Da testare"><StackPanel Classes="bi"><Path Classes="icon" Data="{StaticResource IconClock}"/><TextBlock Text="{Binding UntestedCount}"/></StackPanel></Border>
                                                <Border Classes="pill failed" IsVisible="{Binding HasFailed}" ToolTip.Tip="Falliti"><StackPanel Classes="bi"><Path Classes="icon" Data="{StaticResource IconAlertCircle}"/><TextBlock Text="{Binding FailedCount}"/></StackPanel></Border>
                                                <Border Classes="pill" IsVisible="{Binding IsEmpty}"><TextBlock Text="vuota"/></Border>
                                                <Border Classes="pill" IsVisible="{Binding IsArchive}"><TextBlock Text="{Binding CountsText}"/></Border>
                                            </StackPanel>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Border>

                        <!-- PROXY ATTIVO DEL PROVIDER -->
                        <Border DockPanel.Dock="Top" Classes="cardElevated" Margin="0,0,0,12" IsVisible="{Binding IsProviderTab}">
                            <StackPanel Spacing="12">
                                <Grid ColumnDefinitions="Auto, *, Auto">
                                    <Border Classes="badgeIcon" Classes.on="{Binding HasActiveProxy}" Margin="0,0,14,0">
                                        <Path Classes="icon" Data="{StaticResource IconGlobe}"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                                        <TextBlock Classes="section">
                                            <Run Text="PROXY ATTIVO · "/><Run Text="{Binding CurrentListTitle}"/>
                                        </TextBlock>
                                        <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding HasActiveProxy}">
                                            <TextBlock Classes="mono" Text="{Binding ActiveProxy.Address, FallbackValue=''}" FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/>
                                            <Border Classes="pill active"><StackPanel Classes="bi"><Path Classes="icon" Data="{StaticResource IconBolt}"/><TextBlock Text="ATTIVO"/></StackPanel></Border>
                                        </StackPanel>
                                        <TextBlock Text="{Binding ActiveDetailText}" FontSize="12" Foreground="{DynamicResource AppTextMutedBrush}" IsVisible="{Binding HasActiveProxy}"/>
                                        <TextBlock Text="Nessun proxy attivo" FontSize="18" FontWeight="Bold" IsVisible="{Binding NoActiveProxy}"/>
                                        <TextBlock Text="Il sito usa la connessione diretta. Premi &quot;Attiva il più veloce&quot; per sceglierne uno." FontSize="12" Foreground="{DynamicResource AppTextMutedBrush}" IsVisible="{Binding NoActiveProxy}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Spacing="2" VerticalAlignment="Top" HorizontalAlignment="Right" ToolTip.Tip="{Binding UseProxyHint}">
                                        <ToggleSwitch IsChecked="{Binding CurrentUseProxy, Mode=TwoWay}" OnContent="Proxy in uso" OffContent="Connessione diretta"/>
                                    </StackPanel>
                                </Grid>

                                <TextBlock Text="{Binding UseProxyHint}" FontSize="11" Foreground="{DynamicResource AppTextMutedBrush}" TextWrapping="Wrap"/>

                                <!-- CB01 · Maxstream: servono proxy residenziali -->
                                <Border IsVisible="{Binding IsCb01Tab}" Background="{DynamicResource AppWarningSoftBrush}" BorderBrush="{DynamicResource AppWarningBrush}" BorderThickness="1" CornerRadius="10" Padding="12,10">
                                    <Grid ColumnDefinitions="Auto, *">
                                        <Path Classes="icon warn" Data="{StaticResource IconAlertCircle}" Width="18" Height="18" VerticalAlignment="Top" Margin="0,1,12,0"/>
                                        <StackPanel Grid.Column="1" Spacing="4">
                                            <TextBlock Text="Solo proxy residenziali" FontWeight="Bold" Foreground="{DynamicResource AppWarningBrush}"/>
                                            <TextBlock TextWrapping="Wrap" FontSize="12">
                                                Maxstream è protetto da Cloudflare, che blocca login e link quando la connessione arriva da proxy di <Run FontWeight="SemiBold">datacenter o VPN</Run> (anche se il test qui risulta OK). Usa solo <Run FontWeight="SemiBold">proxy residenziali</Run> (IP di casa o mobili, meglio se fissi: ogni cambio di IP è un nuovo accesso all'account), oppure lascia il proxy spento: con la connessione di casa CB01 funziona.
                                            </TextBlock>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <WrapPanel Orientation="Horizontal" ItemSpacing="8" LineSpacing="6">
                                    <Button Classes="success" Command="{Binding ProxyActivateFastestCommand}" IsEnabled="{Binding !IsActivating}" ToolTip.Tip="Riprova i proxy funzionanti dal più veloce e attiva il primo che risponde"><StackPanel Classes="bi"><Path Classes="icon" Data="{StaticResource IconBolt}"/><TextBlock Text="Attiva il più veloce"/></StackPanel></Button>
                                    <Button Classes="accent" Command="{Binding ProxyActivateCommand}" IsEnabled="{Binding !IsActivating}" ToolTip.Tip="Verifica il proxy selezionato nella lista e lo attiva se funziona"><StackPanel Classes="bi"><Path Classes="icon" Data="{StaticResource IconPlay}"/><TextBlock Text="Attiva selezionato"/></StackPanel></Button>
                                    <Button Command="{Binding ProxyRotateNextCommand}" IsEnabled="{Binding !IsActivating}" ToolTip.Tip="Passa al prossimo proxy funzionante, dal più veloce"><StackPanel Classes="bi"><Path Classes="icon" Data="{StaticResource IconRepeat}"/><TextBlock Text="Ruota al prossimo"/></StackPanel></Button>
                                    <Button Classes="warning" Command="{Binding ProxyDeactivateCommand}" IsEnabled="{Binding HasActiveProxy}" ToolTip.Tip="Toglie il proxy attivo: il sito va in connessione diretta"><StackPanel Classes="bi"><Path Classes="icon" Data="{StaticResource IconBoltOff}"/><TextBlock Text="Disattiva"/></StackPanel></Button>
                                </WrapPanel>

                                <StackPanel Spacing="6" IsVisible="{Binding IsActivating}">
                                    <ProgressBar IsIndeterminate="True" Height="4" MinHeight="4"/>
                                    <TextBlock Text="{Binding ActivatingText}" FontSize="12" Foreground="{DynamicResource AppInfoBrush}"/>
                                </StackPanel>

                                <Border Classes="result" Classes.ok="{Binding ActivationResultOk}" IsVisible="{Binding HasActivationResult}">
                                    <Grid ColumnDefinitions="Auto, *">
                                        <Panel Margin="0,0,10,0" VerticalAlignment="Center">
                                            <Path Classes="icon" Data="{StaticResource IconCheckCircle}" Width="16" Height="16" IsVisible="{Binding ActivationResultOk}"/>
                                            <Path Classes="icon" Data="{StaticResource IconAlertCircle}" Width="16" Height="16" IsVisible="{Binding !ActivationResultOk}"/>
                                        </Panel>
                                        <TextBlock Grid.Column="1" Text="{Binding ActivationResultText}" TextWrapping="Wrap" FontSize="12" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- RIEPILOGO ARCHIVIO -->
                        <Border DockPanel.Dock="Top" Classes="cardElevated" Margin="0,0,0,12" IsVisible="{Binding IsArchiveTab}">
                            <Grid ColumnDefinitions="Auto, *, Auto">
                                <Border Classes="badgeIcon" Margin="0,0,14,0"><Path Classes="icon" Data="{StaticResource IconLayers}"/></Border>
                                <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                                    <TextBlock Classes="section" Text="ARCHIVIO"/>
                                    <TextBlock Text="{Binding ArchiveSummary}" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                    <TextBlock Text="Le sigle su ogni riga indicano le liste del proxy e il suo stato in ciascuna (bordo blu = attivo lì)." FontSize="12" Foreground="{DynamicResource AppTextMutedBrush}" TextWrapping="Wrap"/>
                                </StackPanel>
                                <Button Grid.Column="2" Classes="danger" Click="OnProxyCleanupArchiveClick" VerticalAlignment="Center" ToolTip.Tip="Elimina i proxy falliti o esclusi in tutte le loro liste"><StackPanel Classes="bi"><Path Classes="icon" Data="{StaticResource IconTrash}"/><TextBlock Text="Pulisci archivio"/></StackPanel></Button>
                            </Grid>
                        </Border>

                        <!-- AZIONI -->
                        <Border DockPanel.Dock="Top" Classes="cardElevated" Margin="0,0,0,12">
                            <StackPanel Spacing="10">
                                <WrapPanel Orientation="Horizontal" ItemSpacing="8" LineSpacing="6">
                                    <TextBlock Classes="section" Text="PROXY" Width="64"/>
                                    <Button Classes="accent" Command="{Binding ProxyNewCommand}" ToolTip.Tip="Inserisci un proxy a mano"><StackPanel Classes="bi"><Path Classes="icon" Data="{StaticResource IconPlus}"/><TextBlock Text="Nuovo"/></StackPanel></Button>
                                    <Button Click="OnProxyImportFileClick" IsEnabled="{Binding !IsProxyBusy}" ToolTip.Tip="Incolla una lista o caricala da file, in tutte le liste o solo in alcune"><StackPanel Classes="bi"><Path Classes="icon" Data="{StaticResource IconUpload}"/><TextBlock Text="Importa"/></StackPanel></Button>
                                    <Button Command="{Binding ProxySaveCommand}" IsEnabled="{Binding !IsProxyBusy}" ToolTip.Tip="Salva le modifiche al proxy selezionato"><StackPanel Classes="bi"><Path Classes="icon" Data="{StaticResource IconSave}"/><TextBlock Text="Salva"/></StackPanel></Button>
                                </WrapPanel>

                                <WrapPanel Orientation="Horizontal" ItemSpacing="8" LineSpacing="6">
                                    <TextBlock Classes="section" Text="TEST" Width="64"/>
                                    <Button Classes="info" Command="{Binding ProxyTestUntestedCommand}" IsEnabled="{Binding !IsProxyBusy}" IsVisible="{Binding IsProviderTab}" ToolTip.Tip="Prova solo i proxy mai testati in questa lista"><StackPanel Classes="bi"><Path Classes="icon" Data="{StaticResource IconClock}"/><TextBlock Text="Testa da testare"/></StackPanel></Button>
                                    <Button Command="{Binding ProxyTestSelectedCommand}" IsEnabled="{Binding !IsProxyBusy}" IsVisible="{Binding IsProviderTab}" ToolTip.Tip="Prova i proxy spuntati"><StackPanel Classes="bi"><Path Classes="icon" Data="{StaticResource IconCheck}"/><TextBlock Text="Testa selezionati"/></StackPanel></Button>
                                    <Button Command="{Binding ProxyRetestAllCommand}" IsEnabled="{Binding !IsProxyBusy}" IsVisible="{Binding IsProviderTab}" ToolTip.Tip="Riprova tutti i proxy della lista (non gli esclusi)"><StackPanel Classes="bi"><Path Classes="icon" Data="{StaticResource IconRefresh}"/><TextBlock Text="Ritesta tutti"/></StackPanel></Button>
                                    <Button Classes="accent" Command="{Binding ProxyTestAllProvidersCommand}" IsEnabled="{Binding !IsProxyBusy}" ToolTip.Tip="Ritesta i proxy di tutte le liste (AnimeWorld, AnimeSaturn, StreamingCommunity, CB01, Download), un provider dopo l'altro. Gli esclusi non vengono testati."><StackPanel Classes="bi"><Path Classes="icon" Data="{StaticResource IconLayers}"/><TextBlock Text="Testa tutti i provider"/></StackPanel></Button>
                                    <Button Classes="danger" Command="{Binding ProxyStopTestCommand}" IsVisible="{Binding IsProxyBusy}" ToolTip.Tip="Interrompe i test in corso"><StackPanel Classes="bi"><Path Classes="icon" Data="{StaticResource IconStop}"/><TextBlock Text="Stop"/></StackPanel></Button>
                                    <Border Width="1" Background="{DynamicResource AppBorderBrush}" Margin="4,2"/>
                                    <TextBlock Text="In parallelo" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource AppTextMutedBrush}"/>
                                    <Slider Value="{Binding ProxyTestConcurrency}" Minimum="1" Maximum="30" Width="110" TickFrequency="1" IsSnapToTickEnabled="True" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding ProxyTestConcurrency}" Width="22" VerticalAlignment="Center" FontWeight="Bold" Foreground="{DynamicResource AppAccentBrush}"/>
                                    <CheckBox Content="Escludi automaticamente i falliti" IsChecked="{Binding AutoExcludeFailed, Mode=TwoWay}" VerticalAlignment="Center" Margin="4,0,0,0" ToolTip.Tip="Un proxy che fallisce il test esce dalla lista di questo sito e non viene più testato"/>
                                </WrapPanel>

                                <WrapPanel Orientation="Horizontal" ItemSpacing="8" LineSpacing="6">
                                    <TextBlock Classes="section" Text="SPUNTATI" Width="64"/>
                                    <Button Command="{Binding ProxySelectAllCommand}" ToolTip.Tip="Spunta tutti i proxy visibili"><StackPanel Classes="bi"><Path Classes="icon" Data="{StaticResource IconCheck}"/><TextBlock Text="Tutti"/></StackPanel></Button>
                                    <Button Command="{Binding ProxyDeselectAllCommand}" ToolTip.Tip="Toglie tutte le spunte"><StackPanel Classes="bi"><Path Classes="icon" Data="{StaticResource IconClose}"/><TextBlock Text="Nessuno"/></StackPanel></Button>
                                    <Border Width="1" Background="{DynamicResource AppBorderBrush}" Margin="4,2"/>
                                    <Button Command="{Binding ProxyExcludeSelectedCommand}" IsVisible="{Binding IsProviderTab}" ToolTip.Tip="Toglie i proxy spuntati solo da questa lista: non verranno più testati qui"><StackPanel Classes="bi"><Path Classes="icon" Data="{StaticResource IconMinusCircle}"/><TextBlock Text="Escludi"/></StackPanel></Button>
                                    <Button Command="{Binding ProxyExcludeFailedCommand}" IsVisible="{Binding IsProviderTab}" ToolTip.Tip="Esclude da questa lista tutti i proxy falliti"><StackPanel Classes="bi"><Path Classes="icon" Data="{StaticResource IconAlertCircle}"/><TextBlock Text="Escludi falliti"/></StackPanel></Button>
                                    <Button Command="{Binding ProxyRestoreSelectedCommand}" IsVisible="{Binding IsProviderTab}" ToolTip.Tip="Riporta in lista gli esclusi spuntati (filtro Esclusi), da testare"><StackPanel Classes="bi"><Path Classes="icon" Data="{StaticResource IconUndo}"/><TextBlock Text="Ripristina"/></StackPanel></Button>
                                    <Button Classes="warning" Command="{Binding ProxyRemoveFromAllListsCommand}" ToolTip.Tip="Toglie i proxy spuntati da tutte le liste: restano solo nell'archivio"><StackPanel Classes="bi"><Path Classes="icon" Data="{StaticResource IconLayers}"/><TextBlock Text="Togli da tutte le liste"/></StackPanel></Button>
                                    <Button Classes="danger" Click="OnProxyDeleteCheckedClick" ToolTip.Tip="Elimina definitivamente i proxy spuntati"><StackPanel Classes="bi"><Path Classes="icon" Data="{StaticResource IconTrash}"/><TextBlock Text="Elimina"/></StackPanel></Button>
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <Grid ColumnDefinitions="3*, 2*">
                            <!-- LISTA -->
                            <Border Grid.Column="0" Classes="cardElevated" Margin="0,0,6,0">
                                <DockPanel>
                                    <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto, Auto, *, 280" Margin="0,0,0,12">
                                        <TextBlock Text="{Binding CurrentListTitle}" FontWeight="Bold" FontSize="16" VerticalAlignment="Center"/>
                                        <Border Grid.Column="1" Classes="pill" Margin="10,0,0,0"><TextBlock Text="{Binding VisibleCountText}"/></Border>
                                        <TextBox Grid.Column="3" x:Name="ProxySearchBox" Text="{Binding SearchText, Mode=TwoWay}" PlaceholderText="Cerca IP, host o nome..."/>
                                    </Grid>
                                    <ListBox DockPanel.Dock="Top" ItemsSource="{Binding Filters}" SelectedItem="{Binding SelectedFilter, Mode=TwoWay}" Background="Transparent" Margin="0,0,0,10" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                        <ListBox.ItemsPanel>
                                            <ItemsPanelTemplate><WrapPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                                        </ListBox.ItemsPanel>
                                        <ListBox.Styles>
                                            <Style Selector="ListBoxItem">
                                                <Setter Property="Margin" Value="0,0,8,0"/>
                                                <Setter Property="Padding" Value="18,8"/>
                                                <Setter Property="MinWidth" Value="90"/>
                                                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                                <Setter Property="CornerRadius" Value="16"/>
                                                <Setter Property="FontSize" Value="13"/>
                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                                <Setter Property="BorderThickness" Value="1"/>
                                                <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}"/>
                                            </Style>
                                        </ListBox.Styles>
                                    </ListBox>
                                    <Border DockPanel.Dock="Top" Background="{DynamicResource AppInfoSoftBrush}" CornerRadius="8" Padding="10,6" Margin="0,0,0,8"
                                            IsVisible="{Binding FilterHint, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                        <Grid ColumnDefinitions="Auto, *">
                                            <Path Classes="icon" Data="{StaticResource IconInfo}" Stroke="{DynamicResource AppInfoBrush}" Width="13" Height="13" Margin="0,0,8,0" VerticalAlignment="Top"/>
                                            <TextBlock Grid.Column="1" Text="{Binding FilterHint}" FontSize="12" TextWrapping="Wrap"/>
                                        </Grid>
                                    </Border>
                                    <ListBox Height="600" ItemsSource="{Binding VisibleProxies}" SelectedItem="{Binding SelectedProxy, Mode=TwoWay}" SelectionMode="Multiple" SelectionChanged="OnProxyListSelectionChanged">
                                        <ListBox.Styles>
                                            <Style Selector="ListBoxItem">
                                                <Setter Property="Margin" Value="0,2"/>
                                                <Setter Property="Padding" Value="10,9"/>
                                                <Setter Property="CornerRadius" Value="8"/>
                                            </Style>
                                        </ListBox.Styles>
                                        <ListBox.ItemTemplate>
                                            <DataTemplate x:DataType="models:ProxyConfig">
                                                <Grid ColumnDefinitions="Auto, *, Auto">
                                                    <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected, Mode=TwoWay}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                                            <TextBlock Classes="mono" Text="{Binding Address}" FontWeight="Bold" FontSize="14" VerticalAlignment="Center"/>
                                                            <Border Classes="pill active" IsVisible="{Binding IsActiveForSelectedProvider}" ToolTip.Tip="Proxy attivo per questo provider">
                                                                <StackPanel Classes="bi"><Path Classes="icon" Data="{StaticResource IconBolt}"/><TextBlock Text="ATTIVO"/></StackPanel>
                                                            </Border>
                                                        </StackPanel>
                                                        <TextBlock Text="{Binding DetailText}" FontSize="12" Foreground="{DynamicResource AppTextMutedBrush}" TextTrimming="CharacterEllipsis"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Margin="8,0,12,0">
                                                        <ItemsControl ItemsSource="{Binding ListBadges}" IsVisible="{Binding !ShowStatus}" VerticalAlignment="Center">
                                                            <ItemsControl.ItemsPanel>
                                                                <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="5"/></ItemsPanelTemplate>
                                                            </ItemsControl.ItemsPanel>
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate x:DataType="models:ProxyListBadge">
                                                                    <Border Classes="pill" MinWidth="56" Classes.absent="{Binding IsAbsent}" Classes.ok="{Binding StatusOk}" Classes.failed="{Binding StatusFailed}" Classes.untested="{Binding StatusUntested}" Classes.ring="{Binding IsActive}" ToolTip.Tip="{Binding Tooltip}">
                                                                        <StackPanel Classes="bi" HorizontalAlignment="Center">
                                                                            <Path Classes="icon" Data="{StaticResource IconCheckCircle}" IsVisible="{Binding StatusOk}"/>
                                                                            <Path Classes="icon" Data="{StaticResource IconAlertCircle}" IsVisible="{Binding StatusFailed}"/>
                                                                            <Path Classes="icon" Data="{StaticResource IconBan}" IsVisible="{Binding StatusExcluded}"/>
                                                                            <Path Classes="icon" Data="{StaticResource IconClock}" IsVisible="{Binding StatusUntested}"/>
                                                                            <TextBlock Text="{Binding Short}"/>
                                                                        </StackPanel>
                                                                    </Border>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                        <Border Classes="pill info" IsVisible="{Binding IsTesting}"><StackPanel Classes="bi"><Path Classes="icon" Data="{StaticResource IconRefresh}"/><TextBlock Text="Test..."/></StackPanel></Border>
                                                        <Border Classes="pill" IsVisible="{Binding LatencyText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" ToolTip.Tip="Tempo di risposta all'ultimo test">
                                                            <TextBlock Classes="mono" Text="{Binding LatencyText}"/>
                                                        </Border>
                                                        <Border Classes="pill" Classes.ok="{Binding StatusOk}" Classes.failed="{Binding StatusFailed}" Classes.untested="{Binding StatusUntested}" IsVisible="{Binding ShowStatus}" MinWidth="104">
                                                            <StackPanel Classes="bi" HorizontalAlignment="Center">
                                                                <Path Classes="icon" Data="{StaticResource IconCheckCircle}" IsVisible="{Binding StatusOk}"/>
                                                                <Path Classes="icon" Data="{StaticResource IconAlertCircle}" IsVisible="{Binding StatusFailed}"/>
                                                                <Path Classes="icon" Data="{StaticResource IconBan}" IsVisible="{Binding StatusExcluded}"/>
                                                                <Path Classes="icon" Data="{StaticResource IconClock}" IsVisible="{Binding StatusUntested}"/>
                                                                <TextBlock Text="{Binding StatusText}"/>
                                                            </StackPanel>
                                                        </Border>
                                                        <TextBlock Text="{Binding LastTestedText}" FontSize="12" Width="78" TextAlignment="Right" Foreground="{DynamicResource AppTextMutedBrush}" VerticalAlignment="Center" ToolTip.Tip="Ultimo test"/>
                                                    </StackPanel>
                                                </Grid>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </DockPanel>
                            </Border>

                            <!-- DETTAGLI -->
                            <Border Grid.Column="1" Classes="cardElevated" Margin="6,0,0,0">
                                <StackPanel Spacing="12">
                                    <TextBlock Classes="section" Text="PROXY SELEZIONATO"/>
                                    <TextBlock Text="Seleziona un proxy dalla lista per vederne i dettagli." FontSize="12" Foreground="{DynamicResource AppTextMutedBrush}" IsVisible="{Binding SelectedProxy, Converter={x:Static ObjectConverters.IsNull}}"/>
                                    <TextBlock Classes="mono" Text="{Binding SelectedProxy.Address, FallbackValue=''}" FontSize="18" FontWeight="Bold" IsVisible="{Binding SelectedProxy, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                                    <Panel IsVisible="{Binding SelectedProxy, Converter={x:Static ObjectConverters.IsNotNull}}">
                                    <Grid ColumnDefinitions="110, *" RowDefinitions="Auto, Auto, Auto, Auto, Auto, Auto, Auto" DataContext="{Binding SelectedProxy}">
                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Nome" VerticalAlignment="Center" Margin="0,0,10,6"/>
                                        <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding Name}" Margin="0,0,0,6"/>
                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Protocollo" VerticalAlignment="Center" Margin="0,0,10,6"/>
                                        <ComboBox Grid.Row="1" Grid.Column="1" SelectedIndex="{Binding ProtocolIndex, Mode=TwoWay}" HorizontalAlignment="Stretch" Margin="0,0,0,6">
                                            <ComboBoxItem>HTTP</ComboBoxItem>
                                            <ComboBoxItem>SOCKS5</ComboBoxItem>
                                        </ComboBox>
                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Host" VerticalAlignment="Center" Margin="0,0,10,6"/>
                                        <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Host}" Margin="0,0,0,6"/>
                                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Porta" VerticalAlignment="Center" Margin="0,0,10,6"/>
                                        <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding Port}" Margin="0,0,0,6"/>
                                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Autenticazione" VerticalAlignment="Center" Margin="0,0,10,6"/>
                                        <ComboBox Grid.Row="4" Grid.Column="1" SelectedIndex="{Binding AuthIndex, Mode=TwoWay}" HorizontalAlignment="Stretch" Margin="0,0,0,6">
                                            <ComboBoxItem>Nessuna</ComboBoxItem>
                                            <ComboBoxItem>Username + Password</ComboBoxItem>
                                        </ComboBox>
                                        <TextBlock Grid.Row="5" Grid.Column="0" Text="Username" VerticalAlignment="Center" Margin="0,0,10,6"/>
                                        <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding Username}" Margin="0,0,0,6"/>
                                        <TextBlock Grid.Row="6" Grid.Column="0" Text="Password" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                        <TextBox Grid.Row="6" Grid.Column="1" Text="{Binding Password, Mode=TwoWay}" PasswordChar="•"/>
                                    </Grid>
                                    </Panel>

                                    <Border Background="{DynamicResource AppSurface2Brush}" CornerRadius="8" Padding="12" IsVisible="{Binding SelectedProxy, Converter={x:Static ObjectConverters.IsNotNull}}">
                                        <StackPanel Spacing="8">
                                            <TextBlock Classes="section" Text="LISTE IN CUI COMPARE"/>
                                            <ItemsControl ItemsSource="{Binding Memberships}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="vm:ProxyMembershipItem">
                                                        <Grid ColumnDefinitions="*, Auto, Auto, Auto" Margin="0,2">
                                                            <CheckBox Content="{Binding Title}" IsChecked="{Binding IsMember, Mode=TwoWay}" ToolTip.Tip="Spunta per aggiungerlo a questa lista, togli la spunta per toglierlo"/>
                                                            <Border Grid.Column="1" Classes="pill active" Margin="0,0,4,0" IsVisible="{Binding IsActive}"><TextBlock Text="ATTIVO"/></Border>
                                                            <TextBlock Grid.Column="2" Classes="mono" Text="{Binding StateText}" FontSize="11" Foreground="{DynamicResource AppTextMutedBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                            <Border Grid.Column="3" Classes="pill" Classes.ok="{Binding StatusOk}" Classes.failed="{Binding StatusFailed}" Classes.untested="{Binding StatusUntested}"
                                                                    IsVisible="{Binding StatusText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                                                <TextBlock Text="{Binding StatusText}"/>
                                                            </Border>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </DockPanel>
                    </ScrollViewer>
                    <!-- Copia del messaggio fissata in alto, visibile solo scorrendo (StickyBanner) -->
                    <Border x:Name="ProxyStickyBanner" VerticalAlignment="Top" IsVisible="False" Padding="0,10,0,0" Background="{DynamicResource AppBackgroundBrush}">
                        <ContentControl Margin="0,0,0,8" Theme="{StaticResource StatusBannerTheme}" Content="{Binding ProxyStatusMessage}"/>
                    </Border>
                    </Panel>
                </Panel>
                <Panel IsVisible="{Binding #MainTabs.SelectedIndex, Converter={x:Static vm:IndexEqualsConverter.Default}, ConverterParameter=7}">
                    <!-- Il messaggio di stato sta nella pagina; scorrendo ne compare una copia fissa in alto -->
                    <Panel DataContext="{Binding Domains}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" h:StickyBanner.Overlay="{Binding #DomainsStickyBanner}">
                        <DockPanel Margin="0,10,0,0">
                            <ContentControl DockPanel.Dock="Top" Theme="{StaticResource StatusBannerTheme}" Content="{Binding StatusMessage}"/>
                            <!-- STATUS (in alto, sopra la guida) -->

                            <!-- GUIDA DOMINI -->
                            <Border DockPanel.Dock="Top" Classes="cardElevated" Margin="0,0,0,12" Padding="0" ClipToBounds="True">
                                <StackPanel>
                                    <ToggleButton Classes="guideToggle" x:Name="ToggleGuideDomini" IsChecked="False">
                                        <Grid ColumnDefinitions="*, Auto">
                                            <StackPanel Classes="bi">
                                                <Path Classes="icon accent" Data="{StaticResource IconBulb}"/>
                                                <TextBlock Text="Guida rapida - Domini" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource AppTextBrush}"/>
                                            </StackPanel>
                                            <Path Grid.Column="1" Classes="chevron"/>
                                        </Grid>
                                    </ToggleButton>
                                    <Border IsVisible="{Binding #ToggleGuideDomini.IsChecked}" Background="Transparent" Margin="16,0,16,16" Padding="12,12,4,12">
                                        <ScrollViewer MaxHeight="240" VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
                                        <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource AppTextMutedBrush}">
                                            <Run FontWeight="Bold" Foreground="{DynamicResource AppTextBrush}">A cosa serve</Run><LineBreak/>
                                            I siti dei provider cambiano spesso indirizzo. Qui vedi il dominio usato per ciascun provider e se risponde.<LineBreak/>
                                            <LineBreak/>
                                            <Run FontWeight="Bold" Foreground="{DynamicResource AppTextBrush}">Come si usa</Run><LineBreak/>
                                            <Run FontWeight="SemiBold" Foreground="{DynamicResource AppTextBrush}">• Test:</Run> "Test tutti" (o il pulsante a spina su una riga) controlla stato HTTP e tempo di risposta. Il pallino è verde se il sito risponde e rosso se non è raggiungibile.<LineBreak/>
                                            <Run FontWeight="SemiBold" Foreground="{DynamicResource AppTextBrush}">• Modifica:</Run> se un sito ha cambiato indirizzo, scrivi quello nuovo e premi il pulsante Salva della riga: i provider useranno subito il nuovo dominio.<LineBreak/>
                                            <Run FontWeight="SemiBold" Foreground="{DynamicResource AppTextBrush}">• Controllo automatico:</Run> i domini vengono ricontrollati da soli; con "Ricontrolla" scegli ogni quanti minuti (o solo all'avvio) e accanto vedi quando avverrà il prossimo controllo.<LineBreak/>
                                            <Run FontWeight="SemiBold" Foreground="{DynamicResource AppTextBrush}">• Ripristina:</Run> il pulsante con la freccia circolare riporta il dominio predefinito.<LineBreak/>
                                            <LineBreak/>
                                            <Run FontWeight="SemiBold" Foreground="{DynamicResource AppTextBrush}">• Indicatore:</Run> il pallino sulla tab Domini diventa rosso quando almeno un dominio non risponde.
                                        </TextBlock>
                                        </ScrollViewer>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <Border DockPanel.Dock="Top" Classes="cardElevated" Margin="0,0,0,12">
                                <WrapPanel Orientation="Horizontal" ItemSpacing="8" LineSpacing="6">
                                    <Button ToolTip.Tip="Verifica che tutti i domini rispondano (stato HTTP e tempo di risposta)" Classes="info" Command="{Binding TestAllCommand}" IsEnabled="{Binding !IsTestingAll}"><StackPanel Classes="bi"><Path Classes="icon" Data="{StaticResource IconPlug}"/><TextBlock Text="Test tutti"/></StackPanel></Button>
                                    <Button ToolTip.Tip="Interrompe il test dei domini" Classes="danger" Command="{Binding StopTestAllCommand}" IsVisible="{Binding IsTestingAll}"><StackPanel Classes="bi"><Path Classes="icon" Data="{StaticResource IconStop}"/><TextBlock Text="Stop"/></StackPanel></Button>
                                    <Border Width="1" Background="{DynamicResource AppBorderBrush}" Margin="6,2"/>
                                    <StackPanel Classes="bi" ToolTip.Tip="Ricontrolla i domini in background mentre l'app è aperta; se uno smette di rispondere il pallino della tab diventa rosso">
                                        <Path Classes="icon accent" Data="{StaticResource IconClock}"/>
                                        <TextBlock Text="Ricontrolla" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                        <ComboBox ItemsSource="{Binding CheckIntervalLabels}" SelectedIndex="{Binding CheckIntervalIndex, Mode=TwoWay}" MinWidth="160" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding NextCheckText}" FontSize="11" Foreground="{DynamicResource AppTextMutedBrush}" VerticalAlignment="Center"/>
                                </WrapPanel>
                            </Border>

                            <Border Classes="cardElevated">
                                <StackPanel Spacing="4">
                                    <Grid ColumnDefinitions="140, *, 180, 140, Auto, Auto" Margin="10,4,10,8">
                                        <TextBlock Grid.Column="0" Text="Provider" FontWeight="Bold" FontSize="12"/>
                                        <TextBlock Grid.Column="1" Text="URL" FontWeight="Bold" FontSize="12"/>
                                        <TextBlock Grid.Column="2" Text="Stato" FontWeight="Bold" FontSize="12"/>
                                        <TextBlock Grid.Column="3" Text="Ultimo test" FontWeight="Bold" FontSize="12"/>
                                    </Grid>

                                    <ItemsControl ItemsSource="{Binding Domains}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="models:DomainConfig">
                                                <Border Padding="10,7" Background="{DynamicResource DownloadGroupRowBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="0,0,0,1">
                                                    <Grid ColumnDefinitions="140, *, 180, 140, Auto, Auto">
                                                        <TextBlock Grid.Column="0" Text="{Binding ProviderName}" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                                        <TextBox Grid.Column="1" Text="{Binding Url, Mode=TwoWay}" Margin="0,0,8,0" MinHeight="32" VerticalAlignment="Center"/>
                                                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                            <Panel VerticalAlignment="Center" Margin="2,0,2,0"><Ellipse Width="10" Height="10" Fill="{DynamicResource AppSuccessBrush}" IsVisible="{Binding StatusTone, Converter={x:Static h:ToneConverters.Is}, ConverterParameter=ok}"/><Ellipse Width="10" Height="10" Fill="{DynamicResource AppDangerBrush}" IsVisible="{Binding StatusTone, Converter={x:Static h:ToneConverters.Is}, ConverterParameter=ko}"/><Ellipse Width="10" Height="10" Fill="{DynamicResource AppTextMutedBrush}" Opacity="0.6" IsVisible="{Binding StatusTone, Converter={x:Static h:ToneConverters.Is}, ConverterParameter=none}"/></Panel>
                                                            <TextBlock Text="{Binding StatusMessage}" FontSize="11" Foreground="{DynamicResource AppTextMutedBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                        </StackPanel>
                                                        <TextBlock Grid.Column="3" Text="{Binding LastTested, StringFormat='{}{0:dd/MM HH:mm:ss}'}" FontSize="11" Foreground="{DynamicResource AppTextMutedBrush}" VerticalAlignment="Center"/>
                                                        <Button Grid.Column="4" Classes="iconCircle" Width="32" Height="32" Margin="4,0" Command="{Binding $parent[ItemsControl].((vm:DomainsTabViewModel)DataContext).TestSingleCommand}" CommandParameter="{Binding}" ToolTip.Tip="Testa la connessione al dominio">
                                                            <Path Classes="icon" Data="{StaticResource IconPlug}"/>
                                                        </Button>
                                                        <StackPanel Grid.Column="5" Orientation="Horizontal" Spacing="4">
                                                            <Button Classes="iconCircle" Width="32" Height="32" Command="{Binding $parent[ItemsControl].((vm:DomainsTabViewModel)DataContext).SaveDomainCommand}" CommandParameter="{Binding}" ToolTip.Tip="Salva il nuovo URL nel database">
                                                                <Path Classes="icon" Data="{StaticResource IconSave}"/>
                                                            </Button>
                                                            <Button Classes="iconCircle" Width="32" Height="32" Command="{Binding $parent[ItemsControl].((vm:DomainsTabViewModel)DataContext).ResetDomainCommand}" CommandParameter="{Binding}" ToolTip.Tip="Ripristina l'URL di default di questo provider" IsEnabled="{Binding IsModified}">
                                                                <Path Classes="icon" Data="{StaticResource IconUndo}"/>
                                                            </Button>
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </DockPanel>
                    </ScrollViewer>
                    <!-- Copia del messaggio fissata in alto, visibile solo scorrendo (StickyBanner) -->
                    <Border x:Name="DomainsStickyBanner" VerticalAlignment="Top" IsVisible="False" Padding="0,10,0,0" Background="{DynamicResource AppBackgroundBrush}">
                        <ContentControl Margin="0,0,0,8" Theme="{StaticResource StatusBannerTheme}" Content="{Binding StatusMessage}"/>
                    </Border>
                    </Panel>
                </Panel>
            </Panel>
        </DockPanel>

        <!-- ============================================================ -->
        <!--  LOG PANEL                                                   -->
        <!-- ============================================================ -->
        <Border Grid.Row="3"
                x:Name="LogPanel"
                Background="{DynamicResource AppSurfaceBrush}"
                BorderBrush="{DynamicResource AppBorderBrush}"
                BorderThickness="1"
                CornerRadius="14"
                MinHeight="43"
                MaxHeight="43"
                Height="43"
                Margin="12,6,12,0"
                ClipToBounds="True">
            <DockPanel>
                <Grid DockPanel.Dock="Top" Height="40" ColumnDefinitions="Auto, *, Auto, Auto, Auto, Auto, Auto" Margin="0,0,8,0">
                    <!-- Barra di stato: cosa sta lavorando, visibile da ogni tab (clic = apre la tab) -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Margin="6,0,10,0" ClipToBounds="True">
                        <TextBlock Text="Nessun download o trasferimento in corso" FontSize="11" Foreground="{DynamicResource AppTextMutedBrush}" VerticalAlignment="Center" IsVisible="{Binding Activity.IsIdle}"/>
                        <Button Classes="statusChip" Classes.failed="{Binding Activity.AnimeHasFailed}" IsVisible="{Binding Activity.HasAnime}" ToolTip.Tip="{Binding Activity.AnimeTip}" Click="OnStatusAnimeClick">
                            <StackPanel Classes="bi"><Path Classes="icon" Data="{StaticResource IconPlayCircle}"/><TextBlock Text="Anime"/><TextBlock Classes="chipValue" Text="{Binding Activity.AnimeText}"/></StackPanel>
                        </Button>
                        <Button Classes="statusChip" Classes.failed="{Binding Activity.StreamingHasFailed}" IsVisible="{Binding Activity.HasStreaming}" ToolTip.Tip="{Binding Activity.StreamingTip}" Click="OnStatusStreamingClick">
                            <StackPanel Classes="bi"><Path Classes="icon" Data="{StaticResource IconFilm}"/><TextBlock Text="Film/Serie"/><TextBlock Classes="chipValue" Text="{Binding Activity.StreamingText}"/></StackPanel>
                        </Button>
                        <Button Classes="statusChip" Classes.failed="{Binding Activity.SftpHasFailed}" IsVisible="{Binding Activity.HasSftp}" ToolTip.Tip="{Binding Activity.SftpTip}" Click="OnStatusSftpClick">
                            <StackPanel Classes="bi"><Path Classes="icon" Data="{StaticResource IconCloud}"/><TextBlock Text="SFTP"/><TextBlock Classes="chipValue" Text="{Binding Activity.SftpText}"/></StackPanel>
                        </Button>
                    </StackPanel>
                    <ToggleButton Grid.Column="0" x:Name="ToggleLogButton" Classes="guideToggle"
                                IsChecked="False" Height="40" Padding="14,0"
                                Click="OnToggleLogClick" ToolTip.Tip="Comprimi / espandi log">
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Path Classes="chevron" Margin="0"/>
                            <Path Classes="icon accent" Data="{StaticResource IconList}"/>
                            <TextBlock Text="Log globale" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" Foreground="{DynamicResource AppTextBrush}"/>
                            <Border Background="{DynamicResource AppSurface2Brush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" CornerRadius="999" Padding="8,1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding FilteredLogs.Count}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource AppTextMutedBrush}"/>
                            </Border>
                        </StackPanel>
                    </ToggleButton>
                    <ComboBox Grid.Column="2" ItemsSource="{Binding LogLevelFilters}" SelectedIndex="{Binding SelectedLogLevelFilter}" Height="28" MinWidth="150" FontSize="11" Margin="0,0,6,0" VerticalAlignment="Center" ToolTip.Tip="Mostra tutti i messaggi o solo avvisi/errori"/>
                    <ComboBox Grid.Column="3" ItemsSource="{Binding LogCategories}" SelectedItem="{Binding SelectedLogCategory}" Height="28" MinWidth="150" FontSize="11" Margin="0,0,8,0" VerticalAlignment="Center" ToolTip.Tip="Mostra solo i messaggi di una sezione dell'app"/>
                    <Button Grid.Column="4" FontSize="11" Padding="10,0" Height="28" Command="{Binding CopyLogsCommand}" Margin="0,0,4,0" ToolTip.Tip="Copia negli appunti i log visibili (filtrati)" Classes="ghost"><StackPanel Classes="bi"><Path Classes="icon" Data="{StaticResource IconCopy}"/><TextBlock Text="Copia"/></StackPanel></Button>
                    <Button Grid.Column="5" FontSize="11" Padding="10,0" Height="28" Command="{Binding ExportLogsCommand}" Margin="0,0,4,0" ToolTip.Tip="Salva tutto il log su un file di testo" Classes="ghost"><StackPanel Classes="bi"><Path Classes="icon" Data="{StaticResource IconSave}"/><TextBlock Text="Esporta"/></StackPanel></Button>
                    <Button Grid.Column="6" FontSize="11" Padding="10,0" Height="28" Command="{Binding ClearLogsCommand}" Classes="ghost" ToolTip.Tip="Svuota il log"><StackPanel Classes="bi"><Path Classes="icon" Data="{StaticResource IconTrash}"/><TextBlock Text="Pulisci"/></StackPanel></Button>
                </Grid>
                <Border DockPanel.Dock="Top" Height="1" Background="{DynamicResource AppBorderBrush}"/>
                <ScrollViewer x:Name="LogScrollViewer" IsVisible="False" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                    <!-- VirtualizingStackPanel: vengono create solo le righe visibili (il log arriva a 2000 voci) -->
                    <ItemsControl x:Name="LogItems" ItemsSource="{Binding FilteredLogs}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><VirtualizingStackPanel/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.Styles>
                            <Style Selector="SelectableTextBlock.logMessage">
                                <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}"/>
                            </Style>
                            <Style Selector="SelectableTextBlock.logMessage.error">
                                <Setter Property="Foreground" Value="{DynamicResource AppDangerBrush}"/>
                            </Style>
                            <Style Selector="SelectableTextBlock.logMessage.warning">
                                <Setter Property="Foreground" Value="{DynamicResource AppWarningBrush}"/>
                            </Style>
                        </ItemsControl.Styles>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Classes="logRow" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="0,0,0,1" Padding="14,4">
                                    <Grid ColumnDefinitions="Auto, Auto, Auto, *">
                                        <SelectableTextBlock Grid.Column="0" Text="{Binding TimestampText}" FontFamily="Cascadia Mono,Consolas,Menlo,monospace" FontSize="11" Foreground="{DynamicResource AppTextMutedBrush}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                        <Panel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,8,0" ToolTip.Tip="{Binding LevelText}"><Path Classes="icon" Width="12" Height="12" Stroke="{DynamicResource AppTextMutedBrush}" Data="{StaticResource IconInfo}" IsVisible="{Binding IsInfo}"/><Path Classes="icon" Width="12" Height="12" Stroke="{DynamicResource AppWarningBrush}" Data="{StaticResource IconAlert}" IsVisible="{Binding IsWarning}"/><Path Classes="icon" Width="12" Height="12" Stroke="{DynamicResource AppDangerBrush}" Data="{StaticResource IconAlertCircle}" IsVisible="{Binding IsError}"/></Panel>
                                        <Border Grid.Column="2" Background="{DynamicResource AppAccentSoftBrush}" CornerRadius="999" Padding="8,1" MinWidth="64" Margin="0,0,12,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Category}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource AppAccentBrush}" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                        </Border>
                                        <SelectableTextBlock Grid.Column="3" Classes="logMessage" Classes.error="{Binding IsError}" Classes.warning="{Binding IsWarning}" Text="{Binding Message}" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <Border Grid.Row="4" Height="10"/>
    </Grid>
</Window>